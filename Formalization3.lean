/-- Finite extraction of five ordered root-band divisors. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.1, Sub-layer 02, Sub-box 02

Incoming state shape:
  5 ≤ D_C C n

Outgoing state shape:
  ∃ d, five_near_root_divisor_witness C n d

Effect:
  Selects one increasing five-divisor witness from the counted root-band set.

Public theorem:
  finite_five_divisor_extraction

================================================================================
-/

theorem finite_five_divisor_extraction
    {C : ℝ} {n : ℕ}
    (h5 : 5 ≤ D_C C n) :
    ∃ d : Fin 5 → ℕ, five_near_root_divisor_witness C n d := by
  have hDC : D_C_state_shape C n :=
    close_D_C_state_shape C n

  have hcard : 5 ≤ (rootBandDivisors C n).card := by
    rw [← hDC.1]
    exact h5

  let e : Fin 5 ↪o ℕ :=
    (rootBandDivisors C n).orderEmbOfCardLe hcard

  refine ⟨fun i => e i, ?_⟩
  apply
    (five_near_root_divisor_witness_state_shape
      (C := C) (n := n) (d := fun i => e i)).2
  constructor
  · exact e.strictMono
  · intro i
    have hi : e i ∈ rootBandDivisors C n := by
      simpa [e] using
        (Finset.orderEmbOfCardLe_mem (rootBandDivisors C n) hcard i)
    exact (hDC.2 (e i)).mp hi

/- ## Sub-container 3.2: Near-root pairs. -/

/- Sub-layer 01 -/
/-
Paper ref: 3.2
Sub-box Label: `Near-root pair setup: R=sqrt n, H=C n^(1/4), R<d_i<d_j<R+H`
Sub-inputs: `Five_ext`
Sub-outputs: `near_root_pair_context`
-/
def section_3_2_sub_layer_01_sub_box_01_label : String := "Near-root pair setup: R=sqrt n, H=C n^(1/4), R<d_i<d_j<R+H"
def section_3_2_sub_layer_01_sub_box_01_inputs : List String := ["Five_ext [construction]"]
def section_3_2_sub_layer_01_sub_box_01_outputs : List String := ["near_root_pair_context [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.2, Sub-layer 01, Sub-box 01
Birth token: near_root_pair_context

This box selects one ordered edge i<j from the already extracted witness and
opens only the pair facts used by the exact four-block decomposition.  It does
not choose new divisors and does not yet construct g,u,v,w.
================================================================================
-/

/--
The selected ordered pair is an edge of the same five-divisor witness.
No custom structure or record is introduced.
-/
def near_root_pair_context
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ) (i j : Fin 5) : Prop :=
  five_near_root_divisor_witness C n d ∧ i < j

/-- Build the pair context from the existing witness and one ordered edge. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.2, Sub-layer 01, Sub-box 01

Incoming state shape:
  five_near_root_divisor_witness C n d
  i < j

Outgoing state shape:
  near_root_pair_context C n d i j

Effect:
  Opens one ordered edge of the same selected witness without reselecting a
  divisor.

Public theorem:
  build_near_root_pair_context

================================================================================
-/

theorem build_near_root_pair_context
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {i j : Fin 5}
    (hW : five_near_root_divisor_witness C n d)
    (hij : i < j) :
    near_root_pair_context C n d i j :=
  ⟨hW, hij⟩

/--
The exact finite data opened from a near-root pair context.  Positivity follows
from the lower root-band inequality and is recorded here for the division
lemmas in the next box.
-/
theorem near_root_pair_context_data
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {i j : Fin 5}
    (hpair : near_root_pair_context C n d i j) :
    d i < d j ∧
      0 < d i ∧ 0 < d j ∧
      d i ∣ n ∧ d j ∣ n ∧
      inRootBand C n (d i) ∧ inRootBand C n (d j) := by
  rcases hpair with ⟨hW, hij⟩
  rcases hW with ⟨hmono, hdata⟩
  have hi := hdata i
  have hj := hdata j
  have hdi_pos : 0 < d i := by
    apply Nat.pos_of_ne_zero
    intro hzero
    have hneg : Real.sqrt (n : ℝ) < 0 := by
      simpa [hzero] using hi.2.1
    exact (not_lt_of_ge (Real.sqrt_nonneg (n : ℝ))) hneg
  have hdj_pos : 0 < d j := by
    apply Nat.pos_of_ne_zero
    intro hzero
    have hneg : Real.sqrt (n : ℝ) < 0 := by
      simpa [hzero] using hj.2.1
    exact (not_lt_of_ge (Real.sqrt_nonneg (n : ℝ))) hneg
  exact ⟨hmono hij, hdi_pos, hdj_pos, hi.1, hj.1, hi.2, hj.2⟩

/- Sub-layer 02 -/
/-
Paper ref: 3.2
Sub-box Label: `Pair decomposition: g=gcd(d_i,d_j), d_i=g u, d_j=g v, n=g u v w`
Sub-inputs: `near_root_pair_context`
Sub-outputs: `pair_four_block_labels`
-/
def section_3_2_sub_layer_02_sub_box_02_label : String := "Pair decomposition: g=gcd(d_i,d_j), d_i=g u, d_j=g v, n=g u v w"
def section_3_2_sub_layer_02_sub_box_02_inputs : List String := ["near_root_pair_context [construction]"]
def section_3_2_sub_layer_02_sub_box_02_outputs : List String := ["pair_four_block_labels [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.2, Sub-layer 02, Sub-box 02
Birth token: pair_four_block_labels

This box owns the exact reduced four-block decomposition and the two lower
partner reads.  It constructs g,u,v,w from one selected pair.  The later root-
gap box reads these equations but does not reconstruct the factors.
================================================================================
-/

/--
The exact four-block label attached to one ordered pair of divisors.
The last two conjuncts are the lower partner identities from the same integer n.
-/
def pair_four_block_labels
    (n d_i d_j g u v w : ℕ) : Prop :=
  g = Nat.gcd d_i d_j ∧
    d_i = g * u ∧
    d_j = g * v ∧
    Nat.Coprime u v ∧
    u < v ∧
    n = g * u * v * w ∧
    n / d_i = v * w ∧
    n / d_j = u * w

/--
Every selected ordered near-root pair has an exact reduced four-block label.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.2, Sub-layer 02, Sub-box 02

Incoming state shape:
  near_root_pair_context C n d i j

Outgoing state shape:
  ∃ g u v w, pair_four_block_labels n (d i) (d j) g u v w

Effect:
  Re-encodes the selected edge as its exact gcd-reduced four-block
  factorization and lower-partner equations.

Public theorem:
  pair_decomposition

================================================================================
-/

theorem pair_decomposition
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {i j : Fin 5}
    (hpair : near_root_pair_context C n d i j) :
    ∃ g u v w : ℕ,
      pair_four_block_labels n (d i) (d j) g u v w := by
  rcases near_root_pair_context_data hpair with
    ⟨hij, hdi_pos, hdj_pos, hdi_dvd, hdj_dvd, _, _⟩

  let g : ℕ := Nat.gcd (d i) (d j)
  obtain ⟨u, v, hcop, hdi_raw, hdj_raw⟩ := Nat.exists_coprime (d i) (d j)

  have hdi : d i = g * u := by
    simpa [g, Nat.mul_comm] using hdi_raw
  have hdj : d j = g * v := by
    simpa [g, Nat.mul_comm] using hdj_raw
  have hg_pos : 0 < g := by
    exact Nat.gcd_pos_of_pos_left (d j) hdi_pos
  have huv : u < v := by
    apply (Nat.mul_lt_mul_left hg_pos).mp
    simpa [hdi, hdj] using hij

  have hlcm : Nat.lcm (d i) (d j) = g * (u * v) := by
    rw [hdi, hdj, Nat.lcm_mul_left]
    rw [hcop.lcm_eq_mul]

  have hguv_dvd : g * (u * v) ∣ n := by
    rw [← hlcm]
    exact Nat.lcm_dvd hdi_dvd hdj_dvd

  rcases hguv_dvd with ⟨w, hw⟩
  have hn : n = g * u * v * w := by
    simpa [Nat.mul_assoc] using hw

  have hlower_i : n / d i = v * w := by
    apply (Nat.div_eq_iff_eq_mul_right hdi_pos hdi_dvd).2
    rw [hn, hdi]
    ring
  have hlower_j : n / d j = u * w := by
    apply (Nat.div_eq_iff_eq_mul_right hdj_pos hdj_dvd).2
    rw [hn, hdj]
    ring

  refine ⟨g, u, v, w, ?_⟩
  exact ⟨rfl, hdi, hdj, hcop, huv, hn, hlower_i, hlower_j⟩

/- Sub-layer 03 -/
/-
Paper ref: 3.2
Sub-box Label: `Root-gap pair laws: Delta_j-Delta_i=(v-u)(g+w), Delta_i+Delta_j=(u+v)(g-w)`
Sub-inputs: `pair_four_block_labels`
Sub-outputs: `root_gap_pair_laws`
-/
def section_3_2_sub_layer_03_sub_box_03_label : String := "Root-gap pair laws: Delta_j-Delta_i=(v-u)(g+w), Delta_i+Delta_j=(u+v)(g-w)"
def section_3_2_sub_layer_03_sub_box_03_inputs : List String := ["pair_four_block_labels [construction]"]
def section_3_2_sub_layer_03_sub_box_03_outputs : List String := ["root_gap_pair_laws [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.2, Sub-layer 03, Sub-box 03
Birth token: root_gap_pair_laws

Natural subtraction is not used for the pair gaps.  The exact identities live
in the integers, where subtraction has the same meaning as in the paper.
================================================================================
-/

/-- The signed gap between an upper divisor and its lower partner. -/
def pairGap (n d : ℕ) : ℤ :=
  (d : ℤ) - ((n / d : ℕ) : ℤ)

/-- The two exact root-gap identities attached to one four-block label. -/
def root_gap_pair_laws
    (n d_i d_j g u v w : ℕ) : Prop :=
  pairGap n d_j - pairGap n d_i =
      ((v : ℤ) - (u : ℤ)) * ((g : ℤ) + (w : ℤ)) ∧
    pairGap n d_i + pairGap n d_j =
      ((u : ℤ) + (v : ℤ)) * ((g : ℤ) - (w : ℤ))

/-- The four-block equations imply the two exact signed root-gap laws. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.2, Sub-layer 03, Sub-box 03

Incoming state shape:
  pair_four_block_labels n d_i d_j g u v w

Outgoing state shape:
  root_gap_pair_laws n d_i d_j g u v w

Effect:
  Converts the four-block and lower-partner equations into the two signed
  integer pair-gap identities.

Public theorem:
  derive_root_gap_pair_laws

================================================================================
-/

theorem derive_root_gap_pair_laws
    {n d_i d_j g u v w : ℕ}
    (hlabels : pair_four_block_labels n d_i d_j g u v w) :
    root_gap_pair_laws n d_i d_j g u v w := by
  rcases hlabels with ⟨_, hdi, hdj, _, _, _, hlower_i, hlower_j⟩

  have hlower_i_int :
      ((n / d_i : ℕ) : ℤ) = ((v * w : ℕ) : ℤ) :=
    congrArg (fun x : ℕ => (x : ℤ)) hlower_i

  have hlower_j_int :
      ((n / d_j : ℕ) : ℤ) = ((u * w : ℕ) : ℤ) :=
    congrArg (fun x : ℕ => (x : ℤ)) hlower_j

  unfold root_gap_pair_laws pairGap
  constructor
  · rw [hlower_i_int, hlower_j_int, hdi, hdj]
    simp only [Nat.cast_mul]
    ring
  · rw [hlower_i_int, hlower_j_int, hdi, hdj]
    simp only [Nat.cast_mul]
    ring

/- Sub-layer 04 -/
/-
Paper ref: 3.2
Sub-box Label: `Root-band size control: pair gaps are O_C(n^(1/4)) and constrain pair blocks`
Sub-inputs: `near_root_pair_context`, `root_gap_pair_laws`
Sub-outputs: `pair_gap_size_controls`
Note: this box proves a finite explicit version of the paper's O_C(n^(1/4))
statement.  Each individual pair gap is strictly between 0 and
2*C*n^(1/4).  The difference-side block expression lies in the sharper interval
(-2*C*n^(1/4), 2*C*n^(1/4)); the positive sum-side expression is less than
4*C*n^(1/4).
-/
def section_3_2_sub_layer_04_sub_box_04_label : String := "Root-band size control: pair gaps are O_C(n^(1/4)) and constrain pair blocks"
def section_3_2_sub_layer_04_sub_box_04_inputs : List String := ["near_root_pair_context [read]", "root_gap_pair_laws [construction]"]
def section_3_2_sub_layer_04_sub_box_04_outputs : List String := ["pair_gap_size_controls [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.2, Sub-layer 04, Sub-box 04
Birth token: pair_gap_size_controls

This box replaces the paper's asymptotic O_C notation by explicit finite
inequalities.  It does not open Section 3.3 and does not route any parent wire.

For one root-band divisor d, write E=n/d and R=sqrt n.  The exact product
D*E=n and R^2=n give

  (D-E)D = (D-R)(D+R).

Since R<D<R+C*n^(1/4), the right side is less than
2*C*n^(1/4)*D.  Positivity of D permits cancellation, giving

  0 < D-E < 2*C*n^(1/4).

The exact root-gap laws then transfer these two individual bounds without
discarding the available constants: their difference lies between
-2*C*n^(1/4) and 2*C*n^(1/4), while their positive sum is less than
4*C*n^(1/4).
================================================================================
-/

/-- The real form of the difference-side four-block expression. -/
def pairBlockDifferenceReal (g u v w : ℕ) : ℝ :=
  ((v : ℝ) - (u : ℝ)) * ((g : ℝ) + (w : ℝ))

/-- The real form of the sum-side four-block expression. -/
def pairBlockSumReal (g u v w : ℕ) : ℝ :=
  ((u : ℝ) + (v : ℝ)) * ((g : ℝ) - (w : ℝ))

/--
Finite root-band size controls for one ordered divisor pair.

The first four conjuncts bound the two individual signed pair gaps.  The last
four conjuncts retain the strongest bounds immediately supplied by those two
gaps: the difference expression lies in the open interval with radius
`2*C*fourthRootNat n`, and the positive sum expression is below
`4*C*fourthRootNat n`.
-/
def pair_gap_size_controls
    (C : ℝ) (n d_i d_j g u v w : ℕ) : Prop :=
  0 < ((pairGap n d_i : ℤ) : ℝ) ∧
    ((pairGap n d_i : ℤ) : ℝ) < 2 * C * fourthRootNat n ∧
    0 < ((pairGap n d_j : ℤ) : ℝ) ∧
    ((pairGap n d_j : ℤ) : ℝ) < 2 * C * fourthRootNat n ∧
    -(2 * C * fourthRootNat n) < pairBlockDifferenceReal g u v w ∧
    pairBlockDifferenceReal g u v w < 2 * C * fourthRootNat n ∧
    0 < pairBlockSumReal g u v w ∧
    pairBlockSumReal g u v w < 4 * C * fourthRootNat n

/--
A single root-band divisor has a positive pair gap bounded by twice the window
height. This is the explicit finite inequality behind the paper's
`O_C(n^(1/4))` statement.
-/
theorem pairGap_real_pos_and_lt
    {C : ℝ} {n d : ℕ}
    (hdvd : d ∣ n)
    (hband : inRootBand C n d) :
    0 < ((pairGap n d : ℤ) : ℝ) ∧
      ((pairGap n d : ℤ) : ℝ) <
        2 * C * fourthRootNat n := by
  have hsqrt_nonneg : 0 ≤ Real.sqrt (n : ℝ) :=
    Real.sqrt_nonneg (n : ℝ)

  have hd_pos : 0 < (d : ℝ) :=
    lt_of_le_of_lt hsqrt_nonneg hband.1

  have hsqrt_sq : (Real.sqrt (n : ℝ)) ^ 2 = (n : ℝ) :=
    Real.sq_sqrt (Nat.cast_nonneg n)

  have hprod_nat : d * (n / d) = n := by
    simpa [Nat.mul_comm] using Nat.div_mul_cancel hdvd

  have hprod_real :
      (d : ℝ) * ((n / d : ℕ) : ℝ) = (n : ℝ) := by
    have hcast :=
      congrArg (fun x : ℕ => (x : ℝ)) hprod_nat
    simpa only [Nat.cast_mul] using hcast

  have hd_sq_gt : (n : ℝ) < (d : ℝ) ^ 2 := by
    nlinarith [hband.1, hsqrt_nonneg, hsqrt_sq]

  have hlower_lt :
      ((n / d : ℕ) : ℝ) < (d : ℝ) := by
    by_contra hnot
    have hle :
        (d : ℝ) ≤ ((n / d : ℕ) : ℝ) :=
      le_of_not_gt hnot

    have hmul :
        (d : ℝ) ^ 2 ≤
          (d : ℝ) * ((n / d : ℕ) : ℝ) := by
      simpa [pow_two] using
        mul_le_mul_of_nonneg_left hle (le_of_lt hd_pos)

    rw [hprod_real] at hmul
    exact (not_le_of_gt hd_sq_gt) hmul

  have hgap_cast :
      ((pairGap n d : ℤ) : ℝ) =
        (d : ℝ) - ((n / d : ℕ) : ℝ) := by
    simp only [pairGap, Int.cast_sub, Int.cast_natCast]

  have hdelta_pos :
      0 < (d : ℝ) - Real.sqrt (n : ℝ) :=
    sub_pos.mpr hband.1

  have hdelta_lt :
      (d : ℝ) - Real.sqrt (n : ℝ) <
        C * fourthRootNat n := by
    linarith [hband.2]

  have hwindow_pos :
      0 < C * fourthRootNat n :=
    lt_trans hdelta_pos hdelta_lt

  have hsum_pos :
      0 < (d : ℝ) + Real.sqrt (n : ℝ) :=
    add_pos_of_pos_of_nonneg hd_pos hsqrt_nonneg

  have hsum_lt :
      (d : ℝ) + Real.sqrt (n : ℝ) <
        2 * (d : ℝ) := by
    linarith [hband.1]

  have hfirst :
      ((d : ℝ) - Real.sqrt (n : ℝ)) *
          ((d : ℝ) + Real.sqrt (n : ℝ)) <
        (C * fourthRootNat n) *
          ((d : ℝ) + Real.sqrt (n : ℝ)) :=
    mul_lt_mul_of_pos_right hdelta_lt hsum_pos

  have hsecond :
      (C * fourthRootNat n) *
          ((d : ℝ) + Real.sqrt (n : ℝ)) <
        (C * fourthRootNat n) * (2 * (d : ℝ)) :=
    mul_lt_mul_of_pos_left hsum_lt hwindow_pos

  have hfactor :
      ((d : ℝ) - ((n / d : ℕ) : ℝ)) * (d : ℝ) =
        ((d : ℝ) - Real.sqrt (n : ℝ)) *
          ((d : ℝ) + Real.sqrt (n : ℝ)) := by
    calc
      ((d : ℝ) - ((n / d : ℕ) : ℝ)) * (d : ℝ)
          =
          (d : ℝ) ^ 2 -
            (d : ℝ) * ((n / d : ℕ) : ℝ) := by
              ring
      _ = (d : ℝ) ^ 2 - (n : ℝ) := by
            rw [hprod_real]
      _ =
          (d : ℝ) ^ 2 -
            (Real.sqrt (n : ℝ)) ^ 2 := by
              rw [hsqrt_sq]
      _ =
          ((d : ℝ) - Real.sqrt (n : ℝ)) *
            ((d : ℝ) + Real.sqrt (n : ℝ)) := by
              ring

  have hscaled :
      ((d : ℝ) - ((n / d : ℕ) : ℝ)) * (d : ℝ) <
        (2 * C * fourthRootNat n) * (d : ℝ) := by
    calc
      ((d : ℝ) - ((n / d : ℕ) : ℝ)) * (d : ℝ)
          =
          ((d : ℝ) - Real.sqrt (n : ℝ)) *
            ((d : ℝ) + Real.sqrt (n : ℝ)) :=
        hfactor
      _ <
          (C * fourthRootNat n) *
            ((d : ℝ) + Real.sqrt (n : ℝ)) :=
        hfirst
      _ <
          (C * fourthRootNat n) *
            (2 * (d : ℝ)) :=
        hsecond
      _ =
          (2 * C * fourthRootNat n) * (d : ℝ) := by
        ring

  have hgap_lt :
      (d : ℝ) - ((n / d : ℕ) : ℝ) <
        2 * C * fourthRootNat n := by
    nlinarith [hscaled, hd_pos]

  constructor
  · rw [hgap_cast]
    linarith
  · rw [hgap_cast]
    exact hgap_lt

/--
The root-band pair context, four-block equations, and exact root-gap identities
produce the explicit finite pair-gap controls.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.2, Sub-layer 04, Sub-box 04

Incoming state shape:
  near_root_pair_context C n d i j
  root_gap_pair_laws n (d i) (d j) g u v w

Outgoing state shape:
  pair_gap_size_controls C n (d i) (d j) g u v w

Effect:
  Applies the finite root-band estimate to both endpoint gaps and transfers the
  exact gap laws into the complete pair-block size-control packet.

Public theorem:
  derive_pair_gap_size_controls

================================================================================
-/

theorem derive_pair_gap_size_controls
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {i j : Fin 5}
    {g u v w : ℕ}
    (hpair : near_root_pair_context C n d i j)
    (hlaws : root_gap_pair_laws n (d i) (d j) g u v w) :
    pair_gap_size_controls C n (d i) (d j) g u v w := by
  rcases near_root_pair_context_data hpair with
    ⟨_, _, _, hdi_dvd, hdj_dvd, hband_i, hband_j⟩
  rcases pairGap_real_pos_and_lt hdi_dvd hband_i with
    ⟨hgap_i_pos, hgap_i_lt⟩
  rcases pairGap_real_pos_and_lt hdj_dvd hband_j with
    ⟨hgap_j_pos, hgap_j_lt⟩

  have hdiff_cast := congrArg (fun z : ℤ => (z : ℝ)) hlaws.1
  have hsum_cast := congrArg (fun z : ℤ => (z : ℝ)) hlaws.2

  have hdiff :
      ((pairGap n (d j) : ℤ) : ℝ) -
          ((pairGap n (d i) : ℤ) : ℝ) =
        pairBlockDifferenceReal g u v w := by
    simpa [pairBlockDifferenceReal] using hdiff_cast
  have hsum :
      ((pairGap n (d i) : ℤ) : ℝ) +
          ((pairGap n (d j) : ℤ) : ℝ) =
        pairBlockSumReal g u v w := by
    simpa [pairBlockSumReal] using hsum_cast

  unfold pair_gap_size_controls
  refine ⟨hgap_i_pos, hgap_i_lt, hgap_j_pos, hgap_j_lt, ?_, ?_, ?_, ?_⟩
  · rw [← hdiff]
    linarith
  · rw [← hdiff]
    linarith
  · rw [← hsum]
    linarith
  · rw [← hsum]
    linarith

/-
================================================================================
STATE-SHAPE PARENT BATCH
Section 3.2 complete near-root-pair analysis

Incoming state shape:
  five_near_root_divisor_witness C n d

Outgoing state shape:
  pair_analysis_state C n d

Effect:
  Composes every Section 3.2 sub-box on every ordered edge: pair context,
  four-block decomposition, signed gap laws, and finite size controls.

Public theorem:
  close_pair_analysis_state

================================================================================
-/

def pair_analysis_state
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  ∀ i j : Fin 5, i < j →
    ∃ g u v w : ℕ,
      pair_four_block_labels n (d i) (d j) g u v w ∧
      root_gap_pair_laws n (d i) (d j) g u v w ∧
      pair_gap_size_controls C n (d i) (d j) g u v w

theorem close_pair_analysis_state
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hW : five_near_root_divisor_witness C n d) :
    pair_analysis_state C n d := by
  intro i j hij
  have hPair : near_root_pair_context C n d i j :=
    build_near_root_pair_context hW hij
  obtain ⟨g, u, v, w, hLabels⟩ :=
    pair_decomposition hPair
  have hLaws :
      root_gap_pair_laws n (d i) (d j) g u v w :=
    derive_root_gap_pair_laws hLabels
  have hControls :
      pair_gap_size_controls C n (d i) (d j) g u v w :=
    derive_pair_gap_size_controls hPair hLaws
  exact ⟨g, u, v, w, hLabels, hLaws, hControls⟩


/- ## Sub-container 3.3: The complete K5 pair-ratio graph. -/

/- Sub-layer 01 -/
/-
Paper ref: 3.3
Sub-box Label: `K5 edge ledger: ten reduced four-block edge labels (g_ij,u_ij,v_ij,w_ij)`
Sub-inputs: `Five_ext`, `pair_four_block_labels`
Sub-outputs: `K5_pair_ratio_graph`
-/
def section_3_3_sub_layer_01_sub_box_01_label : String := "K5 edge ledger: ten reduced four-block edge labels (g_ij,u_ij,v_ij,w_ij)"
def section_3_3_sub_layer_01_sub_box_01_inputs : List String := ["Five_ext [construction]", "pair_four_block_labels [construction]"]
def section_3_3_sub_layer_01_sub_box_01_outputs : List String := ["K5_pair_ratio_graph [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.3, Sub-layer 01, Sub-box 01
Birth token: K5_pair_ratio_graph

This box applies the already-proved pair decomposition to every ordered edge
i<j of the same five-divisor witness.

The ledger is kept as the proposition

  for every i<j, there exist g_ij,u_ij,v_ij,w_ij
  satisfying pair_four_block_labels.

This avoids introducing a custom structure or an arbitrary global choice
function.  Triangle consistency below is proved for every valid choice of the
three edge labels, so no coherence is lost by this representation.

[CONNECTION-AUDIT: K5-LEDGER-MATERIALIZATION]
This transitional graph is immediately materialized by
`materialize_K5_pair_ratio_frontier`; later arithmetic state reads one coherent
finite family and never reselects an edge.
================================================================================
-/

/--
The complete K5 four-block ledger over one ordered five-divisor witness.

Because the vertex type is `Fin 5`, the ordered pairs `i<j` are exactly the ten
unordered non-loop edges of K5.
-/
def K5_pair_ratio_graph
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  five_near_root_divisor_witness C n d ∧
    ∀ i j : Fin 5, i < j →
      ∃ g u v w : ℕ,
        pair_four_block_labels n (d i) (d j) g u v w

/--
One materialized family of four-block labels.  Only entries with `i < j` are
mathematical K5 edges; the other entries make the family a total Lean
function and are never read as edge data.
-/
abbrev K5FourBlockFamily :=
  Fin 5 → Fin 5 → (ℕ × ℕ × ℕ × ℕ)

/-- Every ordered K5 edge reads its four-block label from the same family. -/
def K5FourBlockFamilyLegal
    (n : ℕ) (d : Fin 5 → ℕ)
    (labels : K5FourBlockFamily) : Prop :=
  ∀ i j : Fin 5, i < j →
    pair_four_block_labels n (d i) (d j)
      (labels i j).1
      (labels i j).2.1
      (labels i j).2.2.1
      (labels i j).2.2.2

/--
Every five-divisor witness supplies a reduced four-block label on every K5
edge.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.3, Sub-layer 01, Sub-box 01

Incoming state shape:
  five_near_root_divisor_witness C n d

Outgoing state shape:
  K5_pair_ratio_graph C n d

Effect:
  Applies the pair-context and pair-decomposition batches to every ordered K5
  edge of the same witness.

Public theorem:
  build_K5_pair_ratio_graph

================================================================================
-/

theorem build_K5_pair_ratio_graph
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hW : five_near_root_divisor_witness C n d) :
    K5_pair_ratio_graph C n d := by
  refine ⟨hW, ?_⟩
  intro i j hij
  exact pair_decomposition
    (build_near_root_pair_context hW hij)

/--
The denominator and numerator in every reduced pair label are positive.

The denominator is positive because the lower endpoint divisor is positive and
equals `g*u`; the numerator is larger than the denominator.
-/
theorem pair_label_uv_positive
    {n d_i d_j g u v w : ℕ}
    (hdi_pos : 0 < d_i)
    (hlabels : pair_four_block_labels n d_i d_j g u v w) :
    0 < u ∧ 0 < v := by
  have hdi : d_i = g * u := hlabels.2.1
  have huv : u < v := hlabels.2.2.2.2.1
  have hu : 0 < u := by
    rw [hdi] at hdi_pos
    exact Nat.pos_of_mul_pos_left hdi_pos
  exact ⟨hu, lt_trans hu huv⟩

/--
One four-block label gives the denominator-cleared form of its edge ratio:

  d_j / d_i = v / u

is represented exactly in the naturals by

  d_j * u = d_i * v.
-/
theorem pair_label_ratio_cross
    {n d_i d_j g u v w : ℕ}
    (hlabels : pair_four_block_labels n d_i d_j g u v w) :
    d_j * u = d_i * v := by
  have hdi : d_i = g * u := hlabels.2.1
  have hdj : d_j = g * v := hlabels.2.2.1
  rw [hdi, hdj]
  ring

/--
The reduced four-block label of one positive ordered divisor pair is unique.

The positivity hypothesis excludes the degenerate zero-gcd tuple, which is not
an edge of a near-root witness.
-/
theorem pair_four_block_labels_unique
    {n d_i d_j : ℕ}
    {g₁ u₁ v₁ w₁ g₂ u₂ v₂ w₂ : ℕ}
    (hdi_pos : 0 < d_i)
    (h₁ :
      pair_four_block_labels n d_i d_j g₁ u₁ v₁ w₁)
    (h₂ :
      pair_four_block_labels n d_i d_j g₂ u₂ v₂ w₂) :
    (g₁, u₁, v₁, w₁) = (g₂, u₂, v₂, w₂) := by
  have hg : g₁ = g₂ := h₁.1.trans h₂.1.symm
  subst g₂
  have hg_pos : 0 < g₁ := by
    rw [h₁.1]
    exact Nat.gcd_pos_of_pos_left d_j hdi_pos
  have hu :
      u₁ = u₂ := by
    apply Nat.mul_left_cancel hg_pos
    exact h₁.2.1.symm.trans h₂.2.1
  subst u₂
  have hv :
      v₁ = v₂ := by
    apply Nat.mul_left_cancel hg_pos
    exact h₁.2.2.1.symm.trans h₂.2.2.1
  subst v₂
  have hu_pos : 0 < u₁ :=
    (pair_label_uv_positive hdi_pos h₁).1
  have hv_pos : 0 < v₁ :=
    (pair_label_uv_positive hdi_pos h₁).2
  have hbase_pos : 0 < g₁ * u₁ * v₁ :=
    Nat.mul_pos (Nat.mul_pos hg_pos hu_pos) hv_pos
  have hw :
      w₁ = w₂ := by
    apply Nat.mul_left_cancel hbase_pos
    exact h₁.2.2.2.2.2.1.symm.trans
      h₂.2.2.2.2.2.1
  subst w₂
  rfl

/--
Two legal materialized K5 families agree on every mathematical edge.
Diagonal and reverse-order dummy entries are intentionally unconstrained.
-/
theorem K5FourBlockFamilyLegal_unique_on_ordered_edges
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    {labels₁ labels₂ : K5FourBlockFamily}
    (hW : five_near_root_divisor_witness C n d)
    (h₁ : K5FourBlockFamilyLegal n d labels₁)
    (h₂ : K5FourBlockFamilyLegal n d labels₂) :
    ∀ i j : Fin 5, i < j →
      labels₁ i j = labels₂ i j := by
  intro i j hij
  rcases near_root_pair_context_data
      (build_near_root_pair_context hW hij) with
    ⟨_hij, hdi_pos, _hdj_pos, _hdi_dvd, _hdj_dvd,
      _hband_i, _hband_j⟩
  exact pair_four_block_labels_unique
    hdi_pos (h₁ i j hij) (h₂ i j hij)

/- Sub-layer 02 -/
/-
Paper ref: 3.3
Sub-box Label: `Triangle ratio consistency: edge ratios multiply around every K5 triangle`
Sub-inputs: `K5_pair_ratio_graph`
Sub-outputs: `Meta_K5`
Note: triangle consistency is exact ratio algebra on the ten edge labels.  The
pair-gap size controls are routed separately into the Section 3.4 extraction
opening and are not used to prove the triangle identity.
-/
def section_3_3_sub_layer_02_sub_box_02_label : String := "Triangle ratio consistency: edge ratios multiply around every K5 triangle"
def section_3_3_sub_layer_02_sub_box_02_inputs : List String := ["K5_pair_ratio_graph [construction]"]
def section_3_3_sub_layer_02_sub_box_02_outputs : List String := ["Meta_K5 [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.3, Sub-layer 02, Sub-box 02
Birth token: Meta_K5

For i<j<k, the three edge equations give

  d_j*u_ij = d_i*v_ij,
  d_k*u_jk = d_j*v_jk,
  d_k*u_ik = d_i*v_ik.

Multiplying and cancelling the positive divisor d_i yields the exact
denominator-cleared triangle identity

  v_ik*(u_ij*u_jk) = u_ik*(v_ij*v_jk).

The direct edge pair (u_ik,v_ik) is already coprime.  A separate elementary
reduced-fraction lemma then proves that it equals the gcd reduction of the
two-step denominator-numerator pair.

No natural-number division is used as a rational operation.
================================================================================
-/

/--
The paper's reduction operation

  red(a,b) = (a/gcd(a,b), b/gcd(a,b)).
-/
def red (a b : ℕ) : ℕ × ℕ :=
  (a / Nat.gcd a b, b / Nat.gcd a b)

/--
Uniqueness of a positive reduced natural fraction.

If `u` and `v` are coprime and `v*A = u*B`, then `(u,v)` is exactly the gcd
reduction of `(A,B)`.
-/
theorem coprime_pair_eq_red
    {u v A B : ℕ}
    (hu : 0 < u)
    (hv : 0 < v)
    (hA : 0 < A)
    (hcop : Nat.Coprime u v)
    (hcross : v * A = u * B) :
    (u, v) = red A B := by
  have hu_dvd_A : u ∣ A := by
    apply (hcop.dvd_mul_right).1
    refine ⟨B, ?_⟩
    calc
      A * v = v * A := Nat.mul_comm A v
      _ = u * B := hcross

  have hv_dvd_B : v ∣ B := by
    apply (hcop.symm.dvd_mul_right).1
    refine ⟨A, ?_⟩
    calc
      B * u = u * B := Nat.mul_comm B u
      _ = v * A := hcross.symm

  rcases hu_dvd_A with ⟨s, hs⟩
  rcases hv_dvd_B with ⟨t, ht⟩

  have hst_scaled :
      (u * v) * s = (u * v) * t := by
    calc
      (u * v) * s = v * (u * s) := by ring
      _ = v * A := by rw [hs]
      _ = u * B := hcross
      _ = u * (v * t) := by rw [ht]
      _ = (u * v) * t := by ring

  have hst : s = t :=
    Nat.mul_left_cancel (Nat.mul_pos hu hv) hst_scaled

  have hB_as : B = v * s := by
    rw [ht, ← hst]

  have hcop_gcd : Nat.gcd u v = 1 := hcop

  have hG : Nat.gcd A B = s := by
    calc
      Nat.gcd A B = Nat.gcd (u * s) (v * s) := by
        rw [hs, hB_as]
      _ = Nat.gcd u v * s := Nat.gcd_mul_right u s v
      _ = s := by
        rw [hcop_gcd, one_mul]

  have hs_pos : 0 < s := by
    rw [hs] at hA
    exact Nat.pos_of_mul_pos_left hA

  unfold red
  apply Prod.ext
  · rw [hG, hs]
    symm
    exact Nat.mul_div_left u hs_pos
  · rw [hG, hB_as]
    symm
    exact Nat.mul_div_left v hs_pos

/--
The complete triangle statement for one triple of edge labels.

The first conjunct is the exact natural-number form of

  v_ik/u_ik = (v_ij*v_jk)/(u_ij*u_jk).

The second conjunct is the equivalent reduced-pair statement from the paper.
-/
def triangle_ratio_consistency
    (u_ij v_ij u_jk v_jk u_ik v_ik : ℕ) : Prop :=
  v_ik * (u_ij * u_jk) =
      u_ik * (v_ij * v_jk) ∧
    (u_ik, v_ik) =
      red (u_ij * u_jk) (v_ij * v_jk)

/--
The three reduced edge labels on every ordered K5 triangle satisfy the ratio
multiplication law and the equivalent gcd-reduced pair identity.
-/
theorem derive_triangle_ratio_consistency
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    {i j k : Fin 5}
    {g_ij u_ij v_ij w_ij : ℕ}
    {g_jk u_jk v_jk w_jk : ℕ}
    {g_ik u_ik v_ik w_ik : ℕ}
    (hW : five_near_root_divisor_witness C n d)
    (hij : i < j)
    (hjk : j < k)
    (hlabels_ij :
      pair_four_block_labels
        n (d i) (d j) g_ij u_ij v_ij w_ij)
    (hlabels_jk :
      pair_four_block_labels
        n (d j) (d k) g_jk u_jk v_jk w_jk)
    (hlabels_ik :
      pair_four_block_labels
        n (d i) (d k) g_ik u_ik v_ik w_ik) :
    triangle_ratio_consistency
      u_ij v_ij u_jk v_jk u_ik v_ik := by
  rcases near_root_pair_context_data
      (build_near_root_pair_context hW hij) with
    ⟨_, hdi_pos, _, _, _, _, _⟩

  rcases near_root_pair_context_data
      (build_near_root_pair_context hW hjk) with
    ⟨_, hdj_pos, _, _, _, _, _⟩

  rcases pair_label_uv_positive hdi_pos hlabels_ij with
    ⟨hu_ij, hv_ij⟩
  rcases pair_label_uv_positive hdj_pos hlabels_jk with
    ⟨hu_jk, hv_jk⟩
  rcases pair_label_uv_positive hdi_pos hlabels_ik with
    ⟨hu_ik, hv_ik⟩

  have hratio_ij :
      d j * u_ij = d i * v_ij :=
    pair_label_ratio_cross hlabels_ij
  have hratio_jk :
      d k * u_jk = d j * v_jk :=
    pair_label_ratio_cross hlabels_jk
  have hratio_ik :
      d k * u_ik = d i * v_ik :=
    pair_label_ratio_cross hlabels_ik

  have hscaled :
      d i * (v_ik * (u_ij * u_jk)) =
        d i * (u_ik * (v_ij * v_jk)) := by
    calc
      d i * (v_ik * (u_ij * u_jk))
          = (d i * v_ik) * (u_ij * u_jk) := by
              ring
      _ = (d k * u_ik) * (u_ij * u_jk) := by
            rw [← hratio_ik]
      _ = u_ik * u_ij * (d k * u_jk) := by
            ring
      _ = u_ik * u_ij * (d j * v_jk) := by
            rw [hratio_jk]
      _ = u_ik * (d j * u_ij) * v_jk := by
            ring
      _ = u_ik * (d i * v_ij) * v_jk := by
            rw [hratio_ij]
      _ = d i * (u_ik * (v_ij * v_jk)) := by
            ring

  have hcross :
      v_ik * (u_ij * u_jk) =
        u_ik * (v_ij * v_jk) :=
    Nat.mul_left_cancel hdi_pos hscaled

  have hcop_ik : Nat.Coprime u_ik v_ik :=
    hlabels_ik.2.2.2.1

  have hred :
      (u_ik, v_ik) =
        red (u_ij * u_jk) (v_ij * v_jk) :=
    coprime_pair_eq_red
      hu_ik
      hv_ik
      (Nat.mul_pos hu_ij hu_jk)
      hcop_ik
      hcross

  exact ⟨hcross, hred⟩

/--
All arithmetic reads carried by one already materialized label family.
-/
def materialized_K5_pair_ratio_data
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ)
    (labels : K5FourBlockFamily) : Prop :=
  K5FourBlockFamilyLegal n d labels ∧
    (∀ i j : Fin 5, i < j →
      root_gap_pair_laws n (d i) (d j)
        (labels i j).1
        (labels i j).2.1
        (labels i j).2.2.1
        (labels i j).2.2.2) ∧
    (∀ i j : Fin 5, i < j →
      pair_gap_size_controls C n (d i) (d j)
        (labels i j).1
        (labels i j).2.1
        (labels i j).2.2.1
        (labels i j).2.2.2) ∧
    ∀ i j k : Fin 5, i < j → j < k →
      triangle_ratio_consistency
        (labels i j).2.1
        (labels i j).2.2.1
        (labels j k).2.1
        (labels j k).2.2.1
        (labels i k).2.1
        (labels i k).2.2.1

/--
The materialized ten-edge arithmetic frontier.  The witness, every edge law,
every finite pair control, and every triangle law all refer to one fixed
family `labels`.

Semantic kind: exact finite algebraic refinement.
-/
def materialized_K5_pair_ratio_frontier
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  five_near_root_divisor_witness C n d ∧
    ∃ labels : K5FourBlockFamily,
      materialized_K5_pair_ratio_data C n d labels

/--
Materialize all ten edge labels once from the existential graph, then derive
all pair and triangle reads from that same family.
-/
theorem materialize_K5_pair_ratio_frontier
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hGraph : K5_pair_ratio_graph C n d) :
    materialized_K5_pair_ratio_frontier C n d := by
  classical
  have hEdgeExists :
      ∀ i j : Fin 5,
        ∃ q : ℕ × ℕ × ℕ × ℕ,
          i < j →
            pair_four_block_labels n (d i) (d j)
              q.1 q.2.1 q.2.2.1 q.2.2.2 := by
    intro i j
    by_cases hij : i < j
    · rcases hGraph.2 i j hij with ⟨g, u, v, w, hlabels⟩
      exact ⟨(g, u, v, w), fun _ => hlabels⟩
    · exact ⟨(0, 0, 0, 0), fun hlt => (hij hlt).elim⟩
  choose labels hlabels using hEdgeExists
  have hLegal : K5FourBlockFamilyLegal n d labels := by
    intro i j hij
    exact hlabels i j hij
  refine ⟨hGraph.1, labels, hLegal, ?_, ?_, ?_⟩
  · intro i j hij
    exact derive_root_gap_pair_laws (hLegal i j hij)
  · intro i j hij
    exact derive_pair_gap_size_controls
      (build_near_root_pair_context hGraph.1 hij)
      (derive_root_gap_pair_laws (hLegal i j hij))
  · intro i j k hij hjk
    exact derive_triangle_ratio_consistency
      hGraph.1 hij hjk
      (hLegal i j hij)
      (hLegal j k hjk)
      (hLegal i k (lt_trans hij hjk))

/--
The Section 3.3 output: one materialized K5 edge ledger together with pair
controls and triangle consistency over that same family.
-/
def Meta_K5
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  materialized_K5_pair_ratio_frontier C n d

/--
A five-divisor witness produces the complete K5 pair-ratio frontier.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.3, Sub-layer 02, Sub-box 02

Incoming state shape:
  K5_pair_ratio_graph C n d

Outgoing state shape:
  Meta_K5 C n d

Effect:
  Takes the exact K5 edge-ledger state produced by the preceding sub-box and
  adds triangle-ratio consistency for every valid triple of reduced edge
  labels. It does not rebuild the graph from the older witness state.

Public theorem:
  derive_Meta_K5

================================================================================
-/

theorem derive_Meta_K5
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hGraph : K5_pair_ratio_graph C n d) :
    Meta_K5 C n d := by
  exact materialize_K5_pair_ratio_frontier hGraph


/-
================================================================================
STATE-SHAPE PARENT BATCH
Section 3.2 and Section 3.3 complete arithmetic frontier

Incoming state shape:
  five_near_root_divisor_witness C n d

Outgoing state shape:
  section_3_arithmetic_state C n d

Effect:
  Retains the same selected witness and adds both paper-visible arithmetic
  branches:
    * every-edge four-block, root-gap, and finite size-control state;
    * the K5 edge ledger followed by triangle consistency.

  Pair laws, size controls, pair-gcd reads, and triangle laws all use one
  materialized ten-edge family.

Semantic kind:
  retained exact arithmetic ancestry.

Public theorem:
  close_section_3_arithmetic_state

================================================================================
-/

/--
The complete paper-visible root-band K5 arithmetic frontier: one fixed label
family carries the exact root-gap, size-control, and triangle reads.
-/
def Meta_K5_frontier_state
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  Meta_K5 C n d

theorem close_Meta_K5_frontier
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hW : five_near_root_divisor_witness C n d) :
    Meta_K5_frontier_state C n d := by
  have hGraph : K5_pair_ratio_graph C n d :=
    build_K5_pair_ratio_graph hW

  have hMeta : Meta_K5 C n d :=
    derive_Meta_K5 hGraph

  exact hMeta

/--
The retained arithmetic route state. The witness remains available while the
pair-gap controls and Meta_K5 frontier are added in parallel.
-/
def section_3_arithmetic_state
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  five_near_root_divisor_witness C n d ∧
    Meta_K5_frontier_state C n d

theorem close_section_3_arithmetic_state
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hW : five_near_root_divisor_witness C n d) :
    section_3_arithmetic_state C n d :=
  ⟨hW, close_Meta_K5_frontier hW⟩

/--
The materialized K5 frontier contains the earlier every-edge pair-analysis
state.  No edge label is selected a second time.
-/
theorem Meta_K5_to_pair_analysis_state
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hMeta : Meta_K5 C n d) :
    pair_analysis_state C n d := by
  rcases hMeta with
    ⟨_hW, labels, hLegal, hLaws, hControls, _hTriangles⟩
  intro i j hij
  exact
    ⟨(labels i j).1,
      (labels i j).2.1,
      (labels i j).2.2.1,
      (labels i j).2.2.2,
      hLegal i j hij,
      hLaws i j hij,
      hControls i j hij⟩

/--
Continuity projection from the cumulative Section 3 arithmetic frontier to
the complete Section 3.2 pair-analysis view.
-/
theorem section_3_arithmetic_state_to_pair_analysis_state
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hArithmetic : section_3_arithmetic_state C n d) :
    pair_analysis_state C n d :=
  Meta_K5_to_pair_analysis_state hArithmetic.2


