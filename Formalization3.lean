def same_k_endpoint_polynomial_section_10_sub_layer_04_sub_box_04_label : String := "Endpoint polynomial identity over the same K: an endpoint polynomial of degree at most three vanishing on the infinite valid parameter set is zero in Q[T]"
def same_k_endpoint_polynomial_section_10_sub_layer_04_sub_box_04_inputs : List String := ["endpoint_polynomial_data_over_K [construction]"]
