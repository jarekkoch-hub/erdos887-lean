  prefixAverageSurvivorData sourceData = survivorData ∧
    prefixAverageAffineData sourceData = affineData ∧
    prefixAveragePolynomialData sourceData = polynomialData ∧
    prefixAverageProductRowData sourceData = productRowData ∧
    (∀ k : Section6.AdjacentGapAddress,
      0 < SameKEndpointPolynomial.sameKAffineKappa affineData k) ∧
    (∀ k : Section6.AdjacentGapAddress,
      SameKEndpointPolynomial.sameKAffineOffset affineData k =
        adjacentAffineRatio sourceData k *
          SameKEndpointPolynomial.sameKAffineKappa affineData k) ∧
    (∀ i : Fin 3, prefixAverageVertexFormulaFacts sourceData i) ∧
    (∀ i : Fin 3, prefixAverageFormulaFacts sourceData i) ∧
    ∀ i : Fin 3,
      prefixAverageVertexFormulaFacts sourceData i →
        prefixAverageFormulaFacts sourceData i →
          SameKEndpointPolynomial.sameKAffineKappa affineData
                (adjacentPairLeftAddress i) *
              adjacentAffineRatio sourceData (adjacentPairLeftAddress i) +
            SameKEndpointPolynomial.sameKAffineKappa affineData
                (adjacentPairRightAddress i) *
              adjacentAffineRatio sourceData (adjacentPairRightAddress i) =
            (SameKEndpointPolynomial.sameKAffineKappa affineData
                (adjacentPairLeftAddress i) +
              SameKEndpointPolynomial.sameKAffineKappa affineData
                (adjacentPairRightAddress i)) *
              adjacentAffineRatio sourceData (adjacentPairLeftAddress i)

