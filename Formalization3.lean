  permission context, constructs all ten reduced cubic rows, constructs the
  finite ten-row quadratic descent table, and retains the same `S_0` for the
  later leading-descendant extraction.

Public theorem:
  close_rank_trichotomy_section_8_1
================================================================================
-/

theorem close_rank_trichotomy_section_8_1
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {nuSeq : IncidentGrowth.IncidentGrowthExponentSequence}
    {sigmaSeq : IncidentGrowth.ProfileReadSequence}
    {GSeq : IncidentGrowth.MaxLinearProfileSequence}
    (hInput :
      section_8_input_frontier
        C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq) :
    section_8_1_frontier
      C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq := by
  have hB :
      IncidentGrowth.B_unif
        opening GammaSeq nuSeq sigmaSeq GSeq :=
    hInput.1

  have hSector :
      Z_sector_laws
        (openingTSeq opening)
        (openingZSeq opening) :=
    hInput.2.1

  have hS0 :
      Section6.Legacy.legacy_S_0
        C nSeq dSeq
        (openingTSeq opening)
        (openingBSeq opening)
        (openingZSeq opening) :=
    hInput.2.2

  have hE :
      E_W_canonical_endpoint_system
        C nSeq dSeq
        (openingTSeq opening)
        (openingBSeq opening)
        (openingZSeq opening) :=
    hS0.1

  have hContext :
      rank_layer_context
        C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq :=
    build_rank_layer_context hB hE hSector

  have hRows : R_cub opening :=
    build_R_cub hContext hE hSector

  have hDesc : Q_desc opening :=
    build_Q_desc hRows

  exact
    ⟨hContext, hRows, hDesc, hS0⟩

/- ## Sub-container 8.2: Quadratic descendant rows. -/

/- Sub-layer 01 -/
/-
Paper ref: 8.2
Sub-box Label: `Quadratic descendant row shape: tuple (t;u,v,w;r,s;e_vw,e_uw,e_uv;lambda_vw,lambda_uw,lambda_uv) with coefficient function vanishing off the three active edges, active part Q_t=lambda_vw x_vw+lambda_uw x_uw+lambda_uv x_uv, carrying its quadratic identity`
Sub-inputs: `Q_desc`
Sub-outputs: `quadratic_descendant_rows`
Note: First compression of the rank layer: still edge-indexed, but with three-edge active support. These become rank data only after the leading descendant extraction; they are not affine product rows, prefix-average rows, or terminal endpoint-cubic rows.
-/
def rank_trichotomy_section_8_2_sub_layer_01_sub_box_01_label : String := "Quadratic descendant row shape: tuple (t;u,v,w;r,s;e_vw,e_uw,e_uv;lambda_vw,lambda_uw,lambda_uv) with coefficient function vanishing off the three active edges, active part Q_t=lambda_vw x_vw+lambda_uw x_uw+lambda_uv x_uv, carrying its quadratic identity"
def rank_trichotomy_section_8_2_sub_layer_01_sub_box_01_inputs : List String := ["Q_desc [construction]"]
def rank_trichotomy_section_8_2_sub_layer_01_sub_box_01_outputs : List String := ["quadratic_descendant_rows [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 8.2, Sub-layer 01, Sub-box 01
Birth token: quadratic_descendant_rows

This box performs the first rank-layer representation compression.  It does
not derive a second family of quadratic identities.  Instead, it materializes
each row already present in `Q_desc` as one fixed five-vertex row address with
three named endpoint-edge references, one edge-indexed coefficient function
that vanishes away from those references, three quadratic sector coordinates,
and the same integer identity cast into the rational coefficient universe used
by the leading descendant matrix.
================================================================================
-/

/-- The ten quadratic descendant row addresses. -/
abbrev QuadraticDescendantRowAddress :=
  Fin 10

/-- The first active triangle vertex in the fixed ten-row order. -/
def quadraticDescendantRowU :
    QuadraticDescendantRowAddress → Section6.EndpointAddress :=
  ![0, 0, 0, 0, 0, 0, 1, 1, 1, 2]

/-- The second active triangle vertex in the fixed ten-row order. -/
def quadraticDescendantRowV :
    QuadraticDescendantRowAddress → Section6.EndpointAddress :=
  ![1, 1, 1, 2, 2, 3, 2, 2, 3, 3]

/-- The third active triangle vertex in the fixed ten-row order. -/
def quadraticDescendantRowW :
    QuadraticDescendantRowAddress → Section6.EndpointAddress :=
  ![2, 3, 4, 3, 4, 4, 3, 4, 4, 4]

/-- The first endpoint outside the active triangle. -/
def quadraticDescendantRowR :
    QuadraticDescendantRowAddress → Section6.EndpointAddress :=
  ![3, 2, 2, 1, 1, 1, 0, 0, 0, 0]

/-- The second endpoint outside the active triangle. -/
def quadraticDescendantRowS :
    QuadraticDescendantRowAddress → Section6.EndpointAddress :=
  ![4, 4, 3, 4, 3, 2, 4, 3, 2, 1]

/--
The five named vertices of one descendant row are pairwise distinct, exhaust
the fixed endpoint set, and place the active triangle in increasing order.
-/
def quadraticDescendantVertexPacket
    (t : QuadraticDescendantRowAddress) : Prop :=
  quadraticDescendantRowU t < quadraticDescendantRowV t ∧
    quadraticDescendantRowV t < quadraticDescendantRowW t ∧
    quadraticDescendantRowR t < quadraticDescendantRowS t ∧
    List.Nodup
      [quadraticDescendantRowU t,
        quadraticDescendantRowV t,
        quadraticDescendantRowW t,
        quadraticDescendantRowR t,
        quadraticDescendantRowS t] ∧
    ∀ x : Section6.EndpointAddress,
      x = quadraticDescendantRowU t ∨
      x = quadraticDescendantRowV t ∨
      x = quadraticDescendantRowW t ∨
      x = quadraticDescendantRowR t ∨
      x = quadraticDescendantRowS t

/-- The fixed ten-row vertex table has the advertised five-vertex shape. -/
theorem quadraticDescendantVertexPacket_holds
    (t : QuadraticDescendantRowAddress) :
    quadraticDescendantVertexPacket t := by
  classical
  fin_cases t <;>
    simp
      [quadraticDescendantVertexPacket,
        quadraticDescendantRowU,
        quadraticDescendantRowV,
        quadraticDescendantRowW,
        quadraticDescendantRowR,
        quadraticDescendantRowS] <;>
    intro x <;>
    fin_cases x <;>
    simp

/-- The active endpoint edge `e_vw` of one descendant row. -/
def quadraticDescendantEdgeVW
    (t : QuadraticDescendantRowAddress) :
    Section6.K5EdgeAddress :=
  Section6.endpointEdgeReference
    (quadraticDescendantRowV t)
    (quadraticDescendantRowW t)

/-- The active endpoint edge `e_uw` of one descendant row. -/
def quadraticDescendantEdgeUW
    (t : QuadraticDescendantRowAddress) :
    Section6.K5EdgeAddress :=
  Section6.endpointEdgeReference
    (quadraticDescendantRowU t)
    (quadraticDescendantRowW t)

/-- The active endpoint edge `e_uv` of one descendant row. -/
def quadraticDescendantEdgeUV
    (t : QuadraticDescendantRowAddress) :
    Section6.K5EdgeAddress :=
  Section6.endpointEdgeReference
    (quadraticDescendantRowU t)
    (quadraticDescendantRowV t)

/--
The three row references point to the advertised endpoint pairs and are
pairwise distinct.
-/
def quadraticDescendantActiveEdgePacket
    (t : QuadraticDescendantRowAddress) : Prop :=
  Section6.k5EdgeBoundary (quadraticDescendantEdgeVW t) =
      (quadraticDescendantRowV t, quadraticDescendantRowW t) ∧
    Section6.k5EdgeBoundary (quadraticDescendantEdgeUW t) =
      (quadraticDescendantRowU t, quadraticDescendantRowW t) ∧
    Section6.k5EdgeBoundary (quadraticDescendantEdgeUV t) =
      (quadraticDescendantRowU t, quadraticDescendantRowV t) ∧
    quadraticDescendantEdgeVW t ≠ quadraticDescendantEdgeUW t ∧
    quadraticDescendantEdgeVW t ≠ quadraticDescendantEdgeUV t ∧
    quadraticDescendantEdgeUW t ≠ quadraticDescendantEdgeUV t

/-- The fixed edge references have the advertised three-edge shape. -/
theorem quadraticDescendantActiveEdgePacket_holds
    (t : QuadraticDescendantRowAddress) :
    quadraticDescendantActiveEdgePacket t := by
  have hVertices :
      quadraticDescendantVertexPacket t :=
    quadraticDescendantVertexPacket_holds t

  have hUV :
      quadraticDescendantRowU t <
        quadraticDescendantRowV t :=
    hVertices.1

  have hVW :
      quadraticDescendantRowV t <
        quadraticDescendantRowW t :=
    hVertices.2.1

  have hUW :
      quadraticDescendantRowU t <
        quadraticDescendantRowW t :=
    lt_trans hUV hVW

  have hBoundaryVW :
      Section6.k5EdgeBoundary
          (quadraticDescendantEdgeVW t) =
        (quadraticDescendantRowV t,
          quadraticDescendantRowW t) := by
    have h :=
      Section6.endpointEdgeReference_boundary
        (i := quadraticDescendantRowV t)
        (j := quadraticDescendantRowW t)
        (ne_of_lt hVW)
    simpa
      [quadraticDescendantEdgeVW,
        Section6.orderedEndpointPair,
        hVW]
      using h

  have hBoundaryUW :
      Section6.k5EdgeBoundary
          (quadraticDescendantEdgeUW t) =
        (quadraticDescendantRowU t,
          quadraticDescendantRowW t) := by
    have h :=
      Section6.endpointEdgeReference_boundary
        (i := quadraticDescendantRowU t)
        (j := quadraticDescendantRowW t)
        (ne_of_lt hUW)
    simpa
      [quadraticDescendantEdgeUW,
        Section6.orderedEndpointPair,
        hUW]
      using h

  have hBoundaryUV :
      Section6.k5EdgeBoundary
          (quadraticDescendantEdgeUV t) =
        (quadraticDescendantRowU t,
          quadraticDescendantRowV t) := by
    have h :=
      Section6.endpointEdgeReference_boundary
        (i := quadraticDescendantRowU t)
        (j := quadraticDescendantRowV t)
        (ne_of_lt hUV)
    simpa
      [quadraticDescendantEdgeUV,
        Section6.orderedEndpointPair,
        hUV]
      using h

  have hVW_ne_UW :
      quadraticDescendantEdgeVW t ≠
        quadraticDescendantEdgeUW t := by
    intro hEq
    have hPairEq :=
      congrArg Section6.k5EdgeBoundary hEq
    rw [hBoundaryVW, hBoundaryUW] at hPairEq
    have hVU :
        quadraticDescendantRowV t =
          quadraticDescendantRowU t :=
      congrArg
        (fun p :
          Section6.EndpointAddress ×
            Section6.EndpointAddress => p.1)
        hPairEq
    exact (ne_of_gt hUV) hVU

  have hVW_ne_UV :
      quadraticDescendantEdgeVW t ≠
        quadraticDescendantEdgeUV t := by
    intro hEq
    have hPairEq :=
      congrArg Section6.k5EdgeBoundary hEq
    rw [hBoundaryVW, hBoundaryUV] at hPairEq
    have hVU :
        quadraticDescendantRowV t =
          quadraticDescendantRowU t :=
      congrArg
        (fun p :
          Section6.EndpointAddress ×
            Section6.EndpointAddress => p.1)
        hPairEq
    exact (ne_of_gt hUV) hVU

  have hUW_ne_UV :
      quadraticDescendantEdgeUW t ≠
        quadraticDescendantEdgeUV t := by
    intro hEq
    have hPairEq :=
      congrArg Section6.k5EdgeBoundary hEq
    rw [hBoundaryUW, hBoundaryUV] at hPairEq
    have hWV :
        quadraticDescendantRowW t =
          quadraticDescendantRowV t :=
      congrArg
        (fun p :
          Section6.EndpointAddress ×
            Section6.EndpointAddress => p.2)
        hPairEq
    exact (ne_of_gt hVW) hWV

  exact
    ⟨hBoundaryVW,
      hBoundaryUW,
      hBoundaryUV,
      hVW_ne_UW,
      hVW_ne_UV,
      hUW_ne_UV⟩

/-- The rational row coefficient on the active edge `e_vw`. -/
def quadraticDescendantLambdaVW
    (b : Section3.EndpointCoefficientFamily)
    (t : QuadraticDescendantRowAddress) : ℚ :=
  (b (quadraticDescendantRowV t)
      (quadraticDescendantRowW t) : ℚ)

/-- The rational row coefficient on the active edge `e_uw`. -/
def quadraticDescendantLambdaUW
    (b : Section3.EndpointCoefficientFamily)
    (t : QuadraticDescendantRowAddress) : ℚ :=
  -(b (quadraticDescendantRowU t)
      (quadraticDescendantRowW t) : ℚ)

/-- The rational row coefficient on the active edge `e_uv`. -/
def quadraticDescendantLambdaUV
    (b : Section3.EndpointCoefficientFamily)
    (t : QuadraticDescendantRowAddress) : ℚ :=
  (b (quadraticDescendantRowU t)
      (quadraticDescendantRowV t) : ℚ)

/-- The quadratic sector coordinate read at the active edge `e_vw`. -/
def quadraticDescendantXvw
    (Z : Section3.IntegerSectorFamily)
    (t : QuadraticDescendantRowAddress) : ℚ :=
  (quadraticOutsideProduct Z
      (quadraticDescendantRowU t)
      (quadraticDescendantRowV t)
      (quadraticDescendantRowW t) : ℚ)

/-- The quadratic sector coordinate read at the active edge `e_uw`. -/
def quadraticDescendantXuw
    (Z : Section3.IntegerSectorFamily)
    (t : QuadraticDescendantRowAddress) : ℚ :=
  (quadraticOutsideProduct Z
      (quadraticDescendantRowV t)
      (quadraticDescendantRowU t)
      (quadraticDescendantRowW t) : ℚ)

/-- The quadratic sector coordinate read at the active edge `e_uv`. -/
def quadraticDescendantXuv
    (Z : Section3.IntegerSectorFamily)
    (t : QuadraticDescendantRowAddress) : ℚ :=
  (quadraticOutsideProduct Z
      (quadraticDescendantRowW t)
      (quadraticDescendantRowU t)
      (quadraticDescendantRowV t) : ℚ)

/--
The full ten-edge coefficient function of one descendant row.  Its values are
the signed endpoint coefficients from the reduced-cubic comparison.  Only the
three fixed active references can receive a nonzero value.
-/
def quadraticDescendantCoefficient
    (b : Section3.EndpointCoefficientFamily)
    (t : QuadraticDescendantRowAddress)
    (e : Section6.K5EdgeAddress) : ℚ :=
  if e = quadraticDescendantEdgeVW t then
    quadraticDescendantLambdaVW b t
  else if e = quadraticDescendantEdgeUW t then
    quadraticDescendantLambdaUW b t
  else if e = quadraticDescendantEdgeUV t then
    quadraticDescendantLambdaUV b t
  else
    0

/--
The coefficient function has the three advertised active values and vanishes
off the three active edge references.
-/
def quadraticDescendantCoefficientPacket
    (b : Section3.EndpointCoefficientFamily)
    (t : QuadraticDescendantRowAddress) : Prop :=
  quadraticDescendantCoefficient b t
      (quadraticDescendantEdgeVW t) =
      quadraticDescendantLambdaVW b t ∧
    quadraticDescendantCoefficient b t
      (quadraticDescendantEdgeUW t) =
      quadraticDescendantLambdaUW b t ∧
    quadraticDescendantCoefficient b t
      (quadraticDescendantEdgeUV t) =
      quadraticDescendantLambdaUV b t ∧
    ∀ e : Section6.K5EdgeAddress,
      e ≠ quadraticDescendantEdgeVW t →
      e ≠ quadraticDescendantEdgeUW t →
      e ≠ quadraticDescendantEdgeUV t →
        quadraticDescendantCoefficient b t e = 0

/-- The deterministic coefficient function has exactly the advertised shape. -/
theorem quadraticDescendantCoefficientPacket_holds
    (b : Section3.EndpointCoefficientFamily)
    (t : QuadraticDescendantRowAddress) :
    quadraticDescendantCoefficientPacket b t := by
  rcases quadraticDescendantActiveEdgePacket_holds t with
    ⟨_, _, _, hVWUW, hVWUV, hUWUV⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp [quadraticDescendantCoefficient]
  · simp [quadraticDescendantCoefficient, Ne.symm hVWUW]
  · simp
      [quadraticDescendantCoefficient,
        Ne.symm hVWUV,
        Ne.symm hUWUV]
  · intro e heVW heUW heUV
    simp
      [quadraticDescendantCoefficient,
        heVW, heUW, heUV]

/-- The displayed three-term quadratic active part of one descendant row. -/
def quadraticDescendantActivePart
    (b : Section3.EndpointCoefficientFamily)
    (Z : Section3.IntegerSectorFamily)
    (t : QuadraticDescendantRowAddress) : ℚ :=
  quadraticDescendantLambdaVW b t *
      quadraticDescendantXvw Z t +
    quadraticDescendantLambdaUW b t *
      quadraticDescendantXuw Z t +
    quadraticDescendantLambdaUV b t *
      quadraticDescendantXuv Z t

/-- One row of `Q_desc` gives the same three-term identity over `ℚ`. -/
theorem quadratic_descent_table_gives_active_part
    {b : Section3.EndpointCoefficientFamily}
    {Z : Section3.IntegerSectorFamily}
    (hTable : quadratic_descent_table_at b Z)
    (t : QuadraticDescendantRowAddress) :
    quadraticDescendantActivePart b Z t = 0 := by
  rcases quadraticDescendantVertexPacket_holds t with
    ⟨huv, hvw, _, _, _⟩
  have hIntegerRaw :=
    hTable
      (quadraticDescendantRowU t)
      (quadraticDescendantRowV t)
      (quadraticDescendantRowW t)
      huv hvw
  have hInteger :
      b (quadraticDescendantRowU t) (quadraticDescendantRowV t) *
          quadraticOutsideProduct Z
            (quadraticDescendantRowW t)
            (quadraticDescendantRowU t)
            (quadraticDescendantRowV t) -
        b (quadraticDescendantRowU t) (quadraticDescendantRowW t) *
          quadraticOutsideProduct Z
            (quadraticDescendantRowV t)
            (quadraticDescendantRowU t)
            (quadraticDescendantRowW t) +
        b (quadraticDescendantRowV t) (quadraticDescendantRowW t) *
          quadraticOutsideProduct Z
            (quadraticDescendantRowU t)
            (quadraticDescendantRowV t)
            (quadraticDescendantRowW t) = 0 := by
    simpa [quadraticDescendantIdentityAt] using hIntegerRaw
  have hRational :=
    congrArg (fun z : ℤ => (z : ℚ)) hInteger
  simp only
    [Int.cast_add, Int.cast_sub, Int.cast_mul, Int.cast_zero] at hRational
  unfold quadraticDescendantActivePart
  unfold quadraticDescendantLambdaVW
  unfold quadraticDescendantLambdaUW
  unfold quadraticDescendantLambdaUV
  unfold quadraticDescendantXvw
  unfold quadraticDescendantXuw
  unfold quadraticDescendantXuv
  ring_nf at hRational ⊢
  exact hRational

/--
One materialized quadratic descendant row.  The row index fixes all five
vertices, the three active edge references, and the rational coefficient
function.  Its final field is the exact quadratic identity inherited from
`Q_desc`.
-/
def quadratic_descendant_row_at
    (b : Section3.EndpointCoefficientFamily)
    (Z : Section3.IntegerSectorFamily)
    (t : QuadraticDescendantRowAddress) : Prop :=
  quadraticDescendantVertexPacket t ∧
    quadraticDescendantActiveEdgePacket t ∧
    quadraticDescendantCoefficientPacket b t ∧
    quadraticDescendantActivePart b Z t = 0

/-- The sequence-level family of ten materialized quadratic descendant rows. -/
def quadratic_descendant_rows
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∀ m : ℕ,
    ∀ t : QuadraticDescendantRowAddress,
      quadratic_descendant_row_at
        (openingBSeq opening m)
        (openingZSeq opening m)
        t

/-
================================================================================
STATE-SHAPE BATCH
Section 8.2, Sub-layer 01, Sub-box 01

Incoming state shape:
  Q_desc opening

Outgoing state shape:
  quadratic_descendant_rows opening

Effect:
  Re-indexes the finite quadratic descent table by a fixed ten-row address set.
  Each row materializes the ordered active triangle, the two complementary
  endpoints, the three exact Section 6 edge references, an edge-indexed
  rational coefficient function formed from the signed endpoint coefficients,
  three quadratic sector coordinates, and the same identity already proved in
  `Q_desc`.  This is a representation
  compression only.  It does not create a new quadratic source and does not
  read rank, coloring, prefix, affine, or terminal data.

Public theorem:
  build_quadratic_descendant_rows
================================================================================
-/

theorem build_quadratic_descendant_rows
    {opening : CanonicalIntervalOverloadOpeningData}
    (hDesc : Q_desc opening) :
    quadratic_descendant_rows opening := by
  intro m t
  refine
    ⟨quadraticDescendantVertexPacket_holds t,
      quadraticDescendantActiveEdgePacket_holds t,
      quadraticDescendantCoefficientPacket_holds
        (openingBSeq opening m) t,
      ?_⟩
  exact
    quadratic_descent_table_gives_active_part
      (hDesc m) t


