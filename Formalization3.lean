      (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
      (polynomialData :
        SameKEndpointPolynomial.EndpointPolynomialSourceData D)
      (productRowData : ProductRowExtraction.SameKProductRowSourceData D)
      (sourceData : SameKPrefixAverageFormulaSourceData D),
