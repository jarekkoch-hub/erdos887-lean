    (Section6.k5EdgeBoundary e).1
    (Section6.k5EdgeBoundary e).2 : ℚ)

/-- The ten interval sums in the paper's fixed edge order. -/
def prefixAdjacentGapInterval
    (g : PrefixAdjacentGapFamily)
    (m : ℕ) :
    Section6.K5EdgeAddress → ℚ :=
  ![
    g m 0,
    g m 0 + g m 1,
    g m 0 + g m 1 + g m 2,
    g m 0 + g m 1 + g m 2 + g m 3,
    g m 1,
    g m 1 + g m 2,
    g m 1 + g m 2 + g m 3,
