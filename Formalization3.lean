  does not open either source and does not reselect any Section 9 component.

Public theorem:
  build_same_k_endpoint_polynomial_context
================================================================================
-/

theorem build_same_k_endpoint_polynomial_context
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hK : PrefixConflict.K C nSeq dSeq opening)
    (hAffineSource :
      same_K_affine_pencil_source C nSeq dSeq opening)
    (hPolynomialSource :
      endpoint_polynomial_vanishing_source C nSeq dSeq opening) :
    same_k_endpoint_polynomial_context C nSeq dSeq opening := by
  have hKState : PrefixConflict.K C nSeq dSeq opening := hK
  rcases hK.2.2 with
    ⟨_hRegular, _hAlternatives, _hInterval, _hPattern,
      _hRank, _hFamily, _hEliminated,
      D, survivorData, hComponentsAt⟩
  exact
    ⟨hKState, hAffineSource, hPolynomialSource,
      D, survivorData, hComponentsAt⟩


