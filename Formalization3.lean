    rank_three_absorption_completion_source_batch := by
  intro C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
    leadingData regimeData _hB hRank _hComponents
    hRankThree hAbsorbedMarker
  have hSource :=
    hRank.2.2.2.2.1 hRankThree
