theorem derive_exact_finite_support_ledgers
    {n : ℕ} {d : Fin 5 → ℕ}
    (hfull : full_atom_model n d) :
    exact_finite_support_ledgers n d := by
  exact
    ⟨hfull,
     exactLevelProduct_pos n d,
     levelProductRead_eq_n hfull⟩

