theorem build_EndpointSectorDisplay_can
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hsector :
      Sector_can C nSeq dSeq) :
    EndpointSectorDisplay_can C nSeq dSeq := by
  rcases hsector with
    ⟨hExternal, hsectorProducts, hclip,
      B, M, o, ZNatSeq, bSeq, mWSeq,
      hM, hOrientation, hselected, hchamber⟩

  refine
    ⟨fun m => endpointValuesFromSectors (ZNatSeq m),
      bSeq,
      fun m => integerSectorFamilyOfNat (ZNatSeq m),
      ?_, ?_, ?_⟩

  · exact
      ⟨hExternal, hsectorProducts, hclip,
        B, M, o, ZNatSeq, mWSeq,
        hM, hOrientation, hselected, hchamber,
        (by
          intro m
          rfl),
        (by
          intro m
          rfl)⟩

  · intro m
    exact canonicalEndpointSystemAt_of_chamber
      (hchamber m)

  · intro m
    exact canonicalSectorLawsAt_of_chamber
      (hchamber m)

/-- Open the exact three component families from the endpoint/sector display. -/
theorem EndpointSectorDisplay_can_display_components
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hDisplay : EndpointSectorDisplay_can C nSeq dSeq) :
    ∃ TSeq : ℕ → EndpointValueFamily,
      ∃ bSeq : ℕ → EndpointCoefficientFamily,
      ∃ ZSeq : ℕ → IntegerSectorFamily,
        componentDisplayRealizedBySectorCan
          C nSeq dSeq TSeq bSeq ZSeq ∧
        (∀ m : ℕ,
          canonicalEndpointSystemAt
            (TSeq m) (bSeq m) (ZSeq m)) ∧
        ∀ m : ℕ,
          canonicalSectorLawsAt
            (TSeq m) (ZSeq m) :=
  hDisplay

/-
================================================================================
BOUNDARY VOCABULARY COMPARTMENT
Section 3.5 canonical datum shape

The paper states that `Geom(W)` is the pointwise endpoint system, sector-law
data, and adjacent growth profile constituting the canonical interval-overload
datum.  `O_can` therefore has exactly those three components and no execution
indices.  The available `EndpointSectorDisplay_can` is only the partial
endpoint/sector display and cannot package `O_can` while growth remains open.
This compartment defines the target vocabulary only; it is not an executable
packaging box.
================================================================================
-/

/--
The paper's pointwise canonical interval-overload data.

This is an ordinary nested product, in accordance with the file-wide
no-structures contract.  Its four visible coordinates are the endpoint values,
endpoint coefficients, integer sectors, and raw adjacent-growth profile.
-/
abbrev O_can_data :=
  EndpointValueFamily ×
    EndpointCoefficientFamily ×
      IntegerSectorFamily ×
        AdjacentGrowthProfile

/-- Endpoint values carried by one pointwise canonical datum. -/
def O_can_T (O : O_can_data) : EndpointValueFamily :=
  O.1

/-- Endpoint coefficients carried by one pointwise canonical datum. -/
def O_can_b (O : O_can_data) : EndpointCoefficientFamily :=
  O.2.1

/-- Integer sectors carried by one pointwise canonical datum. -/
def O_can_Z (O : O_can_data) : IntegerSectorFamily :=
  O.2.2.1

/-- Raw adjacent-growth profile carried by one pointwise canonical datum. -/
def O_can_Gamma (O : O_can_data) : AdjacentGrowthProfile :=
  O.2.2.2

/--
The intrinsic proposition-valued endpoint and sector laws of one pointwise
canonical interval-overload datum.  The raw growth profile is data at this
boundary.  No same-execution growth extraction law is claimed by the partial
compatibility relation below; the adjacent-growth production route remains
open.
-/
def O_can_state (O : O_can_data) : Prop :=
  canonicalEndpointSystemAt
      (O_can_T O) (O_can_b O) (O_can_Z O) ∧
    canonicalSectorLawsAt
      (O_can_T O) (O_can_Z O)

/--
Endpoint-and-sector execution compatibility for a pointwise canonical datum.

The selected index is retained explicitly.  The visible pointwise components
`T`, `b`, and `Z` must be read at that exact index from one coherent executable
component display.  This intermediate compatibility relation intentionally
does not claim that `Gamma` was externally produced; it is migration scaffolding
until the growth-profile paper specification is repaired.
-/
def O_can_endpoint_sector_compatible_at_execution_index
    (O : O_can_data)
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (m : ℕ) : Prop :=
  ∃ TSeq : ℕ → EndpointValueFamily,
    ∃ bSeq : ℕ → EndpointCoefficientFamily,
      ∃ ZSeq : ℕ → IntegerSectorFamily,
          componentDisplayRealizedBySectorCan
              C nSeq dSeq TSeq bSeq ZSeq ∧
            (∀ q : ℕ,
              canonicalEndpointSystemAt
                (TSeq q) (bSeq q) (ZSeq q)) ∧
            (∀ q : ℕ,
              canonicalSectorLawsAt
                (TSeq q) (ZSeq q)) ∧
            O_can_T O = TSeq m ∧
            O_can_b O = bSeq m ∧
            O_can_Z O = ZSeq m

/-- Its endpoint and sector components are compatible somewhere in an execution. -/
def O_can_endpoint_sector_compatible_by_execution
    (O : O_can_data)
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  ∃ m : ℕ,
    O_can_endpoint_sector_compatible_at_execution_index
      O C nSeq dSeq m

