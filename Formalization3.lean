def section_3_4_6_sub_sub_layer_02_sub_sub_box_02_label : String := "Four-face vector balance primitive"
def section_3_4_6_sub_sub_layer_02_sub_sub_box_02_inputs : List String := ["four_face_restriction [construction]"]
def section_3_4_6_sub_sub_layer_02_sub_sub_box_02_outputs : List String := ["VecBal_4 [birth]"]


/-
================================================================================
EXECUTABLE BOX
Section 3.4.6, Sub-sub-layer 02, Sub-sub-box 02
Birth token: VecBal_4

This box proves the finite balance implication on every deleted-endpoint face.
For any face mass `mu`, equality of opposite directed-cut masses implies equal
endpoint loads for all endpoints remaining in that face.  The proof is the same
common-plus-directed decomposition used in Section 3.4.5, now over the sixteen
collapsed face addresses.

The first active face mass and its cut-balance hypothesis are not constructed
here.  `VecBal_4` records the universal implication that later sequence wiring
may instantiate over the same face and scale.
================================================================================
-/

/-- Endpoint load of a mass function on the face deleting `r`. -/
noncomputable def fourFaceEndpointLoad
    (r : Fin 5) (mu : SupportAddress → ℝ) (i : Fin 5) : ℝ := by
  classical
  exact ∑ T ∈ (fourFaceAddresses r).filter (fun T => i ∈ T), mu T

/-- Common-address mass of two endpoints inside one four-face. -/
noncomputable def fourFaceCommonLoad
    (r : Fin 5) (mu : SupportAddress → ℝ)
    (i j : Fin 5) : ℝ := by
  classical
  exact ∑ T ∈ (fourFaceAddresses r).filter
    (fun T => i ∈ T ∧ j ∈ T), mu T

/-- Directed-cut mass from `i` away from `j` inside one four-face. -/
noncomputable def fourFaceDirectedCutLoad
    (r : Fin 5) (mu : SupportAddress → ℝ)
    (i j : Fin 5) : ℝ := by
  classical
  exact ∑ T ∈ (fourFaceAddresses r).filter
    (fun T => i ∈ T ∧ j ∉ T), mu T

/-- Nonnegativity of a support mass on the deleted-endpoint face. -/
def fourFaceSupportMassNonnegative
    (r : Fin 5) (mu : SupportAddress → ℝ) : Prop :=
  ∀ T ∈ fourFaceAddresses r, 0 ≤ mu T

/-- Opposite directed cuts have equal normalized mass inside the face. -/
def fourFaceDirectedCutBalance
    (r : Fin 5) (mu : SupportAddress → ℝ) : Prop :=
  ∀ i j : Fin 5, i ≠ r → j ≠ r → i ≠ j →
    fourFaceDirectedCutLoad r mu i j =
      fourFaceDirectedCutLoad r mu j i

/-- Common four-face support load is symmetric. -/
theorem fourFaceCommonLoad_comm
    (r : Fin 5) (mu : SupportAddress → ℝ)
    (i j : Fin 5) :
    fourFaceCommonLoad r mu i j =
      fourFaceCommonLoad r mu j i := by
  classical
  unfold fourFaceCommonLoad
  simp_rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro T _hT
  by_cases hi : i ∈ T
  · by_cases hj : j ∈ T
    · simp [hi, hj]
    · simp [hi, hj]
  · by_cases hj : j ∈ T
    · simp [hi, hj]
    · simp [hi, hj]

/-- A face endpoint load splits into common and directed-cut mass. -/
theorem fourFaceEndpointLoad_eq_common_add_directed
    (r : Fin 5) (mu : SupportAddress → ℝ)
    (i j : Fin 5) :
    fourFaceEndpointLoad r mu i =
      fourFaceCommonLoad r mu i j +
        fourFaceDirectedCutLoad r mu i j := by
  classical
  unfold fourFaceEndpointLoad fourFaceCommonLoad
    fourFaceDirectedCutLoad
  simp_rw [Finset.sum_filter]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro T _hT
  by_cases hi : i ∈ T
  · by_cases hj : j ∈ T
    · simp [hi, hj]
    · simp [hi, hj]
  · simp [hi]

/--
The four-face balance primitive.  It retains the exact face restriction and
states universally that every nonnegative face mass with opposite-cut balance
has equal endpoint loads on the four surviving endpoints.
-/
def VecBal_4
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (r : Fin 5) : Prop :=
  four_face_restriction C nSeq dSeq r ∧
    ∀ mu : SupportAddress → ℝ,
      fourFaceSupportMassNonnegative r mu →
      fourFaceDirectedCutBalance r mu →
      ∀ i j : Fin 5, i ≠ r → j ≠ r →
        fourFaceEndpointLoad r mu i =
          fourFaceEndpointLoad r mu j

/-- Exact four-face restriction produces the universal balance primitive. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.6, Sub-sub-layer 02, Sub-sub-box 02

Incoming state shape:
  four_face_restriction C nSeq dSeq r

Outgoing state shape:
  VecBal_4 C nSeq dSeq r

Effect:
  Converts opposite directed-cut balance on the deleted-endpoint face into
  equality of all surviving face endpoint loads.

Public theorem:
  derive_VecBal_4

================================================================================
-/

theorem derive_VecBal_4
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {r : Fin 5}
    (hface : four_face_restriction C nSeq dSeq r) :
    VecBal_4 C nSeq dSeq r := by
  refine ⟨hface, ?_⟩
  intro mu _hnonneg hcut i j hir hjr
  by_cases hij : i = j
  · simp [hij]
  · have hdirected :
        fourFaceDirectedCutLoad r mu i j =
          fourFaceDirectedCutLoad r mu j i :=
      hcut i j hir hjr hij
    calc
      fourFaceEndpointLoad r mu i
          = fourFaceCommonLoad r mu i j +
              fourFaceDirectedCutLoad r mu i j :=
        fourFaceEndpointLoad_eq_common_add_directed r mu i j
      _ = fourFaceCommonLoad r mu i j +
              fourFaceDirectedCutLoad r mu j i := by
        rw [hdirected]
      _ = fourFaceCommonLoad r mu j i +
              fourFaceDirectedCutLoad r mu j i := by
        rw [fourFaceCommonLoad_comm r mu i j]
      _ = fourFaceEndpointLoad r mu j :=
        (fourFaceEndpointLoad_eq_common_add_directed r mu j i).symm

