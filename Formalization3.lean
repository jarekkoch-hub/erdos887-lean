    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  finite_prefix_conflict_family C nSeq dSeq opening ∧
    prefix_cone_conflict_impossible C nSeq dSeq opening ∧
      ∀ (D : Type),
        ∀ data : RegularColoringProblemData,
          ∀ certificateData : FinitePrefixCertificateSourceData D,
            ∀ intervalData : PrefixIntervalSectorData,
              ∀ lowRankData : RankTrichotomy.LowRankSourceData,
