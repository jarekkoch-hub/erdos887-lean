      C nSeq dSeq opening
      survivorData affineData polynomialData productRowData sourceData := by
  have hSyncAtState :
      A_sync_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hSyncAt
  rcases hSyncAt with
