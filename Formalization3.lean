            (SameKEndpointPolynomial.endpointPolynomialFamily
              polynomialData e).coeff 0 := by
    intro e
    have hPolynomialZero :
        SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e = 0 :=
      hIdentityPacketAt.2.2 e
    constructor
    · rw [hPolynomialZero]
      simp [endpointCoefficientPolynomial, endpointCoefficientC3,
        endpointCoefficientC2, endpointCoefficientC1,
        endpointCoefficientC0, hPolynomialIndex, hPolynomialZero]
    · simp [endpointCoefficientC3, endpointCoefficientC2,
