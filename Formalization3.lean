Effect:
  Samples four distinct valid parameters from the retained infinite set, applies
  the degree-three root bound to each endpoint polynomial, and adds P_e = 0 for
  every K5 edge.  Every source index and source datum remains unchanged.

Public theorem:
  prove_endpoint_polynomial_identity
================================================================================
-/

theorem prove_endpoint_polynomial_identity
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hPolynomialData :
      endpoint_polynomial_data_over_K C nSeq dSeq opening) :
    endpoint_polynomial_identity C nSeq dSeq opening := by
  have hPolynomialDataState :
      endpoint_polynomial_data_over_K C nSeq dSeq opening :=
    hPolynomialData
  rcases hPolynomialData.2 with
    ⟨D, survivorData, affineData, polynomialData,
      hAffineAt, hPolynomialAt⟩
  have hIdentityAt :
      endpoint_polynomial_identity_at polynomialData :=
    endpoint_polynomial_identity_of_source hPolynomialAt
  exact
    ⟨hPolynomialDataState,
      D, survivorData, affineData, polynomialData,
      hAffineAt, hPolynomialAt, hIdentityAt⟩


