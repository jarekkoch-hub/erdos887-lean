    (sourceData : SameKPrefixAverageFormulaSourceData D) : Prop :=
  neighbor_ratio_equalities_at
      C nSeq dSeq opening
      survivorData affineData polynomialData productRowData sourceData ∧
    ∃ tau : ℚ, commonAdjacentRatioAt sourceData tau

/--
The Section 12.3 common-ratio transformation.  It acts on every exact
