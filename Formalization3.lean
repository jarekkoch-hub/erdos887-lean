/-
================================================================================
EXECUTABLE BOX
Section 3.5, Sub-layer 01, Sub-box 01
Pass 1 of 2: exact component-level projections

The canonical sector chamber has already been reconstructed.  This pass merely
displays its endpoint and sector-law components in the integer types used by the
internal obstruction.

For one fixed pointwise chamber:

  * `endpointValuesFromSectors Z` is the integer endpoint family `T`;
  * `integerSectorFamilyOfNat Z` is the integer sector family;
  * `canonicalEndpointSystemAt` records the incident-product equations,
    endpoint equations, and nonzero off-diagonal coefficients;
  * `canonicalSectorLawsAt` records unordered nonzero off-diagonal sectors and
    the same incident-product equations.

Both displays are proved from the same `Z` and `b` already present in one
`canonicalSectorChamberAt`.  No witness, orientation, sector family,
coefficient family, or branch is reselected.

This first compartment deliberately does not define `Geom_can`.  The adjacent
growth profile is a separate theorem-source read.  The continuation below uses
the compiled projections from this compartment to assemble the coherent
sequence-level endpoint/sector display.
================================================================================
-/

/-- Integer endpoint values used by the canonical internal endpoint algebra. -/
abbrev EndpointValueFamily :=
  Fin 5 → ℤ

/-- Integer presentation of the unordered sector family. -/
abbrev IntegerSectorFamily :=
  Fin 5 → Fin 5 → ℤ

/-- The endpoint family obtained by casting the incident sector products. -/
def endpointValuesFromSectors
    (Z : SectorProductFamily) : EndpointValueFamily :=
  fun i => (incidentSectorProduct Z i : ℤ)

/-- The integer sector family obtained from the positive natural sectors. -/
def integerSectorFamilyOfNat
    (Z : SectorProductFamily) : IntegerSectorFamily :=
  fun i j => (Z i j : ℤ)

/--
The canonical endpoint system `E = (T,b,Z)`.

The bounded root-band coefficient control remains a property of the extracted
chamber and is not folded into this core endpoint-system predicate.
-/
def canonicalEndpointSystemAt
    (T : EndpointValueFamily)
    (b : EndpointCoefficientFamily)
    (Z : IntegerSectorFamily) : Prop :=
  (∀ i : Fin 5,
    T i = ∏ r ∈ Finset.univ.erase i, Z i r) ∧
    (∀ i j : Fin 5, i ≠ j →
      T j - T i = b i j * Z i j) ∧
    ∀ i j : Fin 5, i ≠ j →
      b i j ≠ 0

/--
The canonical sector-law component attached to one endpoint system.

The universal incident-product equation is the compact form of the five
displayed endpoint expansions in the paper.
-/
def canonicalSectorLawsAt
    (T : EndpointValueFamily)
    (Z : IntegerSectorFamily) : Prop :=
  (∀ i j : Fin 5, i ≠ j →
    Z i j = Z j i) ∧
    (∀ i j : Fin 5, i ≠ j →
      Z i j ≠ 0) ∧
    ∀ i : Fin 5,
      T i = ∏ r ∈ Finset.univ.erase i, Z i r

/-- The cast endpoint values satisfy the integer incident-product equations. -/
theorem endpointValuesFromSectors_incident
    (Z : SectorProductFamily)
    (i : Fin 5) :
    endpointValuesFromSectors Z i =
      ∏ r ∈ Finset.univ.erase i,
        integerSectorFamilyOfNat Z i r := by
  simp [endpointValuesFromSectors, integerSectorFamilyOfNat,
    incidentSectorProduct]

/--
One pointwise canonical sector chamber displays a canonical endpoint system.
Only fields already present in that same chamber are read.
-/
theorem canonicalEndpointSystemAt_of_chamber
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    canonicalEndpointSystemAt
      (endpointValuesFromSectors Z)
      b
      (integerSectorFamilyOfNat Z) := by
  refine ⟨?_, ?_, ?_⟩
  · intro i
    exact endpointValuesFromSectors_incident Z i
  · intro i j hij
    have heq := hchamber.2.1 i j hij
    simpa [endpointValuesFromSectors,
      integerSectorFamilyOfNat] using heq
  · intro i j hij
    exact (hchamber.2.2.1 i j hij).1

/--
The same pointwise chamber displays the unordered nonzero canonical sector
laws, with no new selection of its sector family.
-/
theorem canonicalSectorLawsAt_of_chamber
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    canonicalSectorLawsAt
      (endpointValuesFromSectors Z)
      (integerSectorFamilyOfNat Z) := by
  refine ⟨?_, ?_, ?_⟩
  · intro i j _hij
    have hsym :
        Z i j = Z j i :=
      hchamber.1.2.1 i j
    exact congrArg (fun x : ℕ => (x : ℤ)) hsym
  · intro i j _hij
    have hnat : Z i j ≠ 0 :=
      Nat.ne_of_gt (hchamber.1.2.2 i j)
    simpa [integerSectorFamilyOfNat] using hnat
  · intro i
    exact endpointValuesFromSectors_incident Z i

/--
The two exact component displays are obtained together from one and the same
pointwise chamber.
-/
theorem canonicalEndpointAndSectorComponents_of_chamber
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    canonicalEndpointSystemAt
        (endpointValuesFromSectors Z)
        b
        (integerSectorFamilyOfNat Z) ∧
      canonicalSectorLawsAt
        (endpointValuesFromSectors Z)
        (integerSectorFamilyOfNat Z) := by
  exact
    ⟨canonicalEndpointSystemAt_of_chamber hchamber,
      canonicalSectorLawsAt_of_chamber hchamber⟩

/- Pointwise display box: exact chamber indices remain visible. -/
def section_3_5_pointwise_endpoint_sector_display_label : String :=
  "Pointwise endpoint-sector display at one exact canonical chamber"
def section_3_5_pointwise_endpoint_sector_display_inputs : List String :=
  ["canonicalSectorChamberAt [read]"]
def section_3_5_pointwise_endpoint_sector_display_outputs : List String :=
  ["PointwiseEndpointSectorDisplayAt [birth]"]

/--
The exact indexed endpoint-and-sector display of one canonical chamber.
Every reconstruction index remains tied to the same chamber.
-/
def PointwiseEndpointSectorDisplayAt
    (C : ℝ)
    (n : ℕ)
    (d : Fin 5 → ℕ)
    (o : ℕ)
    (Z : SectorProductFamily)
    (b : EndpointCoefficientFamily)
    (M mW : ℕ) : Prop :=
  canonicalSectorChamberAt C n d o Z b M mW ∧
    canonicalEndpointSystemAt
      (endpointValuesFromSectors Z)
      b
      (integerSectorFamilyOfNat Z) ∧
    canonicalSectorLawsAt
      (endpointValuesFromSectors Z)
      (integerSectorFamilyOfNat Z)

/-- Build the exact indexed display from that same canonical chamber. -/
theorem build_PointwiseEndpointSectorDisplayAt
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hChamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    PointwiseEndpointSectorDisplayAt
      C n d o Z b M mW := by
  rcases canonicalEndpointAndSectorComponents_of_chamber hChamber with
    ⟨hEndpoint, hLaws⟩
  exact ⟨hChamber, hEndpoint, hLaws⟩

/--
The pointwise endpoint-and-sector display produced by one exact sector chamber.
Adjacent growth is not part of this packet.
-/
def PointwiseEndpointSectorDisplay
    (C : ℝ)
    (n : ℕ)
    (d : Fin 5 → ℕ) : Prop :=
  ∃ o : ℕ,
    ∃ Z : SectorProductFamily,
      ∃ b : EndpointCoefficientFamily,
        ∃ M mW : ℕ,
          PointwiseEndpointSectorDisplayAt
            C n d o Z b M mW

/-- Build the pointwise display without selecting a second chamber. -/
theorem build_PointwiseEndpointSectorDisplay
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hChamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    PointwiseEndpointSectorDisplay C n d := by
  exact
    ⟨o, Z, b, M, mW,
      build_PointwiseEndpointSectorDisplayAt hChamber⟩

/-
================================================================================
EXECUTABLE BOX
Section 3.5, Sub-layer 01, Sub-box 01
Pass 2 of 2: coherent component display
Birth token: EndpointSectorDisplay_can

The endpoint and sector-law projections above are now assembled over the same
sequence-indexed chamber data selected once inside `Sector_can`.

The adjacent growth component is not assembled here: Section 3.5 supplies no
same-witness source relation for its four coordinates.  Accordingly,
`build_EndpointSectorDisplay_can` exposes only the coherent endpoint and sector
display and the full external route remains open.

`componentDisplayRealizedBySectorCan` is a provenance predicate.  Its visible
arguments are exactly the endpoint values, endpoint coefficients, and integer
sector family retained by the component display.  Its existential witnesses
are the already materialized chamber data that realize those visible
components.  The constructor below opens `Sector_can` once and reuses those
same witnesses; it does not construct a parallel chamber.
================================================================================
-/

/-- The four adjacent growth coordinates retained by the component display. -/
abbrev AdjacentGrowthProfile :=
  Fin 4 → ℤ

/-- The sequence-indexed adjacent growth-profile family. -/
abbrev AdjacentGrowthProfileSequence :=
  ℕ → AdjacentGrowthProfile

/-
The remaining max-linear and monotone-cubic vocabulary belongs to the later
incident-growth owner, not to Section 3.
-/
end Section3

namespace IncidentGrowth

/-- Five incident-product growth exponents at each retained sequence index. -/
abbrev CanonicalIncidentGrowthExponentSequence :=
  ℕ → Fin 5 → ℚ

/-- Five stored max-linear profile reads at each retained sequence index. -/
abbrev CanonicalProfileReadSequence :=
  ℕ → Fin 5 → ℚ

/-- One rational four-coordinate max-linear profile. -/
abbrev CanonicalMaxLinearProfile :=
  Fin 4 → ℚ

/-- A sequence of rational max-linear profiles. -/
abbrev CanonicalMaxLinearProfileSequence :=
  ℕ → CanonicalMaxLinearProfile

/-- Rationalize one exact integer adjacent-growth profile. -/
def canonicalRationalMaxLinearProfile
    (GammaSeq : Section3.AdjacentGrowthProfileSequence)
    (m : ℕ) :
    CanonicalMaxLinearProfile :=
  fun k => (GammaSeq m k : ℚ)

/-- Three-entry maximum used by the canonical profile sums. -/
def canonicalMaxLinearMax3
    (x y z : ℚ) : ℚ :=
  max x (max y z)

/-- Four-entry maximum used by the canonical profile sums. -/
def canonicalMaxLinearMax4
    (w x y z : ℚ) : ℚ :=
  max w (max x (max y z))

/-- The five canonical max-linear profile reads. -/
def canonicalMaxLinearSigma
    (G : CanonicalMaxLinearProfile) :
    Fin 5 → ℚ :=
  ![
    G 0 +
      max (G 0) (G 1) +
      canonicalMaxLinearMax3 (G 0) (G 1) (G 2) +
      canonicalMaxLinearMax4 (G 0) (G 1) (G 2) (G 3),
    G 0 + G 1 +
      max (G 1) (G 2) +
      canonicalMaxLinearMax3 (G 1) (G 2) (G 3),
    max (G 0) (G 1) +
      G 1 + G 2 +
      max (G 2) (G 3),
    canonicalMaxLinearMax3 (G 0) (G 1) (G 2) +
      max (G 1) (G 2) +
      G 2 + G 3,
    canonicalMaxLinearMax4 (G 0) (G 1) (G 2) (G 3) +
      canonicalMaxLinearMax3 (G 1) (G 2) (G 3) +
      max (G 2) (G 3) +
      G 3
  ]

/-- The adjacent incident-product balance chain at one sequence index. -/
def canonicalIncidentGrowthBalance
    (nu : Fin 5 → ℚ) : Prop :=
  nu 0 = nu 1 ∧
    nu 1 = nu 2 ∧
    nu 2 = nu 3 ∧
    nu 3 = nu 4

/-- The canonical incident-product growth law carried by the growth component. -/
def canonicalIncidentProductGrowthLaw
    (GammaSeq : Section3.AdjacentGrowthProfileSequence)
    (nuSeq : CanonicalIncidentGrowthExponentSequence)
    (sigmaSeq : CanonicalProfileReadSequence) : Prop :=
  (∀ m : ℕ, ∀ i : Fin 5,
    nuSeq m i = sigmaSeq m i) ∧
    (∀ m : ℕ,
      canonicalIncidentGrowthBalance (nuSeq m)) ∧
    ∀ m : ℕ, ∀ i : Fin 5,
      sigmaSeq m i =
        canonicalMaxLinearSigma
          (canonicalRationalMaxLinearProfile GammaSeq m) i

/-- The monotone cubic used by the nonuniform branch-production component. -/
def canonicalGrowthMonotoneCubic
    (U V X : ℚ) : ℚ :=
  X * (X + U) * (X + U + V)

/-- The shifted cubic difference factor. -/
def canonicalGrowthMonotoneCubicDifferenceFactor
    (U V L X : ℚ) : ℚ :=
  3 * X ^ 2 +
    3 * L * X +
    L ^ 2 +
    (2 * U + V) * (2 * X + L) +
    U ^ 2 +
    U * V

/-- Endpoint reversal of one canonical max-linear profile. -/
def canonicalGrowthEndpointReversalProfile
    (G : CanonicalMaxLinearProfile) :
    CanonicalMaxLinearProfile :=
  ![G 3, G 2, G 1, G 0]

/-- The exact left-low source branch shape. -/
def canonicalGrowthLeftLowProductionBranchShape
    (G : CanonicalMaxLinearProfile) : Prop :=
  G 0 < G 2 ∧
    G 2 < G 1 ∧
    G 2 = G 3 ∧
    G 0 + G 1 = 2 * G 2

/-- The exact right-low source branch shape. -/
def canonicalGrowthRightLowProductionBranchShape
    (G : CanonicalMaxLinearProfile) : Prop :=
  G 3 < G 1 ∧
    G 1 < G 2 ∧
    G 0 = G 1 ∧
    G 3 + G 2 = 2 * G 1

/--
The conditional nonuniform monotone-cubic production law carried by the exact
adjacent-growth component.  It remains dormant until Section 7.6 opens a
selected nonuniform branch.
-/
def canonicalNonuniformMonotoneCubicProductionLaw
    (GammaSeq : Section3.AdjacentGrowthProfileSequence) : Prop :=
  ∀ GSeq : CanonicalMaxLinearProfileSequence,
    (∀ m : ℕ, ∀ k : Fin 4,
      GSeq m k = (GammaSeq m k : ℚ)) →
      ((∀ m : ℕ,
        canonicalGrowthLeftLowProductionBranchShape (GSeq m) →
          ∃ x U V L B H : ℚ,
            L = GSeq m 1 - GSeq m 2 ∧
              0 < H ∧
              0 < L ∧
              canonicalGrowthMonotoneCubic U V (x + L) -
                  canonicalGrowthMonotoneCubic U V x = B ∧
              H ^ 2 ≤
                canonicalGrowthMonotoneCubicDifferenceFactor U V L x ∧
              B < L * H ^ 2) ∧
       ∀ m : ℕ,
        canonicalGrowthRightLowProductionBranchShape (GSeq m) →
          ∃ x U V L B H : ℚ,
            L =
                canonicalGrowthEndpointReversalProfile (GSeq m) 1 -
                  canonicalGrowthEndpointReversalProfile (GSeq m) 2 ∧
              0 < H ∧
              0 < L ∧
              canonicalGrowthMonotoneCubic U V (x + L) -
                  canonicalGrowthMonotoneCubic U V x = B ∧
              H ^ 2 ≤
                canonicalGrowthMonotoneCubicDifferenceFactor U V L x ∧
              B < L * H ^ 2)

end IncidentGrowth

