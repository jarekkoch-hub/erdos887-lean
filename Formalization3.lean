  constructor

  · intro G x U V L B H hRightCertificate
    change
      left_low_monotone_cubic_certificate
        (endpointReversalProfile G)
        x U V L B H at hRightCertificate
    exact
      hLeftRuledOut.1
        (endpointReversalProfile G)
        x U V L B H
        hRightCertificate

  · intro m hRight

    rcases hInterfaces.2 m hRight with
      ⟨x, U, V, L, B, H, hRightCertificate⟩

    have hReversedLeft :
        refined_left_low_profile
          (endpointReversalProfile (GSeq m)) :=
      right_low_reverses_to_left_low hRight

    change
      left_low_monotone_cubic_certificate
        (endpointReversalProfile (GSeq m))
        x U V L B H at hRightCertificate

    rcases hRightCertificate with
      ⟨_, hShift, hHPositive, hLPositive,
        hDifference, hFactorLower, hSmallBound⟩

    have hLeftCertificate :
        left_low_monotone_cubic_certificate
          (endpointReversalProfile (GSeq m))
          x U V L B H :=
      ⟨hReversedLeft,
        hShift,
        hHPositive,
        hLPositive,
        hDifference,
        hFactorLower,
        hSmallBound⟩

