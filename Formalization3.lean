/-- Infinitely many five-divisor violations for one fixed root-band constant. -/
def ExternalInfiniteViolations (C : ℝ) : Prop :=
  ∀ N : ℕ,
    ∃ n : ℕ,
      N ≤ n ∧ 5 ≤ D_C C n

/-
================================================================================
STATE-SHAPE BATCH
External reconstruction sequence materialization

Incoming state shape:
  ExternalInfiniteViolations C

Outgoing state shape:
  ∃ nSeq dSeq, external_violation_sequence_state C nSeq dSeq

Effect:
  Materializes one divergent integer sequence and selects exactly one
  five-divisor witness at every index.  The materialized arithmetic frontier,
  paired-root split, atomization, edge data, load data, and pointwise activity
  are all then constructed from that same indexed witness.

Semantic kind:
  production ingress with retained ancestry.

Public theorem:
  derive_external_violation_sequence_state
================================================================================
-/

theorem derive_external_violation_sequence_state
    {C : ℝ}
    (hViolations : ExternalInfiniteViolations C) :
    ∃ nSeq : ℕ → ℕ,
      ∃ dSeq : ℕ → Fin 5 → ℕ,
        external_violation_sequence_state C nSeq dSeq := by
  classical

  let nSeq : ℕ → ℕ :=
    fun m => Classical.choose (hViolations (m + 1))

  have hnSeq :
      ∀ m : ℕ,
        m + 1 ≤ nSeq m ∧
          5 ≤ D_C C (nSeq m) := by
    intro m
    exact Classical.choose_spec (hViolations (m + 1))

  let dSeq : ℕ → Fin 5 → ℕ :=
    fun m =>
      Classical.choose
        (Five_ext (hnSeq m).2)

  have hdSeq :
      ∀ m : ℕ,
        Section3.five_near_root_divisor_witness
          C (nSeq m) (dSeq m) := by
    intro m
    exact Classical.choose_spec (Five_ext (hnSeq m).2)

  have hDiverges :
      Section3.natSequenceTendsToInfinity nSeq := by
    intro B
    refine ⟨B + 1, ?_⟩
    intro m hm
    have hBm : B < m :=
      lt_of_lt_of_le (Nat.lt_succ_self B) hm
    have hmN : m < nSeq m :=
      lt_of_lt_of_le (Nat.lt_succ_self m) (hnSeq m).1
    exact lt_trans hBm hmN

  have hArithmetic :
      ∀ m : ℕ,
        Section3.section_3_arithmetic_state
          C (nSeq m) (dSeq m) := by
    intro m
    exact Section3.close_section_3_arithmetic_state (hdSeq m)

  have hSplit :
      ∀ m : ℕ,
        Section3.paired_root_split C (nSeq m) (dSeq m) := by
    intro m
    exact Section3.close_paired_root_split
      (Section3.open_section_3_4 (hArithmetic m))

  have hFull :
      ∀ m : ℕ,
        Section3.full_atom_model (nSeq m) (dSeq m) := by
    intro m
    exact Atom_can_route (hdSeq m)

  have hEdge :
      ∀ m : ℕ,
        Section3.Edge_can (nSeq m) (dSeq m) := by
    intro m
    exact Edge_can_route (hFull m)

  have hLoad :
      ∀ m : ℕ,
        Section3.Load_can (nSeq m) (dSeq m) := by
    intro m
    exact Load_can_route (hEdge m)

  have hAct :
      ∀ m : ℕ,
        Section3.Act_can_all_edges C (nSeq m) (dSeq m) := by
    intro m
    exact Act_can_route (hEdge m) (hdSeq m)

  have hC : 0 < C := by
    let i : Fin 5 := ⟨0, by decide⟩
    let j : Fin 5 := ⟨1, by decide⟩
    have hij : i < j := by decide
    exact (hAct 0 i j hij).2.2.1

  exact
    ⟨nSeq, dSeq, hC, hDiverges, hArithmetic, hSplit,
      hFull, hEdge, hLoad, hAct⟩

