  Reads the conversion and packer fields from the exact product-row source
  already retained inside the coefficient-vanishing witness.  The cubic and
  quadratic rules are rewritten against the named c3 and c2 functions of the
  same table.  No row family is produced yet.

Public theorem:
  build_row_conversion_semantics
================================================================================
-/

theorem build_row_conversion_semantics
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hRows : product_difference_row_source C nSeq dSeq opening)
    (hVanish : coefficient_vanishings C nSeq dSeq opening) :
    row_conversion_semantics C nSeq dSeq opening := by
  have hRowsState :
      product_difference_row_source C nSeq dSeq opening :=
    hRows
  have hVanishState :
      coefficient_vanishings C nSeq dSeq opening :=
    hVanish
  refine ⟨hRowsState, hVanishState, ?_⟩
  intro D survivorData affineData polynomialData productRowData hVanishAt
  have hVanishAtState :
      coefficient_vanishings_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hVanishAt
  rcases hVanishAt with ⟨hTableAt, _hZeros⟩
  rcases hTableAt with ⟨hRowsAt, hCoefficientMatches⟩
  rcases hRowsAt with ⟨_hIdentityPacketAt, hProductRowAt⟩
  rcases hProductRowAt with
    ⟨_hSurvivorIndex, _hAffineIndex, _hPolynomialIndex,
      _hLeftAffine, _hRightAffine, _hProductIdentity,
      hLeadRule, hVertRule, hCubRule,
      hLeadPacker, hVertPacker, hCubPacker⟩
  have hNamedLeadRule :
      ∀ e : Section6.K5EdgeAddress,
        endpointCoefficientC3 productRowData e = 0 →
          productRowLeadPredicate productRowData e := by
    intro e hC3Zero
    have hRawC3 :
        (SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e).coeff 3 = 0 :=
      (hCoefficientMatches e).2.1.symm.trans hC3Zero
    exact hLeadRule e hRawC3
  have hNamedVertRule :
      ∀ e : Section6.K5EdgeAddress,
        endpointCoefficientC2 productRowData e = 0 →
          productRowLeadPredicate productRowData e →
            productRowVertPredicate productRowData e := by
    intro e hC2Zero hLead
    have hRawC2 :
        (SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e).coeff 2 = 0 :=
      (hCoefficientMatches e).2.2.1.symm.trans hC2Zero
    exact hVertRule e hRawC2 hLead
  exact
    ⟨hVanishAtState,
      hNamedLeadRule, hNamedVertRule, hCubRule,
      hLeadPacker, hVertPacker, hCubPacker⟩


