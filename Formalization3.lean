def incident_growth_section_7_5_sub_layer_01_sub_box_01_label : String := "Adjacent profile balance is full profile balance"
def incident_growth_section_7_5_sub_layer_01_sub_box_01_inputs : List String := ["profile_balance [construction]"]
def incident_growth_section_7_5_sub_layer_01_sub_box_01_outputs : List String := ["full_profile_balance [birth]"]

/- Sub-layer 02 -/
