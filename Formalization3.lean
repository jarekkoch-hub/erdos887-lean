/- # Sub-sub-container 3.4.5: Primitive support vectors and endpoint-load balance. -/

/- Sub-sub-layer 01 -/
/-
Paper ref: 3.4.5
Sub-sub-box Label: `Primitive support vectors: endpoint-incidence vector e(S) and endpoint-load vector E(mu)`
Sub-sub-inputs: `bounded_full_K5_branch`, `supportMassNonnegative`,
`directedCutBalance`
Sub-sub-outputs: `primitive_support_vectors`
-/
def section_3_4_5_sub_sub_layer_01_sub_sub_box_01_label : String := "Primitive support vectors: endpoint-incidence vector e(S) and endpoint-load vector E(mu)"
def section_3_4_5_sub_sub_layer_01_sub_sub_box_01_inputs : List String := ["bounded_full_K5_branch [permission]", "supportMassNonnegative [read]", "directedCutBalance [read]"]
def section_3_4_5_sub_sub_layer_01_sub_sub_box_01_outputs : List String := ["primitive_support_vectors [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.5, Sub-sub-layer 01, Sub-sub-box 01
Birth token: primitive_support_vectors

This box introduces the primitive endpoint-incidence vector and endpoint-load
coordinates for an arbitrary nonnegative support-mass function `mu`.  It also
records the normalized opposite directed-cut equality that the paper obtains
from a bounded full K5 sequence after taking limits.

The exact finite identities are proved here.  The analytic birth of the mass
limits and opposite-cut equality is deliberately not manufactured from one
fixed witness.  See
[CONNECTION-AUDIT: NORMALIZED-CUT-BALANCE-BIRTH].

No face entry, clipping permission, subsequence choice, or parent route is
created in this box.
================================================================================
-/

/--
The endpoint-incidence coordinate of one support address.  Its value is exactly
zero or one.
-/
def endpointIncidence
    (S : SupportAddress) (i : Fin 5) : ℝ :=
  if i ∈ S then 1 else 0

/-- The `i`th endpoint load of a support-mass function. -/
noncomputable def endpointLoad
    (mu : SupportAddress → ℝ) (i : Fin 5) : ℝ := by
  classical
  exact ∑ S ∈ supportAddresses.filter (fun S => i ∈ S), mu S

/-- Mass carried by addresses containing both endpoints of one edge. -/
noncomputable def commonSupportLoad
    (mu : SupportAddress → ℝ) (i j : Fin 5) : ℝ := by
  classical
  exact ∑ S ∈ supportAddresses.filter (commonEdgeAddress i j), mu S

/-- Mass carried by addresses cutting the directed edge `i|j`. -/
noncomputable def directedCutLoad
    (mu : SupportAddress → ℝ) (i j : Fin 5) : ℝ := by
  classical
  exact ∑ S ∈ supportAddresses.filter (directedEdgeAddress i j), mu S

/-- A support-mass function is nonnegative on every legal support address. -/
def supportMassNonnegative
    (mu : SupportAddress → ℝ) : Prop :=
  ∀ S ∈ supportAddresses, 0 ≤ mu S

/--
The normalized opposite directed cuts have equal mass.  This is the exact
finite equality obtained after the paper's sequence-limit passage.
-/
def directedCutBalance
    (mu : SupportAddress → ℝ) : Prop :=
  ∀ i j : Fin 5, i ≠ j →
    directedCutLoad mu i j = directedCutLoad mu j i

/-- Every endpoint-incidence coordinate is zero or one. -/
theorem endpointIncidence_zero_or_one
    (S : SupportAddress) (i : Fin 5) :
    endpointIncidence S i = 0 ∨ endpointIncidence S i = 1 := by
  unfold endpointIncidence
  by_cases hi : i ∈ S
  · exact Or.inr (by simp [hi])
  · exact Or.inl (by simp [hi])

/--
The filtered endpoint-load definition is exactly the incidence-vector
coordinate formula from the paper.
-/
theorem endpointLoad_eq_incidence_sum
    (mu : SupportAddress → ℝ) (i : Fin 5) :
    endpointLoad mu i =
      ∑ S ∈ supportAddresses, mu S * endpointIncidence S i := by
  classical
  unfold endpointLoad endpointIncidence
  simp_rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro S _hS
  by_cases hi : i ∈ S
  · simp [hi]
  · simp [hi]

/-- The common support load is symmetric in the two endpoints. -/
theorem commonSupportLoad_comm
    (mu : SupportAddress → ℝ) (i j : Fin 5) :
    commonSupportLoad mu i j = commonSupportLoad mu j i := by
  classical
  unfold commonSupportLoad commonEdgeAddress
  simp_rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro S _hS
  by_cases hi : i ∈ S
  · by_cases hj : j ∈ S
    · simp [hi, hj]
    · simp [hi, hj]
  · by_cases hj : j ∈ S
    · simp [hi, hj]
    · simp [hi, hj]

/--
One endpoint load is the disjoint sum of the common-edge mass and the directed
cut mass away from the other endpoint.
-/
theorem endpointLoad_eq_common_add_directed
    (mu : SupportAddress → ℝ) (i j : Fin 5) :
    endpointLoad mu i =
      commonSupportLoad mu i j + directedCutLoad mu i j := by
  classical
  unfold endpointLoad commonSupportLoad directedCutLoad
    commonEdgeAddress directedEdgeAddress
  simp_rw [Finset.sum_filter]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro S _hS
  by_cases hi : i ∈ S
  · by_cases hj : j ∈ S
    · simp [hi, hj]
    · simp [hi, hj]
  · simp [hi]

/--
The retained primitive support-vector packet over one already fixed bounded
full K5 sequence.  The same `nSeq`, `dSeq`, and support-mass function `mu` are
carried throughout; no sequence or mass function is selected by this
predicate.
-/
def primitive_support_vectors
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (mu : SupportAddress → ℝ) : Prop :=
  bounded_full_K5_branch C nSeq dSeq ∧
    (∀ m : ℕ, full_atom_model (nSeq m) (dSeq m)) ∧
    supportMassNonnegative mu ∧
    (∀ S ∈ supportAddresses, ∀ i : Fin 5,
      endpointIncidence S i = 0 ∨ endpointIncidence S i = 1) ∧
    (∀ i : Fin 5,
      endpointLoad mu i =
        ∑ S ∈ supportAddresses, mu S * endpointIncidence S i) ∧
    directedCutBalance mu

/--
Build the exact primitive vector packet from a retained bounded branch, a
nonnegative normalized mass function, and the normalized opposite-cut equality.
The latter two inputs are explicit because their sequence-limit construction is
not connected in this derivation increment.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.5, Sub-sub-layer 01, Sub-sub-box 01

Incoming state shape:
  bounded_full_K5_branch C nSeq dSeq
  supportMassNonnegative mu
  directedCutBalance mu

Outgoing state shape:
  primitive_support_vectors C nSeq dSeq mu

Effect:
  Builds the endpoint-incidence and endpoint-load vector packet over the same
  bounded branch and supplied normalized mass.

Public theorem:
  derive_primitive_support_vectors

================================================================================
-/

theorem derive_primitive_support_vectors
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {mu : SupportAddress → ℝ}
    (hbranch : bounded_full_K5_branch C nSeq dSeq)
    (hnonneg : supportMassNonnegative mu)
    (hcut : directedCutBalance mu) :
    primitive_support_vectors C nSeq dSeq mu := by
  refine ⟨hbranch, ?_, hnonneg, ?_, ?_, hcut⟩
  · intro m
    exact (hbranch.1.1 m).1
  · intro S _hS i
    exact endpointIncidence_zero_or_one S i
  · intro i
    exact endpointLoad_eq_incidence_sum mu i

/- Sub-sub-layer 02 -/
/-
Paper ref: 3.4.5
Sub-sub-box Label: `Endpoint-load balance on the surviving bounded full chamber`
Sub-sub-inputs: `primitive_support_vectors`
Sub-sub-outputs: `VecBal`
-/
def section_3_4_5_sub_sub_layer_02_sub_sub_box_02_label : String := "Endpoint-load balance on the surviving bounded full chamber"
def section_3_4_5_sub_sub_layer_02_sub_sub_box_02_inputs : List String := ["primitive_support_vectors [construction]"]
def section_3_4_5_sub_sub_layer_02_sub_sub_box_02_outputs : List String := ["VecBal [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.5, Sub-sub-layer 02, Sub-sub-box 02
Birth token: VecBal

This box proves the exact finite implication

  opposite directed-cut balance  =>  equal endpoint loads.

For endpoints i and j, both endpoint loads contain the same common-address
mass.  Removing that common term leaves the two opposite directed-cut masses,
which are equal by the normalized cut-balance read retained in
`primitive_support_vectors`.

No logarithmic limit is recomputed here and no later clipping wire is activated.
================================================================================
-/

/-- Every endpoint coordinate of the normalized support mass is equal. -/
def VecBal
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (mu : SupportAddress → ℝ) : Prop :=
  primitive_support_vectors C nSeq dSeq mu ∧
    ∀ i j : Fin 5, endpointLoad mu i = endpointLoad mu j

/-- Directed-cut balance implies endpoint-load balance. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.5, Sub-sub-layer 02, Sub-sub-box 02

Incoming state shape:
  primitive_support_vectors C nSeq dSeq mu

Outgoing state shape:
  VecBal C nSeq dSeq mu

Effect:
  Cancels the common-address load and converts opposite directed-cut balance
  into equality of all endpoint loads.

Public theorem:
  derive_VecBal

================================================================================
-/

theorem derive_VecBal
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {mu : SupportAddress → ℝ}
    (hprim : primitive_support_vectors C nSeq dSeq mu) :
    VecBal C nSeq dSeq mu := by
  refine ⟨hprim, ?_⟩
  intro i j
  by_cases hij : i = j
  · simp [hij]
  · have hcut :
        directedCutLoad mu i j = directedCutLoad mu j i :=
      hprim.2.2.2.2.2 i j hij
    calc
      endpointLoad mu i
          = commonSupportLoad mu i j + directedCutLoad mu i j :=
        endpointLoad_eq_common_add_directed mu i j
      _ = commonSupportLoad mu i j + directedCutLoad mu j i := by
        rw [hcut]
      _ = commonSupportLoad mu j i + directedCutLoad mu j i := by
        rw [commonSupportLoad_comm mu i j]
      _ = endpointLoad mu j :=
        (endpointLoad_eq_common_add_directed mu j i).symm

/- # Sub-sub-container 3.4.6: Four-face restriction and primitive balance. -/

/- Sub-sub-layer 01 -/
/-
Paper ref: 3.4.6
Sub-sub-box Label: `Four-face restriction: deleted-endpoint faces F_r=V\{r}`
Sub-sub-inputs: `full_atom_model`, `bounded_full_K5_branch`
Sub-sub-outputs: `four_face_restriction`
-/
def section_3_4_6_sub_sub_layer_01_sub_sub_box_01_label : String := "Four-face restriction: deleted-endpoint faces F_r=V\\{r}"
def section_3_4_6_sub_sub_layer_01_sub_sub_box_01_inputs : List String := ["full_atom_model [read]", "bounded_full_K5_branch [permission]"]
def section_3_4_6_sub_sub_layer_01_sub_sub_box_01_outputs : List String := ["four_face_restriction [birth]"]


/-
================================================================================
EXECUTABLE BOX
Section 3.4.6, Sub-sub-layer 01, Sub-sub-box 01
Birth token: four_face_restriction

For a deleted endpoint `r`, this box defines the face

  F_r = V \ {r}

and projects every five-endpoint support address `S` to `S ∩ F_r`.  The
collapsed atom over a face address `T` is the exact product of all original
atoms having that projection.  Fiberwise finite-product identities then prove
that upper reads, lower reads, and directed quotients between endpoints still
in the face are unchanged.

This is pointwise regrouping only.  No first active face mass, divergent scale,
subsequence, face entry, or clipping route is selected here.  See
[CONNECTION-AUDIT: FOUR-FACE-MASS-BIRTH].
================================================================================
-/

/-- The four-endpoint face obtained by deleting `r`. -/
def deletedEndpointFace (r : Fin 5) : SupportAddress :=
  Finset.univ.erase r

@[simp]
theorem mem_deletedEndpointFace
    {r i : Fin 5} :
    i ∈ deletedEndpointFace r ↔ i ≠ r := by
  simp [deletedEndpointFace]

/-- Projection of a five-endpoint address onto the face deleting `r`. -/
def faceProjection
    (r : Fin 5) (S : SupportAddress) : SupportAddress :=
  S ∩ deletedEndpointFace r

/-- A support address lies entirely in the face deleting `r`. -/
def fourFaceAddress
    (r : Fin 5) (T : SupportAddress) : Prop :=
  T ⊆ deletedEndpointFace r

instance decidablePredFourFaceAddress (r : Fin 5) :
    DecidablePred (fourFaceAddress r) := by
  intro T
  unfold fourFaceAddress
  infer_instance

/-- The sixteen support addresses of the face deleting `r`. -/
def fourFaceAddresses (r : Fin 5) : Finset SupportAddress :=
  supportAddresses.filter (fourFaceAddress r)

@[simp]
theorem mem_fourFaceAddresses
    {r : Fin 5} {T : SupportAddress} :
    T ∈ fourFaceAddresses r ↔ T ⊆ deletedEndpointFace r := by
  classical
  simp [fourFaceAddresses, fourFaceAddress,
    supportAddresses, endpointUniverse]

/-- Every projected address lies in the deleted-endpoint face. -/
theorem faceProjection_mem_fourFaceAddresses
    (r : Fin 5) (S : SupportAddress) :
    faceProjection r S ∈ fourFaceAddresses r := by
  apply mem_fourFaceAddresses.mpr
  unfold faceProjection
  exact Finset.inter_subset_right

/-- Away from the deleted endpoint, projection preserves membership exactly. -/
@[simp]
theorem mem_faceProjection_iff
    {r i : Fin 5} {S : SupportAddress}
    (hir : i ≠ r) :
    i ∈ faceProjection r S ↔ i ∈ S := by
  simp [faceProjection, hir]

/--
The collapsed face atom is the product of all original atoms having the same
intersection with the deleted-endpoint face.
-/
noncomputable def collapsedFourFaceAtom
    (n : ℕ) (d : Fin 5 → ℕ)
    (r : Fin 5) (T : SupportAddress) : ℕ :=
  ∏ S ∈ supportAddresses.filter
      (fun S => faceProjection r S = T),
    atomBucket n d S

/-- Every collapsed four-face atom is positive. -/
theorem collapsedFourFaceAtom_pos
    (n : ℕ) (d : Fin 5 → ℕ)
    (r : Fin 5) (T : SupportAddress) :
    0 < collapsedFourFaceAtom n d r T := by
  unfold collapsedFourFaceAtom
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro S _hS
    exact atomBucket_pos n d S)

/-- Product of collapsed atoms satisfying one face-address predicate. -/
noncomputable def collapsedFourFaceReadBy
    (n : ℕ) (d : Fin 5 → ℕ) (r : Fin 5)
    (Q : SupportAddress → Prop) [DecidablePred Q] : ℕ :=
  ∏ T ∈ (fourFaceAddresses r).filter Q,
    collapsedFourFaceAtom n d r T

/--
Fiberwise regrouping theorem for the deleted-endpoint projection.  A predicate
`Q` may be read before or after projection whenever it is invariant under
removing the endpoint `r`.
-/
theorem collapsedFourFaceReadBy_eq
    (n : ℕ) (d : Fin 5 → ℕ) (r : Fin 5)
    (Q : SupportAddress → Prop) [DecidablePred Q]
    (hinv : ∀ S : SupportAddress,
      Q (faceProjection r S) ↔ Q S) :
    collapsedFourFaceReadBy n d r Q =
      ∏ S ∈ supportAddresses.filter Q, atomBucket n d S := by
  classical
  have hmaps :
      ∀ S ∈ supportAddresses.filter Q,
        faceProjection r S ∈ (fourFaceAddresses r).filter Q := by
    intro S hS
    have hQS : Q S := (Finset.mem_filter.mp hS).2
    exact Finset.mem_filter.mpr
      ⟨faceProjection_mem_fourFaceAddresses r S,
       (hinv S).2 hQS⟩

  unfold collapsedFourFaceReadBy
  calc
    (∏ T ∈ (fourFaceAddresses r).filter Q,
        collapsedFourFaceAtom n d r T)
        =
        ∏ T ∈ (fourFaceAddresses r).filter Q,
          ∏ S ∈ (supportAddresses.filter Q).filter
              (fun S => faceProjection r S = T),
            atomBucket n d S := by
      apply Finset.prod_congr rfl
      intro T hT
      have hQT : Q T := (Finset.mem_filter.mp hT).2
      unfold collapsedFourFaceAtom
      apply Finset.prod_congr
      · ext S
        simp only [Finset.mem_filter]
        constructor
        · rintro ⟨hSaddr, hproj⟩
          have hQproj : Q (faceProjection r S) := by
            rw [hproj]
            exact hQT
          have hQS : Q S := (hinv S).1 hQproj
          exact ⟨⟨hSaddr, hQS⟩, hproj⟩
        · rintro ⟨⟨hSaddr, _hQS⟩, hproj⟩
          exact ⟨hSaddr, hproj⟩
      · intro S _hS
        rfl
    _ = ∏ S ∈ supportAddresses.filter Q, atomBucket n d S := by
      simpa only using
        (Finset.prod_fiberwise_of_maps_to
          (s := supportAddresses.filter Q)
          (t := (fourFaceAddresses r).filter Q)
          (g := faceProjection r)
          hmaps
          (fun S => atomBucket n d S))

/-- Upper-divisor read through the collapsed four-face atoms. -/
noncomputable def fourFaceUpperRead
    (n : ℕ) (d : Fin 5 → ℕ)
    (r i : Fin 5) : ℕ :=
  collapsedFourFaceReadBy n d r (fun T => i ∈ T)

/-- Lower-partner read through the collapsed four-face atoms. -/
noncomputable def fourFaceLowerRead
    (n : ℕ) (d : Fin 5 → ℕ)
    (r i : Fin 5) : ℕ :=
  collapsedFourFaceReadBy n d r (fun T => i ∉ T)

/-- Directed quotient read inside the face deleting `r`. -/
noncomputable def fourFaceDirectedQuotient
    (n : ℕ) (d : Fin 5 → ℕ)
    (r i j : Fin 5) : ℕ :=
  collapsedFourFaceReadBy n d r
    (fun T => i ∈ T ∧ j ∉ T)

/-- The collapsed upper read equals the original upper atom read. -/
theorem fourFaceUpperRead_eq_upperAtomRead
    (n : ℕ) (d : Fin 5 → ℕ)
    {r i : Fin 5} (hir : i ≠ r) :
    fourFaceUpperRead n d r i = upperAtomRead n d i := by
  classical
  unfold fourFaceUpperRead upperAtomRead
  apply collapsedFourFaceReadBy_eq
  intro S
  simp [mem_faceProjection_iff hir]

/-- The collapsed lower read equals the original lower atom read. -/
theorem fourFaceLowerRead_eq_lowerAtomRead
    (n : ℕ) (d : Fin 5 → ℕ)
    {r i : Fin 5} (hir : i ≠ r) :
    fourFaceLowerRead n d r i = lowerAtomRead n d i := by
  classical
  unfold fourFaceLowerRead lowerAtomRead
  apply collapsedFourFaceReadBy_eq
  intro S
  simp [mem_faceProjection_iff hir]

/-- The four-face directed quotient is exactly the original directed quotient. -/
theorem fourFaceDirectedQuotient_eq_directedQuotient
    (n : ℕ) (d : Fin 5 → ℕ)
    {r i j : Fin 5}
    (hir : i ≠ r) (hjr : j ≠ r) :
    fourFaceDirectedQuotient n d r i j =
      directedQuotient n d i j := by
  classical
  unfold fourFaceDirectedQuotient directedQuotient directedEdgeAddress

  have hcollapse :=
    collapsedFourFaceReadBy_eq
      n d r
      (fun T : SupportAddress => i ∈ T ∧ j ∉ T)
      (by
        intro S
        simp [mem_faceProjection_iff hir,
          mem_faceProjection_iff hjr])

  rw [hcollapse]

  apply Finset.prod_congr
  · ext S
    simp
  · intro S _hS
    rfl
/--
The exact deleted-endpoint restriction packet over one retained bounded full
K5 sequence.  Every statement is pointwise in the same sequence and uses only
regrouping of the existing atom family.
-/
def four_face_restriction
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (r : Fin 5) : Prop :=
  bounded_full_K5_branch C nSeq dSeq ∧
    (∀ m : ℕ, ∀ T ∈ fourFaceAddresses r,
      0 < collapsedFourFaceAtom (nSeq m) (dSeq m) r T) ∧
    (∀ m : ℕ, ∀ i : Fin 5, i ≠ r →
      dSeq m i = fourFaceUpperRead (nSeq m) (dSeq m) r i) ∧
    (∀ m : ℕ, ∀ i : Fin 5, i ≠ r →
      nSeq m / dSeq m i =
        fourFaceLowerRead (nSeq m) (dSeq m) r i) ∧
    ∀ m : ℕ, ∀ i j : Fin 5, i ≠ r → j ≠ r →
      fourFaceDirectedQuotient (nSeq m) (dSeq m) r i j =
        directedQuotient (nSeq m) (dSeq m) i j

/-- A bounded full K5 branch has every exact deleted-endpoint restriction. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.6, Sub-sub-layer 01, Sub-sub-box 01

Incoming state shape:
  bounded_full_K5_branch C nSeq dSeq
  deleted endpoint r

Outgoing state shape:
  four_face_restriction C nSeq dSeq r

Effect:
  Collapses every support address onto the face deleting r while preserving the
  endpoint, lower-partner, and directed-quotient reads on surviving vertices.

Public theorem:
  derive_four_face_restriction

================================================================================
-/

theorem derive_four_face_restriction
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hbranch : bounded_full_K5_branch C nSeq dSeq)
    (r : Fin 5) :
    four_face_restriction C nSeq dSeq r := by
  refine ⟨hbranch, ?_, ?_, ?_, ?_⟩
  · intro m T _hT
    exact collapsedFourFaceAtom_pos (nSeq m) (dSeq m) r T
  · intro m i hir
    have hfull : full_atom_model (nSeq m) (dSeq m) :=
      (hbranch.1.1 m).1
    calc
      dSeq m i = upperAtomRead (nSeq m) (dSeq m) i :=
        hfull.2.2.1 i
      _ = fourFaceUpperRead (nSeq m) (dSeq m) r i :=
        (fourFaceUpperRead_eq_upperAtomRead
          (nSeq m) (dSeq m) hir).symm
  · intro m i hir
    have hfull : full_atom_model (nSeq m) (dSeq m) :=
      (hbranch.1.1 m).1
    calc
      nSeq m / dSeq m i = lowerAtomRead (nSeq m) (dSeq m) i :=
        hfull.2.2.2.1 i
      _ = fourFaceLowerRead (nSeq m) (dSeq m) r i :=
        (fourFaceLowerRead_eq_lowerAtomRead
          (nSeq m) (dSeq m) hir).symm
  · intro m i j hir hjr
    exact fourFaceDirectedQuotient_eq_directedQuotient
      (nSeq m) (dSeq m) hir hjr

