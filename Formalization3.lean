def rank_trichotomy_section_8_1_sub_layer_01_sub_box_01_label : String := "Reduced cubic rows: R_ij(Z)=prod_{r!=i,j} Z_jr - prod_{r!=i,j} Z_ir, and the lemma b_ij=R_ij(Z) by incident products, Z_ij=Z_ji, and cancellation of nonzero Z_ij"
def rank_trichotomy_section_8_1_sub_layer_01_sub_box_01_inputs : List String := ["rank_layer_context [read]", "E_W canonical endpoint system [construction]", "Z sector laws [construction]"]
def rank_trichotomy_section_8_1_sub_layer_01_sub_box_01_outputs : List String := ["R_cub [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 8.1, Sub-layer 01, Sub-box 01

Birth token: R_cub

The reduced cubic row is formed directly from the exact endpoint equations and
unordered nonzero sector laws.  The proof splits each incident product at the
selected edge, uses sector symmetry, and cancels the nonzero common sector.
================================================================================
-/

/-- The product of the three sectors at endpoint `i` away from the edge `ij`. -/
def reducedCubicComplementProduct
    (Z : Section3.IntegerSectorFamily)
    (i j : Fin 5) : ℤ :=
  ∏ r ∈ (Finset.univ.erase i).erase j, Z i r

/-- The reduced cubic expression attached to the ordered endpoint pair `i,j`. -/
def reducedCubicRowValue
    (Z : Section3.IntegerSectorFamily)
    (i j : Fin 5) : ℤ :=
  reducedCubicComplementProduct Z j i -
    reducedCubicComplementProduct Z i j

/-- The ten increasing-orientation reduced cubic endpoint rows at one index. -/
def reduced_cubic_rows_at
    (b : Section3.EndpointCoefficientFamily)
    (Z : Section3.IntegerSectorFamily) : Prop :=
  ∀ i j : Fin 5, i < j →
    b i j = reducedCubicRowValue Z i j

/-- Split one incident product into the selected edge and its three complements. -/
theorem incident_product_split_off_edge
    (Z : Section3.IntegerSectorFamily)
    {i j : Fin 5}
    (hij : i ≠ j) :
    (∏ r ∈ Finset.univ.erase i, Z i r) =
      Z i j * reducedCubicComplementProduct Z i j := by
  have hjmem : j ∈ Finset.univ.erase i :=
    Finset.mem_erase.mpr
      ⟨Ne.symm hij, Finset.mem_univ j⟩
  simpa [reducedCubicComplementProduct] using
    (Finset.mul_prod_erase
      (Finset.univ.erase i)
      (fun r : Fin 5 => Z i r)
      hjmem).symm

/-- One canonical endpoint equation gives its reduced cubic row. -/
theorem canonical_endpoint_gives_reduced_cubic_row
    {T : Section3.EndpointValueFamily}
    {b : Section3.EndpointCoefficientFamily}
    {Z : Section3.IntegerSectorFamily}
    (hE : Section3.canonicalEndpointSystemAt T b Z)
    (hSector : Section3.canonicalSectorLawsAt T Z)
    {i j : Fin 5}
    (hij : i ≠ j) :
    b i j = reducedCubicRowValue Z i j := by
  have hji : j ≠ i := Ne.symm hij

  have hTi :
      T i =
        Z i j * reducedCubicComplementProduct Z i j := by
    rw [hE.1 i]
    exact incident_product_split_off_edge Z hij

  have hTj :
      T j =
        Z i j * reducedCubicComplementProduct Z j i := by
    rw [hE.1 j]
    calc
      (∏ r ∈ Finset.univ.erase j, Z j r) =
          Z j i * reducedCubicComplementProduct Z j i :=
        incident_product_split_off_edge Z hji
      _ = Z i j * reducedCubicComplementProduct Z j i := by
        rw [← hSector.1 i j hij]

  have hEndpoint :
      T j - T i = b i j * Z i j :=
    hE.2.1 i j hij

  rw [hTj, hTi] at hEndpoint

  have hNonzero : Z i j ≠ 0 :=
    hSector.2.1 i j hij

  unfold reducedCubicRowValue
  rcases lt_or_gt_of_ne hNonzero with hNegative | hPositive
  · nlinarith
  · nlinarith

/--
The reduced cubic state retains the unordered sector laws needed by the finite
comparison step and the ten reduced cubic equations themselves.
-/
def R_cub
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  Z_sector_laws
      (openingTSeq opening)
      (openingZSeq opening) ∧
    ∀ m : ℕ,
      reduced_cubic_rows_at
        (openingBSeq opening m)
        (openingZSeq opening m)

/-
