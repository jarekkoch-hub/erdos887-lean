    compatible_degree_two_branch
        (regularColoringChi data) cycle →
      prefixCycleCompatible
          (regularColoringChi data) cycle ∧
        prefix_cone_conflict_datum_at
          opening
          (projectiveConeModelFromCertificate certificateData)
          intervalData
          lowRankData
          (prefixCertificateX certificateData cycle)
          (prefixCertificateY certificateData cycle)
          (prefixCertificateZ certificateData cycle)
          (prefixCertificateConflictEdge certificateData cycle)
          (prefixCertificateLeftGap certificateData cycle)
          (prefixCertificateRightGap certificateData cycle)

/-- The branch-indexed family itself supplies the same-coloring, same-cycle record. -/
theorem build_prefix_conflict_same_branch_record_at
    {D : Type}
    {opening : CanonicalIntervalOverloadOpeningData}
    {data : RegularColoringProblemData}
    {certificateData : FinitePrefixCertificateSourceData D}
    {intervalData : PrefixIntervalSectorData}
    {lowRankData : RankTrichotomy.LowRankSourceData}
    (hFamilyAt :
      finite_prefix_conflict_family_at
        opening data certificateData intervalData lowRankData) :
    prefix_conflict_same_branch_record_at
      opening data certificateData intervalData lowRankData := by
  rcases hFamilyAt with
    ⟨_hRegular, _hBranchFamily, _hCertificate, _hModel,
      _hInterval, _hLowerClosed, hRows⟩
  intro cycle hBranch
  exact ⟨hBranch.1, hRows cycle hBranch⟩

/-- The classification alternative and the eliminated cycle family leave a monochrome survivor. -/
theorem selected_monochrome_survivor_of_classification
    (data : RegularColoringProblemData)
    (hAlternatives : regular_coloring_alternatives_at data)
    (hEliminated : degree_two_branches_eliminated_at data) :
    ∃ color : Bool,
      selected_post_prefix_monochrome_survivor data color := by
  rcases hAlternatives with hMonochrome | hCycle
  · exact hMonochrome
  · rcases hCycle with ⟨cycle, hBranch⟩
    exact (hEliminated cycle hBranch).elim

/--
The concrete data retained by one closed prefix survivor.  No custom structure
or record is introduced.
-/
abbrev ClosedPrefixSurvivorData (D : Type) :=
  RegularColoringProblemData ×
    (PrefixIntervalSectorData ×
      (RankTrichotomy.FrozenEndpointCoefficientPattern ×
        (FinitePrefixCertificateSourceData D ×
          (RankTrichotomy.LowRankSourceData × Bool))))

/-- The selected regular-coloring datum stored in the survivor. -/
def closedPrefixRegularData
    {D : Type}
    (data : ClosedPrefixSurvivorData D) :
    RegularColoringProblemData :=
  data.1

/-- The exact prefix interval-sector packet stored in the survivor. -/
def closedPrefixIntervalData
    {D : Type}
    (data : ClosedPrefixSurvivorData D) :
    PrefixIntervalSectorData :=
  data.2.1

/-- The exact frozen coefficient pattern stored in the survivor. -/
def closedPrefixFrozenPattern
    {D : Type}
    (data : ClosedPrefixSurvivorData D) :
    RankTrichotomy.FrozenEndpointCoefficientPattern :=
  data.2.2.1

/-- The exact finite certificate payload stored in the survivor. -/
def closedPrefixCertificateData
    {D : Type}
    (data : ClosedPrefixSurvivorData D) :
    FinitePrefixCertificateSourceData D :=
  data.2.2.2.1

/-- The exact low-rank source packet stored in the survivor. -/
def closedPrefixLowRankData
    {D : Type}
    (data : ClosedPrefixSurvivorData D) :
    RankTrichotomy.LowRankSourceData :=
  data.2.2.2.2.1

/-- The selected constant color of the post-prefix survivor. -/
def closedPrefixSelectedColor
    {D : Type}
    (data : ClosedPrefixSurvivorData D) : Bool :=
  data.2.2.2.2.2

/--
The nine paper components of one exact closed prefix survivor.

The source-coherence fields ensure that the selected coloring, frozen pattern,
interval packet, low-rank closure, and finite conflict family are all reads of
one canonical interval-overload state.  The same-branch record is retained
separately from the fact that all degree-two branches were eliminated.
-/
def K_components_at
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    {D : Type}
    (survivorData : ClosedPrefixSurvivorData D) : Prop :=
  regular_coloring_source_coherence
      C nSeq dSeq opening
      (closedPrefixRegularData survivorData) ∧
    regular_coloring_problem_at
      (closedPrefixRegularData survivorData) ∧
    regular_coloring_alternatives_at
      (closedPrefixRegularData survivorData) ∧
    prefix_interval_sector_source_coherence
      C nSeq dSeq opening
      (closedPrefixIntervalData survivorData) ∧
    prefix_interval_sector_data_at
      opening (closedPrefixIntervalData survivorData) ∧
    frozen_coefficient_source_coherence
      C nSeq dSeq opening
      (closedPrefixFrozenPattern survivorData) ∧
    frozen_coefficient_pattern_at
      opening (closedPrefixFrozenPattern survivorData) ∧
    prefixIntervalFrozenPattern
        (closedPrefixIntervalData survivorData) =
      closedPrefixFrozenPattern survivorData ∧
    finite_prefix_conflict_low_rank_coherence
      C nSeq dSeq opening
      (closedPrefixRegularData survivorData)
      (closedPrefixLowRankData survivorData) ∧
    RankTrichotomy.lowRankNoLowerEscapeFlag
        (closedPrefixLowRankData survivorData) = true ∧
    finite_prefix_conflict_family_at
      opening
      (closedPrefixRegularData survivorData)
      (closedPrefixCertificateData survivorData)
      (closedPrefixIntervalData survivorData)
      (closedPrefixLowRankData survivorData) ∧
    prefix_conflict_same_branch_record_at
      opening
      (closedPrefixRegularData survivorData)
      (closedPrefixCertificateData survivorData)
      (closedPrefixIntervalData survivorData)
      (closedPrefixLowRankData survivorData) ∧
    degree_two_branches_eliminated_at
      (closedPrefixRegularData survivorData) ∧
    selected_post_prefix_monochrome_survivor
      (closedPrefixRegularData survivorData)
      (closedPrefixSelectedColor survivorData)

/--
The Section 9.5 component state retains every declared input batch and one exact
survivor payload assembled through their common finite-family witness.
-/
def K_components
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  regular_coloring_problem C nSeq dSeq opening ∧
    regular_coloring_alternatives C nSeq dSeq opening ∧
    prefix_interval_sector_data C nSeq dSeq opening ∧
    frozen_coefficient_pattern C nSeq dSeq opening ∧
    RankTrichotomy.S_rank C nSeq dSeq opening ∧
    finite_prefix_conflict_family C nSeq dSeq opening ∧
    degree_two_branches_eliminated C nSeq dSeq opening ∧
    ∃ D : Type,
      ∃ survivorData : ClosedPrefixSurvivorData D,
        K_components_at C nSeq dSeq opening survivorData

/-
================================================================================
STATE-SHAPE BATCH
Section 9.5, Sub-layer 01, Sub-box 01

Incoming state shape:
  regular_coloring_problem C nSeq dSeq opening
  regular_coloring_alternatives C nSeq dSeq opening
  prefix_interval_sector_data C nSeq dSeq opening
  frozen_coefficient_pattern C nSeq dSeq opening
  RankTrichotomy.S_rank C nSeq dSeq opening
  finite_prefix_conflict_family C nSeq dSeq opening
  degree_two_branches_eliminated C nSeq dSeq opening

Outgoing state shape:
  K_components C nSeq dSeq opening

Effect:
  Opens the exact synchronized payload already carried by the finite conflict
  family, reads the classification source and elimination theorem on that same
  regular coloring datum, and retains the resulting selected monochrome color
  together with the exact interval, frozen-pattern, low-rank, certificate, and
  same-branch records.  No state is reselected and no affine route is opened.

Public theorem:
  build_K_components
================================================================================
-/

theorem build_K_components
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hRegular :
      regular_coloring_problem C nSeq dSeq opening)
    (hAlternatives :
      regular_coloring_alternatives C nSeq dSeq opening)
    (hInterval :
      prefix_interval_sector_data C nSeq dSeq opening)
    (hPattern :
      frozen_coefficient_pattern C nSeq dSeq opening)
    (hRank :
      RankTrichotomy.S_rank C nSeq dSeq opening)
    (hFamily :
      finite_prefix_conflict_family C nSeq dSeq opening)
    (hEliminated :
      degree_two_branches_eliminated C nSeq dSeq opening) :
    K_components C nSeq dSeq opening := by
  have hFamilyState :
      finite_prefix_conflict_family C nSeq dSeq opening :=
    hFamily
  have hEliminatedState :
      degree_two_branches_eliminated C nSeq dSeq opening :=
    hEliminated

  rcases hFamily with
    ⟨_hBranchFamilyState, _hCertificateState, _hConflictTypeState,
      data, hDataSource, D, certificateData, intervalData, lowRankData,
      hIntervalSource, hLowCoherence, hFamilyAt⟩

  have hFamilyAtState :
      finite_prefix_conflict_family_at
        opening data certificateData intervalData lowRankData :=
    hFamilyAt

  rcases hFamilyAt with
    ⟨hRegularAt, hBranchFamilyAt, _hCertificateAt, _hModelAt,
      hIntervalAt, hLowerClosed, _hRows⟩

  have hAlternativesForData := hAlternatives
  rcases hAlternativesForData with
    ⟨_hRegularFromAlternatives, _hFamilyFromAlternatives,
      hClassification⟩

  have hAlternativesAt :
      regular_coloring_alternatives_at data :=
    hClassification data hDataSource hRegularAt hBranchFamilyAt

  have hEliminatedForData := hEliminatedState
  rcases hEliminatedForData with
    ⟨_hFamilyFromElimination, _hImpossibleFromElimination,
      hElimination⟩

  have hEliminatedAt :
      degree_two_branches_eliminated_at data :=
    hElimination D data certificateData intervalData lowRankData
      hFamilyAtState

  rcases
      selected_monochrome_survivor_of_classification
        data hAlternativesAt hEliminatedAt with
    ⟨selectedColor, hSelectedColor⟩

  have hFrozenSource :
      frozen_coefficient_source_coherence
        C nSeq dSeq opening
        (prefixIntervalFrozenPattern intervalData) := by
    simpa [prefix_interval_sector_source_coherence] using hIntervalSource

  have hFrozenAt :
      frozen_coefficient_pattern_at
        opening (prefixIntervalFrozenPattern intervalData) :=
    hIntervalAt.1

  have hSameBranch :
      prefix_conflict_same_branch_record_at
        opening data certificateData intervalData lowRankData :=
    build_prefix_conflict_same_branch_record_at hFamilyAtState

  let survivorData : ClosedPrefixSurvivorData D :=
    (data,
      (intervalData,
        (prefixIntervalFrozenPattern intervalData,
          (certificateData, (lowRankData, selectedColor)))))

  have hComponentsAt :
      K_components_at C nSeq dSeq opening survivorData := by
    change
      regular_coloring_source_coherence C nSeq dSeq opening data ∧
        regular_coloring_problem_at data ∧
        regular_coloring_alternatives_at data ∧
        prefix_interval_sector_source_coherence
          C nSeq dSeq opening intervalData ∧
        prefix_interval_sector_data_at opening intervalData ∧
        frozen_coefficient_source_coherence
          C nSeq dSeq opening
          (prefixIntervalFrozenPattern intervalData) ∧
        frozen_coefficient_pattern_at
          opening (prefixIntervalFrozenPattern intervalData) ∧
        prefixIntervalFrozenPattern intervalData =
          prefixIntervalFrozenPattern intervalData ∧
        finite_prefix_conflict_low_rank_coherence
          C nSeq dSeq opening data lowRankData ∧
        RankTrichotomy.lowRankNoLowerEscapeFlag lowRankData = true ∧
        finite_prefix_conflict_family_at
          opening data certificateData intervalData lowRankData ∧
        prefix_conflict_same_branch_record_at
          opening data certificateData intervalData lowRankData ∧
        degree_two_branches_eliminated_at data ∧
        selected_post_prefix_monochrome_survivor data selectedColor
    exact
      ⟨hDataSource, hRegularAt, hAlternativesAt,
        hIntervalSource, hIntervalAt, hFrozenSource, hFrozenAt, rfl,
        hLowCoherence, hLowerClosed, hFamilyAtState, hSameBranch,
        hEliminatedAt, hSelectedColor⟩

  exact
    ⟨hRegular, hAlternatives, hInterval, hPattern, hRank,
      hFamilyState, hEliminatedState, D, survivorData, hComponentsAt⟩


