/-- The first active layer has positive weight at root scale. -/
def positiveRootScaleRegime (theta : ℝ) : Prop :=
  0 < theta

/-- The first active layer is invisible at root scale. -/
def zeroRootScaleRegime (theta : ℝ) : Prop :=
  theta = 0

/--
For a nonnegative root-scale weight, exactly one of the positive and zero
regimes holds.
-/
def scaleRegimeDichotomy (theta : ℝ) : Prop :=
  (positiveRootScaleRegime theta ∨ zeroRootScaleRegime theta) ∧
    ¬ (positiveRootScaleRegime theta ∧ zeroRootScaleRegime theta)

/-- The nonnegative real line splits exactly into the two scale regimes. -/
theorem derive_scaleRegimeDichotomy
    {theta : ℝ}
    (htheta : 0 ≤ theta) :
    scaleRegimeDichotomy theta := by
  constructor
  · rcases lt_or_eq_of_le htheta with hpos | hzero
    · exact Or.inl hpos
    · exact Or.inr hzero.symm
  · rintro ⟨hpos, hzero⟩
    have hpos' : 0 < theta := hpos
    have hzero' : theta = 0 := hzero
    exact (ne_of_gt hpos') hzero'

/-- A support-mass function has a nonzero legal support coordinate. -/
def supportMassNonzero
    (mu : SupportAddress → ℝ) : Prop :=
  ∃ S ∈ supportAddresses, mu S ≠ 0

/-- The root-scale shadow of a first-active support-mass function. -/
def firstActiveRootScaleShadow
    (theta : ℝ)
    (mu : SupportAddress → ℝ) : SupportAddress → ℝ :=
  fun S => theta * mu S

@[simp]
theorem firstActiveRootScaleShadow_apply
    (theta : ℝ)
    (mu : SupportAddress → ℝ)
    (S : SupportAddress) :
    firstActiveRootScaleShadow theta mu S = theta * mu S := by
  rfl

/-- At zero root-scale weight, the shadow is identically zero. -/
theorem firstActiveRootScaleShadow_zero
    (mu : SupportAddress → ℝ)
    (S : SupportAddress) :
    firstActiveRootScaleShadow 0 mu S = 0 := by
  simp [firstActiveRootScaleShadow]

/-- Nonnegativity is preserved when the first-active layer is scaled by theta. -/
theorem firstActiveRootScaleShadow_nonnegative
    {theta : ℝ}
    {mu : SupportAddress → ℝ}
    (htheta : 0 ≤ theta)
    (hmu : supportMassNonnegative mu) :
    supportMassNonnegative
      (firstActiveRootScaleShadow theta mu) := by
  intro S hS
  unfold firstActiveRootScaleShadow
  exact mul_nonneg htheta (hmu S hS)

/-- Corridor support is preserved by passage to the root-scale shadow. -/
theorem firstActiveRootScaleShadow_supported
    {o : ℕ}
    {theta : ℝ}
    {mu : SupportAddress → ℝ}
    (hsupported : offProfileMassSupported o mu) :
    offProfileMassSupported o
      (firstActiveRootScaleShadow theta mu) := by
  intro S hS hcorridor
  unfold firstActiveRootScaleShadow
  rw [hsupported S hS hcorridor, mul_zero]

/-- A positive scale preserves nontriviality of the first-active layer. -/
theorem firstActiveRootScaleShadow_nonzero_of_positive
    {theta : ℝ}
    {mu : SupportAddress → ℝ}
    (htheta : positiveRootScaleRegime theta)
    (hmu : supportMassNonzero mu) :
    supportMassNonzero
      (firstActiveRootScaleShadow theta mu) := by
  rcases hmu with ⟨S, hS, hne⟩
  refine ⟨S, hS, ?_⟩
  unfold firstActiveRootScaleShadow
  exact mul_ne_zero (ne_of_gt htheta) hne

/-- Every `FirstOff_vec` packet carries a nonzero support-mass function. -/
theorem FirstOff_vec_mass_nonzero
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {o : ℕ}
    {mu : SupportAddress → ℝ}
    (hfirst : FirstOff_vec nSeq dSeq o mu) :
    supportMassNonzero mu := by
  rcases hfirst.2.2.2.2.2.2.2 with ⟨S, hSoff, hpos⟩
  have hS : S ∈ supportAddresses :=
    (Finset.mem_filter.mp hSoff).1
  exact ⟨S, hS, ne_of_gt hpos⟩

/--
The finite first-active support shape retained from `FirstOff_vec`.  This is
not the complete transition classification and not a face-entry certificate.
-/
def firstActiveSupportShape
    (o : ℕ)
    (mu : SupportAddress → ℝ) : Prop :=
  offProfileOrientation o ∧
    supportMassNonnegative mu ∧
    offProfileMassSupported o mu

/-- `FirstOff_vec` supplies its orientation and finite support shape. -/
theorem FirstOff_vec_supportShape
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {o : ℕ}
    {mu : SupportAddress → ℝ}
    (hfirst : FirstOff_vec nSeq dSeq o mu) :
    firstActiveSupportShape o mu := by
  exact
    ⟨hfirst.2.2.2.1,
      hfirst.2.2.2.2.1,
      hfirst.2.2.2.2.2.1⟩

/--
Root-scale ledgers may be consulted only in the positive-scale regime and only
together with the retained first-active support shape.  The complete transition
classification is not born in this box.
-/
def rootScaleLedgerUseGuard
    (o : ℕ)
    (theta : ℝ)
    (mu : SupportAddress → ℝ) : Prop :=
  positiveRootScaleRegime theta ∧
    firstActiveSupportShape o mu

/--
The sub-root branch permits only exact support-address, prime-chain, and
directed-quotient diagnostics carried by later inputs.
-/
def subRootExactDiagnosticsGuard
    (o : ℕ)
    (theta : ℝ)
    (mu : SupportAddress → ℝ) : Prop :=
  zeroRootScaleRegime theta ∧
    firstActiveSupportShape o mu

/-- Permissions available only when the first-active layer is visible at root scale. -/
def positiveScalePermissions
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (o : ℕ)
    (mu : SupportAddress → ℝ)
    (theta : ℝ) : Prop :=
  rootScaleLedgerUseGuard o theta mu ∧
    normalized_support_ledgers C nSeq dSeq ∧
    (∀ m : ℕ, Load_can (nSeq m) (dSeq m)) ∧
    supportMassNonzero
      (firstActiveRootScaleShadow theta mu)

/--
Permissions available in the zero-scale branch.  Only exact atom products,
prime-chain nesting through `Load_can`, and exact directed quotients through
`Edge_can` remain available; no normalized root ledger occurs in this type.
-/
def zeroScalePermissions
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (o : ℕ)
    (mu : SupportAddress → ℝ)
    (theta : ℝ) : Prop :=
  subRootExactDiagnosticsGuard o theta mu ∧
    (∀ m : ℕ,
      exact_finite_support_ledgers (nSeq m) (dSeq m)) ∧
    (∀ m : ℕ, Edge_can (nSeq m) (dSeq m)) ∧
    (∀ m : ℕ, Load_can (nSeq m) (dSeq m)) ∧
    ∀ S ∈ supportAddresses,
      firstActiveRootScaleShadow theta mu S = 0

/--
The retained scale-firewall packet.  The same first-active sequence, orientation,
and mass are carried through both branches.  The disjunction is exhaustive and
exclusive because `theta` is nonnegative.
-/
def scale_discipline
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (o : ℕ)
    (mu : SupportAddress → ℝ)
    (theta : ℝ) : Prop :=
  FirstOff_vec nSeq dSeq o mu ∧
    0 ≤ theta ∧
    scaleRegimeDichotomy theta ∧
    supportMassNonnegative
      (firstActiveRootScaleShadow theta mu) ∧
    offProfileMassSupported o
      (firstActiveRootScaleShadow theta mu) ∧
    (positiveScalePermissions C nSeq dSeq o mu theta ∨
      zeroScalePermissions nSeq dSeq o mu theta)

/--
Build the scale firewall in the positive regime.  Normalized root-scale
ledgers enter only after `0 < theta` has been selected.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.8, Sub-sub-layer 01, Sub-sub-box 01

Incoming state shape:
  FirstOff_vec nSeq dSeq o mu
  0 < theta
  normalized_support_ledgers C nSeq dSeq
  Load_can on the same sequence

Outgoing state shape:
  scale_discipline C nSeq dSeq o mu theta

Effect:
  Constructs only the positive root-scale permission channel.  The zero-scale
  constructor below has a disjoint exact-data input cone.

Semantic kind:
  branch-specific permission refinement.

Public theorem:
  build_scale_discipline_positive

================================================================================
-/

theorem build_scale_discipline_positive
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {o : ℕ}
    {mu : SupportAddress → ℝ}
    {theta : ℝ}
    (hFirst : FirstOff_vec nSeq dSeq o mu)
    (hTheta : 0 < theta)
    (hNormalized : normalized_support_ledgers C nSeq dSeq)
    (hLoad : ∀ m : ℕ, Load_can (nSeq m) (dSeq m)) :
    scale_discipline C nSeq dSeq o mu theta := by
  have htheta : 0 ≤ theta := le_of_lt hTheta
  have hregime : scaleRegimeDichotomy theta :=
    derive_scaleRegimeDichotomy htheta
  have hshape :
      firstActiveSupportShape o mu :=
    FirstOff_vec_supportShape hFirst
  have hnonneg : supportMassNonnegative mu :=
    hFirst.2.2.2.2.1
  have hsupported : offProfileMassSupported o mu :=
    hFirst.2.2.2.2.2.1
  have hshadow_nonnegative :
      supportMassNonnegative
        (firstActiveRootScaleShadow theta mu) :=
    firstActiveRootScaleShadow_nonnegative htheta hnonneg
  have hshadow_supported :
      offProfileMassSupported o
        (firstActiveRootScaleShadow theta mu) :=
    firstActiveRootScaleShadow_supported hsupported

  refine
    ⟨hFirst, htheta, hregime, hshadow_nonnegative,
      hshadow_supported, Or.inl ?_⟩
  exact
    ⟨⟨hTheta, hshape⟩, hNormalized, hLoad,
      firstActiveRootScaleShadow_nonzero_of_positive
        hTheta (FirstOff_vec_mass_nonzero hFirst)⟩

/--
Build the scale firewall in the zero regime.  No normalized root-scale ledger
is accepted by this constructor.
-/
theorem build_scale_discipline_zero
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {o : ℕ}
    {mu : SupportAddress → ℝ}
    {theta : ℝ}
    (hFirst : FirstOff_vec nSeq dSeq o mu)
    (hTheta : theta = 0)
    (hExact : ∀ m : ℕ,
      exact_finite_support_ledgers (nSeq m) (dSeq m))
    (hEdge : ∀ m : ℕ, Edge_can (nSeq m) (dSeq m))
    (hLoad : ∀ m : ℕ, Load_can (nSeq m) (dSeq m)) :
    scale_discipline C nSeq dSeq o mu theta := by
  have htheta : 0 ≤ theta := by rw [hTheta]
  have hregime : scaleRegimeDichotomy theta :=
    derive_scaleRegimeDichotomy htheta
  have hshape : firstActiveSupportShape o mu :=
    FirstOff_vec_supportShape hFirst
  have hshadow_nonnegative :
      supportMassNonnegative
        (firstActiveRootScaleShadow theta mu) :=
    firstActiveRootScaleShadow_nonnegative
      htheta hFirst.2.2.2.2.1
  have hshadow_supported :
      offProfileMassSupported o
        (firstActiveRootScaleShadow theta mu) :=
    firstActiveRootScaleShadow_supported
      hFirst.2.2.2.2.2.1
  refine
    ⟨hFirst, htheta, hregime, hshadow_nonnegative,
      hshadow_supported, Or.inr ?_⟩
  refine ⟨⟨hTheta, hshape⟩, hExact, hEdge, hLoad, ?_⟩
  intro S _hS
  unfold firstActiveRootScaleShadow
  rw [hTheta, zero_mul]

/-- The output packet exposes exactly the two guarded scale channels. -/
theorem scale_discipline_regime_cases
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {o : ℕ}
    {mu : SupportAddress → ℝ}
    {theta : ℝ}
    (hscale : scale_discipline C nSeq dSeq o mu theta) :
    positiveScalePermissions C nSeq dSeq o mu theta ∨
      zeroScalePermissions nSeq dSeq o mu theta :=
  hscale.2.2.2.2.2

/- # Sub-sub-container 3.4.9: Canonical face entry. -/

/- Sub-sub-layer 01 -/
/-
Paper ref: 3.4.9
Sub-sub-box Label: `Canonical face-entry certificate: finite support-address check into one of the two low-lcm corridors`
Sub-sub-inputs: `scale_discipline`, `FirstOff_vec`, `VecBal`, `VecBal_4`, `two_canonical_clipped_faces`, `bounded_full_K5_branch`, `Load_can`
Sub-sub-outputs: `FaceEntry_K5`
-/
def section_3_4_9_sub_sub_layer_01_sub_sub_box_01_label : String := "Canonical face-entry certificate: finite support-address check into one of the two low-lcm corridors"
def section_3_4_9_sub_sub_layer_01_sub_sub_box_01_inputs : List String := ["scale_discipline [construction]", "FirstOff_vec [construction]", "VecBal [construction]", "VecBal_4 [construction]", "two_canonical_clipped_faces [construction]", "bounded_full_K5_branch [permission]", "Load_can [read]"]
def section_3_4_9_sub_sub_layer_01_sub_sub_box_01_outputs : List String := ["FaceEntry_K5 [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.9, Sub-sub-layer 01, Sub-sub-box 01
Birth token: FaceEntry_K5

This box proves the exact finite scaffolding used by the paper's canonical
face-entry check:

  * the six support-cardinality orbit roles;
  * the directed edge set loaded by one support address;
  * the corridor trace of a support address;
  * nonincreasing cardinality along every retained prime-height chain.

The remaining finite integer-lift transition classification is represented by
the explicit proposition `canonicalFaceEntryClassification`.  A proof of that
proposition is the theorem-source kernel of this box.  It says that hypothetical
unbounded off-face pressure is routed to directed collapse, active gap escape,
a lower-dimensional exit, or absorption by one canonical corridor.

Crucially, `FaceEntry_K5` is not itself contradictory.  It is an implication
certificate consumed by the clipping box.  No `False.elim`, parent route
activation, new witness sequence, new orientation, or later sector data is used
in its construction.
================================================================================
-/

/-- An address lies outside both canonical support corridors. -/
def offBothCanonicalCorridors
    (S : SupportAddress) : Prop :=
  offThreeFaceAddress S ∧ offTwoFaceAddress S

/--
The exact six-row support-orbit table from the paper.  Each implication records
the role of one cardinality orbit in the two canonical corridors.
-/
def canonicalSupportOrbitTable : Prop :=
  ∀ S : SupportAddress,
    (S.card = 0 → threeFaceAddress S) ∧
    (S.card = 1 → offBothCanonicalCorridors S) ∧
    (S.card = 2 → twoFaceAddress S) ∧
    (S.card = 3 → threeFaceAddress S) ∧
    (S.card = 4 → offBothCanonicalCorridors S) ∧
    (S.card = 5 → twoFaceAddress S)

/-- The existing corridor definitions give the exact six-row orbit table. -/
theorem derive_canonicalSupportOrbitTable :
    canonicalSupportOrbitTable := by
  intro S
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro hcard
    exact Or.inl hcard
  · intro hcard
    simp [offBothCanonicalCorridors, offThreeFaceAddress,
      offTwoFaceAddress, threeFaceAddress, twoFaceAddress, hcard]
  · intro hcard
    exact Or.inl hcard
  · intro hcard
    exact Or.inr hcard
  · intro hcard
    simp [offBothCanonicalCorridors, offThreeFaceAddress,
      offTwoFaceAddress, threeFaceAddress, twoFaceAddress, hcard]
  · intro hcard
    exact Or.inr hcard

/-- The directed edge set loaded by one exact support address. -/
noncomputable def loadedDirectedEdges
    (S : SupportAddress) : Finset (Fin 5 × Fin 5) := by
  classical
  exact Finset.univ.filter fun e =>
    directedEdgeAddress e.1 e.2 S

@[simp]
theorem mem_loadedDirectedEdges
    {S : SupportAddress} {i j : Fin 5} :
    (i, j) ∈ loadedDirectedEdges S ↔
      i ∈ S ∧ j ∉ S := by
  simp [loadedDirectedEdges, directedEdgeAddress]

/--
The paper's corridor trace.  `some 3` and `some 2` are the two canonical
corridors; `none` is an address outside both.
-/
def supportCorridorTrace
    (S : SupportAddress) : Option ℕ :=
  if threeFaceAddress S then some 3
  else if twoFaceAddress S then some 2
  else none

/-- Every support address receives one of the three corridor-trace values. -/
theorem supportCorridorTrace_cases
    (S : SupportAddress) :
    supportCorridorTrace S = some 3 ∨
      supportCorridorTrace S = some 2 ∨
      supportCorridorTrace S = none := by
  by_cases hthree : threeFaceAddress S
  · exact Or.inl (by simp [supportCorridorTrace, hthree])
  · by_cases htwo : twoFaceAddress S
    · exact Or.inr (Or.inl (by
        simp [supportCorridorTrace, hthree, htwo]))
    · exact Or.inr (Or.inr (by
        simp [supportCorridorTrace, hthree, htwo]))

/-- Cardinality trace of one exact prime-height support chain. -/
noncomputable def primeChainCardinalityTrace
    (d : Fin 5 → ℕ) (p ell : ℕ) : ℕ :=
  (primeTokenAddress d p ell).card

/-- Corridor trace of one exact prime-height support-chain level. -/
noncomputable def primeChainCorridorTrace
    (d : Fin 5 → ℕ) (p ell : ℕ) : Option ℕ :=
  supportCorridorTrace (primeTokenAddress d p ell)

/-- Every retained prime-height chain has nonincreasing support cardinality. -/
def primeChainCardinalityNonincreasing
    (d : Fin 5 → ℕ) : Prop :=
  ∀ p ell₁ ell₂ : ℕ, ell₁ ≤ ell₂ →
    primeChainCardinalityTrace d p ell₂ ≤
      primeChainCardinalityTrace d p ell₁

/-- `Load_can` retains the nested support chains required by face entry. -/
theorem primeChainCardinalityNonincreasing_of_Load_can
    {n : ℕ} {d : Fin 5 → ℕ}
    (hload : Load_can n d) :
    primeChainCardinalityNonincreasing d := by
  rcases hload with ⟨hedge, _hfactorization, _hexclusive⟩
  rcases hedge.1 with
    ⟨_hatomPos, _hemptyPos, _hupper, _hlower, _hglobal, hchain⟩
  intro p ell₁ ell₂ hell
  unfold primeChainCardinalityTrace primeTokenAddress
  exact Finset.card_le_card (hchain p ell₁ ell₂ hell)

/-- Exact unboundedness of the natural off-face pressure sequence. -/
def offFacePressureSequenceUnbounded
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  ∀ B : ℕ, ∃ m : ℕ,
    B < offFacePressureNat (nSeq m) (dSeq m)

/-- One orientation-specific exact off-face product is uniformly bounded. -/
def orientationOffFaceProductSequenceBounded
    (o : ℕ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  ∃ B : ℕ, ∀ m : ℕ,
    orientationOffFaceProduct o (nSeq m) (dSeq m) ≤ B

/--
Canonical corridor absorption means that one of the two exact orientation
products has become uniformly bounded.
-/
def canonicalCorridorAbsorption
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  orientationOffFaceProductSequenceBounded 3 nSeq dSeq ∨
    orientationOffFaceProductSequenceBounded 2 nSeq dSeq

/--
Unbounded minimum pressure is incompatible with a uniform bound on either
canonical orientation product.
-/
theorem offFacePressureSequenceUnbounded_not_absorbed
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hunbounded :
      offFacePressureSequenceUnbounded nSeq dSeq) :
    ¬ canonicalCorridorAbsorption nSeq dSeq := by
  intro habsorb
  rcases habsorb with hthree | htwo
  · rcases hthree with ⟨B, hB⟩
    rcases hunbounded B with ⟨m, hm⟩
    have hpressure_le :
        offFacePressureNat (nSeq m) (dSeq m) ≤ B := by
      calc
        offFacePressureNat (nSeq m) (dSeq m)
            ≤ orientationOffFaceProduct 3
                (nSeq m) (dSeq m) := by
              rw [offFacePressureNat_eq_orientation_min]
              exact Nat.min_le_left _ _
        _ ≤ B := hB m
    exact (Nat.not_lt_of_ge hpressure_le) hm
  · rcases htwo with ⟨B, hB⟩
    rcases hunbounded B with ⟨m, hm⟩
    have hpressure_le :
        offFacePressureNat (nSeq m) (dSeq m) ≤ B := by
      calc
        offFacePressureNat (nSeq m) (dSeq m)
            ≤ orientationOffFaceProduct 2
                (nSeq m) (dSeq m) := by
              rw [offFacePressureNat_eq_orientation_min]
              exact Nat.min_le_right _ _
        _ ≤ B := hB m
    exact (Nat.not_lt_of_ge hpressure_le) hm

/--
The exact logarithmic normalization used by the paper's first active
off-profile layer:

  A_m = log C_o(W_m).

This is not a freely supplied scale.
-/
noncomputable def offProfileLogNormalizationAt
    (o n : ℕ)
    (d : Fin 5 → ℕ) : ℝ :=
  Real.log (orientationOffFaceProduct o n d : ℝ)

/-- The exact normalized atom coordinate `log X_S(W_m) / A_m`. -/
noncomputable def normalizedAtomWeightAt
    (n : ℕ)
    (d : Fin 5 → ℕ)
    (A : ℝ)
    (S : SupportAddress) : ℝ :=
  Real.log (atomBucket n d S : ℝ) / A

/--
The first-active layer extended by zero on the selected canonical corridor.
Every limiting coordinate and every cut expression below is formed from this
same residualized weight.
-/
noncomputable def normalizedFirstActiveWeightAt
    (o n : ℕ)
    (d : Fin 5 → ℕ)
    (A : ℝ)
    (S : SupportAddress) : ℝ :=
  if offProfileAddress o S then
    normalizedAtomWeightAt n d A S
  else
    0

/-- The paper's root-scale denominator `log sqrt n`. -/
noncomputable def rootScaleLogAt
    (n : ℕ) : ℝ :=
  Real.log (Real.sqrt (n : ℝ))

/-- The exact root-scale ratio whose subsequential limit is `theta`. -/
noncomputable def offProfileRootScaleRatioAt
    (A : ℝ)
    (n : ℕ) : ℝ :=
  A / rootScaleLogAt n

/--
The normalized opposite-cut difference before taking the limit.  Its limit
zero is the analytic origin of `directedCutBalance`; the latter is not admitted
as an unrelated finite equality.
-/
noncomputable def normalizedOppositeCutDifferenceAt
    (n : ℕ)
    (d : Fin 5 → ℕ)
    (A : ℝ)
    (i j : Fin 5) : ℝ := by
  classical
  exact
    (∑ S ∈ supportAddresses.filter (directedEdgeAddress i j),
      normalizedAtomWeightAt n d A S) -
    (∑ S ∈ supportAddresses.filter (directedEdgeAddress j i),
      normalizedAtomWeightAt n d A S)

/--
Nonproduction diagnostic for the opposite-cut difference of the residualized
first-active layer.  Raw compactness does not assert convergence of this
expression; endpoint balance belongs to the named clipping consequence owner.
-/
noncomputable def normalizedFirstActiveOppositeCutDifferenceAt
    (o n : ℕ)
    (d : Fin 5 → ℕ)
    (A : ℝ)
    (i j : Fin 5) : ℝ := by
  classical
  exact
    (∑ S ∈ supportAddresses.filter (directedEdgeAddress i j),
      normalizedFirstActiveWeightAt o n d A S) -
    (∑ S ∈ supportAddresses.filter (directedEdgeAddress j i),
      normalizedFirstActiveWeightAt o n d A S)

/--
The raw analytic subsequence produced by the first-active-layer compactness
argument.  The first-active layer is already zero-extended on the corridor,
and its limits are recorded at every finite support address.  Finite
consequences are deliberately absent.

Semantic kind: asymptotic diagnostic production.
-/
def boundedBranchAnalyticLimitRawState
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (nSub : ℕ → ℕ)
    (dSub : ℕ → Fin 5 → ℕ)
    (o : ℕ)
    (mu : SupportAddress → ℝ)
    (theta : ℝ) : Prop :=
  external_violation_sequence_state C nSeq dSeq ∧
  ∃ phi : ℕ → ℕ,
    ∃ normalizationSeq : ℕ → ℝ,
      ∃ scaleRatioSeq : ℕ → ℝ,
        StrictMono phi ∧
          (∀ m : ℕ, nSub m = nSeq (phi m)) ∧
          (∀ m : ℕ, dSub m = dSeq (phi m)) ∧
          external_violation_sequence_state C nSub dSub ∧
          bounded_full_K5_branch C nSub dSub ∧
          offFacePressureSequenceUnbounded nSub dSub ∧
          offProfileOrientation o ∧
          (∀ m : ℕ,
            normalizationSeq m =
              offProfileLogNormalizationAt o (nSub m) (dSub m)) ∧
          Filter.Tendsto
            normalizationSeq Filter.atTop Filter.atTop ∧
          (∀ᶠ m : ℕ in Filter.atTop, 0 < normalizationSeq m) ∧
          (∀ S ∈ supportAddresses,
              Filter.Tendsto
              (fun m : ℕ =>
                normalizedFirstActiveWeightAt
                  o (nSub m) (dSub m) (normalizationSeq m) S)
              Filter.atTop
              (nhds (mu S))) ∧
          (∀ S ∈ supportAddresses,
            canonicalSupportCorridor o S → mu S = 0) ∧
          (∀ᶠ m : ℕ in Filter.atTop,
            (∑ S ∈ offProfileAddresses o,
              normalizedFirstActiveWeightAt
                o (nSub m) (dSub m) (normalizationSeq m) S) = 1) ∧
          (∀ m : ℕ,
            scaleRatioSeq m =
              offProfileRootScaleRatioAt
                (normalizationSeq m) (nSub m)) ∧
          Filter.Tendsto
            scaleRatioSeq Filter.atTop (nhds theta) ∧
          natSequenceTendsToInfinity nSub

/--
Finite consequences of one raw analytic packet.  These are theorem outputs,
not additional inputs to the raw compactness state.
-/
def boundedBranchAnalyticLimitConsequences
    (o : ℕ)
    (mu : SupportAddress → ℝ)
    (theta : ℝ) : Prop :=
  supportMassNonnegative mu ∧
    directedCutBalance mu ∧
    offProfileMassSupported o mu ∧
    offProfileMassNormalized o mu ∧
    (∃ S ∈ offProfileAddresses o, 0 < mu S) ∧
    0 ≤ theta

/--
The named mathematical owner that derives every finite limit consequence from
the raw packet.  The paper assigns endpoint-load balance at the first-active
normalization to the clipping theorem-source component.  It is not stored as
raw compactness data and it is not reconstructed later from the internal
obstruction.
-/
def derive_boundedBranchAnalyticLimitConsequences : Prop :=
  ∀ {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {nSub : ℕ → ℕ}
    {dSub : ℕ → Fin 5 → ℕ}
    {o : ℕ}
    {mu : SupportAddress → ℝ}
    {theta : ℝ},
    boundedBranchAnalyticLimitRawState
        C nSeq dSeq nSub dSub o mu theta →
      boundedBranchAnalyticLimitConsequences o mu theta

/-- The combined packet exists only after the consequence theorem is applied. -/
def boundedBranchAnalyticLimitState
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (nSub : ℕ → ℕ)
    (dSub : ℕ → Fin 5 → ℕ)
    (o : ℕ)
    (mu : SupportAddress → ℝ)
    (theta : ℝ) : Prop :=
  boundedBranchAnalyticLimitRawState
      C nSeq dSeq nSub dSub o mu theta ∧
    boundedBranchAnalyticLimitConsequences o mu theta

/-- Assemble the combined packet without accepting consequences independently. -/
theorem build_boundedBranchAnalyticLimitState
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {nSub : ℕ → ℕ}
    {dSub : ℕ → Fin 5 → ℕ}
    {o : ℕ}
    {mu : SupportAddress → ℝ}
    {theta : ℝ}
    (hRaw :
      boundedBranchAnalyticLimitRawState
        C nSeq dSeq nSub dSub o mu theta)
    (hDerive : derive_boundedBranchAnalyticLimitConsequences) :
    boundedBranchAnalyticLimitState
      C nSeq dSeq nSub dSub o mu theta :=
  ⟨hRaw, hDerive hRaw⟩

/--
One exact prime-height token selected from the loaded quotient system.  Prime
validity, legal height, `Load_can`, nonempty support, and a genuinely loaded
directed edge are all checked at the same witness index.
-/
def selectedLoadedPrimeChainTokenAt
    (n : ℕ)
    (d : Fin 5 → ℕ)
    (p ell : ℕ) : Prop :=
  Nat.Prime p ∧
    ell ∈ primeTokenLevels n p ∧
    Load_can n d ∧
    (primeTokenAddress d p ell).Nonempty ∧
    ∃ i j : Fin 5,
      i ≠ j ∧
        directedEdgeAddress i j (primeTokenAddress d p ell) ∧
        0 < (directedQuotient n d i j).factorization p

/--
The selected token is the positive first-active off-both orbit used by the
six-orbit transition classification, not an arbitrary token elsewhere in the
atomization.
-/
def activeOffBothOrbitTransitionTokenAt
    (o : ℕ)
    (mu : SupportAddress → ℝ)
    (d : Fin 5 → ℕ)
    (p ell : ℕ) : Prop :=
  let S := primeTokenAddress d p ell
  offProfileAddress o S ∧
    offBothCanonicalCorridors S ∧
    0 < mu S ∧
    supportCorridorTrace S = none

/-- The exact persistent deletion alternative in the projected trace. -/
def permanentVertexOmissionAlongPrimeChain
    (dSeq : ℕ → Fin 5 → ℕ)
    (pSeq ellSeq : ℕ → ℕ)
    (omitted : Fin 5) : Prop :=
  (∀ m : ℕ,
      omitted ∉
        primeTokenAddress (dSeq m) (pSeq m) (ellSeq m)) ∨
    (∀ m : ℕ,
      omitted ∈
        primeTokenAddress (dSeq m) (pSeq m) (ellSeq m))

/--
A positive projected prime-chain trace that has become lower-dimensional.

The displayed sequence is the exact analytic subsequence from one
`boundedBranchAnalyticLimitState`.  At every index the selected `(p,ell)` is a
legal prime-height level in `Load_can`, loads a directed edge, belongs to the
positive first-active off-both orbit, and belongs to the legal nested chain of
its own prime base at that index.  Since `pSeq` may vary, no fixed prime base is
asserted without an additional stabilization theorem.  The fixed omitted vertex
is therefore a conclusion about the mathematically active projected trace
rather than an arbitrary atom token.
-/
def projectedPrimeChainVertexOmissionState
    (C : ℝ)
    (nParent : ℕ → ℕ)
    (dParent : ℕ → Fin 5 → ℕ)
    (nSub : ℕ → ℕ)
    (dSub : ℕ → Fin 5 → ℕ)
    (o : ℕ)
    (mu : SupportAddress → ℝ)
    (theta : ℝ) : Prop :=
  boundedBranchAnalyticLimitState
      C nParent dParent nSub dSub o mu theta ∧
    canonicalSupportOrbitTable ∧
    ∃ phiOmit : ℕ → ℕ,
      ∃ nOmit : ℕ → ℕ,
