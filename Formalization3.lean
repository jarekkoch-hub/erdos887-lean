/-
================================================================================
THEOREM-SOURCE PAYLOAD COMPARTMENT
Section 10 same-K affine and endpoint-polynomial sources

The affine source is universal over the exact survivor payload already opened
from K.  The endpoint-polynomial source is universal over that exact survivor
and the exact affine datum selected by the affine source.  Neither source may
choose its own hidden K witness.
================================================================================
-/

/-- The four rational affine slopes kappa_i on the adjacent-gap addresses. -/
abbrev AffineAdjacentSlopeFamily :=
  Section6.AdjacentGapAddress → ℚ

/-- The four rational affine offsets s_i on the adjacent-gap addresses. -/
abbrev AffineAdjacentOffsetFamily :=
  Section6.AdjacentGapAddress → ℚ

/--
One affine-pencil source datum indexed by an explicit closed-prefix survivor.
The only source-selected fields are the adjacent slopes and offsets.  The
frozen coefficient pattern is read from the survivor index and is not stored as
a second independently selected function.
-/
abbrev SameKAffinePencilData (D : Type) :=
  PrefixConflict.ClosedPrefixSurvivorData D ×
    (AffineAdjacentSlopeFamily × AffineAdjacentOffsetFamily)

/-- The exact closed-prefix survivor index carried by an affine-pencil datum. -/
def sameKAffineSurvivorData
    {D : Type}
    (data : SameKAffinePencilData D) :
    PrefixConflict.ClosedPrefixSurvivorData D :=
  data.1

/-- The adjacent affine slope projection. -/
def sameKAffineKappa
    {D : Type}
    (data : SameKAffinePencilData D) :
    AffineAdjacentSlopeFamily :=
  data.2.1

/-- The adjacent affine offset projection. -/
def sameKAffineOffset
    {D : Type}
    (data : SameKAffinePencilData D) :
    AffineAdjacentOffsetFamily :=
  data.2.2

/-- The affine adjacent-gap read g_i(T) = kappa_i T + s_i. -/
def sameKAffineGap
    {D : Type}
    (data : SameKAffinePencilData D)
    (T : ℚ)
    (k : Section6.AdjacentGapAddress) : ℚ :=
  sameKAffineKappa data k * T + sameKAffineOffset data k

/-- The fixed adjacent-gap address set lying in one K5 edge interval. -/
def sameKEdgeGapSet
    (e : Section6.K5EdgeAddress) :
    Finset Section6.AdjacentGapAddress :=
  Finset.univ.filter fun k =>
    (Section6.k5EdgeBoundary e).1.val ≤ k.val ∧
      k.val < (Section6.k5EdgeBoundary e).2.val

/-- The edge-interval affine slope H_e. -/
def sameKAffineEdgeIntervalSlope
    {D : Type}
    (data : SameKAffinePencilData D)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (sameKEdgeGapSet e).sum fun k => sameKAffineKappa data k

/-- The edge-interval affine offset S_e. -/
def sameKAffineEdgeIntervalOffset
    {D : Type}
    (data : SameKAffinePencilData D)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (sameKEdgeGapSet e).sum fun k => sameKAffineOffset data k

/-- The affine edge-interval read I_e(T) = H_e T + S_e. -/
def sameKAffineEdgeInterval
    {D : Type}
    (data : SameKAffinePencilData D)
    (T : ℚ)
    (e : Section6.K5EdgeAddress) : ℚ :=
  sameKAffineEdgeIntervalSlope data e * T +
    sameKAffineEdgeIntervalOffset data e

/-- The sum of the affine adjacent gaps across the fixed edge interval. -/
def sameKAffineGapIntervalSum
    {D : Type}
    (data : SameKAffinePencilData D)
    (T : ℚ)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (sameKEdgeGapSet e).sum fun k => sameKAffineGap data T k

/-- The frozen coefficient b_e read from the exact survivor index. -/
def sameKAffineFrozenCoefficient
    {D : Type}
    (data : SameKAffinePencilData D)
    (e : Section6.K5EdgeAddress) : ℚ :=
  PrefixConflict.closedPrefixFrozenPattern
    (sameKAffineSurvivorData data) e

/-- The normalized affine-sector slope alpha_e = H_e / b_e. -/
def sameKAffineAlpha
    {D : Type}
    (data : SameKAffinePencilData D)
    (e : Section6.K5EdgeAddress) : ℚ :=
  sameKAffineEdgeIntervalSlope data e /
    sameKAffineFrozenCoefficient data e

/-- The normalized affine-sector offset beta_e = S_e / b_e. -/
def sameKAffineBeta
    {D : Type}
    (data : SameKAffinePencilData D)
    (e : Section6.K5EdgeAddress) : ℚ :=
  sameKAffineEdgeIntervalOffset data e /
    sameKAffineFrozenCoefficient data e

/-- The normalized affine sector A_e(T) = alpha_e T + beta_e. -/
def sameKAffineSectorRead
    {D : Type}
    (data : SameKAffinePencilData D)
    (T : ℚ)
    (e : Section6.K5EdgeAddress) : ℚ :=
  sameKAffineAlpha data e * T + sameKAffineBeta data e

/--
The affine datum is over the fixed survivor exactly when its explicit index is
that survivor.  This uses the indexing predicate born in Section 9.6 without
consuming the Section 9.6 synchronization theorem as a direct input.
-/
def same_K_affine_pencil_data_at
    {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKAffinePencilData D) : Prop :=
  PrefixConflict.affine_route_object_over_K_at
    survivorData sameKAffineSurvivorData affineData

/--
The retained same-K affine-pencil source port.  It is applied to the exact
survivor payload opened from K and supplies one affine datum over that payload.
No affine datum is constructed from K inside Section 10.
-/
def same_K_affine_pencil_source
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∀ {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D),
    PrefixConflict.K_components_at
        C nSeq dSeq opening survivorData →
      ∃ affineData : SameKAffinePencilData D,
        same_K_affine_pencil_data_at survivorData affineData

/-- The endpoint-polynomial family indexed by the fixed K5 edge addresses. -/
abbrev EndpointPolynomialFamily :=
  Section6.K5EdgeAddress → Polynomial ℚ

/--
The retained endpoint-polynomial source datum.  It stores its exact survivor
and affine indices together with the valid parameter set and polynomial family.
The explicit indices prevent a later source read from changing either K or the
pencil.
-/
abbrev EndpointPolynomialSourceData (D : Type) :=
  PrefixConflict.ClosedPrefixSurvivorData D ×
    (SameKAffinePencilData D ×
      (Set ℚ × EndpointPolynomialFamily))

/-- The survivor index stored by the endpoint-polynomial source datum. -/
def endpointPolynomialSurvivorData
    {D : Type}
    (data : EndpointPolynomialSourceData D) :
    PrefixConflict.ClosedPrefixSurvivorData D :=
  data.1

/-- The exact affine-pencil datum stored by the polynomial source. -/
def endpointPolynomialAffineData
    {D : Type}
    (data : EndpointPolynomialSourceData D) :
    SameKAffinePencilData D :=
  data.2.1

/-- The valid rational parameter set T_K. -/
def endpointPolynomialValidSet
    {D : Type}
    (data : EndpointPolynomialSourceData D) : Set ℚ :=
  data.2.2.1

/-- The endpoint polynomial family P_e. -/
def endpointPolynomialFamily
    {D : Type}
    (data : EndpointPolynomialSourceData D) :
    EndpointPolynomialFamily :=
  data.2.2.2

/--
The endpoint-polynomial source laws over one exact survivor and one exact
pencil.  This predicate is declared in Pass 1 so the boundary context has its
final source type, but it is not opened until Pass 2.
-/
def endpoint_polynomial_data_at
    {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKAffinePencilData D)
    (polynomialData : EndpointPolynomialSourceData D) : Prop :=
  endpointPolynomialSurvivorData polynomialData = survivorData ∧
    endpointPolynomialAffineData polynomialData = affineData ∧
      (endpointPolynomialValidSet polynomialData).Infinite ∧
        ∀ e : Section6.K5EdgeAddress,
          (endpointPolynomialFamily polynomialData e).natDegree ≤ 3 ∧
            ∀ T : ℚ,
              T ∈ endpointPolynomialValidSet polynomialData →
                Polynomial.eval T
                    (endpointPolynomialFamily polynomialData e) = 0

/--
The retained endpoint-polynomial vanishing source.  It is indexed by the exact
survivor and exact affine datum already chosen upstream.  It cannot select a
second pencil or a second survivor.
-/
def endpoint_polynomial_vanishing_source
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∀ {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKAffinePencilData D),
    PrefixConflict.K_components_at
        C nSeq dSeq opening survivorData →
      same_K_affine_pencil_data_at survivorData affineData →
        ∃ polynomialData : EndpointPolynomialSourceData D,
          endpoint_polynomial_data_at
            survivorData affineData polynomialData


