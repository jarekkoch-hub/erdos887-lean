theorem build_hi_prod
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hChamber : canonical_affine_ratio_chamber C nSeq dSeq opening)
    (hCore : h_core C nSeq dSeq opening)
    (hLead : h_lead C nSeq dSeq opening)
    (hCub : h_cub C nSeq dSeq opening) :
    hi_prod C nSeq dSeq opening := by
  have hChamberState :
      canonical_affine_ratio_chamber C nSeq dSeq opening :=
    hChamber
  have hCoreState : h_core C nSeq dSeq opening :=
    hCore
  have hLeadState : h_lead C nSeq dSeq opening :=
    hLead
  have hCubState : h_cub C nSeq dSeq opening :=
    hCub
  rcases hChamber.2.2.2.2 with
    ⟨D, survivorData, affineData, polynomialData, productRowData,
      sourceData, hChamberAt⟩
  have hChamberAtState :
      canonical_affine_ratio_chamber_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hChamberAt
  rcases hChamberAt with
    ⟨_hContextAt, _hMonoAt, _hSyncAt, _hRatioCoreAt, _hCoherenceAt,
      _hAffineAt, _hPolynomialAt, _hPolynomialIdentityAt,
      _hEndpointSystemAt, hLeadRowAt, _hVertRowAt, hCubRowAt,
      _hConversionAt, _hWeightedAt, _hRatiosAt, _hCommonAt,
      _hScalingAt, _hMatchAt,
      _tau, _hAllRatios, _hPureScaling⟩
  have hCoreAt :
      h_core_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hChamberAtState
  have hLeadingFamilyAt :
      ProductRowExtraction.productRowLeadingFamilyAt productRowData :=
    hLeadRowAt.2
  have hLeadAt :
      h_lead_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    ⟨hChamberAtState, hLeadRowAt, hLeadingFamilyAt⟩
  have hCubicFamilyAt :
      ProductRowExtraction.productRowCubicFamilyAt productRowData :=
    hCubRowAt.2.2
  have hCubAt :
      h_cub_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    ⟨hChamberAtState, hCubRowAt, hCubicFamilyAt⟩
  have hProdAt :
      hi_prod_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    ⟨hChamberAtState, hCoreAt, hLeadAt, hCubAt⟩
  exact
    ⟨hChamberState, hCoreState, hLeadState, hCubState,
      D, survivorData, affineData, polynomialData, productRowData,
      sourceData, hProdAt⟩


