    C nSeq dSeq
    (openingTSeq opening)
    (openingBSeq opening)
    (openingZSeq opening)

Outgoing state shape:
  frozen_coefficient_pattern C nSeq dSeq opening

Effect:
  Opens the exact hidden leading and regime witnesses already fixed by the
  prefix context, projects their frozen coefficient function, identifies that
  function with the canonical endpoint coefficients through the fixed Section
  6 edge table, proves every edge value nonzero, and retains one finite bound.
  The selected low-rank coloring and the certificate payload remain attached
  through the retained prefix context.

Public theorem:
  build_frozen_coefficient_pattern
================================================================================
-/

theorem build_frozen_coefficient_pattern
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hContext :
      prefix_layer_context C nSeq dSeq opening)
    (hRank :
      RankTrichotomy.S_rank C nSeq dSeq opening)
    (hS0 :
      Section6.Legacy.legacy_S_0
        C nSeq dSeq
        (openingTSeq opening)
        (openingBSeq opening)
        (openingZSeq opening)) :
    frozen_coefficient_pattern C nSeq dSeq opening := by
  rcases hContext with
    ⟨leadingData, regimeData,
      hRankSource, hComponents, hLowPacket,
      _hContextS0, directionType, certificateData,
      _hCertificateAt⟩

  let b : RankTrichotomy.FrozenEndpointCoefficientPattern :=
    RankTrichotomy.leadingFrozenCoefficientPattern leadingData

  have hLeading :
      RankTrichotomy.leading_descendant_matrix opening leadingData :=
    hRankSource.1

  have hExtraction :
      RankTrichotomy.leading_descendant_extraction_source
        opening leadingData :=
    hLeading.2.2.1

  have hFrozenRead :
      RankTrichotomy.frozen_endpoint_coefficient_pattern opening b := by
    simpa [b] using hExtraction.1

  have hNonzero :
      ∀ e : Section6.K5EdgeAddress, b e ≠ 0 := by
    intro e
    have hBoundaryOrdered :=
      Section6.k5EdgeBoundary_ordered e
    have hBoundaryDistinct :
        (Section6.k5EdgeBoundary e).1 ≠
          (Section6.k5EdgeBoundary e).2 :=
      ne_of_lt hBoundaryOrdered
    have hEndpointAt :
        Section3.canonicalEndpointSystemAt
          (openingTSeq opening 0)
          (openingBSeq opening 0)
          (openingZSeq opening 0) :=
      hS0.1 0
    have hIntegerNonzero :
        openingBSeq opening 0
            (Section6.k5EdgeBoundary e).1
            (Section6.k5EdgeBoundary e).2 ≠ 0 :=
      hEndpointAt.2.2
        (Section6.k5EdgeBoundary e).1
        (Section6.k5EdgeBoundary e).2
        hBoundaryDistinct
    rw [hFrozenRead 0 e]
    unfold RankTrichotomy.rationalEndpointCoefficientAtEdge
    exact_mod_cast hIntegerNonzero

  have hBound :=
    prefix_frozen_coefficient_pattern_bounded b

  have hSource :
      frozen_coefficient_source_coherence
        C nSeq dSeq opening b := by
    refine
      ⟨leadingData, regimeData,
        hRankSource, hComponents, hLowPacket, ?_, hS0⟩
    rfl

  have hPatternAt :
      frozen_coefficient_pattern_at opening b :=
    ⟨hFrozenRead, hNonzero, hBound.1, hBound.2⟩

  exact
    ⟨⟨leadingData, regimeData,
        hRankSource, hComponents, hLowPacket,
        hS0, directionType, certificateData,
        _hCertificateAt⟩,
      hRank, hS0, b, hSource, hPatternAt⟩


