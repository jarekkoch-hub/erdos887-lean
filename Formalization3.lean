Section 8.1

This parent composes Sub-layer 00 and both Section 8.1 sub-boxes.  The same
`S_0` from the Section 8 input frontier is retained untouched for Section 8.3.
================================================================================
-/

def section_8_1_frontier
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (GammaSeq : Gamma_W_adjacent_growth_profile)
    (nuSeq : IncidentGrowth.IncidentGrowthExponentSequence)
    (sigmaSeq : IncidentGrowth.ProfileReadSequence)
    (GSeq : IncidentGrowth.MaxLinearProfileSequence) : Prop :=
  rank_layer_context
      C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq ∧
    R_cub opening ∧
    Q_desc opening ∧
    Section6.Legacy.legacy_S_0
      C nSeq dSeq
