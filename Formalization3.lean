      hLeadAt, hVertAt, hCubAt⟩
  rcases hRatioAt with
    ⟨_hVertRouteAt, _hAffineAtFromRatio, hRatiosAt, hConversionAt,
      hWeightedAt, hCommonAt, hScalingAt,
      tau, hAllRatios, hPureScaling⟩
  exact
    ⟨hSyncAtState, hAffineAt, hRowsAt, hLeadAt, hVertAt, hCubAt,
      hRatiosAt, hConversionAt, hWeightedAt, hCommonAt, hScalingAt,
      hPolynomialAt, hCoherenceAt,
      tau, hAllRatios, hPureScaling⟩


