Outgoing state shape:
  C_cub C nSeq dSeq opening

Effect:
  Applies the product-row source's constant-identity conversion rule to every
  endpoint edge, packs the endpointwise Cub predicates into the global cubic
  row family, and retains the exact source witness.  No ratio-collapse or
  terminal endpoint constant is introduced.

Public theorem:
  build_C_cub
================================================================================
-/

theorem build_C_cub
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hConstant : endpoint_constant_identity C nSeq dSeq opening)
    (hSemantics : row_conversion_semantics C nSeq dSeq opening) :
    C_cub C nSeq dSeq opening := by
  have hConstantState :
      endpoint_constant_identity C nSeq dSeq opening :=
    hConstant
  have hSemanticsState :
      row_conversion_semantics C nSeq dSeq opening :=
    hSemantics
  refine ⟨hConstantState, hSemanticsState, ?_⟩
  intro D survivorData affineData polynomialData productRowData hConstantAt hSemanticsAt
  have hConstantAtState := hConstantAt
  have hSemanticsAtState := hSemanticsAt
  rcases hConstantAt with
    ⟨_hVanishAt, _hRowsAt, hEndpointConstant⟩
  rcases hSemanticsAt with
    ⟨_hVanishAtFromSemantics, _hLeadRule, _hVertRule, hCubRule,
      _hLeadPacker, _hVertPacker, hCubPacker⟩
  have hEndpointCub :
      ∀ e : Section6.K5EdgeAddress,
        productRowCubPredicate productRowData e := by
    intro e
    exact hCubRule e (hEndpointConstant e)
  have hCubicFamily :
      productRowCubicFamilyAt productRowData :=
    hCubPacker hEndpointCub
  exact ⟨hConstantAtState, hSemanticsAtState, hCubicFamily⟩


