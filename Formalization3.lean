/-
================================================================================
THEOREM-SOURCE PAYLOAD COMPARTMENT
Section 11 same-K product-row source

The source is indexed by the exact survivor, affine datum, polynomial datum,
and polynomial identity opened from Section 10.  Its row identity references
the existing endpointPolynomialFamily directly, so no second polynomial named
P_e exists in this section.
================================================================================
-/

/-- The ordered endpoint-sector addresses on one side of each product row. -/
abbrev ProductRowFactorAddressFamily :=
  Section6.K5EdgeAddress → Fin 3 → Section6.K5EdgeAddress

/-- The derived polynomial factors on one side of each product row. -/
abbrev ProductRowFactorFamily :=
  Section6.K5EdgeAddress → Fin 3 → Polynomial ℚ

/-- One endpoint-indexed semantic predicate family. -/
abbrev ProductRowPredicateFamily :=
  Section6.K5EdgeAddress → Prop

/--
One retained product-row source datum over explicit Section 10 indices.  The
source stores the two ordered triples of endpoint-sector addresses, not free
polynomial families.  The six polynomial factors are derived from those
addresses and the exact affine-sector pencil.  The endpoint polynomial family
is not stored again; it is read through the exact polynomialData component.
-/
abbrev SameKProductRowSourceData (D : Type) :=
  PrefixConflict.ClosedPrefixSurvivorData D ×
    (SameKEndpointPolynomial.SameKAffinePencilData D ×
      (SameKEndpointPolynomial.EndpointPolynomialSourceData D ×
        (ProductRowFactorAddressFamily ×
          (ProductRowFactorAddressFamily ×
            (ProductRowPredicateFamily ×
              (ProductRowPredicateFamily ×
                ProductRowPredicateFamily))))))

/-- The exact survivor index stored by the product-row source. -/
def productRowSurvivorData
    {D : Type}
    (data : SameKProductRowSourceData D) :
    PrefixConflict.ClosedPrefixSurvivorData D :=
  data.1

/-- The exact affine-pencil datum stored by the product-row source. -/
def productRowAffineData
    {D : Type}
    (data : SameKProductRowSourceData D) :
    SameKEndpointPolynomial.SameKAffinePencilData D :=
  data.2.1

/-- The exact endpoint-polynomial source datum stored by the product row. -/
def productRowPolynomialData
    {D : Type}
    (data : SameKProductRowSourceData D) :
    SameKEndpointPolynomial.EndpointPolynomialSourceData D :=
  data.2.2.1

/-- The three left endpoint-sector addresses on one endpoint row. -/
def productRowLeftFactorAddresses
    {D : Type}
    (data : SameKProductRowSourceData D) :
    ProductRowFactorAddressFamily :=
  data.2.2.2.1

/-- The three right endpoint-sector addresses on one endpoint row. -/
def productRowRightFactorAddresses
    {D : Type}
    (data : SameKProductRowSourceData D) :
    ProductRowFactorAddressFamily :=
  data.2.2.2.2.1

/-- The normalized affine-sector polynomial A_e(T). -/
noncomputable def sameKAffineSectorPolynomial
    {D : Type}
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (e : Section6.K5EdgeAddress) : Polynomial ℚ :=
  Polynomial.C
      (SameKEndpointPolynomial.sameKAffineAlpha affineData e) *
    Polynomial.X +
      Polynomial.C
        (SameKEndpointPolynomial.sameKAffineBeta affineData e)

/-- The exact left factor selected by its retained endpoint-sector address. -/
noncomputable def productRowLeftFactors
    {D : Type}
    (data : SameKProductRowSourceData D)
    (e : Section6.K5EdgeAddress)
    (j : Fin 3) : Polynomial ℚ :=
  sameKAffineSectorPolynomial
    (productRowAffineData data)
    (productRowLeftFactorAddresses data e j)

/-- The exact right factor selected by its retained endpoint-sector address. -/
noncomputable def productRowRightFactors
    {D : Type}
    (data : SameKProductRowSourceData D)
    (e : Section6.K5EdgeAddress)
    (j : Fin 3) : Polynomial ℚ :=
  sameKAffineSectorPolynomial
    (productRowAffineData data)
    (productRowRightFactorAddresses data e j)

/-- The endpointwise leading-row predicate retained by the source. -/
def productRowLeadPredicate
    {D : Type}
    (data : SameKProductRowSourceData D) :
    ProductRowPredicateFamily :=
  data.2.2.2.2.2.1

/-- The endpointwise vertex-ratio predicate retained by the source. -/
def productRowVertPredicate
    {D : Type}
    (data : SameKProductRowSourceData D) :
    ProductRowPredicateFamily :=
  data.2.2.2.2.2.2.1

/-- The endpointwise endpoint-cubic predicate retained by the source. -/
def productRowCubPredicate
    {D : Type}
    (data : SameKProductRowSourceData D) :
    ProductRowPredicateFamily :=
  data.2.2.2.2.2.2.2

/-- The polynomial form of one affine adjacent-gap function. -/
noncomputable def sameKAffineGapPolynomial
    {D : Type}
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (k : Section6.AdjacentGapAddress) : Polynomial ℚ :=
  Polynomial.C
      (SameKEndpointPolynomial.sameKAffineKappa affineData k) *
    Polynomial.X +
      Polynomial.C
        (SameKEndpointPolynomial.sameKAffineOffset affineData k)

/--
A polynomial belongs to the same-K affine endpoint pencil exactly when it is
the normalized affine-sector polynomial at one retained K5 endpoint address.
This is deliberately narrower than an arbitrary affine combination of gaps.
-/
def sameKAffineEndpointPolynomialAt
    {D : Type}
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (P : Polynomial ℚ) : Prop :=
  ∃ e : Section6.K5EdgeAddress,
    P = sameKAffineSectorPolynomial affineData e

/-- The product of the three factors in one side of a row. -/
noncomputable def productRowTripleProduct
    (factors : Fin 3 → Polynomial ℚ) : Polynomial ℚ :=
  factors 0 * factors 1 * factors 2

/-- The constant-identity read later consumed by the Cub conversion rule. -/
def productRowEndpointConstantIdentityAt
    {D : Type}
    (data : SameKProductRowSourceData D)
    (e : Section6.K5EdgeAddress) : Prop :=
  SameKEndpointPolynomial.endpointPolynomialFamily
        (productRowPolynomialData data) e = 0 ∧
    (SameKEndpointPolynomial.endpointPolynomialFamily
        (productRowPolynomialData data) e).coeff 0 = 0

/-- The packed global leading-row family carried by one source datum. -/
def productRowLeadingFamilyAt
    {D : Type}
    (data : SameKProductRowSourceData D) : Prop :=
  ∃ family : ProductRowPredicateFamily,
    (∀ e : Section6.K5EdgeAddress,
      family e ↔ productRowLeadPredicate data e) ∧
      ∀ e : Section6.K5EdgeAddress, family e

/-- The packed global vertex-ratio family carried by one source datum. -/
def productRowVertexFamilyAt
    {D : Type}
    (data : SameKProductRowSourceData D) : Prop :=
  ∃ family : ProductRowPredicateFamily,
    (∀ e : Section6.K5EdgeAddress,
      family e ↔ productRowVertPredicate data e) ∧
      ∀ e : Section6.K5EdgeAddress, family e

/-- The packed global endpoint-cubic family carried by one source datum. -/
def productRowCubicFamilyAt
    {D : Type}
    (data : SameKProductRowSourceData D) : Prop :=
  ∃ family : ProductRowPredicateFamily,
    (∀ e : Section6.K5EdgeAddress,
      family e ↔ productRowCubPredicate data e) ∧
      ∀ e : Section6.K5EdgeAddress, family e

/--
All retained laws of one same-K product-row source datum.  The first three
fields fix its exact Section 10 indices.  The product identity uses the existing
P_e.  The final fields retain the conversion rules and packers needed in the
second Section 11 pass.
-/
def same_K_product_row_source_at
    {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (polynomialData :
      SameKEndpointPolynomial.EndpointPolynomialSourceData D)
    (productRowData : SameKProductRowSourceData D) : Prop :=
  productRowSurvivorData productRowData = survivorData ∧
    productRowAffineData productRowData = affineData ∧
      productRowPolynomialData productRowData = polynomialData ∧
        (∀ e : Section6.K5EdgeAddress, ∀ j : Fin 3,
          productRowLeftFactors productRowData e j =
            sameKAffineSectorPolynomial affineData
              (productRowLeftFactorAddresses productRowData e j)) ∧
        (∀ e : Section6.K5EdgeAddress, ∀ j : Fin 3,
          productRowRightFactors productRowData e j =
            sameKAffineSectorPolynomial affineData
              (productRowRightFactorAddresses productRowData e j)) ∧
        (∀ e : Section6.K5EdgeAddress,
          SameKEndpointPolynomial.endpointPolynomialFamily
                polynomialData e =
            productRowTripleProduct
                (productRowLeftFactors productRowData e) -
              productRowTripleProduct
                (productRowRightFactors productRowData e)) ∧
        (∀ e : Section6.K5EdgeAddress,
          (SameKEndpointPolynomial.endpointPolynomialFamily
              polynomialData e).coeff 3 = 0 →
            productRowLeadPredicate productRowData e) ∧
        (∀ e : Section6.K5EdgeAddress,
          (SameKEndpointPolynomial.endpointPolynomialFamily
              polynomialData e).coeff 2 = 0 →
            productRowLeadPredicate productRowData e →
              productRowVertPredicate productRowData e) ∧
        (∀ e : Section6.K5EdgeAddress,
          productRowEndpointConstantIdentityAt productRowData e →
            productRowCubPredicate productRowData e) ∧
        ((∀ e : Section6.K5EdgeAddress,
            productRowLeadPredicate productRowData e) →
          productRowLeadingFamilyAt productRowData) ∧
        (productRowLeadingFamilyAt productRowData →
          (∀ e : Section6.K5EdgeAddress,
            productRowVertPredicate productRowData e) →
              productRowVertexFamilyAt productRowData) ∧
        ((∀ e : Section6.K5EdgeAddress,
            productRowCubPredicate productRowData e) →
          productRowCubicFamilyAt productRowData)

/--
The retained Section 11 source port.  It is universal over the exact complete
Section 10 identity packet and supplies one product-row datum over that packet.
-/
def same_K_product_row_source
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∀ {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (polynomialData :
      SameKEndpointPolynomial.EndpointPolynomialSourceData D),
    SameKEndpointPolynomial.same_K_endpoint_polynomial_identity_data_at
        C nSeq dSeq opening
        survivorData affineData polynomialData →
      ∃ productRowData : SameKProductRowSourceData D,
        same_K_product_row_source_at
          survivorData affineData polynomialData productRowData

