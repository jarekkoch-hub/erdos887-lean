    (hInterval : prefix_interval_sector_data_at opening intervalData)
    (hNonparallel : ¬ projectiveConeSameLine model X Y)
    (hCone : projectiveConePositiveCone model X Y Z)
    (hEndpoint :
      projectiveConeSameLine model Z X ∨
        projectiveConeSameLine model Z Y)
    (hGapDistinct : leftGap ≠ rightGap)
    (hLeftGap :
      RankTrichotomy.adjacentGapLiesInEdge conflictEdge leftGap)
    (hRightGap :
      RankTrichotomy.adjacentGapLiesInEdge conflictEdge rightGap)
    (hIntervalSource :
      prefix_conflict_interval_sum_source intervalData conflictEdge)
    (hLowerClosed :
      RankTrichotomy.lowRankNoLowerEscapeFlag lowRankData = true) :
    prefix_cone_conflict_datum_at
      opening model intervalData lowRankData
      X Y Z conflictEdge leftGap rightGap := by
  exact
    ⟨hModel, hInterval, hNonparallel, hCone, hEndpoint,
      hGapDistinct, hLeftGap, hRightGap, hIntervalSource, hLowerClosed⟩

