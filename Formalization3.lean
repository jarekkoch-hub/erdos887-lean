    (hP :
      SameKEndpointPolynomial.endpoint_polynomial_P_e
        C nSeq dSeq opening) :
    endpoint_coefficient_table C nSeq dSeq opening := by
  have hRowsState :
      product_difference_row_source C nSeq dSeq opening :=
    hRows
  have hPState :
      SameKEndpointPolynomial.endpoint_polynomial_P_e
        C nSeq dSeq opening :=
    hP
  refine ⟨hRowsState, hPState, ?_⟩
  intro D survivorData affineData polynomialData productRowData hRowsAt
  have hRowsAtState :
      product_difference_row_source_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hRowsAt
  rcases hRowsAt with ⟨hIdentityPacketAt, hProductRowAt⟩
  rcases hProductRowAt with
    ⟨_hSurvivorIndex, _hAffineIndex, hPolynomialIndex,
      _hLeftAffine, _hRightAffine, _hProductIdentity,
      _hLeadRule, _hVertRule, _hCubRule,
      _hLeadPacker, _hVertPacker, _hCubPacker⟩
  have hTableRows :
      ∀ e : Section6.K5EdgeAddress,
        SameKEndpointPolynomial.endpointPolynomialFamily polynomialData e =
            endpointCoefficientPolynomial productRowData e ∧
          endpointCoefficientC3 productRowData e =
