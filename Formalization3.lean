/--
One exact monochrome low-rank datum over the already-fixed closed survivor.
The low-rank source coherence includes the rank-at-most-two coloring packet and
identifies its selected coloring with the coloring stored in `K`.
-/
def monochrome_low_rank_datum_at
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    {D : Type}
    (survivorData : ClosedPrefixSurvivorData D) : Prop :=
  K_components_at C nSeq dSeq opening survivorData ∧
    finite_prefix_conflict_low_rank_coherence
      C nSeq dSeq opening
      (closedPrefixRegularData survivorData)
      (closedPrefixLowRankData survivorData) ∧
    selected_post_prefix_monochrome_survivor
      (closedPrefixRegularData survivorData)
      (closedPrefixSelectedColor survivorData)

/--
The retained output of the low-rank rank/coloring-prefix route.  The explicit
`K` field makes the paper-grain order `K -> FG_mono` part of the type.
-/
def FG_mono
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  RankTrichotomy.S_rank C nSeq dSeq opening ∧
    regular_coloring_problem C nSeq dSeq opening ∧
    regular_coloring_alternatives C nSeq dSeq opening ∧
    K C nSeq dSeq opening ∧
    ∃ D : Type,
