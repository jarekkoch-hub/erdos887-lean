    hSeq.2.2.2.2.2.1
    hSeq.2.2.2.2.2.2.2

/--
The quantitative `Act_can` lower bounds on the produced divergent sequence
give full directed-quotient activity in both orientations of every K5 edge.
-/
theorem external_violation_sequence_directedQuotientActivity
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq) :
    Section3.directedQuotientActivity nSeq dSeq := by
  intro i j hij
  have hC : 0 < C := hSeq.1
  constructor
  · apply
      Section3.natSequenceTendsToInfinity_of_fourthRoot_lower_bound
        hC hSeq.2.1
    intro m
    exact
      (hSeq.2.2.2.2.2.2.2 m i j hij).2.2.2.2.1
  · apply
      Section3.natSequenceTendsToInfinity_of_fourthRoot_lower_bound
        hC hSeq.2.1
    intro m
    exact
      (hSeq.2.2.2.2.2.2.2 m i j hij).2.2.2.2.2.1

/-
================================================================================
STATE-SHAPE BATCH
Directed-collapse elimination on the produced external sequence

Incoming state shape:
  external_violation_sequence_state C nSeq dSeq
  DirCollapse C nSeq dSeq

Outgoing state shape:
  False

Effect:
  Uses the quantitative fourth-root lower bounds retained by `Act_can` and the
  divergence of the same produced integer sequence to prove directed quotient
  activity, contradicting the defining failure of activity in `DirCollapse`.

Public theorem:
  eliminate_DirCollapse_on_external_violation_sequence
================================================================================
-/

theorem eliminate_DirCollapse_on_external_violation_sequence
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq)
    (hCollapse : Section3.DirCollapse C nSeq dSeq) :
    False := by
  exact hCollapse.2
    (external_violation_sequence_directedQuotientActivity hSeq)

/-- After genuine collapse elimination, the live chamber route has two forms. -/
def active_external_chamber_route
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  Section3.GapEsc C nSeq dSeq ∨
    Section3.bounded_full_K5_branch C nSeq dSeq

/--
The live production state after canonical clipping.

The projected lower-dimensional face-entry alternative has already been
eliminated.  The retained strict subsequence therefore carries exactly one of
the two canonical corridors.
-/
def boundedPostClippingCorridorState
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  Section3.bounded_full_K5_branch C nSeq dSeq ∧
    Section3.Clip_can C nSeq dSeq ∧
    ∃ nSub : ℕ → ℕ,
      ∃ dSub : ℕ → Fin 5 → ℕ,
        Section3.stableCanonicalCorridorSubsequence
            C nSeq dSeq nSub dSub ∧
          (Section3.F2_corridor_state C nSub dSub ∨
            Section3.F3_corridor_state C nSub dSub)

/--
Historical five-leaf route accounting.

The two chamber exits occur before canonical clipping.  Only the residual
bounded full K5 branch formerly displayed the projected lower-dimensional,
F2, and F3 leaves together.  This ledger is retained for ancestry audit only;
it is not a live production state and no production theorem consumes it.

Semantic kind: historical route accounting, not live state.
-/
def historicalExternalFiveLeafAccounting
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  Section3.DirCollapse C nSeq dSeq ∨
    Section3.GapEsc C nSeq dSeq ∨
      (Section3.bounded_full_K5_branch C nSeq dSeq ∧
        ((∃ nSub : ℕ → ℕ,
            ∃ dSub : ℕ → Fin 5 → ℕ,
              ∃ o : ℕ,
                ∃ mu : Section3.SupportAddress → ℝ,
                  ∃ theta : ℝ,
                    Section3.projectedPrimeChainVertexOmissionState
                      C nSeq dSeq nSub dSub o mu theta) ∨
          (Section3.Clip_can C nSeq dSeq ∧
            ∃ nSub : ℕ → ℕ,
              ∃ dSub : ℕ → Fin 5 → ℕ,
                Section3.stableCanonicalCorridorSubsequence
                  C nSeq dSeq nSub dSub)))

/--
Once clipping is available, materialize the exact live F2/F3 post-clipping
state.  No projected lower-dimensional leaf is reintroduced.
-/
theorem derive_boundedPostClippingCorridorState
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq)
    (hBounded :
      Section3.bounded_full_K5_branch C nSeq dSeq)
    (hClip : Section3.Clip_can C nSeq dSeq) :
    boundedPostClippingCorridorState C nSeq dSeq := by
  rcases
      Section3.stabilize_Clip_can_to_fixed_canonical_corridor
        hSeq.2.1 hBounded hClip with
    ⟨nSub, dSub, hStable⟩
  have hStableCopy := hStable
  rcases hStable with
    ⟨_phi, _hPhi, _hnSub, _hdSub, hCorridor⟩
  exact
    ⟨hBounded, hClip, nSub, dSub,
      hStableCopy, hCorridor⟩

/--
Record the former five-leaf hierarchy for audit only.  The live bounded output
used by reconstruction is `boundedPostClippingCorridorState`.
-/
theorem record_historicalExternalFiveLeafAccounting
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq)
    (hClip :
      Section3.bounded_full_K5_branch C nSeq dSeq →
        Section3.Clip_can C nSeq dSeq) :
    historicalExternalFiveLeafAccounting C nSeq dSeq := by
  rcases
      Section3.derive_logical_chamber_partition
        (external_violation_sequence_to_chamber_context hSeq) with
    hCollapse | hGap | hBounded
  · exact Or.inl hCollapse
  · exact Or.inr (Or.inl hGap)
  · have hClipped : Section3.Clip_can C nSeq dSeq :=
      hClip hBounded
    rcases
        Section3.stabilize_Clip_can_to_fixed_canonical_corridor
          hSeq.2.1 hBounded hClipped with
      ⟨nSub, dSub, hStable⟩
    exact
      Or.inr (Or.inr
        ⟨hBounded, Or.inr
          ⟨hClipped, nSub, dSub, hStable⟩⟩)

/--
The produced external sequence is either in the active gap-escape route or in
the residual bounded full K5 chamber.
-/
theorem external_violation_sequence_to_active_chamber_route
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq) :
    active_external_chamber_route C nSeq dSeq := by
  rcases
      Section3.derive_logical_chamber_partition
        (external_violation_sequence_to_chamber_context hSeq) with
    hCollapse | hGap | hBounded
  · have hImpossible : False :=
      eliminate_DirCollapse_on_external_violation_sequence
        hSeq hCollapse
    contradiction
  · exact Or.inl hGap
  · exact Or.inr hBounded

theorem activity_sequence_to_chamber_context
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : activity_reconstruction_sequence_state C nSeq dSeq) :
    Section3.chamberSequenceContext C nSeq dSeq := by
  apply Section3.close_chamberSequenceContext
  · intro m
    exact (hSeq m).1.1.2
  · intro m
    exact (hSeq m).2

theorem activity_sequence_to_chamber_route
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : activity_reconstruction_sequence_state C nSeq dSeq) :
    Section3.chamber_route_state C nSeq dSeq := by
  exact Section3.close_chamber_route_state
    (activity_sequence_to_chamber_context hSeq)

