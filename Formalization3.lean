theorem build_adjacent_pure_scaling_read
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hCommon : common_ratio_witness C nSeq dSeq opening)
    (hRatios : adjacent_affine_ratios C nSeq dSeq opening) :
    adjacent_pure_scaling_read C nSeq dSeq opening := by
  have hCommonState : common_ratio_witness C nSeq dSeq opening :=
    hCommon
  have hRatiosState : adjacent_affine_ratios C nSeq dSeq opening :=
    hRatios
  refine ⟨hCommonState, hRatiosState, ?_⟩
  intro D survivorData affineData polynomialData productRowData sourceData
    hCommonAt hRatiosAt
  have hCommonAtState :
      common_ratio_witness_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hCommonAt
  have hRatiosAtState :
      adjacent_affine_ratios_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hRatiosAt
  rcases hCommonAt with ⟨_hNeighborsAt, tau, hAllRatios⟩
  rcases hRatiosAt with ⟨hContextAt, hSourceAt, _hQuotient⟩
  have hAffineAt :
      SameKEndpointPolynomial.A_e_affine_pencil_at
        C nSeq dSeq opening survivorData affineData :=
    hContextAt.2.1
  have hGapEquation :
      ∀ T : ℚ, ∀ k : Section6.AdjacentGapAddress,
        SameKEndpointPolynomial.sameKAffineGap affineData T k =
          SameKEndpointPolynomial.sameKAffineKappa affineData k * T +
            SameKEndpointPolynomial.sameKAffineOffset affineData k :=
    hAffineAt.2.2.1
  rcases hSourceAt with
    ⟨_hSurvivorIndex, _hAffineIndex, _hPolynomialIndex, _hProductRowIndex,
      _hPositive, hRatio, _hVertexFacts, _hPrefixFacts, _hConversionRules⟩
  have hScaling : adjacentPureScalingAt affineData tau := by
    intro T k
    calc
      SameKEndpointPolynomial.sameKAffineGap affineData T k =
          SameKEndpointPolynomial.sameKAffineKappa affineData k * T +
            SameKEndpointPolynomial.sameKAffineOffset affineData k :=
        hGapEquation T k
      _ =
          SameKEndpointPolynomial.sameKAffineKappa affineData k * T +
            adjacentAffineRatio sourceData k *
              SameKEndpointPolynomial.sameKAffineKappa affineData k := by
        rw [hRatio k]
      _ =
          SameKEndpointPolynomial.sameKAffineKappa affineData k * T +
            tau * SameKEndpointPolynomial.sameKAffineKappa affineData k := by
        rw [hAllRatios k]
      _ =
          SameKEndpointPolynomial.sameKAffineKappa affineData k *
            (T + tau) := by
        ring
  exact
    ⟨hCommonAtState, hRatiosAtState, tau, hAllRatios, hScaling⟩

