Effect:
  Retains the exact regular-coloring state and attaches the complete fixed
  twelve-cycle family to every source-tied coloring datum in that state.  The
  true and false cycle reads use complementary rows of the same table.  No
  active cycle is selected and no certificate conflict is applied.

Public theorem:
  build_degree_two_branch_family
================================================================================
-/

theorem build_degree_two_branch_family
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hRegular :
      regular_coloring_problem C nSeq dSeq opening) :
    degree_two_branch_family C nSeq dSeq opening := by
  refine ⟨hRegular, ?_⟩
  intro data _hSource hRegularAt
  exact
    build_degree_two_branch_family_at
      data hRegularAt


