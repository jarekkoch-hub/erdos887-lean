def prefix_cone_conflict_datum_at
    {D : Type}
    (opening : CanonicalIntervalOverloadOpeningData)
    (model : ProjectiveConeModelData D)
    (intervalData : PrefixIntervalSectorData)
    (lowRankData : RankTrichotomy.LowRankSourceData)
    (X Y Z : D)
    (conflictEdge : Section6.K5EdgeAddress)
    (leftGap rightGap : Section6.AdjacentGapAddress) : Prop :=
  projective_cone_model_at model ∧
    prefix_interval_sector_data_at opening intervalData ∧
      ¬ projectiveConeSameLine model X Y ∧
        projectiveConePositiveCone model X Y Z ∧
          (projectiveConeSameLine model Z X ∨
            projectiveConeSameLine model Z Y) ∧
            leftGap ≠ rightGap ∧
              RankTrichotomy.adjacentGapLiesInEdge conflictEdge leftGap ∧
                RankTrichotomy.adjacentGapLiesInEdge conflictEdge rightGap ∧
                  prefix_conflict_interval_sum_source
                    intervalData conflictEdge ∧
                    RankTrichotomy.lowRankNoLowerEscapeFlag
                      lowRankData = true

