/-- Elementary eventual divergence of a natural-valued sequence. -/
def natSequenceTendsToInfinity (a : ℕ → ℕ) : Prop :=
  ∀ B : ℕ, ∃ N : ℕ, ∀ m : ℕ, N ≤ m → B < a m

/--
A natural sequence lying above the fourth-root scale of a divergent integer
sequence is itself divergent.
-/
theorem natSequenceTendsToInfinity_of_fourthRoot_lower_bound
    {C : ℝ}
    {nSeq uSeq : ℕ → ℕ}
    (hC : 0 < C)
    (hN : natSequenceTendsToInfinity nSeq)
    (hLower :
      ∀ m : ℕ,
        fourthRootNat (nSeq m) / C < (uSeq m : ℝ)) :
    natSequenceTendsToInfinity uSeq := by
  intro B
  rcases exists_nat_gt
      ((C * ((B + 1 : ℕ) : ℝ)) ^ 4) with
    ⟨N, hThreshold⟩
  rcases hN N with ⟨M, hM⟩
  refine ⟨M, ?_⟩
  intro m hm
  have hNlt : N < nSeq m :=
    hM m hm
  by_contra hNot
  have hULe : uSeq m ≤ B :=
    Nat.le_of_not_gt hNot
  have hULeReal :
      (uSeq m : ℝ) ≤ (B : ℝ) := by
    exact_mod_cast hULe
  have hDivLt :
      fourthRootNat (nSeq m) / C < (B : ℝ) :=
    lt_of_lt_of_le (hLower m) hULeReal
  have hRootLt :
      fourthRootNat (nSeq m) <
        C * (B : ℝ) := by
    have h :=
      (div_lt_iff₀ hC).mp hDivLt
    simpa [mul_comm] using h
  have hSquareLt :
      fourthRootNat (nSeq m) *
          fourthRootNat (nSeq m) <
        (C * (B : ℝ)) * (C * (B : ℝ)) :=
    mul_self_lt_mul_self
      (fourthRootNat_nonneg (nSeq m)) hRootLt
  have hFourthLt :
      fourthRootNat (nSeq m) ^ 4 <
        (C * (B : ℝ)) ^ 4 := by
    have hSquareNonnegative :
        0 ≤
          fourthRootNat (nSeq m) *
            fourthRootNat (nSeq m) :=
      mul_self_nonneg _
    have hSquaredSquare :=
      mul_self_lt_mul_self hSquareNonnegative hSquareLt
    calc
      fourthRootNat (nSeq m) ^ 4 =
          (fourthRootNat (nSeq m) *
            fourthRootNat (nSeq m)) *
          (fourthRootNat (nSeq m) *
            fourthRootNat (nSeq m)) := by ring
      _ <
          ((C * (B : ℝ)) * (C * (B : ℝ))) *
          ((C * (B : ℝ)) * (C * (B : ℝ))) :=
        hSquaredSquare
      _ = (C * (B : ℝ)) ^ 4 := by ring
  have hBStep :
      C * (B : ℝ) <
        C * ((B + 1 : ℕ) : ℝ) := by
    apply mul_lt_mul_of_pos_left _ hC
    exact_mod_cast Nat.lt_succ_self B
  have hBStepSquare :
      (C * (B : ℝ)) * (C * (B : ℝ)) <
        (C * ((B + 1 : ℕ) : ℝ)) *
          (C * ((B + 1 : ℕ) : ℝ)) :=
    mul_self_lt_mul_self
      (mul_nonneg (le_of_lt hC) (Nat.cast_nonneg B))
      hBStep
  have hBStepFourth :
      (C * (B : ℝ)) ^ 4 <
        (C * ((B + 1 : ℕ) : ℝ)) ^ 4 := by
    have hLeftSquareNonnegative :
        0 ≤
          (C * (B : ℝ)) * (C * (B : ℝ)) :=
      mul_self_nonneg _
    have hSquaredSquare :=
      mul_self_lt_mul_self
        hLeftSquareNonnegative hBStepSquare
    calc
      (C * (B : ℝ)) ^ 4 =
          ((C * (B : ℝ)) * (C * (B : ℝ))) *
          ((C * (B : ℝ)) * (C * (B : ℝ))) := by ring
      _ <
          ((C * ((B + 1 : ℕ) : ℝ)) *
            (C * ((B + 1 : ℕ) : ℝ))) *
          ((C * ((B + 1 : ℕ) : ℝ)) *
            (C * ((B + 1 : ℕ) : ℝ))) :=
        hSquaredSquare
      _ = (C * ((B + 1 : ℕ) : ℝ)) ^ 4 := by ring
  have hnReal :
      (nSeq m : ℝ) <
        (C * (B : ℝ)) ^ 4 := by
    rw [← fourthRootNat_pow_four (nSeq m)]
    exact hFourthLt
  have hNltReal :
      (N : ℝ) < (nSeq m : ℝ) := by
    exact_mod_cast hNlt
  linarith

/--
The same-sequence packet read by the chamber classifier.  Every pointwise edge
and activity fact refers to the same `nSeq` and `dSeq`; no witness is reselected.
-/
def chamberSequenceContext
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  (∀ m : ℕ, Edge_can (nSeq m) (dSeq m)) ∧
    ∀ m : ℕ, ∀ i j : Fin 5, i < j →
      pointwiseDirectedQuotientActivityAt
        C (nSeq m) (dSeq m) i j

/--
Every ordered K5 edge has both directed quotient sequences tending to infinity.
The endpoint order is fixed by `i < j`; both orientations are retained.
-/
def directedQuotientActivity
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  ∀ i j : Fin 5, i < j →
    natSequenceTendsToInfinity
      (fun m => directedQuotient (nSeq m) (dSeq m) i j) ∧
    natSequenceTendsToInfinity
      (fun m => directedQuotient (nSeq m) (dSeq m) j i)

/--
The residual bounded edge-gap chamber.  One natural bound works for every
sequence index and every ordered edge; the lower bound records the positive
integer directed difference supplied pointwise by `Act_can`.
-/
def boundedEdgeGapChamber
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  ∃ M : ℕ, ∀ m : ℕ, ∀ i j : Fin 5, i < j →
    1 ≤ directedEdgeGap (nSeq m) (dSeq m) i j ∧
      directedEdgeGap (nSeq m) (dSeq m) i j ≤ M

/--
Directed-factor collapse is exactly failure of sequence-level directed quotient
activity inside the retained same-sequence packet.
-/
def DirCollapse
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  chamberSequenceContext C nSeq dSeq ∧
    ¬ directedQuotientActivity nSeq dSeq

/--
Active gap escape retains activity but fails the bounded full K5 edge-gap
chamber.  This is an external route predicate, not a contradiction.
-/
def GapEsc
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  chamberSequenceContext C nSeq dSeq ∧
    directedQuotientActivity nSeq dSeq ∧
    ¬ boundedEdgeGapChamber nSeq dSeq

/--
The residual branch on which all directed quotient sequences are active and one
uniform finite edge-gap bound controls the full K5 sequence.
-/
def bounded_full_K5_branch
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  chamberSequenceContext C nSeq dSeq ∧
    directedQuotientActivity nSeq dSeq ∧
    boundedEdgeGapChamber nSeq dSeq


/--
The two paper-defined external chamber exits under one routing umbrella.

This proposition does not identify their causes. It records only the state
change relevant to the next routing layer: the full bounded sector corridor has
been left before canonical clipping.
-/
def external_chamber_exit
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  DirCollapse C nSeq dSeq ∨
    GapEsc C nSeq dSeq

/-- A collapse state is injected into the shared external-exit umbrella. -/
theorem DirCollapse_to_external_chamber_exit
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hCollapse : DirCollapse C nSeq dSeq) :
    external_chamber_exit C nSeq dSeq :=
  Or.inl hCollapse

/-- An active gap-escape state is injected into the same external-exit umbrella. -/
theorem GapEsc_to_external_chamber_exit
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hGap : GapEsc C nSeq dSeq) :
    external_chamber_exit C nSeq dSeq :=
  Or.inr hGap

/--
Typed routing property from the paper: an external chamber exit is not the
bounded full K5 branch consumed by canonical clipping.
-/
theorem external_chamber_exit_not_bounded
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hExit : external_chamber_exit C nSeq dSeq) :
    ¬ bounded_full_K5_branch C nSeq dSeq := by
  intro hBounded
  rcases hExit with hCollapse | hGap
  · exact hCollapse.2 hBounded.2.1
  · exact hGap.2.2 hBounded.2.2

/--
The chamber classifier after its two exit branches have been folded into the
paper's common external-routing umbrella.
-/
def chamber_route_state
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  external_chamber_exit C nSeq dSeq ∨
    bounded_full_K5_branch C nSeq dSeq

/--
Exact chamber-entry trichotomy on one already fixed sequence packet.
No branch is connected to a downstream consumer by this theorem.
-/
