/-- The support addresses having exactly `k` active endpoints. -/
def supportAddressesAtLevel (k : ℕ) : Finset SupportAddress :=
  supportAddresses.filter fun S => S.card = k

@[simp]
theorem mem_supportAddressesAtLevel
    {k : ℕ} {S : SupportAddress} :
    S ∈ supportAddressesAtLevel k ↔ S.card = k := by
  simp [supportAddressesAtLevel]

/-- Every support address on `Fin 5` has cardinality strictly below six. -/
theorem supportAddress_card_lt_six (S : SupportAddress) :
    S.card < 6 := by
  have hle :
      S.card ≤ (Finset.univ : Finset (Fin 5)).card :=
    Finset.card_le_univ S
  simpa using Nat.lt_succ_of_le hle

/--
The exact finite level product

  L_k(W) = product_{|S|=k} X_S(W).
-/
noncomputable def exactLevelProduct
    (n : ℕ) (d : Fin 5 → ℕ) (k : ℕ) : ℕ :=
  ∏ S ∈ supportAddressesAtLevel k, atomBucket n d S

/-- Every exact level product is positive, including an empty level product. -/
theorem exactLevelProduct_pos
    (n : ℕ) (d : Fin 5 → ℕ) (k : ℕ) :
    0 < exactLevelProduct n d k := by
  unfold exactLevelProduct
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro S _hS
    exact atomBucket_pos n d S)

/-- Product of the six exact support levels `k=0,...,5`. -/
noncomputable def levelProductRead
    (n : ℕ) (d : Fin 5 → ℕ) : ℕ :=
  ∏ k ∈ Finset.range 6, exactLevelProduct n d k

/-- Positivity of the product of all six exact levels. -/
theorem levelProductRead_pos
    (n : ℕ) (d : Fin 5 → ℕ) :
    0 < levelProductRead n d := by
  unfold levelProductRead
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro k _hk
    exact exactLevelProduct_pos n d k)

/--
The six level fibers partition the thirty-two support addresses.  Consequently
multiplying the six level products gives the product of all atom buckets.
-/
theorem levelProductRead_eq_globalAtomRead
    (n : ℕ) (d : Fin 5 → ℕ) :
    levelProductRead n d = globalAtomRead n d := by
  classical
  have hmaps :
      ∀ S ∈ supportAddresses, S.card ∈ Finset.range 6 := by
    intro S _hS
    exact Finset.mem_range.mpr (supportAddress_card_lt_six S)
  unfold levelProductRead exactLevelProduct supportAddressesAtLevel
    globalAtomRead
  simpa only using
    (Finset.prod_fiberwise_of_maps_to
      (s := supportAddresses)
      (t := Finset.range 6)
      (g := fun S : SupportAddress => S.card)
      hmaps
      (fun S => atomBucket n d S))

/-- The exact six-level product reconstructs the original integer `n`. -/
theorem levelProductRead_eq_n
    {n : ℕ} {d : Fin 5 → ℕ}
    (hfull : full_atom_model n d) :
    levelProductRead n d = n := by
  calc
    levelProductRead n d = globalAtomRead n d :=
      levelProductRead_eq_globalAtomRead n d
    _ = n := hfull.2.2.2.2.1.symm

/--
The exact finite support ledger currently available from one full atom model.
It records the canonical atom model, positivity of every level product, and the
exact partition of `n` into its six support levels.
-/
def exact_finite_support_ledgers
    (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  full_atom_model n d ∧
    (∀ k : ℕ, 0 < exactLevelProduct n d k) ∧
    levelProductRead n d = n

/-- One full atom model produces the complete exact finite support ledger. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.2, Sub-sub-layer 02, Sub-sub-box 02

Incoming state shape:
  full_atom_model n d

Outgoing state shape:
  exact_finite_support_ledgers n d

Effect:
  Partitions the global atom product into six positive level products and
  proves that the product of those six level products reconstructs n.

Public theorem:
  derive_exact_finite_support_ledgers

================================================================================
