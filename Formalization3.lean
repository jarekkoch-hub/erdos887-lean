                  C nSeq dSeq nSub dSub o mu theta

/--
Once the coherent analytic-limit producer is supplied, canonical clipping is a
genuine consequence of the retained bounded branch.  No independently chosen
orientation, mass, scale, or classification enters this theorem.
-/
theorem Clip_can_of_boundedBranchAnalyticLimitRawProduction
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hExternal :
      external_violation_sequence_state C nSeq dSeq)
    (hBranch : bounded_full_K5_branch C nSeq dSeq)
    (hRawProduction :
      boundedBranchAnalyticLimitRawProduction C nSeq dSeq)
    (hConsequenceProduction :
      derive_boundedBranchAnalyticLimitConsequences)
    (hNormalizedLedgerProduction :
      derive_normalized_support_ledgers)
    (hClassificationProduction :
      derive_canonicalFaceEntryClassification)
    (hAbsorptionProduction :
      derive_canonicalCorridorAbsorption_from_structural)
    (hLowerDimensionalObstruction :
      projectedPrimeChainVertexOmissionObstruction) :
    Clip_can C nSeq dSeq := by
  apply Clip_can_of_not_unbounded
  intro hUnbounded
  rcases hRawProduction hExternal hBranch hUnbounded with
    ⟨nSub, dSub, o, mu, theta, hRaw⟩
  have hLimit :
      boundedBranchAnalyticLimitState
        C nSeq dSeq nSub dSub o mu theta :=
    build_boundedBranchAnalyticLimitState hRaw hConsequenceProduction
  have hRawState := hLimit.1
  have hConsequences := hLimit.2
  rcases hRawState with
    ⟨_hParentExternal, _phi, _normalizationSeq, _scaleRatioSeq,
      _hPhi, _hnSub, _hdSub, hSubExternal, hSubBranch, hSubUnbounded,
      hOrientation, _hNormalizationEq, _hNormalizationDiverges,
      _hNormalizationPositive, _hMassConverges, _hCorridorExtension,
      _hExactOffProfileSum, _hScaleRatioEq,
      _hScaleRatioConverges, _hSubDiverges⟩
  rcases hConsequences with
    ⟨hNonnegative, hCut, hSupported, hNormalized,
      _hPositiveMass, hTheta⟩
  have hFull :
      ∀ m : ℕ, full_atom_model (nSub m) (dSub m) := by
    intro m
    exact hSubExternal.2.2.2.2.1 m
  have hFinite :
      ∀ m : ℕ,
        exact_finite_support_ledgers (nSub m) (dSub m) := by
    intro m
    exact derive_exact_finite_support_ledgers (hFull m)
  have hFaces :
      ∀ m : ℕ,
        two_canonical_clipped_faces (nSub m) (dSub m) := by
    intro m
    exact derive_two_canonical_clipped_faces (hFinite m)
  have hOff :
      ∀ m : ℕ, off_face_pressure (nSub m) (dSub m) := by
    intro m
    exact derive_off_face_pressure (hFaces m)
  have hLoad :
      ∀ m : ℕ, Load_can (nSub m) (dSub m) := by
    intro m
    exact hSubExternal.2.2.2.2.2.2.1 m
  have hEdge :
      ∀ m : ℕ, Edge_can (nSub m) (dSub m) := by
    intro m
    exact hSubExternal.2.2.2.2.2.1 m
  have hPrimitive :
      primitive_support_vectors C nSub dSub mu :=
    derive_primitive_support_vectors hSubBranch hNonnegative hCut
  have hVec : VecBal C nSub dSub mu :=
    derive_VecBal hPrimitive
  have hFaceRestriction :
      ∀ r : Fin 5, four_face_restriction C nSub dSub r := by
    intro r
    exact derive_four_face_restriction hSubBranch r
  have hVec4 :
      ∀ r : Fin 5, VecBal_4 C nSub dSub r := by
    intro r
    exact derive_VecBal_4 (hFaceRestriction r)
  have hFirst : FirstOff_vec nSub dSub o mu :=
    derive_FirstOff_vec
      hFull hFaces hOff hOrientation hNonnegative hSupported hNormalized
  rcases lt_or_eq_of_le hTheta with hThetaPositive | hThetaZero
  · have hNormalizedLedgers :
        normalized_support_ledgers C nSub dSub :=
      hNormalizedLedgerProduction hSubExternal
    have hScale : scale_discipline C nSub dSub o mu theta :=
      build_scale_discipline_positive
        hFirst hThetaPositive hNormalizedLedgers hLoad
    have hPositive :
        positiveScalePermissions C nSub dSub o mu theta :=
      (scale_discipline_regime_cases hScale).resolve_right
        (fun hZero => (ne_of_gt hThetaPositive) hZero.1.1)
    have hClassification :
        canonicalFaceEntryClassification
          C nSeq dSeq nSub dSub o mu theta :=
      canonicalFaceEntryClassification_of_structural
        (hClassificationProduction.1
          hLimit hPositive hFirst hSubBranch)
        hAbsorptionProduction
    have hEntry :
        FaceEntry_K5 C nSeq dSeq nSub dSub o mu theta :=
      build_FaceEntry_K5
        hLimit hScale hFirst hVec hVec4 hFaces hSubBranch hLoad
        hClassification
    exact
      (FaceEntry_K5_excludes_unbounded
        hEntry hLowerDimensionalObstruction) hSubUnbounded
  · have hThetaZero' : theta = 0 := hThetaZero.symm
    have hScale : scale_discipline C nSub dSub o mu theta :=
      build_scale_discipline_zero
        hFirst hThetaZero' hFinite hEdge hLoad
    have hZero :
        zeroScalePermissions nSub dSub o mu theta :=
      (scale_discipline_regime_cases hScale).resolve_left
        (fun hPositive => (ne_of_gt hPositive.1.1) hThetaZero')
    have hClassification :
        canonicalFaceEntryClassification
          C nSeq dSeq nSub dSub o mu theta :=
      canonicalFaceEntryClassification_of_structural
        (hClassificationProduction.2
          hLimit hZero hFirst hSubBranch)
        hAbsorptionProduction
    have hEntry :
        FaceEntry_K5 C nSeq dSeq nSub dSub o mu theta :=
      build_FaceEntry_K5
        hLimit hScale hFirst hVec hVec4 hFaces hSubBranch hLoad
        hClassification
    exact
      (FaceEntry_K5_excludes_unbounded
        hEntry hLowerDimensionalObstruction) hSubUnbounded

/--
Full canonical-clipping parent.  Every analytic object is produced from the
repaired external ingress and the retained bounded branch; the projected
lower-dimensional obstruction remains a separate mathematical input.

Semantic kind: state-space elimination.
-/
theorem derive_Clip_can_from_sources
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hExternal :
      external_violation_sequence_state C nSeq dSeq)
    (hBranch : bounded_full_K5_branch C nSeq dSeq)
    (hRawProduction :
      boundedBranchAnalyticLimitRawProduction C nSeq dSeq)
    (hConsequenceProduction :
      derive_boundedBranchAnalyticLimitConsequences)
    (hNormalizedLedgerProduction :
      derive_normalized_support_ledgers)
    (hClassificationProduction :
      derive_canonicalFaceEntryClassification)
    (hAbsorptionProduction :
      derive_canonicalCorridorAbsorption_from_structural)
    (hLowerDimensionalObstruction :
      projectedPrimeChainVertexOmissionObstruction) :
    Clip_can C nSeq dSeq :=
  Clip_can_of_boundedBranchAnalyticLimitRawProduction
    hExternal hBranch hRawProduction hConsequenceProduction
    hNormalizedLedgerProduction hClassificationProduction
    hAbsorptionProduction hLowerDimensionalObstruction

/-
================================================================================
ROUTE COMPARTMENT
Stable canonical-corridor subsequence

The paper's two canonical corridors occur inside the retained bounded full
K5 branch.  They are not two additional alternatives in the earlier chamber
trichotomy.  A pointwise bound on the minimum of the two off-face products can
alternate orientations, so the fixed corridor is materialized only after an
explicit subsequence extraction.
================================================================================
-/

/-- The bounded full branch retained with one globally fixed F2 orientation. -/
def F2_corridor_state
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  natSequenceTendsToInfinity nSeq ∧
    bounded_full_K5_branch C nSeq dSeq ∧
    ∃ B : ℕ, ∀ m : ℕ,
      orientationOffFaceProduct 2 (nSeq m) (dSeq m) ≤ B

/-- The bounded full branch retained with one globally fixed F3 orientation. -/
def F3_corridor_state
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  natSequenceTendsToInfinity nSeq ∧
    bounded_full_K5_branch C nSeq dSeq ∧
    ∃ B : ℕ, ∀ m : ℕ,
      orientationOffFaceProduct 3 (nSeq m) (dSeq m) ≤ B

/-- The paper's two retained canonical corridor orientations. -/
def fixedCanonicalCorridorState
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  F2_corridor_state C nSeq dSeq ∨
    F3_corridor_state C nSeq dSeq

/-- A fixed F2 corridor supplies the orientation-free clipping bound. -/
theorem Clip_can_of_F2_corridor_state
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hF2 : F2_corridor_state C nSeq dSeq) :
    Clip_can C nSeq dSeq := by
  rcases hF2.2.2 with ⟨B, hB⟩
  refine ⟨B, ?_⟩
  intro m
  calc
    offFacePressureNat (nSeq m) (dSeq m)
        ≤ orientationOffFaceProduct 2
            (nSeq m) (dSeq m) := by
          rw [offFacePressureNat_eq_orientation_min]
          exact Nat.min_le_right _ _
    _ ≤ B := hB m

/-- A fixed F3 corridor supplies the orientation-free clipping bound. -/
theorem Clip_can_of_F3_corridor_state
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hF3 : F3_corridor_state C nSeq dSeq) :
    Clip_can C nSeq dSeq := by
  rcases hF3.2.2 with ⟨B, hB⟩
  refine ⟨B, ?_⟩
  intro m
  calc
    offFacePressureNat (nSeq m) (dSeq m)
        ≤ orientationOffFaceProduct 3
            (nSeq m) (dSeq m) := by
          rw [offFacePressureNat_eq_orientation_min]
          exact Nat.min_le_left _ _
    _ ≤ B := hB m

/-- Either fixed canonical corridor supplies the same clipping boundary. -/
theorem Clip_can_of_fixedCanonicalCorridorState
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hCorridor :
      fixedCanonicalCorridorState C nSeq dSeq) :
    Clip_can C nSeq dSeq := by
  rcases hCorridor with hF2 | hF3
  · exact Clip_can_of_F2_corridor_state hF2
  · exact Clip_can_of_F3_corridor_state hF3

/--
Exact coherence of one materialized canonical-corridor subsequence with its
parent sequence.
-/
def stableCanonicalCorridorSubsequence
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (nSub : ℕ → ℕ)
    (dSub : ℕ → Fin 5 → ℕ) : Prop :=
  ∃ phi : ℕ → ℕ,
    StrictMono phi ∧
      (∀ m : ℕ, nSub m = nSeq (phi m)) ∧
      (∀ m : ℕ, dSub m = dSeq (phi m)) ∧
      (F2_corridor_state C nSub dSub ∨
        F3_corridor_state C nSub dSub)

/-- A divergent natural sequence remains divergent along a strict subsequence. -/
theorem natSequenceTendsToInfinity_strict_subsequence
    {a : ℕ → ℕ}
    {phi : ℕ → ℕ}
    (ha : natSequenceTendsToInfinity a)
    (hphi : StrictMono phi) :
    natSequenceTendsToInfinity (fun m => a (phi m)) := by
  intro B
  rcases ha B with ⟨N, hN⟩
  refine ⟨N, ?_⟩
  intro m hm
  exact hN (phi m)
    (le_trans hm (StrictMono.id_le hphi m))

/-- The bounded full K5 branch is inherited by every strict subsequence. -/
theorem bounded_full_K5_branch_strict_subsequence
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {phi : ℕ → ℕ}
    (hbranch : bounded_full_K5_branch C nSeq dSeq)
    (hphi : StrictMono phi) :
    bounded_full_K5_branch
      C
      (fun m => nSeq (phi m))
      (fun m => dSeq (phi m)) := by
  rcases hbranch with
    ⟨hContext, hActivity, M, hGap⟩
  refine ⟨?_, ?_, M, ?_⟩
  · exact
      ⟨(fun m => hContext.1 (phi m)),
        (fun m i j hij => hContext.2 (phi m) i j hij)⟩
  · intro i j hij
    rcases hActivity i j hij with ⟨hForward, hReverse⟩
    constructor
    · exact natSequenceTendsToInfinity_strict_subsequence
        hForward hphi
    · exact natSequenceTendsToInfinity_strict_subsequence
        hReverse hphi
  · intro m i j hij
    exact hGap (phi m) i j hij

/--
An exhaustive binary pointwise choice has a strict subsequence on which one
side is retained at every index.
-/
theorem stabilize_binary_sequence_predicate
    {P Q : ℕ → Prop}
    (hCases : ∀ m : ℕ, P m ∨ Q m) :
    (∃ phi : ℕ → ℕ,
      StrictMono phi ∧ ∀ m : ℕ, P (phi m)) ∨
    (∃ phi : ℕ → ℕ,
      StrictMono phi ∧ ∀ m : ℕ, Q (phi m)) := by
  classical
  by_cases hFrequent :
      ∀ N : ℕ, ∃ m : ℕ, N ≤ m ∧ P m
  · have hInfinite : (setOf P).Infinite := by
      apply Set.infinite_of_not_bddAbove
      intro hBounded
      rcases hBounded with ⟨K, hK⟩
      rcases hFrequent (K + 1) with ⟨m, hm, hPm⟩
      have hmK : m ≤ K := hK hPm
      exact (not_lt_of_ge hmK)
        (lt_of_lt_of_le (Nat.lt_succ_self K) hm)
    exact Or.inl
      ⟨Nat.nth P,
        Nat.nth_strictMono hInfinite,
        Nat.nth_mem_of_infinite hInfinite⟩
  · rcases not_forall.mp hFrequent with ⟨N, hN⟩
    have hNoP :
        ∀ m : ℕ, N ≤ m → ¬ P m := by
      intro m hm hPm
      exact hN ⟨m, hm, hPm⟩
    refine Or.inr
      ⟨fun m => N + m, ?_, ?_⟩
    · intro a b hab
      exact Nat.add_lt_add_left hab N
    · intro m
      exact
        (hCases (N + m)).resolve_left
          (hNoP (N + m) (Nat.le_add_right N m))

/-
================================================================================
STATE-SHAPE BATCH
Stable canonical-corridor materialization

Incoming state shape:
  natSequenceTendsToInfinity nSeq
  bounded_full_K5_branch C nSeq dSeq
  Clip_can C nSeq dSeq

Outgoing state shape:
  ∃ nSub dSub,
    stableCanonicalCorridorSubsequence
      C nSeq dSeq nSub dSub

Effect:
  Passes to one explicit strictly monotone subsequence on which a single fixed
  canonical corridor orientation is retained at every index.  Divergence and
  the complete bounded full K5 branch are inherited from the parent sequence.

Public theorem:
  stabilize_Clip_can_to_fixed_canonical_corridor
================================================================================
-/

theorem stabilize_Clip_can_to_fixed_canonical_corridor
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hDiverges : natSequenceTendsToInfinity nSeq)
    (hBranch : bounded_full_K5_branch C nSeq dSeq)
    (hClip : Clip_can C nSeq dSeq) :
    ∃ nSub : ℕ → ℕ,
      ∃ dSub : ℕ → Fin 5 → ℕ,
        stableCanonicalCorridorSubsequence
          C nSeq dSeq nSub dSub := by
  rcases hClip with ⟨B, hB⟩
  have hCases :
      ∀ m : ℕ,
        orientationOffFaceProduct 2
            (nSeq m) (dSeq m) ≤ B ∨
          orientationOffFaceProduct 3
            (nSeq m) (dSeq m) ≤ B := by
    intro m
    have hMin :
        Nat.min
            (orientationOffFaceProduct 3
              (nSeq m) (dSeq m))
            (orientationOffFaceProduct 2
              (nSeq m) (dSeq m))
          ≤ B := by
      simpa [offFacePressureNat_eq_orientation_min] using hB m
    rcases (min_le_iff.mp hMin) with hThree | hTwo
    · exact Or.inr hThree
    · exact Or.inl hTwo

  rcases stabilize_binary_sequence_predicate hCases with
      ⟨phi, hPhi, hTwo⟩ | ⟨phi, hPhi, hThree⟩
  · let nSub : ℕ → ℕ := fun m => nSeq (phi m)
    let dSub : ℕ → Fin 5 → ℕ := fun m => dSeq (phi m)
    have hDivergesSub :
        natSequenceTendsToInfinity nSub :=
      natSequenceTendsToInfinity_strict_subsequence
        hDiverges hPhi
    have hBranchSub :
        bounded_full_K5_branch C nSub dSub :=
      bounded_full_K5_branch_strict_subsequence
        hBranch hPhi
    have hF2 : F2_corridor_state C nSub dSub :=
      ⟨hDivergesSub, hBranchSub, B, hTwo⟩
    exact
      ⟨nSub, dSub, phi, hPhi,
        (fun _m => rfl), (fun _m => rfl), Or.inl hF2⟩
  · let nSub : ℕ → ℕ := fun m => nSeq (phi m)
    let dSub : ℕ → Fin 5 → ℕ := fun m => dSeq (phi m)
    have hDivergesSub :
        natSequenceTendsToInfinity nSub :=
      natSequenceTendsToInfinity_strict_subsequence
        hDiverges hPhi
    have hBranchSub :
        bounded_full_K5_branch C nSub dSub :=
      bounded_full_K5_branch_strict_subsequence
        hBranch hPhi
    have hF3 : F3_corridor_state C nSub dSub :=
      ⟨hDivergesSub, hBranchSub, B, hThree⟩
    exact
      ⟨nSub, dSub, phi, hPhi,
        (fun _m => rfl), (fun _m => rfl), Or.inr hF3⟩

/- # Sub-sub-container 3.4.10: Canonical sector chamber. -/

/- Sub-sub-layer 01 -/
/-
Paper ref: 3.4.10
Sub-sub-box Label: `Canonical sector products: Z_ij from level-2 atoms or complementary level-3 atoms`
Sub-sub-inputs: `full_atom_model`, `bounded_full_K5_branch`, `Clip_can`
Sub-sub-outputs: `sector_products_Z_ij`
-/
def section_3_4_10_sub_sub_layer_01_sub_sub_box_01_label : String := "Canonical sector products: Z_ij from level-2 atoms or complementary level-3 atoms"
def section_3_4_10_sub_sub_layer_01_sub_sub_box_01_inputs : List String := ["full_atom_model [read]", "bounded_full_K5_branch [permission]", "Clip_can [read]"]
def section_3_4_10_sub_sub_layer_01_sub_sub_box_01_outputs : List String := ["sector_products_Z_ij [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.10, Sub-sub-layer 01, Sub-sub-box 01
Birth token: sector_products_Z_ij

For one off-diagonal endpoint pair `i,j`, the two canonical sector addresses are

  * the level-two address `{i,j}`;
  * its complementary level-three address.

An orientation-2 read uses the first atom bucket.  An orientation-3 read uses
the second.  The diagonal value is fixed to `1`; it is not one of the ten
unordered sectors and is ignored by the later incident products.

`Clip_can` supplies one bound for the pointwise minimum of the two orientation
products.  It therefore supplies, separately at each sequence index, an
orientation whose exact off-face product obeys that bound.  This box does not
claim that one orientation works globally along the whole sequence.

The output packet retains the same pointwise `full_atom_model`, the same
bounded-full-K5 permission, and the same clipping bound.  It births only the
exact symmetric positive sector families.  Endpoint coefficients, the total
sector product, the multiplier, reconstructed divisors, and root-window
alignment remain the job of layer 02.
================================================================================
-/

/-- A total family representing the ten unordered sector products. -/
abbrev SectorProductFamily :=
  Fin 5 → Fin 5 → ℕ

/-- The level-two sector address attached to the unordered pair `{i,j}`. -/
def twoFaceSectorAddress
    (i j : Fin 5) : SupportAddress :=
  {i, j}

@[simp]
theorem mem_twoFaceSectorAddress
    {i j k : Fin 5} :
    k ∈ twoFaceSectorAddress i j ↔
      k = i ∨ k = j := by
  simp [twoFaceSectorAddress]

/-- The level-two address is independent of endpoint order. -/
theorem twoFaceSectorAddress_comm
    (i j : Fin 5) :
    twoFaceSectorAddress i j =
      twoFaceSectorAddress j i := by
  ext k
  simp [twoFaceSectorAddress, or_comm]

/-- An off-diagonal level-two sector address has cardinality two. -/
theorem twoFaceSectorAddress_card
    {i j : Fin 5}
    (hij : i ≠ j) :
    (twoFaceSectorAddress i j).card = 2 := by
  simp [twoFaceSectorAddress, hij]

/-- Every off-diagonal pair address lies in the two-face corridor. -/
theorem twoFaceSectorAddress_is_twoFace
    {i j : Fin 5}
    (hij : i ≠ j) :
    twoFaceAddress (twoFaceSectorAddress i j) := by
  exact Or.inl (twoFaceSectorAddress_card hij)

/--
The complementary level-three address attached to the same unordered pair.
-/
def threeFaceSectorAddress
    (i j : Fin 5) : SupportAddress :=
  complementAddress (twoFaceSectorAddress i j)

@[simp]
theorem mem_threeFaceSectorAddress
    {i j k : Fin 5} :
    k ∈ threeFaceSectorAddress i j ↔
      k ≠ i ∧ k ≠ j := by
  simp [threeFaceSectorAddress, twoFaceSectorAddress]

/-- The complementary level-three address is independent of endpoint order. -/
theorem threeFaceSectorAddress_comm
    (i j : Fin 5) :
    threeFaceSectorAddress i j =
      threeFaceSectorAddress j i := by
  unfold threeFaceSectorAddress
  rw [twoFaceSectorAddress_comm i j]

/-- An off-diagonal complementary sector address has cardinality three. -/
theorem threeFaceSectorAddress_card
    {i j : Fin 5}
    (hij : i ≠ j) :
    (threeFaceSectorAddress i j).card = 3 := by
  unfold threeFaceSectorAddress complementAddress
  rw [Finset.card_compl]
  simp [twoFaceSectorAddress, hij]

/-- Every off-diagonal complementary address lies in the three-face corridor. -/
theorem threeFaceSectorAddress_is_threeFace
    {i j : Fin 5}
    (hij : i ≠ j) :
    threeFaceAddress (threeFaceSectorAddress i j) := by
  exact Or.inr (threeFaceSectorAddress_card hij)

/--
The support address read by one canonical orientation.  Only orientations
`2` and `3` are used by the output packet.
-/
def sectorAddressForOrientation
    (o : ℕ) (i j : Fin 5) : SupportAddress :=
  if o = 2 then
    twoFaceSectorAddress i j
  else
    threeFaceSectorAddress i j

@[simp]
theorem sectorAddressForOrientation_two
    (i j : Fin 5) :
    sectorAddressForOrientation 2 i j =
      twoFaceSectorAddress i j := by
  simp [sectorAddressForOrientation]

@[simp]
theorem sectorAddressForOrientation_three
    (i j : Fin 5) :
    sectorAddressForOrientation 3 i j =
      threeFaceSectorAddress i j := by
  simp [sectorAddressForOrientation]

/-- The selected sector address is symmetric in its endpoint order. -/
theorem sectorAddressForOrientation_comm
    (o : ℕ) (i j : Fin 5) :
    sectorAddressForOrientation o i j =
      sectorAddressForOrientation o j i := by
  by_cases ho : o = 2
  · simp [sectorAddressForOrientation, ho,
      twoFaceSectorAddress_comm]
  · simp [sectorAddressForOrientation, ho,
      threeFaceSectorAddress_comm]

/--
The exact sector read from the atom model.  The diagonal is set to `1`, since
only off-diagonal unordered pairs are sectors.
-/
noncomputable def sectorProductFromAtoms
    (o n : ℕ)
    (d : Fin 5 → ℕ)
    (i j : Fin 5) : ℕ :=
  if i = j then
    1
  else
    atomBucket n d
      (sectorAddressForOrientation o i j)

/-- Off the diagonal, the sector is exactly the selected atom bucket. -/
theorem sectorProductFromAtoms_eq_atom
    (o n : ℕ)
    (d : Fin 5 → ℕ)
    {i j : Fin 5}
    (hij : i ≠ j) :
    sectorProductFromAtoms o n d i j =
      atomBucket n d
        (sectorAddressForOrientation o i j) := by
  simp [sectorProductFromAtoms, hij]

/-- Orientation two reads the level-two pair atom. -/
theorem sectorProductFromAtoms_two
    (n : ℕ)
    (d : Fin 5 → ℕ)
    {i j : Fin 5}
    (hij : i ≠ j) :
    sectorProductFromAtoms 2 n d i j =
      atomBucket n d
        (twoFaceSectorAddress i j) := by
  simp [sectorProductFromAtoms, hij]

/-- Orientation three reads the complementary level-three pair atom. -/
theorem sectorProductFromAtoms_three
    (n : ℕ)
    (d : Fin 5 → ℕ)
    {i j : Fin 5}
    (hij : i ≠ j) :
    sectorProductFromAtoms 3 n d i j =
      atomBucket n d
        (threeFaceSectorAddress i j) := by
  simp [sectorProductFromAtoms, hij]

/-- The exact sector read is symmetric in its two endpoints. -/
theorem sectorProductFromAtoms_comm
    (o n : ℕ)
    (d : Fin 5 → ℕ)
    (i j : Fin 5) :
    sectorProductFromAtoms o n d i j =
      sectorProductFromAtoms o n d j i := by
  by_cases hij : i = j
  · subst j
    rfl
  · have hji : j ≠ i := Ne.symm hij
    simp [sectorProductFromAtoms, hij, hji,
      sectorAddressForOrientation_comm]

/-- Every exact sector read is a positive natural number. -/
theorem sectorProductFromAtoms_pos
    (o n : ℕ)
    (d : Fin 5 → ℕ)
    (i j : Fin 5) :
    0 < sectorProductFromAtoms o n d i j := by
  by_cases hij : i = j
  · simp [sectorProductFromAtoms, hij]
  · simpa [sectorProductFromAtoms, hij] using
      atomBucket_pos n d
        (sectorAddressForOrientation o i j)

/-- The complete exact sector family attached to one orientation. -/
noncomputable def sectorProductsFromAtoms
    (o n : ℕ)
    (d : Fin 5 → ℕ) : SectorProductFamily :=
  fun i j =>
    sectorProductFromAtoms o n d i j

@[simp]
theorem sectorProductsFromAtoms_apply
    (o n : ℕ)
    (d : Fin 5 → ℕ)
    (i j : Fin 5) :
    sectorProductsFromAtoms o n d i j =
      sectorProductFromAtoms o n d i j := by
  rfl

/-- The exact sector family is unordered. -/
theorem sectorProductsFromAtoms_comm
    (o n : ℕ)
    (d : Fin 5 → ℕ)
    (i j : Fin 5) :
    sectorProductsFromAtoms o n d i j =
      sectorProductsFromAtoms o n d j i :=
  sectorProductFromAtoms_comm o n d i j

/-- Every coordinate of the exact sector family is positive. -/
theorem sectorProductsFromAtoms_pos
    (o n : ℕ)
    (d : Fin 5 → ℕ)
    (i j : Fin 5) :
    0 < sectorProductsFromAtoms o n d i j :=
  sectorProductFromAtoms_pos o n d i j

/--
One exact clipped orientation at one sequence index.  The same natural bound
controls the selected orientation's off-face product.
-/
def selectedClippedOrientation
    (B n : ℕ)
    (d : Fin 5 → ℕ)
    (o : ℕ) : Prop :=
  (o = 2 ∨ o = 3) ∧
    orientationOffFaceProduct o n d ≤ B

/-- A minimum bound selects exactly one legal F2 or F3 orientation. -/
theorem offFacePressureNat_selects_clipped_orientation
    {B n : ℕ}
    {d : Fin 5 → ℕ}
    (hBound : offFacePressureNat n d ≤ B) :
    ∃ o : ℕ,
      selectedClippedOrientation B n d o := by
  have hmin :
      Nat.min
          (orientationOffFaceProduct 3 n d)
          (orientationOffFaceProduct 2 n d) ≤ B := by
    simpa [offFacePressureNat_eq_orientation_min] using hBound
  by_cases hthree :
      orientationOffFaceProduct 3 n d ≤
        orientationOffFaceProduct 2 n d
  · have hmin_eq :
        Nat.min
            (orientationOffFaceProduct 3 n d)
            (orientationOffFaceProduct 2 n d) =
          orientationOffFaceProduct 3 n d :=
      min_eq_left hthree
    rw [hmin_eq] at hmin
    exact ⟨3, Or.inr rfl, hmin⟩
  · have htwo :
        orientationOffFaceProduct 2 n d ≤
          orientationOffFaceProduct 3 n d :=
      Nat.le_of_lt (Nat.lt_of_not_ge hthree)
    have hmin_eq :
        Nat.min
            (orientationOffFaceProduct 3 n d)
            (orientationOffFaceProduct 2 n d) =
          orientationOffFaceProduct 2 n d :=
      min_eq_right htwo
    rw [hmin_eq] at hmin
    exact ⟨2, Or.inl rfl, hmin⟩

/-- One bounded pointwise witness with its exact selected clipped face. -/
def pointwiseClippedFaceState
    (C : ℝ)
    (Medge B Nclip n : ℕ)
    (d : Fin 5 → ℕ)
    (o : ℕ) : Prop :=
  Nclip ≤ n ∧
    boundedPointwiseCanonicalChamberData C Medge n d ∧
    offFacePressureNat n d ≤ B ∧
    selectedClippedOrientation B n d o

/-- Apply the exact clipping source and retain the orientation it selects. -/
theorem pointwiseClippedFaceState_of_source
    {C : ℝ}
    {Medge B Nclip n : ℕ}
    {d : Fin 5 → ℕ}
    (hSource :
      canonicalPointwiseClippingSourceAt C Medge B Nclip)
    (hThreshold : Nclip ≤ n)
    (hBounded :
      boundedPointwiseCanonicalChamberData C Medge n d) :
    ∃ o : ℕ,
      pointwiseClippedFaceState
        C Medge B Nclip n d o := by
  have hBound : offFacePressureNat n d ≤ B :=
    hSource n d hThreshold hBounded
  rcases offFacePressureNat_selects_clipped_orientation hBound with
    ⟨o, hSelected⟩
  exact ⟨o, hThreshold, hBounded, hBound, hSelected⟩

/--
A pointwise sector-family read from one selected clipped orientation.
-/
def sectorReadFromClippedFace
    (n : ℕ)
    (d : Fin 5 → ℕ)
    (o : ℕ)
    (Z : SectorProductFamily) : Prop :=
  Z = sectorProductsFromAtoms o n d ∧
    (∀ i j : Fin 5, Z i j = Z j i) ∧
    ∀ i j : Fin 5, 0 < Z i j

/-- The canonical atom read gives the exact symmetric positive sector packet. -/
theorem derive_sectorReadFromClippedFace
    (n : ℕ)
    (d : Fin 5 → ℕ)
    (o : ℕ) :
    sectorReadFromClippedFace n d o
      (sectorProductsFromAtoms o n d) := by
  refine ⟨rfl, ?_, ?_⟩
  · intro i j
    exact sectorProductsFromAtoms_comm o n d i j
  · intro i j
    exact sectorProductsFromAtoms_pos o n d i j

/--
A minimum clipping bound chooses a legal orientation separately at each
sequence index.  No globally fixed orientation is inferred.
-/
theorem Clip_can_selects_clipped_orientation
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hclip : Clip_can C nSeq dSeq) :
    ∃ B : ℕ, ∀ m : ℕ, ∃ o : ℕ,
      selectedClippedOrientation
        B (nSeq m) (dSeq m) o := by
  rcases hclip with ⟨B, hB⟩
  refine ⟨B, ?_⟩
  intro m
  have hmin :
      Nat.min
          (orientationOffFaceProduct 3
            (nSeq m) (dSeq m))
          (orientationOffFaceProduct 2
            (nSeq m) (dSeq m))
        ≤ B := by
    simpa [offFacePressureNat_eq_orientation_min] using hB m
  by_cases hthree :
      orientationOffFaceProduct 3
          (nSeq m) (dSeq m) ≤
        orientationOffFaceProduct 2
          (nSeq m) (dSeq m)
  · have hmin_eq :
        Nat.min
            (orientationOffFaceProduct 3
              (nSeq m) (dSeq m))
            (orientationOffFaceProduct 2
              (nSeq m) (dSeq m))
          =
        orientationOffFaceProduct 3
          (nSeq m) (dSeq m) :=
      min_eq_left hthree
    rw [hmin_eq] at hmin
    exact ⟨3, Or.inr rfl, hmin⟩
  · have htwo :
        orientationOffFaceProduct 2
            (nSeq m) (dSeq m) ≤
          orientationOffFaceProduct 3
            (nSeq m) (dSeq m) :=
      Nat.le_of_lt (Nat.lt_of_not_ge hthree)
    have hmin_eq :
        Nat.min
            (orientationOffFaceProduct 3
              (nSeq m) (dSeq m))
            (orientationOffFaceProduct 2
              (nSeq m) (dSeq m))
          =
        orientationOffFaceProduct 2
          (nSeq m) (dSeq m) :=
      min_eq_right htwo
    rw [hmin_eq] at hmin
    exact ⟨2, Or.inl rfl, hmin⟩

/--
The layer-01 output.  At every sequence index it exposes one selected clipped
orientation and the exact symmetric positive sector family read from that
orientation's atom buckets.
-/
def sector_products_Z_ij
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  (∀ m : ℕ,
    full_atom_model (nSeq m) (dSeq m)) ∧
    fixedCanonicalCorridorState C nSeq dSeq ∧
    Clip_can C nSeq dSeq ∧
    ∃ B o : ℕ,
      offProfileOrientation o ∧
        (∀ m : ℕ,
          selectedClippedOrientation
            B (nSeq m) (dSeq m) o) ∧
        ∀ m : ℕ,
          ∃ Z : SectorProductFamily,
            sectorReadFromClippedFace
              (nSeq m) (dSeq m) o Z

/--
The exact atom models, bounded-full permission, and clipping bound produce the
pointwise canonical sector-family packet.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.10, Sub-sub-layer 01, Sub-sub-box 01

Incoming state shape:
  pointwise full_atom_model
  fixedCanonicalCorridorState C nSeq dSeq

Outgoing state shape:
  sector_products_Z_ij C nSeq dSeq

Effect:
  Retains the one already stabilized F2 or F3 orientation and reads every
  symmetric positive sector-product family from that same fixed corridor.

Public theorem:
  derive_sector_products_Z_ij

================================================================================
-/

theorem derive_sector_products_Z_ij
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hmodel :
      ∀ m : ℕ,
        full_atom_model (nSeq m) (dSeq m))
    (hCorridor :
      fixedCanonicalCorridorState C nSeq dSeq) :
    sector_products_Z_ij C nSeq dSeq := by
  have hclip :
      Clip_can C nSeq dSeq :=
    Clip_can_of_fixedCanonicalCorridorState hCorridor
  rcases hCorridor with hF2 | hF3
  · rcases hF2.2.2 with ⟨B, hB⟩
    refine
      ⟨hmodel, Or.inl hF2, hclip,
        B, 2, Or.inl rfl, ?_, ?_⟩
    · intro m
      exact ⟨Or.inl rfl, hB m⟩
    · intro m
      exact
        ⟨sectorProductsFromAtoms 2 (nSeq m) (dSeq m),
          derive_sectorReadFromClippedFace
            (nSeq m) (dSeq m) 2⟩
  · rcases hF3.2.2 with ⟨B, hB⟩
    refine
      ⟨hmodel, Or.inr hF3, hclip,
        B, 3, Or.inr rfl, ?_, ?_⟩
    · intro m
      exact ⟨Or.inr rfl, hB m⟩
    · intro m
      exact
        ⟨sectorProductsFromAtoms 3 (nSeq m) (dSeq m),
          derive_sectorReadFromClippedFace
            (nSeq m) (dSeq m) 3⟩

/- Sub-sub-layer 02 -/
/-
Paper ref: 3.4.10
Sub-sub-box Label: `Canonical sector chamber: Z_W=(Z,T,b,P,m_W,Dhat), T_i, b_ij, P(W), reconstructed divisors, and root-window alignment`
Sub-sub-inputs: `sector_products_Z_ij`, `Clip_can`
Sub-sub-outputs: `Sector_can`
-/
def section_3_4_10_sub_sub_layer_02_sub_sub_box_02_label : String := "Canonical sector chamber: Z_W=(Z,T,b,P,m_W,Dhat), T_i, b_ij, P(W), reconstructed divisors, and root-window alignment"
def section_3_4_10_sub_sub_layer_02_sub_sub_box_02_inputs : List String := ["sector_products_Z_ij [read]", "Clip_can [read]"]
def section_3_4_10_sub_sub_layer_02_sub_sub_box_02_outputs : List String := ["Sector_can [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.10, Sub-sub-layer 02, Sub-sub-box 02
Birth token: Sector_can

Layer 01 has already produced, at each sequence index, one selected orientation
and one exact symmetric positive sector family `Z`.

This box defines the remaining chamber coordinates:

  T_i     = product of the four sectors incident to endpoint i,
  P       = product of the ten unordered sectors,
  Dhat_i  = P / T_i,
  b_ij    = signed endpoint coefficient,
  mW      = global multiplier.

The incident and total products, their positivity, the signed endpoint equation,
and the elementary skew-symmetry consequence for `b` are local executable
mathematics.

The existence of uniformly bounded nonzero endpoint coefficients, the exact
multiplier identity, and root-window alignment is the paper's clipped-sector
reconstruction theorem source.  It is represented explicitly by
`canonicalSectorChamberReconstructionSource`.  A proof of that proposition is
the theorem-source kernel consumed by `build_Sector_can`.

The selected orientations, sectors, coefficients, and multipliers are
materialized once as sequence-indexed functions.  No pointwise object is
reselected independently after the chamber is packaged.  No Section 3.5
geometry, balanced growth, rank, prefix, affine, or internal obstruction data
is used here.
================================================================================
-/

/-- A signed coefficient on every ordered endpoint pair. -/
abbrev EndpointCoefficientFamily :=
  Fin 5 → Fin 5 → ℤ

/-- The four sectors incident to endpoint `i`. -/
def incidentSectorProduct
    (Z : SectorProductFamily)
    (i : Fin 5) : ℕ :=
  ∏ r ∈ Finset.univ.erase i, Z i r

/--
The ten unordered non-loop endpoint pairs, represented by their increasing
orientation.
-/
def unorderedSectorEdges :
    Finset (Fin 5 × Fin 5) :=
  Finset.univ.filter fun e => e.1 < e.2

@[simp]
theorem mem_unorderedSectorEdges
    {i j : Fin 5} :
    (i, j) ∈ unorderedSectorEdges ↔ i < j := by
  simp [unorderedSectorEdges]

/-- The product of the ten unordered sector coordinates. -/
def totalSectorProduct
    (Z : SectorProductFamily) : ℕ :=
  ∏ e ∈ unorderedSectorEdges, Z e.1 e.2

/-- The canonical reconstructed upper divisor `P / T_i`. -/
def reconstructedSectorDivisor
    (Z : SectorProductFamily)
    (i : Fin 5) : ℕ :=
  totalSectorProduct Z / incidentSectorProduct Z i

/-- The incident-product definition reads exactly as `T_i`. -/
theorem incidentSectorProduct_read
    (Z : SectorProductFamily)
    (i : Fin 5) :
    incidentSectorProduct Z i =
      ∏ r ∈ Finset.univ.erase i, Z i r := by
  rfl

/-- The total-product definition reads exactly as the unordered K5 product. -/
theorem totalSectorProduct_read
    (Z : SectorProductFamily) :
    totalSectorProduct Z =
      ∏ e ∈ unorderedSectorEdges, Z e.1 e.2 := by
  rfl

/-- The reconstructed divisor reads exactly as `P / T_i`. -/
theorem reconstructedSectorDivisor_read
    (Z : SectorProductFamily)
    (i : Fin 5) :
    reconstructedSectorDivisor Z i =
      totalSectorProduct Z / incidentSectorProduct Z i := by
  rfl

/-- Positive sectors give a positive incident product at every endpoint. -/
theorem incidentSectorProduct_pos
    {Z : SectorProductFamily}
    (hpos : ∀ i j : Fin 5, 0 < Z i j)
    (i : Fin 5) :
    0 < incidentSectorProduct Z i := by
  unfold incidentSectorProduct
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro r _hr
    exact hpos i r)

/-- Positive sectors give a positive total sector product. -/
theorem totalSectorProduct_pos
    {Z : SectorProductFamily}
    (hpos : ∀ i j : Fin 5, 0 < Z i j) :
    0 < totalSectorProduct Z := by
  unfold totalSectorProduct
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro e _he
    exact hpos e.1 e.2)

/-- Increasing representative of the unordered edge joining two endpoints. -/
def canonicalUnorderedSectorEdge
    (i r : Fin 5) : Fin 5 × Fin 5 :=
  if i < r then (i, r) else (r, i)

theorem canonicalUnorderedSectorEdge_mem
    {i r : Fin 5}
    (hir : i ≠ r) :
    canonicalUnorderedSectorEdge i r ∈ unorderedSectorEdges := by
  fin_cases i <;> fin_cases r <;>
    simp_all [canonicalUnorderedSectorEdge, unorderedSectorEdges]

theorem canonicalUnorderedSectorEdge_injective
    (i : Fin 5) :
    Set.InjOn
      (canonicalUnorderedSectorEdge i)
      (Finset.univ.erase i : Finset (Fin 5)) := by
  intro r hr s hs hrs
  fin_cases i <;> fin_cases r <;> fin_cases s <;>
    simp_all [canonicalUnorderedSectorEdge]

theorem canonicalUnorderedSectorEdge_factor
    {Z : SectorProductFamily}
    (hSymmetry : ∀ i j : Fin 5, Z i j = Z j i)
    {i r : Fin 5}
    (hir : r ≠ i) :
    Z (canonicalUnorderedSectorEdge i r).1
        (canonicalUnorderedSectorEdge i r).2 =
      Z i r := by
  by_cases hlt : i < r
  · simp [canonicalUnorderedSectorEdge, hlt]
  · have hri : r < i := lt_of_le_of_ne (le_of_not_gt hlt) hir
    simp [canonicalUnorderedSectorEdge, hlt, hSymmetry]

/--
For a symmetric K5 sector family, the four sectors incident to an endpoint
form a subproduct of the ten unordered sectors.
-/
theorem incidentSectorProduct_dvd_totalSectorProduct
    {Z : SectorProductFamily}
    (hSymmetry : ∀ i j : Fin 5, Z i j = Z j i)
    (i : Fin 5) :
    incidentSectorProduct Z i ∣ totalSectorProduct Z := by
  classical
  let incidentEdges :=
    (Finset.univ.erase i).image
      (canonicalUnorderedSectorEdge i)
  have hSubset : incidentEdges ⊆ unorderedSectorEdges := by
    intro e he
    rcases Finset.mem_image.mp he with ⟨r, hr, rfl⟩
    exact canonicalUnorderedSectorEdge_mem
      (Ne.symm (Finset.ne_of_mem_erase hr))
  have hProduct :
      (∏ e ∈ incidentEdges, Z e.1 e.2) =
        incidentSectorProduct Z i := by
    unfold incidentEdges incidentSectorProduct
    rw [Finset.prod_image
      (canonicalUnorderedSectorEdge_injective i)]
    apply Finset.prod_congr rfl
    intro r hr
    exact canonicalUnorderedSectorEdge_factor hSymmetry
      (Finset.ne_of_mem_erase hr)
  rw [← hProduct]
  exact Finset.prod_dvd_prod_of_subset
    incidentEdges unorderedSectorEdges
    (fun e => Z e.1 e.2) hSubset

/--
The signed endpoint equations
`T_j - T_i = b_ij * Z_ij` for every ordered non-loop pair.
-/
def endpointSectorEquations
    (Z : SectorProductFamily)
    (b : EndpointCoefficientFamily) : Prop :=
  ∀ i j : Fin 5, i ≠ j →
    (incidentSectorProduct Z j : ℤ) -
        (incidentSectorProduct Z i : ℤ)
      =
    b i j * (Z i j : ℤ)

/--
The nonzero and uniformly bounded endpoint-coefficient output.  The absolute
value is represented by `Int.natAbs`.
-/
def endpointCoefficientBounds
    (b : EndpointCoefficientFamily)
    (M : ℕ) : Prop :=
  ∀ i j : Fin 5, i ≠ j →
    b i j ≠ 0 ∧
      1 ≤ Int.natAbs (b i j) ∧
      Int.natAbs (b i j) ≤ M

/--
The complete pointwise chamber equations for one selected exact sector family.
The support read is retained so all later coordinates refer to the same `Z`.
-/
def canonicalSectorChamberAt
    (C : ℝ)
    (n : ℕ)
    (d : Fin 5 → ℕ)
    (o : ℕ)
    (Z : SectorProductFamily)
    (b : EndpointCoefficientFamily)
    (M mW : ℕ) : Prop :=
  sectorReadFromClippedFace n d o Z ∧
    endpointSectorEquations Z b ∧
    endpointCoefficientBounds b M ∧
    n = totalSectorProduct Z * mW ∧
    0 < mW ∧
    ∀ i : Fin 5,
      inRootBand C
        (totalSectorProduct Z * mW)
        (reconstructedSectorDivisor Z i)

/-- A pointwise chamber retains the symmetry of its exact sector read. -/
theorem canonicalSectorChamberAt_sector_symmetry
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    ∀ i j : Fin 5, Z i j = Z j i :=
  hchamber.1.2.1

/-- A pointwise chamber retains positive integer sectors. -/
theorem canonicalSectorChamberAt_sector_pos
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    ∀ i j : Fin 5, 0 < Z i j :=
  hchamber.1.2.2

/-- The algebraic sector law retained downstream is nonvanishing. -/
theorem canonicalSectorChamberAt_sector_ne_zero
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW)
    (i j : Fin 5) :
    Z i j ≠ 0 :=
  Nat.ne_of_gt
    (canonicalSectorChamberAt_sector_pos hchamber i j)

/-- Every incident product in a pointwise chamber is positive. -/
theorem canonicalSectorChamberAt_incident_pos
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW)
    (i : Fin 5) :
    0 < incidentSectorProduct Z i :=
  incidentSectorProduct_pos
    (canonicalSectorChamberAt_sector_pos hchamber) i

/-- The total sector product in a pointwise chamber is positive. -/
theorem canonicalSectorChamberAt_total_pos
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    0 < totalSectorProduct Z :=
  totalSectorProduct_pos
    (canonicalSectorChamberAt_sector_pos hchamber)

/--
The endpoint equations and symmetric nonzero sectors force the expected
skew-symmetry `b_ji = -b_ij`.
-/
theorem endpointCoefficient_skew
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    (hsym : ∀ i j : Fin 5, Z i j = Z j i)
    (hpos : ∀ i j : Fin 5, 0 < Z i j)
    (hequations : endpointSectorEquations Z b)
    {i j : Fin 5}
    (hij : i ≠ j) :
    b j i = -b i j := by
  have hji : j ≠ i := Ne.symm hij
  have hijEq := hequations i j hij
  have hjiEq := hequations j i hji
  have hsym' : Z j i = Z i j := hsym j i
  rw [hsym'] at hjiEq

  have hzero :
      b i j * (Z i j : ℤ) +
          b j i * (Z i j : ℤ) = 0 := by
    rw [← hijEq, ← hjiEq]
    ring

  have hfactor :
      (b i j + b j i) * (Z i j : ℤ) = 0 := by
    calc
      (b i j + b j i) * (Z i j : ℤ)
          =
          b i j * (Z i j : ℤ) +
            b j i * (Z i j : ℤ) := by
              ring
      _ = 0 := hzero

  have hZnat : Z i j ≠ 0 :=
    Nat.ne_of_gt (hpos i j)
  have hZint : (Z i j : ℤ) ≠ 0 := by
    simpa using hZnat
  have hsum : b i j + b j i = 0 :=
    (mul_eq_zero.mp hfactor).resolve_right hZint
  linarith

/-- The pointwise chamber therefore has skew endpoint coefficients. -/
theorem canonicalSectorChamberAt_coefficient_skew
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW)
    {i j : Fin 5}
    (hij : i ≠ j) :
    b j i = -b i j := by
  exact endpointCoefficient_skew
    hchamber.1.2.1
    hchamber.1.2.2
    hchamber.2.1
    hij

/--
The pointwise chamber's global multiplier equation, read without changing the
selected sector family.
-/
theorem canonicalSectorChamberAt_multiplier
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    n = totalSectorProduct Z * mW :=
  hchamber.2.2.2.1

/-- The pointwise chamber's reconstructed divisors satisfy the root window. -/
theorem canonicalSectorChamberAt_root_alignment
    {C : ℝ}
    {n : ℕ}
    {d : Fin 5 → ℕ}
    {o : ℕ}
    {Z : SectorProductFamily}
    {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    ∀ i : Fin 5,
      inRootBand C
        (totalSectorProduct Z * mW)
        (reconstructedSectorDivisor Z i) :=
  hchamber.2.2.2.2.2

/-- Every incident sector product divides the exact total sector product. -/
theorem canonicalSectorChamberAt_incident_dvd_total
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {o : ℕ}
    {Z : SectorProductFamily} {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW)
    (i : Fin 5) :
    incidentSectorProduct Z i ∣ totalSectorProduct Z :=
  incidentSectorProduct_dvd_totalSectorProduct
    (canonicalSectorChamberAt_sector_symmetry hchamber) i

/-- The reconstructed quotient multiplies back to the exact total product. -/
theorem canonicalSectorChamberAt_reconstructed_mul_incident
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {o : ℕ}
    {Z : SectorProductFamily} {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW)
    (i : Fin 5) :
    reconstructedSectorDivisor Z i *
        incidentSectorProduct Z i =
      totalSectorProduct Z := by
  unfold reconstructedSectorDivisor
  exact Nat.div_mul_cancel
    (canonicalSectorChamberAt_incident_dvd_total hchamber i)

/-- Every reconstructed sector divisor is positive. -/
theorem canonicalSectorChamberAt_reconstructed_pos
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {o : ℕ}
    {Z : SectorProductFamily} {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW)
    (i : Fin 5) :
    0 < reconstructedSectorDivisor Z i := by
  unfold reconstructedSectorDivisor
  apply Nat.div_pos
  · exact Nat.le_of_dvd
      (canonicalSectorChamberAt_total_pos hchamber)
      (canonicalSectorChamberAt_incident_dvd_total hchamber i)
  · exact canonicalSectorChamberAt_incident_pos hchamber i

/-- Every reconstructed sector divisor divides the original integer `n`. -/
theorem canonicalSectorChamberAt_reconstructed_dvd_n
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {o : ℕ}
    {Z : SectorProductFamily} {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW)
    (i : Fin 5) :
    reconstructedSectorDivisor Z i ∣ n := by
  have hDivTotal :
      reconstructedSectorDivisor Z i ∣
        totalSectorProduct Z :=
    ⟨incidentSectorProduct Z i,
      (canonicalSectorChamberAt_reconstructed_mul_incident
        hchamber i).symm⟩
  have hTotalDivN : totalSectorProduct Z ∣ n :=
    ⟨mW, canonicalSectorChamberAt_multiplier hchamber⟩
  exact dvd_trans hDivTotal hTotalDivN

/-- Nonzero endpoint coefficients force distinct incident products. -/
theorem canonicalSectorChamberAt_incident_injective
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {o : ℕ}
    {Z : SectorProductFamily} {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    Function.Injective (incidentSectorProduct Z) := by
  intro i j hIncident
  by_contra hij
  have hEquation := hchamber.2.1 i j hij
  have hCoefficientNonzero := (hchamber.2.2.1 i j hij).1
  have hSectorNonzero :
      (Z i j : ℤ) ≠ 0 := by
    exact_mod_cast
      (canonicalSectorChamberAt_sector_ne_zero hchamber i j)
  rw [hIncident, sub_self] at hEquation
  have hProductZero : b i j * (Z i j : ℤ) = 0 :=
    hEquation.symm
  rcases mul_eq_zero.mp hProductZero with hCoefficientZero | hSectorZero
  · exact hCoefficientNonzero hCoefficientZero
  · exact hSectorNonzero hSectorZero

/-- The five reconstructed sector divisors form an injective family. -/
theorem canonicalSectorChamberAt_reconstructed_injective
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {o : ℕ}
    {Z : SectorProductFamily} {b : EndpointCoefficientFamily}
    {M mW : ℕ}
    (hchamber :
      canonicalSectorChamberAt C n d o Z b M mW) :
    Function.Injective (reconstructedSectorDivisor Z) := by
  intro i j hReconstructed
  have hMulI :=
    canonicalSectorChamberAt_reconstructed_mul_incident hchamber i
  have hMulJ :=
    canonicalSectorChamberAt_reconstructed_mul_incident hchamber j
  have hIncident :
      incidentSectorProduct Z i =
        incidentSectorProduct Z j := by
    apply Nat.eq_of_mul_eq_mul_left
      (canonicalSectorChamberAt_reconstructed_pos hchamber j)
    calc
      reconstructedSectorDivisor Z j *
          incidentSectorProduct Z i =
        reconstructedSectorDivisor Z i *
          incidentSectorProduct Z i := by rw [hReconstructed]
      _ = totalSectorProduct Z := hMulI
      _ = reconstructedSectorDivisor Z j *
          incidentSectorProduct Z j := hMulJ.symm
  exact
    canonicalSectorChamberAt_incident_injective
      hchamber hIncident

/--
Pointwise sector read at the exact clipped orientation selected upstream.
This source cannot choose a second face.
-/
def canonicalPointwiseSectorChamberSourceAt
    (C : ℝ)
    (Medge B Nclip Nsector Msector : ℕ) : Prop :=
  ∀ n : ℕ,
    ∀ d : Fin 5 → ℕ,
      ∀ o : ℕ,
        Nsector ≤ n →
        pointwiseClippedFaceState C Medge B Nclip n d o →
        ∃ Z : SectorProductFamily,
          ∃ b : EndpointCoefficientFamily,
            ∃ mW : ℕ,
              canonicalSectorChamberAt
                C n d o Z b Msector mW

/-- Named owner of the pointwise sector threshold and coefficient bound. -/
def section_3_4_10_pointwise_sector_source_label : String :=
  "Canonical pointwise sector-chamber theorem-source target"
def section_3_4_10_pointwise_sector_source_inputs : List String :=
  ["positive window constant [permission]",
   "pointwiseResolvedChamberEntryPacket [read]",
   "canonicalPointwiseClippingSourceAt [read]"]
def section_3_4_10_pointwise_sector_source_outputs : List String :=
  ["canonicalPointwiseSectorChamberSourceAt [birth]"]

def derive_canonicalPointwiseSectorChamberSource : Prop :=
  ∀ {C : ℝ}
    {Nedge Medge B Nclip : ℕ},
    0 < C →
    pointwiseResolvedChamberEntryPacket C Nedge Medge →
    canonicalPointwiseClippingSourceAt C Medge B Nclip →
    ∃ Nsector Msector : ℕ,
      canonicalPointwiseSectorChamberSourceAt
        C Medge B Nclip Nsector Msector

/--
The theorem-source kernel of layer 02.  One uniform coefficient bound `M`
works across the sequence.  Every exact sector read selected by layer 01 can be
completed, without changing its orientation or sector family, to endpoint
coefficients and a global multiplier satisfying the full chamber equations.
-/
def canonicalSectorChamberReconstructionSource
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  external_violation_sequence_state C nSeq dSeq ∧
  ∃ M : ℕ, 1 ≤ M ∧
    ∀ B m o Z,
      selectedClippedOrientation
          B (nSeq m) (dSeq m) o →
      sectorReadFromClippedFace
          (nSeq m) (dSeq m) o Z →
      ∃ b : EndpointCoefficientFamily, ∃ mW : ℕ,
        canonicalSectorChamberAt
          C (nSeq m) (dSeq m) o Z b M mW

/--
The still-open owner that must derive the complete sector-chamber source from
the exact stabilized corridor, sector products, and clipping bound.
-/
def derive_canonicalSectorChamberReconstructionSource : Prop :=
  ∀ {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ},
    external_violation_sequence_state C nSeq dSeq →
      fixedCanonicalCorridorState C nSeq dSeq →
        sector_products_Z_ij C nSeq dSeq →
          Clip_can C nSeq dSeq →
            canonicalSectorChamberReconstructionSource C nSeq dSeq

/--
The complete sequence-level canonical sector chamber.  The four component
families are materialized once and all chamber equations read from those same
choices.
-/
def Sector_can
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  external_violation_sequence_state C nSeq dSeq ∧
    sector_products_Z_ij C nSeq dSeq ∧
    Clip_can C nSeq dSeq ∧
    ∃ B M : ℕ,
      ∃ o : ℕ,
      ∃ ZSeq : ℕ → SectorProductFamily,
      ∃ bSeq : ℕ → EndpointCoefficientFamily,
      ∃ mWSeq : ℕ → ℕ,
        1 ≤ M ∧
        offProfileOrientation o ∧
        (∀ m : ℕ,
          selectedClippedOrientation
            B (nSeq m) (dSeq m) o) ∧
        ∀ m : ℕ,
          canonicalSectorChamberAt
            C (nSeq m) (dSeq m)
            o (ZSeq m) (bSeq m) M (mWSeq m)

/--
Layer 01 together with the clipped-sector reconstruction theorem source
produces one coherent canonical chamber family.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.10, Sub-sub-layer 02, Sub-sub-box 02

Incoming state shape:
  external_violation_sequence_state C nSeq dSeq
  sector_products_Z_ij C nSeq dSeq
  Clip_can C nSeq dSeq
  canonicalSectorChamberReconstructionSource C nSeq dSeq

Outgoing state shape:
  Sector_can C nSeq dSeq

Effect:
  Materializes one coherent sequence of sector chambers with one globally
  fixed F2 or F3 orientation, endpoint coefficients, multipliers,
  reconstructed divisors, and root-window alignment.

Semantic kind:
  retained same-witness reconstruction.

Public theorem:
  build_Sector_can

================================================================================
-/

theorem build_Sector_can
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hExternal :
      external_violation_sequence_state C nSeq dSeq)
    (hsectors :
      sector_products_Z_ij C nSeq dSeq)
    (hclip :
      Clip_can C nSeq dSeq)
    (hsource :
      canonicalSectorChamberReconstructionSource
        C nSeq dSeq) :
    Sector_can C nSeq dSeq := by
  classical
  rcases hsectors with
    ⟨hmodel, hCorridor, hclipStored,
      B, o, hOrientation, hselected, hreads⟩
  have hsectorsStored :
      sector_products_Z_ij C nSeq dSeq :=
    ⟨hmodel, hCorridor, hclipStored,
      B, o, hOrientation, hselected, hreads⟩

  choose ZSeq hZSeq using hreads

  rcases hsource with ⟨_hExternalStored, M, hM, hreconstruct⟩

  have hpointwise :
      ∀ m : ℕ,
        ∃ b : EndpointCoefficientFamily, ∃ mW : ℕ,
          canonicalSectorChamberAt
            C (nSeq m) (dSeq m)
            o (ZSeq m) b M mW := by
    intro m
    exact hreconstruct
      B m o (ZSeq m)
      (hselected m)
      (hZSeq m)

  choose bSeq hbSeq using hpointwise
  choose mWSeq hchamber using hbSeq

  refine
    ⟨hExternal, hsectorsStored, hclip, B, M,
      o, ZSeq, bSeq, mWSeq,
      hM, hOrientation, hselected, hchamber⟩

