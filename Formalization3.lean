    (sourceData : SameKPrefixAverageFormulaSourceData D)
    (i : Fin 3) : ℚ :=
  (SameKEndpointPolynomial.sameKAffineKappa affineData
          (adjacentPairLeftAddress i) *
        adjacentAffineRatio sourceData (adjacentPairLeftAddress i) +
      SameKEndpointPolynomial.sameKAffineKappa affineData
          (adjacentPairRightAddress i) *
        adjacentAffineRatio sourceData (adjacentPairRightAddress i)) /
    (SameKEndpointPolynomial.sameKAffineKappa affineData
          (adjacentPairLeftAddress i) +
      SameKEndpointPolynomial.sameKAffineKappa affineData
          (adjacentPairRightAddress i))

/-- Positivity makes the denominator of the explanatory weighted average nonzero. -/
theorem twoGapWeightedAverage_denominator_nonzero
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {D : Type}
    {survivorData : PrefixConflict.ClosedPrefixSurvivorData D}
    {affineData : SameKEndpointPolynomial.SameKAffinePencilData D}
    {polynomialData :
      SameKEndpointPolynomial.EndpointPolynomialSourceData D}
    {productRowData : ProductRowExtraction.SameKProductRowSourceData D}
    {sourceData : SameKPrefixAverageFormulaSourceData D}
    (hRatiosAt :
      adjacent_affine_ratios_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData)
    (i : Fin 3) :
    SameKEndpointPolynomial.sameKAffineKappa affineData
          (adjacentPairLeftAddress i) +
        SameKEndpointPolynomial.sameKAffineKappa affineData
          (adjacentPairRightAddress i) ≠ 0 := by
  rcases hRatiosAt with ⟨_hContextAt, hSourceAt, _hQuotient⟩
  rcases hSourceAt with
    ⟨_hSurvivorIndex, _hAffineIndex, _hPolynomialIndex, _hProductRowIndex,
      hPositive, _hRatio, _hVertexFacts, _hPrefixFacts, _hConversionRules⟩
  exact
    ne_of_gt
      (add_pos
        (hPositive (adjacentPairLeftAddress i))
        (hPositive (adjacentPairRightAddress i)))

/-- The primitive left-anchored balance on one adjacent pair. -/
def leftAnchoredWeightedBalance
    {D : Type}
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
