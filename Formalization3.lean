  low-rank source coherence and selected monochrome color, and packages these
  with the direct rank and coloring states.  The same survivor is reused; no
  coloring, prefix packet, coefficient pattern, or monochrome branch is
  selected again, and no rank-three object is merged into the output.

Public theorem:
  build_FG_mono
================================================================================
-/

theorem build_FG_mono
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hRank :
      RankTrichotomy.S_rank C nSeq dSeq opening)
    (hRegular :
      regular_coloring_problem C nSeq dSeq opening)
    (hAlternatives :
      regular_coloring_alternatives C nSeq dSeq opening)
    (hK :
      K C nSeq dSeq opening) :
    FG_mono C nSeq dSeq opening := by
  have hKState : K C nSeq dSeq opening := hK
  rcases hK with
    ⟨_hRankFromK, _hFamilyFromK, hKComponents⟩
  rcases hKComponents with
    ⟨_hRegularFromK, _hAlternativesFromK, _hIntervalFromK,
      _hPatternFromK, _hRankFromComponents, _hFamilyFromComponents,
      _hEliminatedFromK, D, survivorData, hComponentsAt⟩

  have hComponentsAtState :
      K_components_at C nSeq dSeq opening survivorData :=
    hComponentsAt

  rcases hComponentsAt with
    ⟨_hDataSource, _hRegularAt, _hAlternativesAt,
      _hIntervalSource, _hIntervalAt, _hFrozenSource, _hFrozenAt,
      _hFrozenMatch, hLowCoherence, _hLowerClosed, _hFamilyAt,
      _hSameBranch, _hEliminatedAt, hSelectedColor⟩

  have hMonoAt :
      monochrome_low_rank_datum_at
        C nSeq dSeq opening survivorData :=
    ⟨hComponentsAtState, hLowCoherence, hSelectedColor⟩

  exact
    ⟨hRank, hRegular, hAlternatives, hKState,
      D, survivorData, hMonoAt⟩


