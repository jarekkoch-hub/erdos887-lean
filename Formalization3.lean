-/

/--
A nonzero rational polynomial of degree at most three has at most three roots
inside any finite root sample.
-/
theorem degree_three_polynomial_root_bound
    (P : Polynomial ℚ)
    (hNonzero : P ≠ 0)
    (hDegree : P.natDegree ≤ 3)
    (roots : Finset ℚ)
    (hRoots : ∀ T : ℚ, T ∈ roots → P.eval T = 0) :
    roots.card ≤ 3 := by
  by_contra hNotAtMostThree
  have hThreeLt : 3 < roots.card :=
    Nat.lt_of_not_ge hNotAtMostThree
  have hDegreeLt : P.natDegree < roots.card :=
    lt_of_le_of_lt hDegree hThreeLt
  have hZero : P = 0 :=
    Polynomial.eq_zero_of_natDegree_lt_card_of_eval_eq_zero'
      P roots hRoots hDegreeLt
  exact hNonzero hZero

/-- The zero-polynomial assertion for every endpoint row in one source datum. -/
def endpoint_polynomial_identity_at
    {D : Type}
    (polynomialData : EndpointPolynomialSourceData D) : Prop :=
  ∀ e : Section6.K5EdgeAddress,
    endpointPolynomialFamily polynomialData e = 0

/--
The retained source laws imply the endpoint-polynomial identity on every fixed
K5 edge address.
-/
theorem endpoint_polynomial_identity_of_source
    {D : Type}
    {survivorData : PrefixConflict.ClosedPrefixSurvivorData D}
    {affineData : SameKAffinePencilData D}
    {polynomialData : EndpointPolynomialSourceData D}
    (hPolynomialAt :
      endpoint_polynomial_data_at
        survivorData affineData polynomialData) :
    endpoint_polynomial_identity_at polynomialData := by
  classical
  rcases hPolynomialAt with
    ⟨_hSurvivorIndex, _hAffineIndex, hInfinite, hRows⟩
  intro e
  by_contra hNonzero
  obtain ⟨roots, hRootsSubset, hRootsCard⟩ :=
    hInfinite.exists_subset_card_eq 4
  have hEvalRoots :
      ∀ T : ℚ, T ∈ roots →
        (endpointPolynomialFamily polynomialData e).eval T = 0 := by
    intro T hT
    have hValid :
        T ∈ endpointPolynomialValidSet polynomialData :=
      hRootsSubset (by simpa using hT)
    exact (hRows e).2 T hValid
  have hAtMostThree : roots.card ≤ 3 :=
    degree_three_polynomial_root_bound
      (endpointPolynomialFamily polynomialData e)
      hNonzero
      (hRows e).1
      roots
      hEvalRoots
  rw [hRootsCard] at hAtMostThree
  exact (Nat.not_succ_le_self 3) hAtMostThree

/--
The Section 10 polynomial-identity state.  It retains the exact source datum and
adds the identity theorem without changing the survivor, pencil, valid set, or
polynomial family.
-/
def endpoint_polynomial_identity
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  endpoint_polynomial_data_over_K C nSeq dSeq opening ∧
    ∃ D : Type,
      ∃ survivorData : PrefixConflict.ClosedPrefixSurvivorData D,
        ∃ affineData : SameKAffinePencilData D,
          ∃ polynomialData : EndpointPolynomialSourceData D,
            A_e_affine_pencil_at
                C nSeq dSeq opening survivorData affineData ∧
              endpoint_polynomial_data_at
                  survivorData affineData polynomialData ∧
                endpoint_polynomial_identity_at polynomialData

