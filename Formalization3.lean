-/
def pre_box_layer_01_box_01_label : String := "D_C(n) near-root divisor count"
def pre_box_layer_01_box_01_inputs : List String := []
def pre_box_layer_01_box_01_outputs : List String := ["D_C [route]"]


/-
================================================================================
EXECUTABLE BOX
Container 1, Layer 01, Box 01
Birth / route token: D_C

This box owns only:
  * the fourth-root scale used by the root-band interval;
  * root-band membership;
  * the finite set of divisors being counted;
  * the count D_C;
  * the full membership characterization, whose forward read is used by
    finite extraction.

This box does not assume or prove 5 <= D_C(C,n), and it does not create a
five-divisor witness.
================================================================================
-/

/-- The nonnegative real fourth root of the natural number `n`. -/
noncomputable def fourthRootNat (n : ℕ) : ℝ :=
  Real.sqrt (Real.sqrt (n : ℝ))

/-- Membership in the open root-band interval above `sqrt n`. -/
def inRootBand (C : ℝ) (n d : ℕ) : Prop :=
  Real.sqrt (n : ℝ) < (d : ℝ) ∧
    (d : ℝ) < Real.sqrt (n : ℝ) + C * fourthRootNat n

/-- The finite set of natural divisors of `n` lying in the root band. -/
noncomputable def rootBandDivisors (C : ℝ) (n : ℕ) : Finset ℕ := by
  classical
  exact (Finset.range (n + 1)).filter fun d => d ∣ n ∧ inRootBand C n d

/-- The near-root divisor count from the paper. -/
noncomputable def D_C (C : ℝ) (n : ℕ) : ℕ :=
  (rootBandDivisors C n).card

/--
A member of `rootBandDivisors C n` is a divisor of `n` and lies in the
root-band interval.  Only this forward read is required by `Five_ext`.
-/
theorem mem_rootBandDivisors_data
    {C : ℝ} {n d : ℕ}
    (hd : d ∈ rootBandDivisors C n) :
    d ∣ n ∧ inRootBand C n d := by
  classical
  have hfilter :
      d ∈ (Finset.range (n + 1)).filter
        (fun x => x ∣ n ∧ inRootBand C n x) := by
    simpa [rootBandDivisors] using hd
  exact (Finset.mem_filter.mp hfilter).2

/--
Complete membership specification for the finite root-band divisor set.  The
range cutoff introduces no extra mathematical restriction: a root-band divisor
is positive, the root-band inequalities exclude `n = 0`, and every positive
divisor of `n` is at most `n`.
-/
theorem mem_rootBandDivisors_iff
    {C : ℝ} {n d : ℕ} :
    d ∈ rootBandDivisors C n ↔
      d ∣ n ∧ inRootBand C n d := by
  classical
  constructor
  · exact mem_rootBandDivisors_data
  · rintro ⟨hdvd, hband⟩
    have hn_pos : 0 < n := by
      apply Nat.pos_of_ne_zero
      intro hn
      have hneg : (d : ℝ) < 0 := by
        simpa [hn, fourthRootNat] using hband.2
      exact (not_lt_of_ge (Nat.cast_nonneg d)) hneg
    have hdn : d ≤ n := Nat.le_of_dvd hn_pos hdvd
    have hdlt : d < n + 1 := by
      simpa [Nat.succ_eq_add_one] using Nat.lt_succ_of_le hdn
    have hfilter :
        d ∈ (Finset.range (n + 1)).filter
          (fun x => x ∣ n ∧ inRootBand C n x) :=
      Finset.mem_filter.mpr
        ⟨Finset.mem_range.mpr hdlt, ⟨hdvd, hband⟩⟩
    simpa [rootBandDivisors] using hfilter


/-
================================================================================
STATE-SHAPE BATCH
Container 1, Layer 01, Box 01

Incoming state shape:
  none

Outgoing state shape:
  D_C_state_shape C n

Effect:
  Introduces the root-band count and exposes the exact membership
  characterization used by finite extraction.

Public theorem:
  close_D_C_state_shape

================================================================================
-/

def D_C_state_shape (C : ℝ) (n : ℕ) : Prop :=
  D_C C n = (rootBandDivisors C n).card ∧
    ∀ d : ℕ,
      d ∈ rootBandDivisors C n ↔
        d ∣ n ∧ inRootBand C n d

theorem close_D_C_state_shape
    (C : ℝ) (n : ℕ) :
    D_C_state_shape C n := by
  refine ⟨rfl, ?_⟩
  intro d
  exact mem_rootBandDivisors_iff


