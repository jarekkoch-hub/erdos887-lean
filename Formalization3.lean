/- Sub-layer 01 -/
/-
Paper ref: 9.6
Sub-box Label: `Same-K synchronization: every downstream affine object is read over the same closed prefix survivor K; A_sync(K), C_loc(K), and the affine endpoint-equation datum are all formed from the coloring, prefix interval-sector data, frozen coefficient pattern, finite conflict family, and surviving monochrome branch retained by that fixed K`
Sub-inputs: `K`
Sub-outputs: `same_k_synchronization`
Note: Local same-state constraint. It is enforced by the indexing of the downstream objects themselves: an object built over a different coloring, prefix interval system, frozen pattern, conflict family, or monochrome branch is not an object over this K. The rank-three affine handoff is outside this low-rank prefix constraint and is synchronized separately at the affine merge.
-/
def prefix_conflict_section_9_6_sub_layer_01_sub_box_01_label : String := "Same-K synchronization: every downstream affine object is read over the same closed prefix survivor K; A_sync(K), C_loc(K), and the affine endpoint-equation datum are all formed from the coloring, prefix interval-sector data, frozen coefficient pattern, finite conflict family, and surviving monochrome branch retained by that fixed K"
def prefix_conflict_section_9_6_sub_layer_01_sub_box_01_inputs : List String := ["K [read]"]
def prefix_conflict_section_9_6_sub_layer_01_sub_box_01_outputs : List String := ["same_k_synchronization [birth]"]
/-
================================================================================
EXECUTABLE BOX
Section 9.6, Sub-layer 01, Sub-box 01
Birth token: same_k_synchronization

This box does not construct any affine object.  It exposes one exact survivor
payload already fixed inside `K` and installs the indexing discipline for the
three later object roles.  An affine route, local bridge, or affine endpoint
packet is an object over this survivor only when its explicit survivor index is
this exact payload.

Equality of the full survivor index synchronizes, in one step, the selected
regular coloring, prefix interval-sector packet, frozen coefficient pattern,
finite conflict family, low-rank source, and selected monochrome color.  The
rank-three affine handoff is not part of this index and remains a separate wire
for the later affine merge.
================================================================================
-/

/--
A future synchronized affine-route object is indexed by the exact closed
prefix-survivor payload that it reads.
-/
def affine_route_object_over_K_at
    {D : Type}
    {AffineObject : Type}
    (survivorData : ClosedPrefixSurvivorData D)
    (survivorIndex : AffineObject → ClosedPrefixSurvivorData D)
    (affineObject : AffineObject) : Prop :=
  survivorIndex affineObject = survivorData

/--
A future local compatibility-endpoint bridge is indexed by the exact closed
prefix-survivor payload that it reads.
-/
def local_bridge_object_over_K_at
    {D : Type}
    {LocalObject : Type}
    (survivorData : ClosedPrefixSurvivorData D)
    (survivorIndex : LocalObject → ClosedPrefixSurvivorData D)
    (localObject : LocalObject) : Prop :=
  survivorIndex localObject = survivorData

/--
A future affine endpoint-equation packet is indexed by the exact closed
prefix-survivor payload that it reads.
-/
def endpoint_equation_object_over_K_at
    {D : Type}
    {EndpointObject : Type}
    (survivorData : ClosedPrefixSurvivorData D)
    (survivorIndex : EndpointObject → ClosedPrefixSurvivorData D)
    (endpointObject : EndpointObject) : Prop :=
  survivorIndex endpointObject = survivorData

/--
The local same-`K` indexing law at one already-fixed survivor payload.

The retained survivor data are supplied separately by `K_components_at`.  This
predicate records only the no-reselection law: any affine route, local bridge,
and endpoint-equation object indexed by this payload have the same survivor
index.  It is coherence data, not another copy of the survivor state.
-/
def same_k_synchronization_at
    (_C : ℝ)
    (_nSeq : ℕ → ℕ)
    (_dSeq : ℕ → Fin 5 → ℕ)
    (_opening : CanonicalIntervalOverloadOpeningData)
    {D : Type}
    (survivorData : ClosedPrefixSurvivorData D) : Prop :=
  ∀ {AffineObject LocalObject EndpointObject : Type}
    (affineIndex : AffineObject → ClosedPrefixSurvivorData D)
    (localIndex : LocalObject → ClosedPrefixSurvivorData D)
    (endpointIndex : EndpointObject → ClosedPrefixSurvivorData D)
    (affineObject : AffineObject)
    (localObject : LocalObject)
    (endpointObject : EndpointObject),
    affine_route_object_over_K_at
        survivorData affineIndex affineObject →
      local_bridge_object_over_K_at
          survivorData localIndex localObject →
        endpoint_equation_object_over_K_at
            survivorData endpointIndex endpointObject →
          affineIndex affineObject = localIndex localObject ∧
            localIndex localObject = endpointIndex endpointObject ∧
              endpointIndex endpointObject = survivorData

/--
The Section 9 same-`K` synchronization capability.

It retains `K` and is universal over any exact survivor payload already
certified by `K_components_at`.  A downstream consumer therefore applies this
capability to its authoritative survivor instead of opening a second existential
witness from the public `K` state.  No affine object, endpoint equation, or
terminal theorem is constructed here.
-/
def same_k_synchronization
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  K C nSeq dSeq opening ∧
    ∀ {D : Type}
      (survivorData : ClosedPrefixSurvivorData D),
      K_components_at C nSeq dSeq opening survivorData →
        same_k_synchronization_at
          C nSeq dSeq opening survivorData

/-- The three downstream roles agree because all three indices are the fixed survivor payload. -/
theorem synchronize_objects_over_same_K
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {D : Type}
    {survivorData : ClosedPrefixSurvivorData D}
    (hSync :
      same_k_synchronization_at
        C nSeq dSeq opening survivorData)
    {AffineObject LocalObject EndpointObject : Type}
    (affineIndex : AffineObject → ClosedPrefixSurvivorData D)
    (localIndex : LocalObject → ClosedPrefixSurvivorData D)
    (endpointIndex : EndpointObject → ClosedPrefixSurvivorData D)
    (affineObject : AffineObject)
    (localObject : LocalObject)
    (endpointObject : EndpointObject)
    (hAffine :
      affine_route_object_over_K_at
        survivorData affineIndex affineObject)
    (hLocal :
      local_bridge_object_over_K_at
        survivorData localIndex localObject)
    (hEndpoint :
      endpoint_equation_object_over_K_at
        survivorData endpointIndex endpointObject) :
    affineIndex affineObject = localIndex localObject ∧
      localIndex localObject = endpointIndex endpointObject ∧
        endpointIndex endpointObject = survivorData :=
  hSync affineIndex localIndex endpointIndex
    affineObject localObject endpointObject
    hAffine hLocal hEndpoint

/-
================================================================================
STATE-SHAPE BATCH
Section 9.6, Sub-layer 01, Sub-box 01

Incoming state shape:
  K C nSeq dSeq opening

Outgoing state shape:
  same_k_synchronization C nSeq dSeq opening

Effect:
  Retains `K` and exposes the index-based no-reselection law universally over
  every exact `K_components_at` payload.  A later consumer applies the capability
  to the survivor already authoritative in its own exact state, so no second `K`
  witness is opened.  Equality of the full survivor index keeps the coloring,
  prefix intervals, frozen coefficients, finite conflict family, low-rank source,
  and selected monochrome branch synchronized.  No downstream affine object is
  constructed here, and the rank-three handoff remains outside this low-rank
  prefix index.

Public theorem:
  build_same_k_synchronization
================================================================================
-/

theorem build_same_k_synchronization
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hK : K C nSeq dSeq opening) :
    same_k_synchronization C nSeq dSeq opening := by
  refine ⟨hK, ?_⟩
  intro D survivorData _hComponentsAt AffineObject LocalObject EndpointObject affineIndex localIndex
    endpointIndex affineObject localObject endpointObject hAffine hLocal hEndpoint
  change affineIndex affineObject = survivorData at hAffine
  change localIndex localObject = survivorData at hLocal
  change endpointIndex endpointObject = survivorData at hEndpoint
  exact
    ⟨hAffine.trans hLocal.symm,
      hLocal.trans hEndpoint.symm,
      hEndpoint⟩

