/-- The conditional low-rank coloring output. -/
def low_rank_coloring_datum
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (leadingData : LeadingDescendantExtractionData)
    (regimeData : RankRegimeSourceData) : Prop :=
  leadingDescendantRank leadingData ≤ 2 →
    low_rank_coloring_packet
      C nSeq dSeq opening leadingData regimeData

/-
================================================================================
EXECUTABLE BOX
Section 8.4, Sub-layer 05, Sub-box 05
Birth token: low_rank_coloring_datum

This box materializes the selected two-class coloring and all of its retained
same-branch conditions.  It reuses the exact descendant rows and Section 6
address state rather than selecting replacements.
