def section_3_4_2_normalized_ledger_source_label : String :=
  "Normalized root-scale support ledgers along one coherent external sequence"
def section_3_4_2_normalized_ledger_source_inputs : List String :=
  ["external_violation_sequence_state [read]"]
def section_3_4_2_normalized_ledger_source_outputs : List String :=
  ["normalized_support_ledgers [birth]"]

/-- Root-scale logarithm used by every normalized support ledger. -/
noncomputable def normalizedRootLog (n : ℕ) : ℝ :=
  Real.log (Real.sqrt (n : ℝ))

/-- The paper's normalized exact level mass `M_k(W)`. -/
noncomputable def normalizedLevelMass
    (n : ℕ) (d : Fin 5 → ℕ) (k : ℕ) : ℝ :=
  Real.log (exactLevelProduct n d k : ℝ) /
    normalizedRootLog n

/-- Root-scale mass of one exact atom bucket. -/
noncomputable def normalizedAtomRootMass
    (n : ℕ) (d : Fin 5 → ℕ) (S : SupportAddress) : ℝ :=
  Real.log (atomBucket n d S : ℝ) /
    normalizedRootLog n

/-- The ten ordered representatives `i < j` of the K5 edges. -/
def materializedK5Edges : Finset (Fin 5 × Fin 5) :=
  (Finset.univ.product Finset.univ).filter
    (fun e => e.1 < e.2)

/-- Exact product of the ten gcd components in one materialized K5 ledger. -/
noncomputable def exactMaterializedPairGcdProduct
    (labels : K5FourBlockFamily) : ℕ :=
  ∏ e ∈ materializedK5Edges, (labels e.1 e.2).1

/-- Root-scale logarithmic read of the retained exact pair-gcd ledger. -/
noncomputable def normalizedMaterializedPairGcdMass
    (n : ℕ) (labels : K5FourBlockFamily) : ℝ :=
  Real.log (exactMaterializedPairGcdProduct labels : ℝ) /
    normalizedRootLog n

/-- Exact product of the five selected upper divisors. -/
noncomputable def exactUpperDivisorProduct
    (d : Fin 5 → ℕ) : ℕ :=
  ∏ i : Fin 5, d i

/-- Root-scale logarithmic read of the five upper-divisor product. -/
noncomputable def normalizedUpperDivisorMass
    (n : ℕ) (d : Fin 5 → ℕ) : ℝ :=
  Real.log (exactUpperDivisorProduct d : ℝ) /
    normalizedRootLog n

/-- Exact product of all nonempty support levels, the atomized lcm read. -/
noncomputable def exactNonemptyLevelProduct
    (n : ℕ) (d : Fin 5 → ℕ) : ℕ :=
  ∏ k ∈ Finset.Icc 1 5, exactLevelProduct n d k

/-- Root-scale logarithmic read of the common lcm/product budget. -/
noncomputable def normalizedNonemptyLevelMass
    (n : ℕ) (d : Fin 5 → ℕ) : ℝ :=
  Real.log (exactNonemptyLevelProduct n d : ℝ) /
    normalizedRootLog n

/-- Face-relative normalized defect for one canonical orientation. -/
noncomputable def normalizedFaceDefect
    (o n : ℕ) (d : Fin 5 → ℕ) : ℝ :=
  ∑ S ∈ offProfileAddresses o,
    normalizedAtomRootMass n d S

/-- The paper's orientation-free defect `δ_off = min(δ₃, δ₂)`. -/
noncomputable def normalizedOffFaceDefect
    (n : ℕ) (d : Fin 5 → ℕ) : ℝ :=
  min
    (normalizedFaceDefect 3 n d)
    (normalizedFaceDefect 2 n d)

/--
Logarithmic form of `C_o = (sqrt n)^(δ_o)`.  The identity is valid for every
orientation because every atom bucket in the exact product is positive.
-/
theorem normalizedFaceDefect_log_identity
    (o n : ℕ) (d : Fin 5 → ℕ) :
    normalizedFaceDefect o n d =
      Real.log (orientationOffFaceProduct o n d : ℝ) /
        normalizedRootLog n := by
  classical
  unfold normalizedFaceDefect normalizedAtomRootMass
    orientationOffFaceProduct
  rw [Nat.cast_prod, Real.log_prod]
  · simp [div_eq_mul_inv, Finset.sum_mul]
  · intro S hS
    exact_mod_cast (atomBucket_pos n d S).ne'

/-- Exact logarithmic `C₃` surface. -/
theorem normalizedFaceDefect_three_log_identity
    (n : ℕ) (d : Fin 5 → ℕ) :
    normalizedFaceDefect 3 n d =
      Real.log (orientationOffFaceProduct 3 n d : ℝ) /
        normalizedRootLog n :=
  normalizedFaceDefect_log_identity 3 n d

/-- Exact logarithmic `C₂` surface. -/
theorem normalizedFaceDefect_two_log_identity
    (n : ℕ) (d : Fin 5 → ℕ) :
    normalizedFaceDefect 2 n d =
      Real.log (orientationOffFaceProduct 2 n d : ℝ) /
        normalizedRootLog n :=
  normalizedFaceDefect_log_identity 2 n d

/-- The exact orientation-free pressure is always positive. -/
theorem offFacePressureNat_pos
    (n : ℕ) (d : Fin 5 → ℕ) :
    0 < offFacePressureNat n d := by
  unfold offFacePressureNat
  have hThree := offFaceProductThree_pos n d
  have hTwo := offFaceProductTwo_pos n d
  simp only [Nat.min_def]
  split
  · exact hThree
  · exact hTwo

/--
Exact logarithmic `C_off = (sqrt n)^(δ_off)` surface.  Positivity of the root
log is explicit because division by the normalization may not be ordered at
small `n`.
-/
theorem normalizedOffFaceDefect_log_identity
    {n : ℕ} {d : Fin 5 → ℕ}
    (hRoot : 0 < normalizedRootLog n) :
    normalizedOffFaceDefect n d =
      Real.log (offFacePressureNat n d : ℝ) /
        normalizedRootLog n := by
  have hThreeNat :
      0 < orientationOffFaceProduct 3 n d := by
    rw [orientationOffFaceProduct_three]
    exact offFaceProductThree_pos n d
  have hTwoNat :
      0 < orientationOffFaceProduct 2 n d := by
    rw [orientationOffFaceProduct_two]
    exact offFaceProductTwo_pos n d
  rw [normalizedOffFaceDefect,
    normalizedFaceDefect_three_log_identity,
    normalizedFaceDefect_two_log_identity,
    offFacePressureNat_eq_orientation_min]
  by_cases hOrder :
      orientationOffFaceProduct 3 n d ≤
        orientationOffFaceProduct 2 n d
  · have hLog :
        Real.log (orientationOffFaceProduct 3 n d : ℝ) ≤
          Real.log (orientationOffFaceProduct 2 n d : ℝ) := by
      apply Real.log_le_log
      · exact_mod_cast hThreeNat
      · exact_mod_cast hOrder
    have hDiv :
        Real.log (orientationOffFaceProduct 3 n d : ℝ) /
            normalizedRootLog n ≤
          Real.log (orientationOffFaceProduct 2 n d : ℝ) /
            normalizedRootLog n :=
      (div_le_div_iff_of_pos_right hRoot).2 hLog
    have hMin :
        Nat.min
            (orientationOffFaceProduct 3 n d)
            (orientationOffFaceProduct 2 n d) =
          orientationOffFaceProduct 3 n d := by
      simp [hOrder]
    rw [min_eq_left hDiv, hMin]
  · have hOrder' :
        orientationOffFaceProduct 2 n d ≤
          orientationOffFaceProduct 3 n d :=
      Nat.le_of_lt (Nat.lt_of_not_ge hOrder)
    have hLog :
        Real.log (orientationOffFaceProduct 2 n d : ℝ) ≤
          Real.log (orientationOffFaceProduct 3 n d : ℝ) := by
      apply Real.log_le_log
      · exact_mod_cast hTwoNat
      · exact_mod_cast hOrder'
    have hDiv :
        Real.log (orientationOffFaceProduct 2 n d : ℝ) /
            normalizedRootLog n ≤
          Real.log (orientationOffFaceProduct 3 n d : ℝ) /
            normalizedRootLog n :=
      (div_le_div_iff_of_pos_right hRoot).2 hLog
    have hMin :
        Nat.min
            (orientationOffFaceProduct 3 n d)
            (orientationOffFaceProduct 2 n d) =
          orientationOffFaceProduct 2 n d := by
      simp [Nat.min_def, hOrder]
    rw [min_eq_right hDiv, hMin]

/-- A divergent natural sequence also diverges after coercion to `ℝ`. -/
theorem natSequenceTendsToInfinity_realCast
    {a : ℕ → ℕ}
    (hInfinity : natSequenceTendsToInfinity a) :
    Filter.Tendsto
      (fun m : ℕ => (a m : ℝ))
      Filter.atTop Filter.atTop := by
  rw [Filter.tendsto_atTop_atTop]
  intro b
  rcases exists_nat_gt b with ⟨B, hB⟩
  rcases hInfinity B with ⟨N, hN⟩
  refine ⟨N, ?_⟩
  intro m hm
  have hBm : B < a m := hN m hm
  exact le_of_lt (hB.trans (by exact_mod_cast hBm))

/-- Along a divergent natural sequence, `log sqrt n` tends to infinity. -/
theorem normalizedRootLog_tendsto_atTop
    {nSeq : ℕ → ℕ}
    (hInfinity : natSequenceTendsToInfinity nSeq) :
    Filter.Tendsto
      (fun m : ℕ => normalizedRootLog (nSeq m))
      Filter.atTop Filter.atTop := by
  have hLog :
      Filter.Tendsto
        (fun m : ℕ => Real.log (nSeq m : ℝ))
        Filter.atTop Filter.atTop :=
    Real.tendsto_log_atTop.comp
      (natSequenceTendsToInfinity_realCast hInfinity)
  have hHalf :
      Filter.Tendsto
        (fun m : ℕ => Real.log (nSeq m : ℝ) / 2)
        Filter.atTop Filter.atTop :=
    Filter.Tendsto.atTop_div_const (by norm_num) hLog
  apply hHalf.congr'
  filter_upwards with m
  rw [normalizedRootLog, Real.log_sqrt]
  positivity

/--
The complete normalized support-ledger theorem-source target.

The family `labelsSeq m` is the same materialized K5 family used by the pair
gcd read at index `m`; it is not reselected inside the pair ledger.  Every
other quantity is a real logarithmic diagnostic of an exact integer object.
-/
def normalized_support_ledgers
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  ∃ labelsSeq : ℕ → K5FourBlockFamily,
    ∃ upperError pairError lcmError : ℕ → ℝ,
      0 < C ∧
      natSequenceTendsToInfinity nSeq ∧
      (∀ m : ℕ,
        five_near_root_divisor_witness C (nSeq m) (dSeq m) ∧
        materialized_K5_pair_ratio_data
          C (nSeq m) (dSeq m) (labelsSeq m)) ∧
      (∀ m : ℕ,
        section_3_arithmetic_state C (nSeq m) (dSeq m)) ∧
      (∀ m : ℕ,
        full_atom_model (nSeq m) (dSeq m)) ∧
      (∀ᶠ m : ℕ in Filter.atTop,
        0 < normalizedRootLog (nSeq m)) ∧
      Filter.Tendsto upperError Filter.atTop (nhds 0) ∧
      Filter.Tendsto pairError Filter.atTop (nhds 0) ∧
      Filter.Tendsto lcmError Filter.atTop (nhds 0) ∧
      (∀ m : ℕ,
        normalizedUpperDivisorMass (nSeq m) (dSeq m) =
          normalizedLevelMass (nSeq m) (dSeq m) 1 +
          2 * normalizedLevelMass (nSeq m) (dSeq m) 2 +
          3 * normalizedLevelMass (nSeq m) (dSeq m) 3 +
          4 * normalizedLevelMass (nSeq m) (dSeq m) 4 +
          5 * normalizedLevelMass (nSeq m) (dSeq m) 5) ∧
      (∀ m : ℕ,
        normalizedUpperDivisorMass (nSeq m) (dSeq m) =
          5 + upperError m) ∧
      (∀ m : ℕ,
        normalizedMaterializedPairGcdMass (nSeq m) (labelsSeq m) =
          normalizedLevelMass (nSeq m) (dSeq m) 2 +
          3 * normalizedLevelMass (nSeq m) (dSeq m) 3 +
          6 * normalizedLevelMass (nSeq m) (dSeq m) 4 +
          10 * normalizedLevelMass (nSeq m) (dSeq m) 5) ∧
      (∀ m : ℕ,
        normalizedMaterializedPairGcdMass (nSeq m) (labelsSeq m) =
          5 + pairError m) ∧
      (∀ m : ℕ,
        normalizedNonemptyLevelMass (nSeq m) (dSeq m) =
          normalizedLevelMass (nSeq m) (dSeq m) 1 +
          normalizedLevelMass (nSeq m) (dSeq m) 2 +
          normalizedLevelMass (nSeq m) (dSeq m) 3 +
          normalizedLevelMass (nSeq m) (dSeq m) 4 +
          normalizedLevelMass (nSeq m) (dSeq m) 5) ∧
      (∀ m : ℕ,
        normalizedNonemptyLevelMass (nSeq m) (dSeq m) ≤
          2 + lcmError m) ∧
      (∀ m : ℕ, ∀ o : ℕ,
        offProfileOrientation o →
          normalizedFaceDefect o (nSeq m) (dSeq m) =
            Real.log
                (orientationOffFaceProduct o (nSeq m) (dSeq m) : ℝ) /
              normalizedRootLog (nSeq m))

/--
Expose the single materialized label family used by the normalized pair-gcd
ledger.
-/
theorem normalized_support_ledgers_materialized_family
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hLedgers : normalized_support_ledgers C nSeq dSeq) :
    ∃ labelsSeq : ℕ → K5FourBlockFamily,
      ∀ m : ℕ,
        five_near_root_divisor_witness
            C (nSeq m) (dSeq m) ∧
          materialized_K5_pair_ratio_data
            C (nSeq m) (dSeq m) (labelsSeq m) := by
  rcases hLedgers with
    ⟨labelsSeq, _upperError, _pairError, _lcmError,
      _hC, _hDiverges, hMaterialized, _hRest⟩
  exact ⟨labelsSeq, hMaterialized⟩

/-- Project the cumulative arithmetic frontier retained at every index. -/
theorem normalized_support_ledgers_arithmetic_state
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hLedgers : normalized_support_ledgers C nSeq dSeq) :
    ∀ m : ℕ,
      section_3_arithmetic_state C (nSeq m) (dSeq m) := by
  rcases hLedgers with
    ⟨_labelsSeq, _upperError, _pairError, _lcmError,
      _hC, _hDiverges, _hMaterialized, hArithmetic, _hRest⟩
  exact hArithmetic

/--
The explicit family read by the normalized pair-gcd ledger agrees, on every
mathematical edge, with the materialized family retained by the arithmetic
frontier at the same sequence index.
-/
theorem normalized_support_ledgers_labels_agree_with_arithmetic_frontier
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hLedgers : normalized_support_ledgers C nSeq dSeq) :
    ∃ labelsSeq : ℕ → K5FourBlockFamily,
      ∃ arithmeticLabelsSeq : ℕ → K5FourBlockFamily,
        (∀ m : ℕ,
          materialized_K5_pair_ratio_data
            C (nSeq m) (dSeq m) (labelsSeq m)) ∧
        (∀ m : ℕ,
          materialized_K5_pair_ratio_data
            C (nSeq m) (dSeq m) (arithmeticLabelsSeq m)) ∧
        ∀ m : ℕ, ∀ i j : Fin 5, i < j →
          labelsSeq m i j = arithmeticLabelsSeq m i j := by
  rcases
      normalized_support_ledgers_materialized_family hLedgers with
    ⟨labelsSeq, hMaterialized⟩
  have hArithmetic :=
    normalized_support_ledgers_arithmetic_state hLedgers
  have hArithmeticFamily :
      ∀ m : ℕ,
        ∃ labels : K5FourBlockFamily,
          materialized_K5_pair_ratio_data
            C (nSeq m) (dSeq m) labels := by
    intro m
    rcases (hArithmetic m).2 with
      ⟨_hW, labels, hData⟩
    exact ⟨labels, hData⟩
  choose arithmeticLabelsSeq hArithmeticData using hArithmeticFamily
  refine
    ⟨labelsSeq, arithmeticLabelsSeq,
      (fun m => (hMaterialized m).2),
      hArithmeticData, ?_⟩
  intro m i j hij
  exact
    K5FourBlockFamilyLegal_unique_on_ordered_edges
      (hMaterialized m).1
      (hMaterialized m).2.1
      (hArithmeticData m).1
      i j hij

/--
Named theorem-source surface for the normalized sequence ledgers.

If its compactness proof requires a subsequence, this target must be refined to
an explicit strict-subsequence packet rather than silently changing indices.
-/
def derive_normalized_support_ledgers : Prop :=
  ∀ {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ},
    external_violation_sequence_state C nSeq dSeq →
      normalized_support_ledgers C nSeq dSeq

/-- A mass vanishes on every address in the selected canonical corridor. -/
def offProfileMassSupported
    (o : ℕ) (mu : SupportAddress → ℝ) : Prop :=
  ∀ S ∈ supportAddresses,
    canonicalSupportCorridor o S → mu S = 0

/-- Total mass on the selected orientation's off-profile address set. -/
noncomputable def offProfileMassTotal
    (o : ℕ) (mu : SupportAddress → ℝ) : ℝ :=
  ∑ S ∈ offProfileAddresses o, mu S

/-- A first active off-profile layer is normalized to total off-profile mass one. -/
def offProfileMassNormalized
    (o : ℕ) (mu : SupportAddress → ℝ) : Prop :=
  offProfileMassTotal o mu = 1

/-- Positive mass can occur only at an off-profile address. -/
theorem positive_mass_is_offProfile
    {o : ℕ} {mu : SupportAddress → ℝ}
    (hsupported : offProfileMassSupported o mu)
    {S : SupportAddress}
    (hS : S ∈ supportAddresses)
    (hpos : 0 < mu S) :
    offProfileAddress o S := by
  unfold offProfileAddress
  intro hcorridor
  have hzero : mu S = 0 :=
    hsupported S hS hcorridor
  linarith

/--
A nonnegative off-profile mass with total mass one has a strictly positive
coordinate on the finite off-profile address set.
-/
theorem normalized_offProfileMass_exists_positive
    {o : ℕ} {mu : SupportAddress → ℝ}
    (hnonneg : supportMassNonnegative mu)
    (hnorm : offProfileMassNormalized o mu) :
    ∃ S ∈ offProfileAddresses o, 0 < mu S := by
  by_contra hnone
  have hzero :
      ∀ S ∈ offProfileAddresses o, mu S = 0 := by
    intro S hS
    have hSall : S ∈ supportAddresses :=
      (Finset.mem_filter.mp hS).1
    have hge : 0 ≤ mu S := hnonneg S hSall
    have hnpos : ¬ 0 < mu S := by
      intro hpos
      exact hnone ⟨S, hS, hpos⟩
    exact le_antisymm (le_of_not_gt hnpos) hge
  have hsumzero : offProfileMassTotal o mu = 0 := by
    unfold offProfileMassTotal
    apply Finset.sum_eq_zero
    intro S hS
    exact hzero S hS
  unfold offProfileMassNormalized at hnorm
  rw [hsumzero] at hnorm
  exact zero_ne_one hnorm

/--
The finite first-active-layer packet over one already fixed sequence of atomized
states.  The orientation and mass are explicit parameters, not choices made by
this predicate.  The three pointwise input packets are retained over the same
`nSeq` and `dSeq`.
-/
def FirstOff_vec
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (o : ℕ)
    (mu : SupportAddress → ℝ) : Prop :=
  (∀ m : ℕ, full_atom_model (nSeq m) (dSeq m)) ∧
    (∀ m : ℕ, two_canonical_clipped_faces (nSeq m) (dSeq m)) ∧
    (∀ m : ℕ, off_face_pressure (nSeq m) (dSeq m)) ∧
    offProfileOrientation o ∧
    supportMassNonnegative mu ∧
    offProfileMassSupported o mu ∧
    offProfileMassNormalized o mu ∧
    ∃ S ∈ offProfileAddresses o, 0 < mu S

/--
Construct the finite first-active-layer packet from the same-state pointwise
atom, corridor, and off-face-pressure reads together with the explicit finite
properties of the normalized mass.  Sequence extraction and logarithmic limit
production are intentionally outside this theorem.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.7, Sub-sub-layer 01, Sub-sub-box 01

Incoming state shape:
  pointwise full_atom_model, two_canonical_clipped_faces, and off_face_pressure
  one explicit orientation o
