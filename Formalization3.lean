This box derives the affine interval and normalized-sector formulas from the
source-selected kappa and s functions over the fixed edge-address table.  The
coefficient b_e is a projection of survivorData and its nonvanishing is read
from the exact K_components_at packet.
================================================================================
-/

/-- The affine edge interval is the sum of the affine adjacent gaps it spans. -/
theorem sameKAffineEdgeInterval_eq_gap_sum
    {D : Type}
    (affineData : SameKAffinePencilData D)
    (T : ℚ)
    (e : Section6.K5EdgeAddress) :
    sameKAffineEdgeInterval affineData T e =
      sameKAffineGapIntervalSum affineData T e := by
  change
    (sameKEdgeGapSet e).sum
          (fun k => sameKAffineKappa affineData k) * T +
        (sameKEdgeGapSet e).sum
          (fun k => sameKAffineOffset affineData k) =
      (sameKEdgeGapSet e).sum
        (fun k =>
          sameKAffineKappa affineData k * T +
            sameKAffineOffset affineData k)
  rw [Finset.sum_mul, Finset.sum_add_distrib]

/-- The exact frozen coefficient stored in K is nonzero on every K5 edge. -/
theorem closedPrefixFrozenCoefficient_nonzero
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {D : Type}
    {survivorData : PrefixConflict.ClosedPrefixSurvivorData D}
    (hComponents :
      PrefixConflict.K_components_at
        C nSeq dSeq opening survivorData)
    (e : Section6.K5EdgeAddress) :
    PrefixConflict.closedPrefixFrozenPattern survivorData e ≠ 0 := by
  rcases hComponents with
    ⟨_hRegularSource, _hRegularAt, _hAlternativesAt,
      _hIntervalSource, _hIntervalAt, _hFrozenSource, hFrozenAt,
      _hFrozenMatch, _hLowCoherence, _hLowerClosed, _hFamilyAt,
      _hSameBranch, _hEliminatedAt, _hSelectedColor⟩
  exact hFrozenAt.2.1 e

/--
The complete affine-pencil packet at one exact survivor and source-selected
affine datum.
-/
def A_e_affine_pencil_at
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKAffinePencilData D) : Prop :=
  PrefixConflict.K_components_at
      C nSeq dSeq opening survivorData ∧
    same_K_affine_pencil_data_at survivorData affineData ∧
      (∀ T : ℚ, ∀ k : Section6.AdjacentGapAddress,
        sameKAffineGap affineData T k =
          sameKAffineKappa affineData k * T +
            sameKAffineOffset affineData k) ∧
      (∀ e : Section6.K5EdgeAddress,
        sameKAffineEdgeIntervalSlope affineData e =
          (sameKEdgeGapSet e).sum
            (fun k => sameKAffineKappa affineData k)) ∧
      (∀ e : Section6.K5EdgeAddress,
        sameKAffineEdgeIntervalOffset affineData e =
          (sameKEdgeGapSet e).sum
            (fun k => sameKAffineOffset affineData k)) ∧
      (∀ T : ℚ, ∀ e : Section6.K5EdgeAddress,
        sameKAffineEdgeInterval affineData T e =
            sameKAffineEdgeIntervalSlope affineData e * T +
              sameKAffineEdgeIntervalOffset affineData e ∧
          sameKAffineEdgeInterval affineData T e =
            sameKAffineGapIntervalSum affineData T e) ∧
      (∀ e : Section6.K5EdgeAddress,
        sameKAffineFrozenCoefficient affineData e =
            PrefixConflict.closedPrefixFrozenPattern survivorData e ∧
          sameKAffineFrozenCoefficient affineData e ≠ 0 ∧
          sameKAffineAlpha affineData e =
            sameKAffineEdgeIntervalSlope affineData e /
              sameKAffineFrozenCoefficient affineData e ∧
          sameKAffineBeta affineData e =
            sameKAffineEdgeIntervalOffset affineData e /
              sameKAffineFrozenCoefficient affineData e) ∧
      ∀ T : ℚ, ∀ e : Section6.K5EdgeAddress,
        sameKAffineSectorRead affineData T e =
            sameKAffineAlpha affineData e * T +
              sameKAffineBeta affineData e ∧
          sameKAffineSectorRead affineData T e =
            (sameKAffineEdgeIntervalSlope affineData e /
                sameKAffineFrozenCoefficient affineData e) * T +
              sameKAffineEdgeIntervalOffset affineData e /
                sameKAffineFrozenCoefficient affineData e

/-- The routed A_e affine-pencil state produced in Pass 1. -/
def A_e_affine_pencil
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  same_K_affine_pencil_data C nSeq dSeq opening ∧
    PrefixConflict.K C nSeq dSeq opening ∧
      ∃ D : Type,
        ∃ survivorData : PrefixConflict.ClosedPrefixSurvivorData D,
          ∃ affineData : SameKAffinePencilData D,
            A_e_affine_pencil_at
              C nSeq dSeq opening survivorData affineData

/-
================================================================================
STATE-SHAPE BATCH
Section 10, Sub-layer 02, Sub-box 02

Incoming state shape:
  same_K_affine_pencil_data C nSeq dSeq opening
  PrefixConflict.K C nSeq dSeq opening

Outgoing state shape:
  A_e_affine_pencil C nSeq dSeq opening

Effect:
  Computes the affine adjacent-gap, edge-slope, edge-offset, interval, and
  normalized-sector formulas over the exact affine datum selected in Sub-layer
  01.  The frozen coefficient and its nonvanishing are read from the same
  survivorData stored by K.  No endpoint-polynomial source is opened.

Public theorem:
  build_A_e_affine_pencil
================================================================================
-/

theorem build_A_e_affine_pencil
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hAffineState :
      same_K_affine_pencil_data C nSeq dSeq opening)
    (hK : PrefixConflict.K C nSeq dSeq opening) :
    A_e_affine_pencil C nSeq dSeq opening := by
  have hAffineStateCopy :
      same_K_affine_pencil_data C nSeq dSeq opening :=
    hAffineState
  rcases hAffineState with
    ⟨_hContext, D, survivorData, affineData,
      hComponentsAt, hAffineAt⟩

  have hIndex :
      sameKAffineSurvivorData affineData = survivorData := by
    change sameKAffineSurvivorData affineData = survivorData at hAffineAt
    exact hAffineAt

  refine
    ⟨hAffineStateCopy, hK, D, survivorData, affineData, ?_⟩
  refine
    ⟨hComponentsAt, hAffineAt, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro T k
    rfl
  · intro e
    rfl
  · intro e
    rfl
  · intro T e
    exact
      ⟨rfl,
        sameKAffineEdgeInterval_eq_gap_sum affineData T e⟩
  · intro e
    have hFrozenNonzero :
        PrefixConflict.closedPrefixFrozenPattern survivorData e ≠ 0 :=
      closedPrefixFrozenCoefficient_nonzero hComponentsAt e
    refine ⟨?_, ?_, rfl, rfl⟩
    · unfold sameKAffineFrozenCoefficient
      rw [hIndex]
    · simpa [sameKAffineFrozenCoefficient, hIndex] using hFrozenNonzero
  · intro T e
    exact ⟨rfl, rfl⟩


