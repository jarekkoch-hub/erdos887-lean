/-- The cubic coefficient c3(e) of the exact row polynomial P_e. -/
def endpointCoefficientC3
    {D : Type}
    (productRowData : SameKProductRowSourceData D)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (SameKEndpointPolynomial.endpointPolynomialFamily
      (productRowPolynomialData productRowData) e).coeff 3

/-- The quadratic coefficient c2(e) of the exact row polynomial P_e. -/
def endpointCoefficientC2
    {D : Type}
    (productRowData : SameKProductRowSourceData D)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (SameKEndpointPolynomial.endpointPolynomialFamily
      (productRowPolynomialData productRowData) e).coeff 2

/-- The linear coefficient c1(e) of the exact row polynomial P_e. -/
def endpointCoefficientC1
    {D : Type}
    (productRowData : SameKProductRowSourceData D)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (SameKEndpointPolynomial.endpointPolynomialFamily
      (productRowPolynomialData productRowData) e).coeff 1

/-- The constant coefficient c0(e) of the exact row polynomial P_e. -/
def endpointCoefficientC0
    {D : Type}
    (productRowData : SameKProductRowSourceData D)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (SameKEndpointPolynomial.endpointPolynomialFamily
      (productRowPolynomialData productRowData) e).coeff 0

/-- The uniform cubic presentation built from the four named coefficients. -/
noncomputable def endpointCoefficientPolynomial
    {D : Type}
    (productRowData : SameKProductRowSourceData D)
    (e : Section6.K5EdgeAddress) : Polynomial ℚ :=
  Polynomial.C (endpointCoefficientC3 productRowData e) *
      Polynomial.X ^ 3 +
    Polynomial.C (endpointCoefficientC2 productRowData e) *
      Polynomial.X ^ 2 +
    Polynomial.C (endpointCoefficientC1 productRowData e) *
      Polynomial.X +
    Polynomial.C (endpointCoefficientC0 productRowData e)

