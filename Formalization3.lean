/--
Uniform exact clipping bound on one retained witness sequence.

The `_C` parameter is intentional migration scaffolding: the exact bound
predicate depends only on `nSeq` and `dSeq`, while the surrounding route keeps
the fixed window constant in its index.  No theorem treats `_C` as a consumed
mathematical input to this elementary boundedness proposition.
-/
def Clip_can
    (_C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  ∃ B : ℕ, ∀ m : ℕ,
    offFacePressureNat (nSeq m) (dSeq m) ≤ B

/-- A uniform clipping bound rules out an unbounded pressure sequence. -/
theorem Clip_can_not_unbounded
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hclip : Clip_can C nSeq dSeq) :
    ¬ offFacePressureSequenceUnbounded nSeq dSeq := by
  intro hunbounded
  rcases hclip with ⟨B, hB⟩
  rcases hunbounded B with ⟨m, hm⟩
  exact (Nat.not_lt_of_ge (hB m)) hm

/-- Failure of pressure unboundedness produces one uniform natural bound. -/
theorem Clip_can_of_not_unbounded
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hnot :
      ¬ offFacePressureSequenceUnbounded nSeq dSeq) :
    Clip_can C nSeq dSeq := by
  classical
  by_contra hnoclip
  have hunbounded :
      offFacePressureSequenceUnbounded nSeq dSeq := by
    intro B
    have hnotall :
        ¬ ∀ m : ℕ,
          offFacePressureNat (nSeq m) (dSeq m) ≤ B := by
      intro hall
      exact hnoclip ⟨B, hall⟩
    rcases not_forall.mp hnotall with ⟨m, hm⟩
    exact ⟨m, Nat.lt_of_not_ge hm⟩
  exact hnot hunbounded

/-- Uniform clipping is equivalent to exclusion of exact pressure unboundedness. -/
theorem Clip_can_iff_not_unbounded
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ} :
    Clip_can C nSeq dSeq ↔
      ¬ offFacePressureSequenceUnbounded nSeq dSeq := by
  constructor
  · exact Clip_can_not_unbounded
  · exact Clip_can_of_not_unbounded

/--
Uniform clipping forces only the orientation-free minimum defect to vanish.
No conclusion is asserted for both orientation-specific defects.
-/
theorem normalizedOffFaceDefect_tendsto_zero_of_Clip_can
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hClip : Clip_can C nSeq dSeq)
    (hInfinity : natSequenceTendsToInfinity nSeq) :
    Filter.Tendsto
      (fun m : ℕ =>
        normalizedOffFaceDefect (nSeq m) (dSeq m))
      Filter.atTop (nhds 0) := by
  rcases hClip with ⟨B, hB⟩
  have hBPositive : 0 < B :=
    lt_of_lt_of_le
      (offFacePressureNat_pos (nSeq 0) (dSeq 0))
      (hB 0)
  have hNumeratorNonnegative :
      ∀ᶠ m : ℕ in Filter.atTop,
        0 ≤ Real.log
          (offFacePressureNat (nSeq m) (dSeq m) : ℝ) :=
    Filter.Eventually.of_forall (fun m => by
      apply Real.log_nonneg
      exact_mod_cast
        (offFacePressureNat_pos (nSeq m) (dSeq m)))
  have hNumeratorBounded :
      ∀ᶠ m : ℕ in Filter.atTop,
        Real.log
            (offFacePressureNat (nSeq m) (dSeq m) : ℝ) ≤
          Real.log (B : ℝ) :=
    Filter.Eventually.of_forall (fun m => by
      apply Real.log_le_log
      · exact_mod_cast
          (offFacePressureNat_pos (nSeq m) (dSeq m))
      · exact_mod_cast hB m)
  have hRoot :
      Filter.Tendsto
        (fun m : ℕ => normalizedRootLog (nSeq m))
        Filter.atTop Filter.atTop :=
    normalizedRootLog_tendsto_atTop hInfinity
  have hRatio :
      Filter.Tendsto
        (fun m : ℕ =>
          Real.log
              (offFacePressureNat (nSeq m) (dSeq m) : ℝ) /
            normalizedRootLog (nSeq m))
        Filter.atTop (nhds 0) :=
    tendsto_bdd_div_atTop_nhds_zero
      hNumeratorNonnegative hNumeratorBounded hRoot
  apply hRatio.congr'
  filter_upwards [hRoot.eventually_gt_atTop 0] with m hRootPositive
  exact
    (normalizedOffFaceDefect_log_identity
      (n := nSeq m) (d := dSeq m) hRootPositive).symm

