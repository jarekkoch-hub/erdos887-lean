theorem extract_coefficient_vanishings
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hTable : endpoint_coefficient_table C nSeq dSeq opening)
    (hP :
      SameKEndpointPolynomial.endpoint_polynomial_P_e
        C nSeq dSeq opening) :
    coefficient_vanishings C nSeq dSeq opening := by
  have hTableState :
      endpoint_coefficient_table C nSeq dSeq opening :=
    hTable
  have hPState :
      SameKEndpointPolynomial.endpoint_polynomial_P_e
        C nSeq dSeq opening :=
    hP
  refine ⟨hTableState, hPState, ?_⟩
  intro D survivorData affineData polynomialData productRowData hTableAt
  have hTableAtState :
      endpoint_coefficient_table_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hTableAt
  rcases hTableAt with ⟨hRowsAt, hCoefficientMatches⟩
  rcases hRowsAt with ⟨hIdentityPacketAt, _hProductRowAt⟩
  have hIdentityAt :
      SameKEndpointPolynomial.endpoint_polynomial_identity_at
        polynomialData :=
    hIdentityPacketAt.2.2
  have hZeros :
      ∀ e : Section6.K5EdgeAddress,
        endpointCoefficientC3 productRowData e = 0 ∧
          endpointCoefficientC2 productRowData e = 0 ∧
            endpointCoefficientC1 productRowData e = 0 ∧
              endpointCoefficientC0 productRowData e = 0 := by
    intro e
    rcases hCoefficientMatches e with
      ⟨_hExpansion, hC3Match, hC2Match, hC1Match, hC0Match⟩
    have hPolynomialZero :
        SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e = 0 :=
      hIdentityAt e
    have hC3Raw :
        (SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e).coeff 3 = 0 := by
      have hCoeff :=
        congrArg (fun P : Polynomial ℚ => P.coeff 3) hPolynomialZero
      simpa using hCoeff
    have hC2Raw :
        (SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e).coeff 2 = 0 := by
      have hCoeff :=
        congrArg (fun P : Polynomial ℚ => P.coeff 2) hPolynomialZero
      simpa using hCoeff
    have hC1Raw :
        (SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e).coeff 1 = 0 := by
      have hCoeff :=
        congrArg (fun P : Polynomial ℚ => P.coeff 1) hPolynomialZero
      simpa using hCoeff
    have hC0Raw :
        (SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e).coeff 0 = 0 := by
      have hCoeff :=
        congrArg (fun P : Polynomial ℚ => P.coeff 0) hPolynomialZero
      simpa using hCoeff
    exact
      ⟨hC3Match.trans hC3Raw,
        hC2Match.trans hC2Raw,
        hC1Match.trans hC1Raw,
        hC0Match.trans hC0Raw⟩
  exact ⟨hTableAtState, hZeros⟩


