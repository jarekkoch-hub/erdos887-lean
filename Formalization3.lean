Gamma_W state. This box opens that same-state field after classification; it
does not accept a second source port.
-/
def incident_growth_section_7_6_sub_layer_01_sub_box_01_label : String := "Branch shape and certificate interface for the two refined nonuniform branches"
def incident_growth_section_7_6_sub_layer_01_sub_box_01_inputs : List String := ["I_grow [construction]", "balanced_branch_classification [construction]"]
def incident_growth_section_7_6_sub_layer_01_sub_box_01_outputs : List String := ["monotone_cubic_certificate_interfaces [birth]"]


/-
================================================================================
EXECUTABLE BOX
Section 7.6, Sub-layer 01, Sub-box 01

Birth token: monotone_cubic_certificate_interfaces

This compartment owns the branch-local certificate types, the shifted-cubic
identity, endpoint-reversal conversion, and the public interface constructor.
The conditional production law is read from the exact I_grow state and is not
redeclared or accepted as an additional input here.
================================================================================
-/

/--
The exact shifted-difference identity for the branch-local monotone cubic.
-/
theorem monotone_cubic_shifted_difference_identity
    (X L U V : ℚ) :
    monotoneCubic U V (X + L) -
        monotoneCubic U V X =
      L * monotoneCubicDifferenceFactor
        U V L X := by
  unfold monotoneCubic canonicalGrowthMonotoneCubic
  unfold monotoneCubicDifferenceFactor
    canonicalGrowthMonotoneCubicDifferenceFactor
  ring

/--
A left-low monotone-cubic certificate attached to one exact profile.

The branch shape is retained explicitly.  The only profile-derived certificate
coordinate is `L = b - c`.  The remaining variables are independent
branch-local endpoint-certificate reads supplied by the production theorem.
-/
def left_low_monotone_cubic_certificate
    (G : MaxLinearProfile)
    (x U V L B H : ℚ) : Prop :=
  refined_left_low_profile G ∧
    L = G 1 - G 2 ∧
    0 < H ∧
    0 < L ∧
    monotoneCubic U V (x + L) -
        monotoneCubic U V x = B ∧
    H ^ 2 ≤
      monotoneCubicDifferenceFactor U V L x ∧
    B < L * H ^ 2

/--
A refined right-low profile reverses to a refined left-low profile.
-/
theorem right_low_reverses_to_left_low
    {G : MaxLinearProfile}
    (hRight :
      refined_right_low_profile G) :
    refined_left_low_profile
      (endpointReversalProfile G) := by
  rcases hRight with
    ⟨hdb, hbc, hab, hsum⟩
  change
    G 3 < G 1 ∧
      G 1 < G 2 ∧
      G 1 = G 0 ∧
      G 3 + G 2 = 2 * G 1
  exact
    ⟨hdb, hbc, hab.symm, hsum⟩

/--
Right-low certificate data is exactly left-low certificate data on the reversed
profile.  No second cubic is introduced.
-/
def right_low_monotone_cubic_certificate
    (G : MaxLinearProfile)
    (x U V L B H : ℚ) : Prop :=
  left_low_monotone_cubic_certificate
    (endpointReversalProfile G)
    x U V L B H

/--
The two branch-local certificate interfaces opened over the exact retained
Section 7 state.

Only the conditional production maps are returned.  The exact `I_grow` and
classification states remain separate siblings in the pass frontier, so this
interface does not duplicate its ancestry or select a nonuniform branch.
-/
def monotone_cubic_certificate_interfaces
    (GSeq : MaxLinearProfileSequence) : Prop :=
  (∀ m : ℕ,
    refined_left_low_profile (GSeq m) →
      ∃ x U V L B H : ℚ,
        left_low_monotone_cubic_certificate
          (GSeq m) x U V L B H) ∧
    ∀ m : ℕ,
      refined_right_low_profile (GSeq m) →
        ∃ x U V L B H : ℚ,
          right_low_monotone_cubic_certificate
            (GSeq m) x U V L B H

/--
Project the exact conditional production law from the retained I_grow state.
This is a read of the same Gamma_W branch, not a new source selection.
-/
theorem read_nonuniform_monotone_cubic_production_law
    {opening : CanonicalIntervalOverloadOpeningData}
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {nuSeq : IncidentGrowthExponentSequence}
    {sigmaSeq : ProfileReadSequence}
    (hGrow :
      I_grow opening GammaSeq nuSeq sigmaSeq) :
    canonicalNonuniformMonotoneCubicProductionLaw GammaSeq :=
  hGrow.2.1.2

/-
================================================================================
STATE-SHAPE BATCH
Section 7.6, Sub-layer 01, Sub-box 01

Incoming state shape:
  I_grow opening GammaSeq nuSeq sigmaSeq
  balanced_branch_classification GammaSeq sigmaSeq GSeq

Outgoing state shape:
  monotone_cubic_certificate_interfaces GSeq

Effect:
  Projects the exact conditional production law from the Gamma_W component of
  I_grow, applies it to the exact max-linear realization retained inside the
  balanced classification, and assembles the named left-low and right-low
  certificate interfaces.  No new opening, Gamma family, profile sequence, or
  theorem-source input is introduced.

Public theorem:
  build_monotone_cubic_certificate_interfaces
================================================================================
-/

theorem build_monotone_cubic_certificate_interfaces
    {opening : CanonicalIntervalOverloadOpeningData}
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {nuSeq : IncidentGrowthExponentSequence}
    {sigmaSeq : ProfileReadSequence}
    {GSeq : MaxLinearProfileSequence}
    (hGrow :
      I_grow opening GammaSeq nuSeq sigmaSeq)
    (hClassification :
      balanced_branch_classification
        GammaSeq sigmaSeq GSeq) :
    monotone_cubic_certificate_interfaces GSeq := by
  have hProfile :
      max_linear_profile GammaSeq sigmaSeq GSeq :=
    hClassification.1.1

  have hProductionLaw :
      canonicalNonuniformMonotoneCubicProductionLaw GammaSeq :=
    read_nonuniform_monotone_cubic_production_law hGrow

  have hProduced :=
    hProductionLaw GSeq hProfile.1

  constructor

  · intro m hLeft
    have hSourceLeft :
        leftLowProductionBranchShape (GSeq m) := by
      simpa [refined_left_low_profile] using hLeft

    rcases hProduced.1 m hSourceLeft with
      ⟨x, U, V, L, B, H,
        hShift, hHPositive, hLPositive,
        hDifference, hFactorLower, hSmallBound⟩

    exact
      ⟨x, U, V, L, B, H,
        hLeft,
        hShift,
        hHPositive,
        hLPositive,
        hDifference,
        hFactorLower,
        hSmallBound⟩

  · intro m hRight
    have hSourceRight :
        rightLowProductionBranchShape (GSeq m) := by
      simpa [refined_right_low_profile] using hRight

    rcases hProduced.2 m hSourceRight with
      ⟨x, U, V, L, B, H,
        hShift, hHPositive, hLPositive,
        hDifference, hFactorLower, hSmallBound⟩

    have hReversedLeft :
        refined_left_low_profile
          (endpointReversalProfile (GSeq m)) :=
      right_low_reverses_to_left_low hRight

    refine ⟨x, U, V, L, B, H, ?_⟩
    change
      left_low_monotone_cubic_certificate
        (endpointReversalProfile (GSeq m))
        x U V L B H
    exact
      ⟨hReversedLeft,
        hShift,
        hHPositive,
        hLPositive,
        hDifference,
        hFactorLower,
        hSmallBound⟩

/- Sub-layer 02 -/
/-
Paper ref: 7.6
Sub-box Label: `Left-low monotone-cubic certificate production and nonexistence`
Sub-inputs: `monotone_cubic_certificate_interfaces`
Sub-outputs: `left_low_ruled_out`
-/
def incident_growth_section_7_6_sub_layer_02_sub_box_02_label : String := "Left-low monotone-cubic certificate production and nonexistence"
def incident_growth_section_7_6_sub_layer_02_sub_box_02_inputs : List String := ["monotone_cubic_certificate_interfaces [construction]"]
def incident_growth_section_7_6_sub_layer_02_sub_box_02_outputs : List String := ["left_low_ruled_out [birth]"]



/-
================================================================================
EXECUTABLE BOX
Section 7.6, Sub-layer 02, Sub-box 02

Birth token: left_low_ruled_out

This compartment owns the factor equation, the explicit left-certificate
contradiction, and elimination of every selected left-low branch.
================================================================================
-/

/--
The certificate difference equation and the shifted-difference identity give
the factor equation `L * Q = B`.
-/
theorem left_low_certificate_factor_equation
    {G : MaxLinearProfile}
    {x U V L B H : ℚ}
    (hCertificate :
      left_low_monotone_cubic_certificate
        G x U V L B H) :
    L * monotoneCubicDifferenceFactor
          U V L x =
      B := by
  rcases hCertificate with
    ⟨_, _, _, _, hDifference, _, _⟩
  calc
    L * monotoneCubicDifferenceFactor U V L x =
        monotoneCubic U V (x + L) -
          monotoneCubic U V x :=
      (monotone_cubic_shifted_difference_identity
        x L U V).symm
    _ = B := hDifference

/--
The explicit certificate algebra is inconsistent.

This theorem proves only nonexistence of an object with the displayed
certificate components.  It does not produce the certificate.
-/
theorem left_low_monotone_cubic_certificate_nonexistence
    {G : MaxLinearProfile}
    {x U V L B H : ℚ}
    (hCertificate :
      left_low_monotone_cubic_certificate
        G x U V L B H) :
    False := by
  rcases hCertificate with
    ⟨hBranch, hShift, hHPositive, hLPositive,
      hDifference, hFactorLower, hSmallBound⟩

  have hFactorEquation :
      L * monotoneCubicDifferenceFactor
            U V L x =
        B :=
    left_low_certificate_factor_equation
      ⟨hBranch, hShift, hHPositive, hLPositive,
        hDifference, hFactorLower, hSmallBound⟩

  have hScaledLower :
      L * H ^ 2 ≤
        L * monotoneCubicDifferenceFactor
          U V L x :=
    mul_le_mul_of_nonneg_left
      hFactorLower
      (le_of_lt hLPositive)

  rw [hFactorEquation] at hScaledLower
  exact (not_lt_of_ge hScaledLower) hSmallBound

/--
The left-low elimination state contains both:

  * the generic algebraic nonexistence theorem for any left-low certificate;
  * the resulting elimination of every left-low branch in the exact retained
    profile sequence.

The generic component is retained because the right-low proof applies the same
certificate obstruction after endpoint reversal.
-/
def left_low_ruled_out
    (GSeq : MaxLinearProfileSequence) : Prop :=
  (∀ G : MaxLinearProfile,
    ∀ x U V L B H : ℚ,
      ¬ left_low_monotone_cubic_certificate
        G x U V L B H) ∧
    ∀ m : ℕ,
      ¬ refined_left_low_profile (GSeq m)

/-
================================================================================
STATE-SHAPE BATCH
Section 7.6, Sub-layer 02, Sub-box 02

Incoming state shape:
  monotone_cubic_certificate_interfaces GSeq

Outgoing state shape:
  left_low_ruled_out GSeq

Effect:
  Uses the left production map to construct a certificate only after a
  left-low branch is selected, then applies the explicit certificate algebra.
  The generic left-certificate nonexistence theorem is retained for reversal.

Public theorem:
  build_left_low_ruled_out
================================================================================
-/

theorem build_left_low_ruled_out
    {GSeq : MaxLinearProfileSequence}
    (hInterfaces :
      monotone_cubic_certificate_interfaces GSeq) :
    left_low_ruled_out GSeq := by
  constructor

  · intro G x U V L B H hCertificate
    exact
      left_low_monotone_cubic_certificate_nonexistence
        hCertificate

  · intro m hLeft
    rcases hInterfaces.1 m hLeft with
      ⟨x, U, V, L, B, H, hCertificate⟩
    exact
      left_low_monotone_cubic_certificate_nonexistence
        hCertificate


