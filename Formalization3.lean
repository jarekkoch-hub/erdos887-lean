/-
================================================================================
EXECUTABLE BOX
Section 3.4.4, Sub-sub-layer 03, Sub-sub-box 03
Birth token: pointwiseDirectedQuotientActivityAt

This box proves the finite one-edge arithmetic behind sequence activity.  For
one ordered near-root pair i<j, the exact endpoint splits force

  U_{i|j} < U_{j|i},
  fourthRootNat n / C < U_{i|j},
  fourthRootNat n / C < U_{j|i}.

It also defines the bounded edge-gap diagnostic at an externally supplied
natural bound M.  It does not assert that such an M(C) exists, does not open an
unbounded sequence, and does not assign a chamber route.
================================================================================
-/

/-- The exact positive directed difference on an ordered edge. -/
noncomputable def directedEdgeGap
    (n : ℕ) (d : Fin 5 → ℕ) (i j : Fin 5) : ℕ :=
  directedQuotient n d j i -
    directedQuotient n d i j

/-- Pointwise membership in a directed edge-gap chamber with bound M. -/
def boundedEdgeGapAt
    (M n : ℕ) (d : Fin 5 → ℕ) (i j : Fin 5) : Prop :=
  1 ≤ directedEdgeGap n d i j ∧
    directedEdgeGap n d i j ≤ M

/-- The fourth-root scale is nonnegative. -/
theorem fourthRootNat_nonneg (n : ℕ) :
    0 ≤ fourthRootNat n := by
  unfold fourthRootNat
  exact Real.sqrt_nonneg (Real.sqrt (n : ℝ))

/-- Squaring the fourth-root scale gives sqrt n. -/
theorem fourthRootNat_sq (n : ℕ) :
    fourthRootNat n ^ 2 = Real.sqrt (n : ℝ) := by
  unfold fourthRootNat
  exact Real.sq_sqrt (Real.sqrt_nonneg (n : ℝ))

/-- Raising the fourth-root scale to the fourth power reconstructs `n`. -/
theorem fourthRootNat_pow_four (n : ℕ) :
    fourthRootNat n ^ 4 = (n : ℝ) := by
  calc
    fourthRootNat n ^ 4 =
        (fourthRootNat n ^ 2) ^ 2 := by ring
    _ = Real.sqrt (n : ℝ) ^ 2 := by
      rw [fourthRootNat_sq]
    _ = (n : ℝ) := by
      exact Real.sq_sqrt (Nat.cast_nonneg n)

/--
Finite directed quotient activity packet for one ordered near-root edge.
The two displayed lower bounds are the paper's sqrt(R)/C bounds, since
fourthRootNat n = sqrt(sqrt n).
-/
def Act_can
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ)
    (i j : Fin 5) : Prop :=
  near_root_pair_context C n d i j ∧
    Edge_can n d ∧
    0 < C ∧
    directedQuotient n d i j < directedQuotient n d j i ∧
    fourthRootNat n / C < (directedQuotient n d i j : ℝ) ∧
    fourthRootNat n / C < (directedQuotient n d j i : ℝ) ∧
    1 ≤ directedEdgeGap n d i j

/--
Honest name for the finite, pointwise packet formerly exposed only as
`Act_can`.  The shorter name is retained as a compatibility alias.
-/
abbrev pointwiseDirectedQuotientActivityAt :=
  Act_can

/--
Near-root arithmetic and the exact directed-edge packet produce the pointwise
activity estimate on one ordered edge.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.4, Sub-sub-layer 03, Sub-sub-box 03

Incoming state shape:
  Edge_can n d
  near_root_pair_context C n d i j

Outgoing state shape:
  pointwiseDirectedQuotientActivityAt C n d i j

Effect:
  Turns one ordered near-root edge into its finite directed-quotient activity
  and positive edge-gap packet.

Semantic kind:
  pointwise exact diagnostic.

Public theorem:
  derive_Act_can

================================================================================
-/

theorem derive_Act_can
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} {i j : Fin 5}
    (hedge : Edge_can n d)
    (hpair : near_root_pair_context C n d i j) :
    Act_can C n d i j := by
  rcases near_root_pair_context_data hpair with
    ⟨hdij, _hdi_pos, _hdj_pos, _hdi_dvd, _hdj_dvd,
      hband_i, hband_j⟩

  have hsplit_i :
      d i = commonEdgeFactor n d i j *
        directedQuotient n d i j :=
    hedge.2.1 i j
  have hsplit_j :
      d j = commonEdgeFactor n d i j *
        directedQuotient n d j i :=
    hedge.2.2.1 i j

  have hG_pos : 0 < commonEdgeFactor n d i j :=
    commonEdgeFactor_pos n d i j
  have hUi_pos : 0 < directedQuotient n d i j :=
    directedQuotient_pos n d i j

  have hU_lt :
      directedQuotient n d i j <
        directedQuotient n d j i := by
    rw [hsplit_i, hsplit_j] at hdij
    exact (Nat.mul_lt_mul_left hG_pos).mp hdij

  have hgap_one :
      1 ≤ directedEdgeGap n d i j := by
    unfold directedEdgeGap
    exact Nat.sub_pos_of_lt hU_lt

  have hwindow_pos : 0 < C * fourthRootNat n := by
    linarith [hband_i.1, hband_i.2]

  have hC_and_root_pos : 0 < C ∧ 0 < fourthRootNat n := by
    rcases (mul_pos_iff.mp hwindow_pos) with hpos | hneg
    · exact hpos
    · exfalso
      exact (not_lt_of_ge (fourthRootNat_nonneg n)) hneg.2

  have hC_pos : 0 < C := hC_and_root_pos.1
  have hroot_pos : 0 < fourthRootNat n := hC_and_root_pos.2

  have hpair_gap_lt :
      (d j : ℝ) - (d i : ℝ) < C * fourthRootNat n := by
    linarith [hband_j.2, hband_i.1]

  have hsplit_i_real :=
    congrArg (fun x : ℕ => (x : ℝ)) hsplit_i
  have hsplit_j_real :=
    congrArg (fun x : ℕ => (x : ℝ)) hsplit_j
  simp only [Nat.cast_mul] at hsplit_i_real hsplit_j_real

  have hU_succ_real :
      (directedQuotient n d i j : ℝ) + 1 ≤
        (directedQuotient n d j i : ℝ) := by
    calc
      (directedQuotient n d i j : ℝ) + 1
          =
          ((directedQuotient n d i j + 1 : ℕ) : ℝ) := by
            rw [Nat.cast_add, Nat.cast_one]
      _ ≤
          (directedQuotient n d j i : ℝ) :=
        Nat.cast_le.mpr hU_lt

  have hUdiff_ge_one :
      1 ≤
        (directedQuotient n d j i : ℝ) -
          (directedQuotient n d i j : ℝ) := by
    linarith [hU_succ_real]

  have hgap_eq :
      (d j : ℝ) - (d i : ℝ) =
        (commonEdgeFactor n d i j : ℝ) *
          ((directedQuotient n d j i : ℝ) -
            (directedQuotient n d i j : ℝ)) := by
    rw [hsplit_i_real, hsplit_j_real]
    ring

  have hG_pos_real :
      0 < (commonEdgeFactor n d i j : ℝ) :=
    Nat.cast_pos.mpr hG_pos

  have hG_le_gap :
      (commonEdgeFactor n d i j : ℝ) ≤
        (d j : ℝ) - (d i : ℝ) := by
    calc
      (commonEdgeFactor n d i j : ℝ)
          = (commonEdgeFactor n d i j : ℝ) * 1 := by ring
      _ ≤ (commonEdgeFactor n d i j : ℝ) *
          ((directedQuotient n d j i : ℝ) -
            (directedQuotient n d i j : ℝ)) :=
        mul_le_mul_of_nonneg_left
          hUdiff_ge_one (le_of_lt hG_pos_real)
      _ = (d j : ℝ) - (d i : ℝ) := hgap_eq.symm

  have hG_lt_window :
      (commonEdgeFactor n d i j : ℝ) <
        C * fourthRootNat n :=
    lt_of_le_of_lt hG_le_gap hpair_gap_lt

  have hUi_pos_real :
      0 < (directedQuotient n d i j : ℝ) :=
    Nat.cast_pos.mpr hUi_pos

  have hroot_sq_lt_product :
      fourthRootNat n ^ 2 <
        (commonEdgeFactor n d i j : ℝ) *
          (directedQuotient n d i j : ℝ) := by
    calc
      fourthRootNat n ^ 2 = Real.sqrt (n : ℝ) :=
        fourthRootNat_sq n
      _ < (d i : ℝ) := hband_i.1
      _ = (commonEdgeFactor n d i j : ℝ) *
          (directedQuotient n d i j : ℝ) := hsplit_i_real

  have hscaled_Ui :
      fourthRootNat n <
        C * (directedQuotient n d i j : ℝ) := by
    by_contra hnot
    have hCUi_le :
        C * (directedQuotient n d i j : ℝ) ≤
          fourthRootNat n :=
      le_of_not_gt hnot
    have hproduct_lt :
        (commonEdgeFactor n d i j : ℝ) *
            (directedQuotient n d i j : ℝ) <
          fourthRootNat n ^ 2 := by
      calc
        (commonEdgeFactor n d i j : ℝ) *
            (directedQuotient n d i j : ℝ)
            < (C * fourthRootNat n) *
                (directedQuotient n d i j : ℝ) :=
          mul_lt_mul_of_pos_right hG_lt_window hUi_pos_real
        _ = fourthRootNat n *
              (C * (directedQuotient n d i j : ℝ)) := by ring
        _ ≤ fourthRootNat n * fourthRootNat n :=
          mul_le_mul_of_nonneg_left hCUi_le (le_of_lt hroot_pos)
        _ = fourthRootNat n ^ 2 := by ring
    exact
      (not_lt_of_ge (le_of_lt hroot_sq_lt_product)) hproduct_lt

  have hU_lt_real :
      (directedQuotient n d i j : ℝ) <
        (directedQuotient n d j i : ℝ) :=
    Nat.cast_lt.mpr hU_lt

  have hscaled_Uj :
      fourthRootNat n <
        C * (directedQuotient n d j i : ℝ) := by
    exact lt_trans hscaled_Ui
      (mul_lt_mul_of_pos_left hU_lt_real hC_pos)

  have hbound_i :
      fourthRootNat n / C <
        (directedQuotient n d i j : ℝ) := by
    apply (div_lt_iff₀ hC_pos).2
    simpa [mul_comm] using hscaled_Ui

  have hbound_j :
      fourthRootNat n / C <
        (directedQuotient n d j i : ℝ) := by
    apply (div_lt_iff₀ hC_pos).2
    simpa [mul_comm] using hscaled_Uj

  exact
    ⟨hpair, hedge, hC_pos, hU_lt,
      hbound_i, hbound_j, hgap_one⟩

