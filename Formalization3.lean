def shared_state_exact_sibling_source_batch : Prop :=
  ∀ {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {nuSeq : IncidentGrowth.IncidentGrowthExponentSequence}
    {sigmaSeq : IncidentGrowth.ProfileReadSequence}
    {GSeq : IncidentGrowth.MaxLinearProfileSequence}
    {Dcan : Type}
    {dcan : Dcan}
    {selection : CanonicalInternal.CanonicalInternalSelectionRelation}
    {sectorLaw : CanonicalInternal.CanonicalSectorLawFamily Dcan}
    {reducedCubicLaw :
      CanonicalInternal.CanonicalReducedCubicLawFamily Dcan},
    IncidentGrowth.B_unif opening GammaSeq nuSeq sigmaSeq GSeq →
      PrefixConflict.FG_mono C nSeq dSeq opening →
        PrefixConflict.K C nSeq dSeq opening →
          AffineSync.A_sync C nSeq dSeq opening →
            AffineSync.C_loc C nSeq dSeq opening →
              AffineChamber.HI_aff C nSeq dSeq opening →
    CanonicalInternal.D_can_int_on_execution
                    C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
                    dcan selection sectorLaw reducedCubicLaw →
                  ∃ D : Type,
                    ∃ survivorData : PrefixConflict.ClosedPrefixSurvivorData D,
                      ∃ affineData :
                          SameKEndpointPolynomial.SameKAffinePencilData D,
                        ∃ polynomialData :
                            SameKEndpointPolynomial.EndpointPolynomialSourceData D,
                          ∃ productRowData :
                              ProductRowExtraction.SameKProductRowSourceData D,
                            ∃ sourceData :
                                RatioCollapse.SameKPrefixAverageFormulaSourceData D,
                              shared_state_context_at
                                C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
                                survivorData affineData polynomialData
                                productRowData sourceData
                                Dcan dcan selection sectorLaw reducedCubicLaw

/--
Prove the exact-sibling owner from the exact chamber witness already sealed by
`HI_aff`.  That witness contains the same monochrome datum, `K`, and `A_sync`;
`C_loc_at` is projected forward from its `A_sync_at`.  The map-free canonical
datum contributes only its two retained law witnesses.
-/
theorem prove_shared_state_exact_sibling_source_batch :
    shared_state_exact_sibling_source_batch := by
  intro C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
    Dcan dcan selection sectorLaw reducedCubicLaw
    hB _hMono _hK _hSync _hLoc hAffine hDatum
  rcases hAffine.2.2.2.2.2.2.2.2 with
    ⟨D, survivorData, affineData, polynomialData, productRowData,
      sourceData, hAffineAt⟩
  have hChamberAt :
      AffineChamber.canonical_affine_ratio_chamber_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hAffineAt.2.1
  have hMonoAt :
      PrefixConflict.monochrome_low_rank_datum_at
        C nSeq dSeq opening survivorData :=
    hChamberAt.2.1
  have hSyncAt :
      AffineSync.A_sync_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hChamberAt.2.2.1
  have hKAt :
      PrefixConflict.K_components_at
        C nSeq dSeq opening survivorData :=
    hSyncAt.1.1.1
  have hLocAt :
      AffineSync.C_loc_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    AffineSync.C_loc_at_of_A_sync_at hSyncAt
  have hDatumAt :
