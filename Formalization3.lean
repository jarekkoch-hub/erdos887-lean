/-- The five canonical endpoint values in an `O_can` datum are distinct. -/
theorem O_can_endpointValues_injective
    {O : Section3.O_can_data}
    (hO : Section3.O_can_state O) :
    Function.Injective (Section3.O_can_T O) := by
  intro i j hT
  by_contra hij
  have hEquation :
      Section3.O_can_T O j - Section3.O_can_T O i =
        Section3.O_can_b O i j * Section3.O_can_Z O i j :=
    hO.1.2.1 i j hij
  have hCoefficient :
      Section3.O_can_b O i j ≠ 0 :=
    hO.1.2.2 i j hij
  have hSector :
      Section3.O_can_Z O i j ≠ 0 :=
    hO.2.2.1 i j hij
  have hProduct :
      Section3.O_can_b O i j * Section3.O_can_Z O i j ≠ 0 :=
    mul_ne_zero hCoefficient hSector
  have hDifference :
      Section3.O_can_T O j - Section3.O_can_T O i = 0 := by
    rw [hT]
    ring
  exact hProduct (hEquation.symm.trans hDifference)

/--
