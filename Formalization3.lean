/--
Provenance of the visible endpoint and sector components.

The displayed `TSeq`, `bSeq`, and `ZSeq` are realized by one coherent
`Sector_can` chamber family.  Orientation, natural sectors, clipping bounds,
coefficient bounds, and multipliers remain hidden reconstruction witnesses and
are not separate visible components of `EndpointSectorDisplay_can`.
-/
def componentDisplayRealizedBySectorCan
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (TSeq : ℕ → EndpointValueFamily)
    (bSeq : ℕ → EndpointCoefficientFamily)
    (ZSeq : ℕ → IntegerSectorFamily) : Prop :=
  external_violation_sequence_state C nSeq dSeq ∧
    sector_products_Z_ij C nSeq dSeq ∧
    Clip_can C nSeq dSeq ∧
    ∃ B M : ℕ,
      ∃ o : ℕ,
      ∃ ZNatSeq : ℕ → SectorProductFamily,
      ∃ mWSeq : ℕ → ℕ,
        1 ≤ M ∧
        offProfileOrientation o ∧
        (∀ m : ℕ,
          selectedClippedOrientation
            B (nSeq m) (dSeq m) o) ∧
        (∀ m : ℕ,
          canonicalSectorChamberAt
            C (nSeq m) (dSeq m)
            o (ZNatSeq m) (bSeq m) M (mWSeq m)) ∧
        (∀ m : ℕ,
          TSeq m =
            endpointValuesFromSectors (ZNatSeq m)) ∧
        ∀ m : ℕ,
          ZSeq m =
            integerSectorFamilyOfNat (ZNatSeq m)

/--
The presently executable endpoint-and-sector component display.

This is not the full paper object `Geom(W)`: the adjacent growth component
cannot be added until the paper-specification interface above is repaired.
-/
def EndpointSectorDisplay_can
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  ∃ TSeq : ℕ → EndpointValueFamily,
    ∃ bSeq : ℕ → EndpointCoefficientFamily,
    ∃ ZSeq : ℕ → IntegerSectorFamily,
      componentDisplayRealizedBySectorCan
        C nSeq dSeq TSeq bSeq ZSeq ∧
      (∀ m : ℕ,
        canonicalEndpointSystemAt
          (TSeq m) (bSeq m) (ZSeq m)) ∧
      ∀ m : ℕ,
        canonicalSectorLawsAt
          (TSeq m) (ZSeq m)

/--
A canonical sector chamber gives the coherent endpoint-and-sector component
display.  It does not produce `Gamma_W`.
