def rank_trichotomy_section_8_4_sub_layer_06_sub_box_06_label : String := "Forked rank/coloring output components: rank four impossible, rank-three handoff on its branch, or low-rank coloring data on its branch, all over the same endpoint-address system"
def rank_trichotomy_section_8_4_sub_layer_06_sub_box_06_inputs : List String := ["rank_fork [construction]", "rank_four_impossible [construction]", "rank_three_affine_handoff [construction]", "low_rank_coloring_datum [construction]", "S_0 [coherence]"]
def rank_trichotomy_section_8_4_sub_layer_06_sub_box_06_outputs : List String := ["S_rank_components [birth]"]

/-- The two surviving rank-layer routes after rank four is eliminated. -/
def S_rank_components
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (leadingData : LeadingDescendantExtractionData)
    (regimeData : RankRegimeSourceData) : Prop :=
  rank_four_impossible leadingData ∧
    ((leadingDescendantRank leadingData = 3 ∧
        (rankThreeAbsorbed (rankThreeSourceData regimeData) = true ∨
          rank_three_affine_line_data
            opening leadingData (rankThreeSourceData regimeData))) ∨
      (leadingDescendantRank leadingData ≤ 2 ∧
        low_rank_coloring_packet
          C nSeq dSeq opening leadingData regimeData)) ∧
    Section6.Legacy.legacy_S_0
      C nSeq dSeq
      (openingTSeq opening)
      (openingBSeq opening)
      (openingZSeq opening)

/-
================================================================================
EXECUTABLE BOX
Section 8.4, Sub-layer 06, Sub-box 06
Birth token: S_rank_components

This box eliminates the rank-four alternative and assembles exactly one of the
two surviving outputs.  The disjunction prevents a rank-three handoff and a
low-rank coloring packet from being treated as simultaneous states.
================================================================================
-/

/-
================================================================================
STATE-SHAPE BATCH
Section 8.4, Sub-layer 06, Sub-box 06

Incoming state shape:
  rank_fork opening leadingData regimeData
  rank_four_impossible leadingData
  rank_three_affine_handoff opening leadingData regimeData
  low_rank_coloring_datum
    C nSeq dSeq opening leadingData regimeData
  Section6.Legacy.legacy_S_0 C nSeq dSeq
    (openingTSeq opening)
    (openingBSeq opening)
    (openingZSeq opening)

Outgoing state shape:
  S_rank_components
    C nSeq dSeq opening leadingData regimeData

Effect:
  Removes the impossible rank-four branch and routes the remaining branch to
  either the rank-three affine handoff or the rank-at-most-two selected-coloring
  packet, retaining the same fixed endpoint-address state.

Public theorem:
  build_S_rank_components
================================================================================
-/

theorem build_S_rank_components
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {leadingData : LeadingDescendantExtractionData}
    {regimeData : RankRegimeSourceData}
    (hFork : rank_fork opening leadingData regimeData)
    (hFourImpossible : rank_four_impossible leadingData)
    (hThree :
      rank_three_affine_handoff opening leadingData regimeData)
    (hLow :
      low_rank_coloring_datum
        C nSeq dSeq opening leadingData regimeData)
    (hS0 :
      Section6.Legacy.legacy_S_0
        C nSeq dSeq
        (openingTSeq opening)
        (openingBSeq opening)
        (openingZSeq opening)) :
    S_rank_components
      C nSeq dSeq opening leadingData regimeData := by
  refine ⟨hFourImpossible, ?_, hS0⟩
  rcases hFork.2 with hRankFour | hRankThree | hRankLow
  · exact (hFourImpossible hRankFour).elim
  · exact Or.inl ⟨hRankThree, hThree hRankThree⟩
  · exact Or.inr ⟨hRankLow, hLow hRankLow⟩


/--
The Section 8 boundary output with its exact rank source and branch selection
existentially sealed together.  Later routes may open the same frozen pattern,
rank data, and regime witnesses, but may not reselect them.
-/
def S_rank
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∃ leadingData : LeadingDescendantExtractionData,
    ∃ regimeData : RankRegimeSourceData,
      rank_source opening leadingData regimeData ∧
        S_rank_components
          C nSeq dSeq opening leadingData regimeData


/--
The exact surviving rank-three route sealed by `S_rank`.

This state retains the same leading extraction, regime source, and Section 6
address state already sealed by the Section 8 output.  It does not contain a
prefix survivor `K` and it does not authorize the finite-prefix certificate.
-/
def rank_three_route
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∃ leadingData : LeadingDescendantExtractionData,
    ∃ regimeData : RankRegimeSourceData,
      rank_source opening leadingData regimeData ∧
        S_rank_components
          C nSeq dSeq opening leadingData regimeData ∧
          leadingDescendantRank leadingData = 3 ∧
            (rankThreeAbsorbed (rankThreeSourceData regimeData) = true ∨
              rank_three_affine_line_data
                opening leadingData (rankThreeSourceData regimeData))

/--
The absorbed rank-three branch at the affine merge boundary.

This is the exact `true` absorption alternative already carried by the
rank-three source.  It contains no `K`, no prefix certificate, and no
low-rank coloring packet.  Its proved owner records exact same-branch
retirement; it is not converted into a low-rank roadmap state.
-/
def rank_three_absorbed_route
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∃ leadingData : LeadingDescendantExtractionData,
    ∃ regimeData : RankRegimeSourceData,
      rank_source opening leadingData regimeData ∧
        S_rank_components
          C nSeq dSeq opening leadingData regimeData ∧
          leadingDescendantRank leadingData = 3 ∧
            rankThreeAbsorbed
              (rankThreeSourceData regimeData) = true

/--
The non-absorbed rank-three affine input at the merge boundary.

The state retains the exact source-selected leading matrix and rank regime,
together with the affine gap, edge-interval, frozen-coefficient, and normalized
sector packet constructed by the Section 8.4 handoff box.  It is not indexed
by `K` and therefore cannot be passed to a same-`K` theorem by coercion.
-/
def rank_three_affine_input_route
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∃ leadingData : LeadingDescendantExtractionData,
    ∃ regimeData : RankRegimeSourceData,
      rank_source opening leadingData regimeData ∧
        S_rank_components
          C nSeq dSeq opening leadingData regimeData ∧
          leadingDescendantRank leadingData = 3 ∧
            rank_three_affine_line_data
              opening leadingData (rankThreeSourceData regimeData)

/--
Open the retained rank-three route at the exact affine merge boundary.

No new branch decision is made here.  The theorem only separates the two
alternatives already sealed by `rank_three_route`: prior affine absorption, or
the concrete non-absorbed affine-line input.
-/
theorem split_rank_three_route_at_affine_merge
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hThree : rank_three_route C nSeq dSeq opening) :
    rank_three_absorbed_route C nSeq dSeq opening ∨
      rank_three_affine_input_route C nSeq dSeq opening := by
  rcases hThree with
    ⟨leadingData, regimeData, hRankSource, hComponents,
      hRankThree, hMerge⟩
  rcases hMerge with hAbsorbed | hAffine
  · exact
      Or.inl
        ⟨leadingData, regimeData, hRankSource, hComponents,
          hRankThree, hAbsorbed⟩
  · exact
      Or.inr
        ⟨leadingData, regimeData, hRankSource, hComponents,
          hRankThree, hAffine⟩


/--
The exact surviving rank-at-most-two route sealed by `S_rank`.

This is the only Section 8 output that may enter Section 9.  The selected
coloring packet, rank source, and fixed endpoint-address state are retained in
one existential package, so Section 9 does not ask a forked `S_rank` to become
low-rank by assumption.
-/
def low_rank_route
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∃ leadingData : LeadingDescendantExtractionData,
    ∃ regimeData : RankRegimeSourceData,
      rank_source opening leadingData regimeData ∧
        S_rank_components
          C nSeq dSeq opening leadingData regimeData ∧
          low_rank_coloring_packet
            C nSeq dSeq opening leadingData regimeData

/-- Read the forked Section 8 output as exactly one surviving branch. -/
theorem split_S_rank_routes
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hRank : S_rank C nSeq dSeq opening) :
    rank_three_route C nSeq dSeq opening ∨
      low_rank_route C nSeq dSeq opening := by
  rcases hRank with
    ⟨leadingData, regimeData, hRankSource, hComponents⟩
  rcases hComponents.2.1 with hThree | hLow
  · exact
      Or.inl
        ⟨leadingData, regimeData, hRankSource, hComponents,
          hThree.1, hThree.2⟩
  · exact
      Or.inr
        ⟨leadingData, regimeData, hRankSource, hComponents,
          hLow.2⟩

/-- Forget the branch refinement and recover the Section 8 boundary output. -/
theorem low_rank_route_to_S_rank
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hLow : low_rank_route C nSeq dSeq opening) :
    S_rank C nSeq dSeq opening := by
  rcases hLow with
    ⟨leadingData, regimeData, hRankSource, hComponents, _hPacket⟩
  exact ⟨leadingData, regimeData, hRankSource, hComponents⟩

/-- The fixed Section 6 address state retained by the low-rank route. -/
theorem low_rank_route_S_0
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hLow : low_rank_route C nSeq dSeq opening) :
    Section6.Legacy.legacy_S_0
      C nSeq dSeq
      (openingTSeq opening)
      (openingBSeq opening)
      (openingZSeq opening) := by
  rcases hLow with
    ⟨_leadingData, _regimeData, _hRankSource, hComponents, _hPacket⟩
  exact hComponents.2.2

/-
================================================================================
STATE-SHAPE PARENT BATCH
Section 8 complete rank-layer compression

Incoming state shape:
  IncidentGrowth.B_unif opening GammaSeq nuSeq sigmaSeq GSeq
  section_8_3_frontier C nSeq dSeq opening

Outgoing state shape:
  S_rank C nSeq dSeq opening

Effect:
  Composes every Section 8.4 executable box over the exact matrix and source
  selection sealed by Section 8.3.  Rank four is eliminated, rank three is
  routed to affine input or absorption, and rank at most two is routed to the
  selected leading-direction coloring datum.  Neither K nor FG_mono is born.

Public theorem:
  close_rank_trichotomy_section_8
================================================================================
-/

theorem close_rank_trichotomy_section_8
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {nuSeq : IncidentGrowth.IncidentGrowthExponentSequence}
    {sigmaSeq : IncidentGrowth.ProfileReadSequence}
    {GSeq : IncidentGrowth.MaxLinearProfileSequence}
    (_hB :
      IncidentGrowth.B_unif
        opening GammaSeq nuSeq sigmaSeq GSeq)
    (hSection83 :
      section_8_3_frontier C nSeq dSeq opening) :
    S_rank C nSeq dSeq opening := by
  rcases hSection83 with
    ⟨leadingData, regimeData, hRank, hS0⟩
  have hFork : rank_fork opening leadingData regimeData :=
    build_rank_fork hRank
  have hFourImpossible : rank_four_impossible leadingData :=
    eliminate_rank_four hRank
  have hThree :
      rank_three_affine_handoff opening leadingData regimeData :=
    build_rank_three_affine_handoff hRank hS0
  have hTop :
      top_product_frame_data leadingData regimeData :=
    build_top_product_frame_data hRank
  have hLow :
      low_rank_coloring_datum
        C nSeq dSeq opening leadingData regimeData :=
    build_low_rank_coloring_datum hRank hTop hS0
  have hComponents :
      S_rank_components
        C nSeq dSeq opening leadingData regimeData :=
    build_S_rank_components
      hFork hFourImpossible hThree hLow hS0
  exact ⟨leadingData, regimeData, hRank, hComponents⟩


end RankTrichotomy



