def adjacent_pure_scaling_read
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  common_ratio_witness C nSeq dSeq opening ∧
    adjacent_affine_ratios C nSeq dSeq opening ∧
    ∀ {D : Type}
