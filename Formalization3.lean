  Sets tau equal to tau_0 on the exact sourceData and chains the three retained
  neighbor equalities to prove tau_i = tau for all four adjacent-gap addresses.
  No affine source, product row, or prefix-average source is reopened.

Public theorem:
  build_common_ratio_witness
================================================================================
-/

theorem build_common_ratio_witness
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hNeighbors : neighbor_ratio_equalities C nSeq dSeq opening) :
    common_ratio_witness C nSeq dSeq opening := by
  have hNeighborsState :
      neighbor_ratio_equalities C nSeq dSeq opening :=
    hNeighbors
  refine ⟨hNeighborsState, ?_⟩
  intro D survivorData affineData polynomialData productRowData sourceData
    hNeighborsAt
  have hNeighborsAtState :
      neighbor_ratio_equalities_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hNeighborsAt
  rcases hNeighborsAt with ⟨_hBalancesAt, hNeighborEqualities⟩
  have h01 :
      adjacentAffineRatio sourceData (1 : Section6.AdjacentGapAddress) =
        adjacentAffineRatio sourceData (0 : Section6.AdjacentGapAddress) := by
    simpa [neighborRatioEquality, adjacentPairLeftAddress,
      adjacentPairRightAddress] using
        (hNeighborEqualities (0 : Fin 3))
  have h12 :
      adjacentAffineRatio sourceData (2 : Section6.AdjacentGapAddress) =
        adjacentAffineRatio sourceData (1 : Section6.AdjacentGapAddress) := by
    simpa [neighborRatioEquality, adjacentPairLeftAddress,
      adjacentPairRightAddress] using
        (hNeighborEqualities (1 : Fin 3))
  have h23 :
      adjacentAffineRatio sourceData (3 : Section6.AdjacentGapAddress) =
        adjacentAffineRatio sourceData (2 : Section6.AdjacentGapAddress) := by
    simpa [neighborRatioEquality, adjacentPairLeftAddress,
      adjacentPairRightAddress] using
        (hNeighborEqualities (2 : Fin 3))
  have hCommon :
      commonAdjacentRatioAt sourceData
        (adjacentAffineRatio sourceData
          (0 : Section6.AdjacentGapAddress)) := by
    intro k
    fin_cases k
    · rfl
    · exact h01
    · exact h12.trans h01
    · exact h23.trans (h12.trans h01)
  exact
    ⟨hNeighborsAtState,
      adjacentAffineRatio sourceData
        (0 : Section6.AdjacentGapAddress),
      hCommon⟩


