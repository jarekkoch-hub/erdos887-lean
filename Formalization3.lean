theorem close_rank_trichotomy_section_8_3
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {leadingData : LeadingDescendantExtractionData}
    {regimeData : RankRegimeSourceData}
    (hSection82 :
      section_8_2_frontier C nSeq dSeq opening)
    (hSource :
      rank_layer_source opening leadingData regimeData) :
    section_8_3_frontier C nSeq dSeq opening := by
  have hLeading :
      leading_descendant_matrix opening leadingData :=
    build_leading_descendant_matrix
      hSection82.1 hSection82.2 hSource.1
  have hRankSource :
      rank_source opening leadingData regimeData :=
    build_rank_source hLeading hSource.2
  exact
    ⟨leadingData, regimeData, hRankSource, hSection82.2⟩



/- ## Sub-container 8.4: The three rank regimes. -/

/- Sub-layer 01 -/
/-
Paper ref: 8.4
Sub-box Label: `Three rank regimes fork: rho=4 (elimination), rho=3 (affine input or absorbed), rho<=2 (selected leading-direction coloring)`
Sub-inputs: `rank_source`
Sub-outputs: `rank_fork`
Note: This box constructs the exhaustive arithmetic fork from the retained four-column rank bound. The three routes remain distinct and merge only at the final rank-layer output surface.
-/
def rank_trichotomy_section_8_4_sub_layer_01_sub_box_01_label : String := "Three rank regimes fork: rho=4 (elimination), rho=3 (affine input or absorbed), rho<=2 (selected leading-direction coloring)"
def rank_trichotomy_section_8_4_sub_layer_01_sub_box_01_inputs : List String := ["rank_source [construction]"]
def rank_trichotomy_section_8_4_sub_layer_01_sub_box_01_outputs : List String := ["rank_fork [birth]"]

/-- The exhaustive three-way classification of the retained leading rank. -/
def rank_fork
    (opening : CanonicalIntervalOverloadOpeningData)
    (leadingData : LeadingDescendantExtractionData)
    (regimeData : RankRegimeSourceData) : Prop :=
  rank_source opening leadingData regimeData ∧
    (leadingDescendantRank leadingData = 4 ∨
      leadingDescendantRank leadingData = 3 ∨
      leadingDescendantRank leadingData ≤ 2)

/-
================================================================================
EXECUTABLE BOX
Section 8.4, Sub-layer 01, Sub-box 01
Birth token: rank_fork

This box performs the finite arithmetic classification of the exact matrix
rank.  It does not open any branch packet and does not merge the two surviving
routes.
================================================================================
-/

/-
================================================================================
STATE-SHAPE BATCH
Section 8.4, Sub-layer 01, Sub-box 01

Incoming state shape:
  rank_source opening leadingData regimeData

Outgoing state shape:
  rank_fork opening leadingData regimeData

Effect:
  Uses the four-column rank bound to classify the retained rank into exactly
  the three paper regimes `rho = 4`, `rho = 3`, or `rho <= 2`.

Public theorem:
  build_rank_fork
================================================================================
-/

theorem build_rank_fork
    {opening : CanonicalIntervalOverloadOpeningData}
    {leadingData : LeadingDescendantExtractionData}
    {regimeData : RankRegimeSourceData}
    (hRank : rank_source opening leadingData regimeData) :
    rank_fork opening leadingData regimeData := by
  refine ⟨hRank, ?_⟩
  let rho : ℕ := leadingDescendantRank leadingData
  have hRhoLeFour : rho ≤ 4 := by
    simpa [rho] using hRank.2.2.1
  by_cases hFour : rho = 4
  · exact Or.inl (by simpa [rho] using hFour)
  by_cases hThree : rho = 3
  · exact Or.inr (Or.inl (by simpa [rho] using hThree))
  · apply Or.inr
    apply Or.inr
    have hRhoLtFour : rho < 4 :=
      lt_of_le_of_ne hRhoLeFour hFour
    have hRhoLeThree : rho ≤ 3 := by
      exact Nat.le_of_lt_succ (by simpa using hRhoLtFour)
    have hRhoLtThree : rho < 3 :=
      lt_of_le_of_ne hRhoLeThree hThree
    have hRhoLeTwo : rho ≤ 2 := by
      exact Nat.le_of_lt_succ (by simpa using hRhoLtThree)
    simpa [rho] using hRhoLeTwo


/- Sub-layer 02 -/
/-
Paper ref: 8.4
Sub-box Label: `Rank-four certificate and boundedness elimination: an invertible selected 4x4 subsystem bounds every adjacent gap and contradicts the retained unbounded branch datum`
Sub-inputs: `rank_source`
Sub-outputs: `rank_four_impossible`
Note: Elimination branch. The rank-four branch dies inside this box and only its impossibility is retained.
-/
def rank_trichotomy_section_8_4_sub_layer_02_sub_box_02_label : String := "Rank-four certificate and boundedness elimination: an invertible selected 4x4 subsystem bounds every adjacent gap and contradicts the retained unbounded branch datum"
def rank_trichotomy_section_8_4_sub_layer_02_sub_box_02_inputs : List String := ["rank_source [construction]"]
def rank_trichotomy_section_8_4_sub_layer_02_sub_box_02_outputs : List String := ["rank_four_impossible [birth]"]

/-- The selected right-hand side of the rank-four subsystem. -/
def rankFourSelectedRHS
    (leadingData : LeadingDescendantExtractionData)
    (rankFourData : RankFourSourceData)
    (m : ℕ) : Fin 4 → ℚ :=
  fun i =>
    leadingRHS leadingData m
      (rankFourSelectedRows rankFourData i)

/-- One uniform inverse-row bound for all four gap coordinates. -/
noncomputable def rankFourInverseGapBound
    (leadingData : LeadingDescendantExtractionData)
    (rankFourData : RankFourSourceData) : ℚ :=
  ∑ k : Fin 4,
    ∑ i : Fin 4,
      |(rankFourMinor leadingData rankFourData)⁻¹ k i| *
        rankFourRHSBound rankFourData

/-- The full leading system restricts to the selected rank-four subsystem. -/
theorem rankFourSubsystemEquation
    {opening : CanonicalIntervalOverloadOpeningData}
    {leadingData : LeadingDescendantExtractionData}
    {rankFourData : RankFourSourceData}
    (hLinear :
      leading_descendant_linear_system opening leadingData)
    (m : ℕ) :
    (rankFourMinor leadingData rankFourData).mulVec
        (leadingAdjacentGapVector opening m) =
      rankFourSelectedRHS leadingData rankFourData m := by
  funext i
  have hRow :=
    hLinear m (rankFourSelectedRows rankFourData i)
  simpa [rankFourMinor, rankFourSelectedRHS,
    leadingMatrixGapRead, Matrix.mulVec, dotProduct] using hRow

/-- An invertible selected subsystem with bounded right-hand side bounds every gap. -/
theorem rankFourGapBounded
    {opening : CanonicalIntervalOverloadOpeningData}
    {leadingData : LeadingDescendantExtractionData}
    {rankFourData : RankFourSourceData}
    (hLinear :
      leading_descendant_linear_system opening leadingData)
    (hDet :
      (rankFourMinor leadingData rankFourData).det ≠ 0)
    (hRHSNonneg :
      0 ≤ rankFourRHSBound rankFourData)
    (hRHSBound :
      ∀ m : ℕ, ∀ i : Fin 4,
        |rankFourSelectedRHS leadingData rankFourData m i| ≤
          rankFourRHSBound rankFourData) :
    ∀ m : ℕ, ∀ k : Fin 4,
      |leadingAdjacentGapVector opening m k| ≤
        rankFourInverseGapBound leadingData rankFourData := by
  have hUnitDet :
      IsUnit (rankFourMinor leadingData rankFourData).det :=
    isUnit_iff_ne_zero.mpr hDet
  letI : Invertible (rankFourMinor leadingData rankFourData) :=
    Matrix.invertibleOfIsUnitDet
      (rankFourMinor leadingData rankFourData) hUnitDet
  intro m k
  have hSolve :
      (rankFourMinor leadingData rankFourData)⁻¹.mulVec
          (rankFourSelectedRHS leadingData rankFourData m) =
        leadingAdjacentGapVector opening m :=
    Matrix.inv_mulVec_eq_vec
      (rankFourSubsystemEquation
        (opening := opening)
        (leadingData := leadingData)
        (rankFourData := rankFourData)
        hLinear m).symm
  rw [← congrFun hSolve k]
  change
    |∑ i : Fin 4,
        (rankFourMinor leadingData rankFourData)⁻¹ k i *
          rankFourSelectedRHS leadingData rankFourData m i| ≤
      rankFourInverseGapBound leadingData rankFourData
  calc
    |∑ i : Fin 4,
        (rankFourMinor leadingData rankFourData)⁻¹ k i *
          rankFourSelectedRHS leadingData rankFourData m i|
        ≤
      ∑ i : Fin 4,
        |(rankFourMinor leadingData rankFourData)⁻¹ k i *
          rankFourSelectedRHS leadingData rankFourData m i| := by
            simpa using
              (Finset.abs_sum_le_sum_abs
                (fun i : Fin 4 =>
                  (rankFourMinor leadingData rankFourData)⁻¹ k i *
                    rankFourSelectedRHS leadingData rankFourData m i)
                Finset.univ)
    _ =
      ∑ i : Fin 4,
        |(rankFourMinor leadingData rankFourData)⁻¹ k i| *
          |rankFourSelectedRHS leadingData rankFourData m i| := by
            apply Finset.sum_congr rfl
            intro i hi
            rw [abs_mul]
    _ ≤
      ∑ i : Fin 4,
        |(rankFourMinor leadingData rankFourData)⁻¹ k i| *
          rankFourRHSBound rankFourData := by
            apply Finset.sum_le_sum
            intro i hi
            exact
              mul_le_mul_of_nonneg_left
                (hRHSBound m i) (abs_nonneg _)
    _ ≤
      ∑ k' : Fin 4,
        ∑ i : Fin 4,
          |(rankFourMinor leadingData rankFourData)⁻¹ k' i| *
            rankFourRHSBound rankFourData := by
              exact
                Finset.single_le_sum
                  (fun k' hk' =>
                    Finset.sum_nonneg
                      (fun i hi =>
                        mul_nonneg (abs_nonneg _) hRHSNonneg))
                  (Finset.mem_univ k)
    _ = rankFourInverseGapBound leadingData rankFourData := rfl

/-- The rank-four branch is impossible. -/
def rank_four_impossible
    (leadingData : LeadingDescendantExtractionData) : Prop :=
  leadingDescendantRank leadingData ≠ 4

/-
================================================================================
EXECUTABLE BOX
Section 8.4, Sub-layer 02, Sub-box 02
Birth token: rank_four_impossible

This box restricts the exact linear system to the selected invertible minor,
uses its inverse to bound every gap coordinate by one fixed rational bound, and
contradicts the retained unbounded-gap branch datum.
================================================================================
-/

/-
================================================================================
STATE-SHAPE BATCH
Section 8.4, Sub-layer 02, Sub-box 02

Incoming state shape:
  rank_source opening leadingData regimeData

Outgoing state shape:
  rank_four_impossible leadingData

Effect:
  Opens the conditional rank-four certificate, derives uniform boundedness of
  all four adjacent gaps from the selected invertible subsystem, and eliminates
  the rank-four branch against its unbounded-gap datum.

Public theorem:
  eliminate_rank_four
================================================================================
-/

theorem eliminate_rank_four
    {opening : CanonicalIntervalOverloadOpeningData}
    {leadingData : LeadingDescendantExtractionData}
    {regimeData : RankRegimeSourceData}
    (hRank : rank_source opening leadingData regimeData) :
    rank_four_impossible leadingData := by
  intro hFour
  have hCertificate :=
    hRank.2.2.2.1 hFour
  rcases hCertificate with
    ⟨hDet, hCoeffNonneg, hRHSNonneg, hDetLowerPos,
      hCoeffBound, hRHSBound, hDetLower, hUnbounded⟩
  have hGapBounded :=
    rankFourGapBounded
      (opening := opening)
      (leadingData := leadingData)
      (rankFourData := rankFourSourceData regimeData)
      hRank.1.2.2.2 hDet hRHSNonneg hRHSBound
  obtain ⟨m, k, hLarge⟩ :=
    hUnbounded
      (rankFourInverseGapBound
        leadingData (rankFourSourceData regimeData))
  exact
    (not_lt_of_ge (hGapBounded m k)) hLarge


/- Sub-layer 03 -/
/-
Paper ref: 8.4
Sub-box Label: `Rank-three affine handoff: affine gaps, edge interval slopes and offsets, frozen nonzero coefficients, and normalized affine sector reads, with an absorption alternative`
Sub-inputs: `rank_source`, `S_0`
Sub-outputs: `rank_three_affine_handoff`
Note: This is not the later same-K affine endpoint-equation packet. It is the rank-three affine-line input over the same endpoint-address system.
-/
def rank_trichotomy_section_8_4_sub_layer_03_sub_box_03_label : String := "Rank-three affine handoff: affine gaps, edge interval slopes and offsets, frozen nonzero coefficients, and normalized affine sector reads, with an absorption alternative"
def rank_trichotomy_section_8_4_sub_layer_03_sub_box_03_inputs : List String := ["rank_source [construction]", "S_0 [read]"]
def rank_trichotomy_section_8_4_sub_layer_03_sub_box_03_outputs : List String := ["rank_three_affine_handoff [birth]"]

/-- Whether an adjacent-gap address lies in the interval addressed by an edge. -/
def adjacentGapLiesInEdge
    (e : Section6.K5EdgeAddress)
    (k : Section6.AdjacentGapAddress) : Prop :=
  (Section6.k5EdgeBoundary e).1.val ≤ k.val ∧
    k.val < (Section6.k5EdgeBoundary e).2.val

/--
The exact finite set of adjacent-gap addresses lying in one endpoint edge.

The membership test is materialized once here.  The affine slope, offset, and
gap sums below all use this same set, so the interval identity is a direct
finite-sum calculation and does not reopen a proposition-valued `if` at each
use.
-/
def rankThreeEdgeGapSet
    (e : Section6.K5EdgeAddress) :
    Finset Section6.AdjacentGapAddress :=
  Finset.univ.filter fun k =>
    (Section6.k5EdgeBoundary e).1.val ≤ k.val ∧
      k.val < (Section6.k5EdgeBoundary e).2.val

/-- Membership in the materialized edge-gap set is the paper interval test. -/
theorem mem_rankThreeEdgeGapSet_iff
    (e : Section6.K5EdgeAddress)
    (k : Section6.AdjacentGapAddress) :
    k ∈ rankThreeEdgeGapSet e ↔ adjacentGapLiesInEdge e k := by
  classical
  simp [rankThreeEdgeGapSet, adjacentGapLiesInEdge]

/-- The edge-interval slope obtained by summing the affine gap slopes. -/
def rankThreeEdgeIntervalSlope
    (rankThreeData : RankThreeSourceData)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (rankThreeEdgeGapSet e).sum
    (fun k => rankThreeKappa rankThreeData k)

/-- The edge-interval offset obtained by summing the affine gap offsets. -/
def rankThreeEdgeIntervalOffset
    (rankThreeData : RankThreeSourceData)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (rankThreeEdgeGapSet e).sum
    (fun k => rankThreeOffset rankThreeData k)

/-- The affine edge interval `I_e(T) = H_e T + S_e`. -/
def rankThreeAffineEdgeInterval
    (rankThreeData : RankThreeSourceData)
    (T : ℚ)
    (e : Section6.K5EdgeAddress) : ℚ :=
  rankThreeEdgeIntervalSlope rankThreeData e * T +
    rankThreeEdgeIntervalOffset rankThreeData e

/-- The sum of the affine adjacent gaps across one edge interval. -/
def rankThreeAffineGapIntervalSum
    (rankThreeData : RankThreeSourceData)
    (T : ℚ)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (rankThreeEdgeGapSet e).sum
    (fun k => rankThreeAffineGap rankThreeData T k)

/-- The edge interval is exactly the sum of its affine adjacent gaps. -/
theorem rankThreeAffineEdgeInterval_eq_gap_sum
    (rankThreeData : RankThreeSourceData)
    (T : ℚ)
    (e : Section6.K5EdgeAddress) :
    rankThreeAffineEdgeInterval rankThreeData T e =
      rankThreeAffineGapIntervalSum rankThreeData T e := by
  change
    (rankThreeEdgeGapSet e).sum
          (fun k => rankThreeKappa rankThreeData k) * T +
        (rankThreeEdgeGapSet e).sum
          (fun k => rankThreeOffset rankThreeData k) =
      (rankThreeEdgeGapSet e).sum
        (fun k =>
          rankThreeKappa rankThreeData k * T +
            rankThreeOffset rankThreeData k)
  rw [Finset.sum_mul, Finset.sum_add_distrib]

/-- The frozen nonzero coefficient attached to one edge. -/
def rankThreeFrozenCoefficient
    (leadingData : LeadingDescendantExtractionData)
    (e : Section6.K5EdgeAddress) : ℚ :=
  leadingFrozenCoefficientPattern leadingData e

/-- The normalized affine-sector slope. -/
def rankThreeAlpha
    (leadingData : LeadingDescendantExtractionData)
    (rankThreeData : RankThreeSourceData)
    (e : Section6.K5EdgeAddress) : ℚ :=
  rankThreeEdgeIntervalSlope rankThreeData e /
    rankThreeFrozenCoefficient leadingData e

/-- The normalized affine-sector offset. -/
def rankThreeBeta
    (leadingData : LeadingDescendantExtractionData)
    (rankThreeData : RankThreeSourceData)
    (e : Section6.K5EdgeAddress) : ℚ :=
  rankThreeEdgeIntervalOffset rankThreeData e /
    rankThreeFrozenCoefficient leadingData e

/-- The normalized affine sector read `A_e(T)`. -/
def rankThreeNormalizedSectorRead
    (leadingData : LeadingDescendantExtractionData)
    (rankThreeData : RankThreeSourceData)
    (T : ℚ)
    (e : Section6.K5EdgeAddress) : ℚ :=
  rankThreeAlpha leadingData rankThreeData e * T +
    rankThreeBeta leadingData rankThreeData e

/-- The non-absorbed affine-line packet carried to the affine input surface. -/
def rank_three_affine_line_data
    (opening : CanonicalIntervalOverloadOpeningData)
    (leadingData : LeadingDescendantExtractionData)
    (rankThreeData : RankThreeSourceData) : Prop :=
  (∀ m : ℕ, ∃ T : ℚ,
    ∀ k : Section6.AdjacentGapAddress,
      leadingAdjacentGapVector opening m k =
        rankThreeAffineGap rankThreeData T k) ∧
    (∀ e : Section6.K5EdgeAddress,
      rankThreeFrozenCoefficient leadingData e ≠ 0) ∧
    (∀ T : ℚ, ∀ e : Section6.K5EdgeAddress,
      rankThreeAffineEdgeInterval rankThreeData T e =
        rankThreeAffineGapIntervalSum rankThreeData T e) ∧
    ∀ T : ℚ, ∀ e : Section6.K5EdgeAddress,
      rankThreeNormalizedSectorRead
          leadingData rankThreeData T e =
        rankThreeAlpha leadingData rankThreeData e * T +
          rankThreeBeta leadingData rankThreeData e

/-- The rank-three branch either is absorbed or carries its affine-line packet. -/
def rank_three_affine_handoff
    (opening : CanonicalIntervalOverloadOpeningData)
    (leadingData : LeadingDescendantExtractionData)
    (regimeData : RankRegimeSourceData) : Prop :=
  leadingDescendantRank leadingData = 3 →
    rankThreeAbsorbed (rankThreeSourceData regimeData) = true ∨
      rank_three_affine_line_data
        opening leadingData (rankThreeSourceData regimeData)

/-
================================================================================
EXECUTABLE BOX
Section 8.4, Sub-layer 03, Sub-box 03
Birth token: rank_three_affine_handoff

This box opens the retained rank-three affine-line source, computes every edge
interval slope and offset from the fixed endpoint address, reads the same frozen
coefficient pattern, and derives the normalized affine-sector formulas.
================================================================================
-/

/-
================================================================================
STATE-SHAPE BATCH
Section 8.4, Sub-layer 03, Sub-box 03

Incoming state shape:
  rank_source opening leadingData regimeData
  Section6.Legacy.legacy_S_0 C nSeq dSeq
    (openingTSeq opening)
    (openingBSeq opening)
    (openingZSeq opening)

Outgoing state shape:
  rank_three_affine_handoff opening leadingData regimeData

Effect:
  On the rank-three branch, preserves the source absorption alternative or
  constructs the affine gap, interval, frozen-coefficient, and normalized
  sector packet over the same endpoint-address state.

Public theorem:
  build_rank_three_affine_handoff
================================================================================
-/

theorem build_rank_three_affine_handoff
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {leadingData : LeadingDescendantExtractionData}
    {regimeData : RankRegimeSourceData}
    (hRank : rank_source opening leadingData regimeData)
    (hS0 :
      Section6.Legacy.legacy_S_0
        C nSeq dSeq
        (openingTSeq opening)
        (openingBSeq opening)
        (openingZSeq opening)) :
    rank_three_affine_handoff opening leadingData regimeData := by
  intro hThree
  have hSource := hRank.2.2.2.2.1 hThree
  rcases hSource with hAbsorbed | hLine
  · exact Or.inl hAbsorbed.1
  · right
    refine ⟨hLine.2, ?_, ?_, ?_⟩
    · intro e
      have hFrozen := hRank.1.2.2.1.1 0 e
      have hBoundaryOrder := Section6.k5EdgeBoundary_ordered e
      have hBNonzero :=
        (hS0.1 0).2.2
          (Section6.k5EdgeBoundary e).1
          (Section6.k5EdgeBoundary e).2
          (ne_of_lt hBoundaryOrder)
      unfold rankThreeFrozenCoefficient
      rw [hFrozen]
      unfold rationalEndpointCoefficientAtEdge
      exact_mod_cast hBNonzero
    · intro T e
      exact rankThreeAffineEdgeInterval_eq_gap_sum _ _ _
    · intro T e
      rfl


