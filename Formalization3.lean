/-- Eliminate every row of one exact finite prefix-conflict family. -/
theorem eliminate_finite_prefix_conflict_family_at
    {D : Type}
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {data : RegularColoringProblemData}
    {certificateData : FinitePrefixCertificateSourceData D}
    {intervalData : PrefixIntervalSectorData}
    {lowRankData : RankTrichotomy.LowRankSourceData}
    (hFamilyAt :
      finite_prefix_conflict_family_at
