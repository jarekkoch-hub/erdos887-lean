/-- The terminal affine sector value A_f(lambda) = alpha_f * lambda + beta_f. -/
def terminalAffineSectorRead
    (alpha beta : Section6.K5EdgeAddress -> ℚ)
    (lambda : ℚ)
    (f : Section6.K5EdgeAddress) : ℚ :=
  alpha f * lambda + beta f

/-- The pointwise endpoint cubic difference attached to one row label. -/
def terminalEndpointCubicDifference
    (left right : ProductRowExtraction.ProductRowFactorAddressFamily)
    (alpha beta : Section6.K5EdgeAddress -> ℚ)
    (lambda : ℚ)
    (e : Section6.K5EdgeAddress) : ℚ :=
  terminalAffineSectorRead alpha beta lambda (left e 0) *
      terminalAffineSectorRead alpha beta lambda (left e 1) *
      terminalAffineSectorRead alpha beta lambda (left e 2) -
    terminalAffineSectorRead alpha beta lambda (right e 0) *
      terminalAffineSectorRead alpha beta lambda (right e 1) *
