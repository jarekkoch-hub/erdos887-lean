theorem third_strict_dominance_right_low_equations
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {sigmaSeq : ProfileReadSequence}
    {GSeq : MaxLinearProfileSequence}
    (hFull :
      full_profile_balance GSeq)
    (hBounds :
      max_read_bounds
        GammaSeq sigmaSeq GSeq)
    (m : ℕ)
    (hDominance :
      third_strict_dominance (GSeq m)) :
    GSeq m 3 < GSeq m 1 ∧
      GSeq m 1 < GSeq m 2 ∧
      GSeq m 0 = GSeq m 1 ∧
      GSeq m 3 + GSeq m 2 =
        2 * GSeq m 1 := by
  let a : ℚ := GSeq m 0
  let b : ℚ := GSeq m 1
  let c : ℚ := GSeq m 2
  let d : ℚ := GSeq m 3

  have hac : a < c := hDominance.1
  have hbc : b < c := hDominance.2.1
  have hdc : d < c := hDominance.2.2

  have hMaxLeft :=
    hBounds.2.2.2.2.1
  have hMaxRight :=
    hBounds.2.2.2.2.2

  have hbc_eq :
      max b c = c :=
    hMaxRight b c (le_of_lt hbc)

  have hcd_eq :
      max c d = c :=
    hMaxLeft c d (le_of_lt hdc)

  have habc :
      maxLinearMax3 a b c = c := by
    change max a (max b c) = c
    rw [hbc_eq]
    exact hMaxRight a c (le_of_lt hac)

  have hbcd :
      maxLinearMax3 b c d = c := by
    change max b (max c d) = c
    rw [hcd_eq, hbc_eq]

  have habcd :
      maxLinearMax4 a b c d = c := by
    change max a (max b (max c d)) = c
    rw [hcd_eq, hbc_eq]
    exact hMaxRight a c (le_of_lt hac)

  have h01 :
      maxLinearSigma (GSeq m) 0 =
        maxLinearSigma (GSeq m) 1 :=
    hFull.2 m 0 1

  rw [
    maxLinearSigma_zero_formula,
    maxLinearSigma_one_formula
  ] at h01
  change
    a + max a b +
        maxLinearMax3 a b c +
        maxLinearMax4 a b c d =
      a + b + max b c +
        maxLinearMax3 b c d at h01
  rw [habc, habcd, hbc_eq, hbcd] at h01

  have hmaxab_equals_b :
      max a b = b := by
    linarith

  have hab_le : a ≤ b := by
    have hle : a ≤ max a b :=
      le_max_left a b
    rw [hmaxab_equals_b] at hle
    exact hle

  have h12 :
      maxLinearSigma (GSeq m) 1 =
        maxLinearSigma (GSeq m) 2 :=
    hFull.2 m 1 2

  rw [
    maxLinearSigma_one_formula,
    maxLinearSigma_two_formula
  ] at h12
  change
    a + b + max b c +
        maxLinearMax3 b c d =
      max a b + b + c + max c d at h12
  rw [hbc_eq, hbcd, hcd_eq] at h12

  have hmaxab_equals_a :
      max a b = a := by
    linarith

  have hba : b ≤ a := by
    have hle : b ≤ max a b :=
      le_max_right a b
    rw [hmaxab_equals_a] at hle
    exact hle

  have hab_value : a = b :=
    le_antisymm hab_le hba

  have h23 :
      maxLinearSigma (GSeq m) 2 =
        maxLinearSigma (GSeq m) 3 :=
    hFull.2 m 2 3

  rw [
    maxLinearSigma_two_formula,
    maxLinearSigma_three_formula
  ] at h23
  change
    max a b + b + c + max c d =
      maxLinearMax3 a b c +
        max b c + c + d at h23
  rw [
    hmaxab_equals_b,
    hcd_eq, habc, hbc_eq
  ] at h23

  have hsum :
      d + c = 2 * b := by
    linarith

  have hdb : d < b := by
    linarith

  change
    d < b ∧ b < c ∧ a = b ∧
      d + c = 2 * b
  exact
    ⟨hdb, hbc, hab_value, hsum⟩

/--
The balanced classification packet retains all five exact construction inputs
and adds the pointwise three-way branch conclusion.

The conclusion is an ordinary disjunction, not an assertion that the three
predicates were already exhaustive in Section 7.2.
-/
def balanced_branch_classification
    (GammaSeq : Gamma_W_adjacent_growth_profile)
    (sigmaSeq : ProfileReadSequence)
    (GSeq : MaxLinearProfileSequence) : Prop :=
  max_linear_comparison_split
      GammaSeq sigmaSeq GSeq ∧
    full_profile_balance GSeq ∧
    refined_branch_alternatives
      GammaSeq sigmaSeq GSeq ∧
    saturation_lemmas ∧
    max_read_bounds
      GammaSeq sigmaSeq GSeq ∧
    ∀ m : ℕ,
      uniform_max_linear_profile (GSeq m) ∨
        refined_left_low_profile (GSeq m) ∨
        refined_right_low_profile (GSeq m)

/-
================================================================================
STATE-SHAPE BATCH
Section 7.5, Sub-layer 02, Sub-box 02

Incoming state shape:
  max_linear_comparison_split GammaSeq sigmaSeq GSeq
  full_profile_balance GSeq
  refined_branch_alternatives GammaSeq sigmaSeq GSeq
  saturation_lemmas
  max_read_bounds GammaSeq sigmaSeq GSeq

Outgoing state shape:
  balanced_branch_classification GammaSeq sigmaSeq GSeq

Effect:
  Applies the balanced case derivation corresponding to each of the five pure
  comparison alternatives, then converts the resulting equations through the
  already registered branch predicates.  No branch is discarded before its
  case lemma is applied.

Public theorem:
  build_balanced_branch_classification
================================================================================
-/

theorem build_balanced_branch_classification
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {sigmaSeq : ProfileReadSequence}
    {GSeq : MaxLinearProfileSequence}
    (hComparison :
      max_linear_comparison_split
        GammaSeq sigmaSeq GSeq)
    (hFull :
      full_profile_balance GSeq)
    (hAlternatives :
      refined_branch_alternatives
        GammaSeq sigmaSeq GSeq)
    (hSaturation :
      saturation_lemmas)
    (hBounds :
      max_read_bounds
        GammaSeq sigmaSeq GSeq) :
    balanced_branch_classification
      GammaSeq sigmaSeq GSeq := by
  refine
    ⟨hComparison, hFull, hAlternatives,
      hSaturation, hBounds, ?_⟩

  intro m

  rcases hComparison.2 m with
    hFirst | hSecond | hThird | hFourth | hTie

  · have hUniformEquations :
        GSeq m 0 = GSeq m 1 ∧
          GSeq m 1 = GSeq m 2 ∧
          GSeq m 2 = GSeq m 3 :=
      first_endpoint_dominance_uniform_equations
        hFull hSaturation hBounds m hFirst

    exact
      Or.inl
        ((hAlternatives.2 m).1.mpr
          hUniformEquations)

  · have hLeftEquations :
        GSeq m 0 < GSeq m 2 ∧
          GSeq m 2 < GSeq m 1 ∧
          GSeq m 2 = GSeq m 3 ∧
          GSeq m 0 + GSeq m 1 =
            2 * GSeq m 2 :=
      second_strict_dominance_left_low_equations
        hFull hBounds m hSecond

    exact
      Or.inr
        (Or.inl
          ((hAlternatives.2 m).2.1.mpr
            hLeftEquations))

  · have hRightEquations :
        GSeq m 3 < GSeq m 1 ∧
          GSeq m 1 < GSeq m 2 ∧
          GSeq m 0 = GSeq m 1 ∧
          GSeq m 3 + GSeq m 2 =
            2 * GSeq m 1 :=
      third_strict_dominance_right_low_equations
        hFull hBounds m hThird

    exact
      Or.inr
        (Or.inr
          ((hAlternatives.2 m).2.2.mpr
            hRightEquations))

  · have hUniformEquations :
        GSeq m 0 = GSeq m 1 ∧
          GSeq m 1 = GSeq m 2 ∧
          GSeq m 2 = GSeq m 3 :=
      fourth_endpoint_dominance_uniform_equations
        hFull hSaturation hBounds m hFourth

    exact
      Or.inl
        ((hAlternatives.2 m).1.mpr
          hUniformEquations)

  · have hUniformEquations :
        GSeq m 0 = GSeq m 1 ∧
          GSeq m 1 = GSeq m 2 ∧
          GSeq m 2 = GSeq m 3 :=
      central_tie_uniform_equations
        hFull hBounds m hTie

    exact
      Or.inl
        ((hAlternatives.2 m).1.mpr
          hUniformEquations)

