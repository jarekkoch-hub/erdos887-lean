Section 9.1, Sub-layer 03, Sub-box 03
Birth token: regular_coloring_alternatives

This box performs the finite classification on the exact regular coloring.
The handshake identity makes the common degree even; the degree bound leaves
only 0, 2, or 4.  Degrees 0 and 4 retain a selected monochrome color, while
degree 2 enters the already-built compatible cycle family.

No prefix branch is eliminated here.  The output is the classification source
consumed later by K and FG_mono.
================================================================================
-/

/-- An even natural number bounded by four is `0`, `2`, or `4`. -/
theorem even_natural_le_four_cases
    (d : ℕ)
    (hBound : d ≤ 4)
    (hEvenMod : d % 2 = 0) :
    d = 0 ∨ d = 2 ∨ d = 4 := by
  cases d with
  | zero =>
      exact Or.inl rfl
  | succ d1 =>
      cases d1 with
      | zero =>
          simp at hEvenMod
      | succ d2 =>
          cases d2 with
          | zero =>
              exact Or.inr (Or.inl rfl)
          | succ d3 =>
              cases d3 with
              | zero =>
                  simp at hEvenMod
              | succ d4 =>
                  cases d4 with
                  | zero =>
                      exact Or.inr (Or.inr rfl)
                  | succ d5 =>
                      nlinarith

/-- The monochrome-or-compatible-cycle classification for one exact datum. -/
def regular_coloring_alternatives_at
    (data : RegularColoringProblemData) : Prop :=
  prefix_monochrome_branch
      (regularColoringChi data) ∨
    ∃ C : PrefixCycleAddress,
      compatible_degree_two_branch
        (regularColoringChi data) C

/-- The paper's regular K5 coloring classification on one selected datum. -/
theorem classify_regular_coloring_at
    (data : RegularColoringProblemData)
    (hRegular : regular_coloring_problem_at data)
    (hFamily : degree_two_branch_family_at data) :
    regular_coloring_alternatives_at data := by
  rcases hRegular with
    ⟨_hIncident, _hInventory, hDegree, _hReferences⟩

  have hBound :
      regularColoringCommonDegree data ≤ 4 := by
    rw [← hDegree 0]
    exact
      Section6.boolean_vertex_degree_bound
        (regularColoringChi data) 0

  have hTotalCommon :
      Section6.booleanTotalVertexDegree
          (regularColoringChi data) =
        5 * regularColoringCommonDegree data := by
    unfold Section6.booleanTotalVertexDegree
    rw [hDegree 0, hDegree 1, hDegree 2,
      hDegree 3, hDegree 4]
    ring

  have hHandshake :
      Section6.booleanTotalVertexDegree
          (regularColoringChi data) =
        2 * Section6.booleanSelectedEdgeCount
          (regularColoringChi data) :=
    Section6.boolean_handshake_identity
      (regularColoringChi data)

  have hDegreeEquation :
      5 * regularColoringCommonDegree data =
        2 * Section6.booleanSelectedEdgeCount
          (regularColoringChi data) := by
    calc
      5 * regularColoringCommonDegree data =
          Section6.booleanTotalVertexDegree
            (regularColoringChi data) :=
        hTotalCommon.symm
      _ =
          2 * Section6.booleanSelectedEdgeCount
            (regularColoringChi data) :=
        hHandshake

  have hModEquation :=
    congrArg (fun q : ℕ => q % 2) hDegreeEquation

  have hEvenMod :
      regularColoringCommonDegree data % 2 = 0 := by
    simpa [Nat.mul_mod] using hModEquation

  rcases
      even_natural_le_four_cases
        (regularColoringCommonDegree data)
        hBound hEvenMod with
    hZero | hTwo | hFour

  · have hDegreeZero :
        ∀ v : Section6.EndpointAddress,
          Section6.booleanVertexDegree
              (regularColoringChi data) v = 0 := by
      intro v
      rw [hDegree v, hZero]

    have hAllFalse :
        ∀ e : Section6.K5EdgeAddress,
          regularColoringChi data e = false :=
      Section6.boolean_zero_degree_extremal
        (regularColoringChi data) hDegreeZero

    exact Or.inl ⟨false, hAllFalse⟩

  · exact Or.inr (hFamily.2 hTwo)

  · have hDegreeFour :
        ∀ v : Section6.EndpointAddress,
          Section6.booleanVertexDegree
              (regularColoringChi data) v = 4 := by
      intro v
      rw [hDegree v, hFour]

    have hAllTrue :
        ∀ e : Section6.K5EdgeAddress,
          regularColoringChi data e = true :=
      Section6.boolean_full_degree_extremal
        (regularColoringChi data) hDegreeFour

    exact Or.inl ⟨true, hAllTrue⟩

/--
The Section 9.1 classification state extends both preceding batches and adds
only the same-data monochrome-or-cycle alternative.
-/
def regular_coloring_alternatives
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  regular_coloring_problem C nSeq dSeq opening ∧
    degree_two_branch_family C nSeq dSeq opening ∧
      ∀ data : RegularColoringProblemData,
        regular_coloring_source_coherence
            C nSeq dSeq opening data →
          regular_coloring_problem_at data →
            degree_two_branch_family_at data →
              regular_coloring_alternatives_at data

/-
