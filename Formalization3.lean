/--
Five near-root divisors of one natural number, indexed in strictly increasing
order.  No custom structure or record is introduced.
-/
def five_near_root_divisor_witness
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  StrictMono d ∧
    ∀ i : Fin 5, d i ∣ n ∧ inRootBand C n (d i)

