    (hImpossible :
      prefix_cone_conflict_impossible C nSeq dSeq opening) :
    degree_two_branches_eliminated_at data := by
  rcases hFamilyAt with
    ⟨_hRegular, _hBranchFamily, _hCertificate,
      _hModel, _hInterval, _hLowerClosed, hRows⟩
  intro cycle hBranch

  have hDatum := hRows cycle hBranch

  exact
    hImpossible.2.2
      D
      (projectiveConeModelFromCertificate certificateData)
      intervalData
      lowRankData
      (prefixCertificateX certificateData cycle)
      (prefixCertificateY certificateData cycle)
      (prefixCertificateZ certificateData cycle)
      (prefixCertificateConflictEdge certificateData cycle)
      (prefixCertificateLeftGap certificateData cycle)
      (prefixCertificateRightGap certificateData cycle)
      hDatum

