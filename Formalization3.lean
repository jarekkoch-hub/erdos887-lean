Effect:
  Packages the first active off-profile support state over the same sequence.

Public theorem:
  derive_FirstOff_vec

================================================================================
-/

theorem derive_FirstOff_vec
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {o : ℕ}
    {mu : SupportAddress → ℝ}
    (hfull : ∀ m : ℕ, full_atom_model (nSeq m) (dSeq m))
    (hfaces : ∀ m : ℕ,
      two_canonical_clipped_faces (nSeq m) (dSeq m))
    (hoff : ∀ m : ℕ, off_face_pressure (nSeq m) (dSeq m))
    (horientation : offProfileOrientation o)
    (hnonneg : supportMassNonnegative mu)
    (hsupported : offProfileMassSupported o mu)
    (hnorm : offProfileMassNormalized o mu) :
    FirstOff_vec nSeq dSeq o mu := by
  refine
    ⟨hfull, hfaces, hoff, horientation, hnonneg,
      hsupported, hnorm, ?_⟩
  exact normalized_offProfileMass_exists_positive hnonneg hnorm

