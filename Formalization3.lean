  identification remains outside Coh_sh.

Public theorem:
  build_Coh_sh
================================================================================
-/

theorem build_Coh_sh
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {nuSeq : IncidentGrowth.IncidentGrowthExponentSequence}
    {sigmaSeq : IncidentGrowth.ProfileReadSequence}
    {GSeq : IncidentGrowth.MaxLinearProfileSequence}
    {Dcan : Type}
    {dcan : Dcan}
    {selection : CanonicalInternal.CanonicalInternalSelectionRelation}
    {sectorLaw : CanonicalInternal.CanonicalSectorLawFamily Dcan}
    {reducedCubicLaw :
      CanonicalInternal.CanonicalReducedCubicLawFamily Dcan}
    (hCanonicalSource :
      CanonicalInternal.canonical_internal_source
        C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
        dcan selection sectorLaw reducedCubicLaw)
    (hContext :
      shared_state_context
        C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
        dcan selection sectorLaw reducedCubicLaw)
    (hSameK :
      PrefixConflict.same_k_synchronization C nSeq dSeq opening) :
    Coh_sh
      C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
      dcan selection sectorLaw reducedCubicLaw := by
  rcases hContext with
    ⟨_hB, hMono, _hK, _hSync, _hLoc, hAffine, _hDatum,
      D, survivorData, affineData, polynomialData, productRowData,
      sourceData, hContextAt⟩
  have hKAt :
      PrefixConflict.K_components_at
        C nSeq dSeq opening survivorData :=
    hContextAt.2.2.1
  have hSyncAt :
      AffineSync.A_sync_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hContextAt.2.2.2.1
  have hAffineAt :
      AffineChamber.HI_aff_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hContextAt.2.2.2.2.2.1
  have hSameKAt :
      PrefixConflict.same_k_synchronization_at
        C nSeq dSeq opening survivorData :=
    hSameK.2 survivorData hKAt
  have hAffineIdentificationsAt :
      AffineSync.same_k_affine_identifications_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hSyncAt.2.2.2.2.2
  have hMatchAt :
      AffineChamber.match_mono_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hAffineAt.2.2.1
  have hSelectionAt :
      CanonicalInternal.canonical_internal_selection_at
        survivorData affineData polynomialData productRowData sourceData
        Dcan dcan selection sectorLaw reducedCubicLaw :=
    (hCanonicalSource
      survivorData affineData polynomialData productRowData sourceData
      hAffineAt).1
  have hReads :=
    CanonicalInternal.constant_pointwise_reads_from_section_states
      (Dcan := Dcan) hMono hAffine
  exact
    ⟨D, survivorData, affineData, polynomialData, productRowData,
      sourceData, hContextAt,
      hSameKAt, hAffineIdentificationsAt, hMatchAt, hSelectionAt,
      hReads.1, hReads.2⟩


