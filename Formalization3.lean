/-- An address lies in the three-face corridor exactly at level 0 or 3. -/
def threeFaceAddress (S : SupportAddress) : Prop :=
  S.card = 0 ∨ S.card = 3

/-- An address lies in the two-face corridor exactly at level 2 or 5. -/
def twoFaceAddress (S : SupportAddress) : Prop :=
  S.card = 2 ∨ S.card = 5

/-- Decidability of membership in the exact three-face corridor. -/
instance decidablePredThreeFaceAddress :
    DecidablePred threeFaceAddress := by
  intro S
  unfold threeFaceAddress
  infer_instance

/-- Decidability of membership in the exact two-face corridor. -/
instance decidablePredTwoFaceAddress :
    DecidablePred twoFaceAddress := by
  intro S
  unfold twoFaceAddress
  infer_instance

/-- The exact finite support-address alphabet of the three-face corridor. -/
def threeFaceAddresses : Finset SupportAddress :=
  supportAddresses.filter threeFaceAddress

/-- The exact finite support-address alphabet of the two-face corridor. -/
def twoFaceAddresses : Finset SupportAddress :=
  supportAddresses.filter twoFaceAddress

@[simp]
theorem mem_threeFaceAddresses
    {S : SupportAddress} :
    S ∈ threeFaceAddresses ↔ threeFaceAddress S := by
  simp [threeFaceAddresses]

@[simp]
theorem mem_twoFaceAddresses
    {S : SupportAddress} :
    S ∈ twoFaceAddresses ↔ twoFaceAddress S := by
  simp [twoFaceAddresses]

/-- Complement of a support address inside the five-endpoint universe. -/
def complementAddress (S : SupportAddress) : SupportAddress :=
  Sᶜ

@[simp]
theorem mem_complementAddress
    {S : SupportAddress} {i : Fin 5} :
    i ∈ complementAddress S ↔ i ∉ S := by
  simp [complementAddress]

@[simp]
theorem complementAddress_involutive (S : SupportAddress) :
    complementAddress (complementAddress S) = S := by
  ext i
  simp [complementAddress]

/-- Complementation sends every three-face address to a two-face address. -/
theorem threeFaceAddress_complement
    {S : SupportAddress}
    (hS : threeFaceAddress S) :
    twoFaceAddress (complementAddress S) := by
  rcases hS with hzero | hthree
  · right
    unfold complementAddress
    rw [Finset.card_compl]
    simp [hzero]
  · left
    unfold complementAddress
    rw [Finset.card_compl]
    simp [hthree]

/-- Complementation sends every two-face address to a three-face address. -/
theorem twoFaceAddress_complement
    {S : SupportAddress}
    (hS : twoFaceAddress S) :
    threeFaceAddress (complementAddress S) := by
  rcases hS with htwo | hfive
  · right
    unfold complementAddress
    rw [Finset.card_compl]
    simp [htwo]
  · left
    unfold complementAddress
    rw [Finset.card_compl]
    simp [hfive]

/-- The two exact face corridors are complementary reads of one address. -/
theorem threeFaceAddress_iff_complement_twoFace
    (S : SupportAddress) :
    threeFaceAddress S ↔
      twoFaceAddress (complementAddress S) := by
  constructor
  · exact threeFaceAddress_complement
  · intro hS
    have hdouble :
        threeFaceAddress
          (complementAddress (complementAddress S)) :=
      twoFaceAddress_complement hS
    simpa using hdouble

/--
The exact two-face packet carried by one finite atomized witness.  It names the
corridors and records their complementarity without asserting that the witness
has entered either ideal face.
-/
def two_canonical_clipped_faces
    (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  exact_finite_support_ledgers n d ∧
    ∀ S : SupportAddress,
      threeFaceAddress S ↔
        twoFaceAddress (complementAddress S)

/-- The exact finite support ledger canonically names the two face corridors. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.3, Sub-sub-layer 01, Sub-sub-box 01

Incoming state shape:
  exact_finite_support_ledgers n d

Outgoing state shape:
  two_canonical_clipped_faces n d

Effect:
  Introduces the exact level-3/0 and level-2/5 complementary support-address
  corridor coordinates.  This coordinate birth does not assert that the
  witness has entered either corridor.

Public theorem:
  derive_two_canonical_clipped_faces

================================================================================
-/

theorem derive_two_canonical_clipped_faces
    {n : ℕ} {d : Fin 5 → ℕ}
    (hfinite : exact_finite_support_ledgers n d) :
    two_canonical_clipped_faces n d := by
  exact ⟨hfinite, threeFaceAddress_iff_complement_twoFace⟩

/- Sub-sub-layer 02 -/
/-
Paper ref: 3.4.3
Sub-sub-box Label: `Off-face products and defect read: C_3(W), C_2(W), C_off(W)=min(C_3,C_2)`
Sub-sub-inputs: `two_canonical_clipped_faces`
Sub-sub-outputs: `off_face_pressure`
Note: this box constructs only the exact natural products and their exact
prime-height exponent reads.  It does not assert a C-dependent bound and does
not identify the natural products with normalized real powers.
-/
def section_3_4_3_sub_sub_layer_02_sub_sub_box_02_label : String := "Off-face products and defect read: C_3(W), C_2(W), C_off(W)=min(C_3,C_2)"
def section_3_4_3_sub_sub_layer_02_sub_sub_box_02_inputs : List String := ["two_canonical_clipped_faces [construction]"]
def section_3_4_3_sub_sub_layer_02_sub_sub_box_02_outputs : List String := ["off_face_pressure [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.3, Sub-sub-layer 02, Sub-sub-box 02
Birth token: off_face_pressure

The exact off-face products are

  C_3(W) = product of X_S over addresses outside levels {0,3},
  C_2(W) = product of X_S over addresses outside levels {2,5},
  C_off(W) = min(C_3(W), C_2(W)).

For each base p, the exponent of p in C_3 or C_2 is proved to be the number of
prime-height levels whose support address lies outside the corresponding face.
This is the exact finite primitive form from the paper.

No logarithm, normalized defect, asymptotic smallness, C-dependent bound,
face-entry claim, or later wire activation occurs here.
================================================================================
-/

/-- An address lies outside the exact three-face corridor. -/
def offThreeFaceAddress (S : SupportAddress) : Prop :=
  ¬ threeFaceAddress S

/-- An address lies outside the exact two-face corridor. -/
def offTwoFaceAddress (S : SupportAddress) : Prop :=
  ¬ twoFaceAddress S

/-- Decidability of lying outside the exact three-face corridor. -/
instance decidablePredOffThreeFaceAddress :
    DecidablePred offThreeFaceAddress := by
  intro S
  unfold offThreeFaceAddress threeFaceAddress
  infer_instance

/-- Decidability of lying outside the exact two-face corridor. -/
instance decidablePredOffTwoFaceAddress :
    DecidablePred offTwoFaceAddress := by
  intro S
  unfold offTwoFaceAddress twoFaceAddress
  infer_instance

/-- All support addresses outside levels 0 and 3. -/
def offThreeFaceAddresses : Finset SupportAddress :=
  supportAddresses.filter offThreeFaceAddress

/-- All support addresses outside levels 2 and 5. -/
def offTwoFaceAddresses : Finset SupportAddress :=
  supportAddresses.filter offTwoFaceAddress

@[simp]
theorem mem_offThreeFaceAddresses
    {S : SupportAddress} :
    S ∈ offThreeFaceAddresses ↔ offThreeFaceAddress S := by
  simp [offThreeFaceAddresses]

@[simp]
theorem mem_offTwoFaceAddresses
    {S : SupportAddress} :
    S ∈ offTwoFaceAddresses ↔ offTwoFaceAddress S := by
  simp [offTwoFaceAddresses]

/-- Exact natural off-face product relative to the three-face corridor. -/
noncomputable def offFaceProductThree
    (n : ℕ) (d : Fin 5 → ℕ) : ℕ :=
  ∏ S ∈ offThreeFaceAddresses, atomBucket n d S

/-- Exact natural off-face product relative to the two-face corridor. -/
noncomputable def offFaceProductTwo
    (n : ℕ) (d : Fin 5 → ℕ) : ℕ :=
  ∏ S ∈ offTwoFaceAddresses, atomBucket n d S

/-- Orientation-free exact off-face pressure. -/
noncomputable def offFacePressureNat
    (n : ℕ) (d : Fin 5 → ℕ) : ℕ :=
  Nat.min (offFaceProductThree n d) (offFaceProductTwo n d)

/-- Every exact three-face off-product is positive. -/
theorem offFaceProductThree_pos
    (n : ℕ) (d : Fin 5 → ℕ) :
    0 < offFaceProductThree n d := by
  unfold offFaceProductThree
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro S _hS
    exact atomBucket_pos n d S)

/-- Every exact two-face off-product is positive. -/
theorem offFaceProductTwo_pos
    (n : ℕ) (d : Fin 5 → ℕ) :
    0 < offFaceProductTwo n d := by
  unfold offFaceProductTwo
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro S _hS
    exact atomBucket_pos n d S)

/-- Prime-height levels of p lying outside the three-face corridor. -/
noncomputable def offFaceExponentThree
    (n : ℕ) (d : Fin 5 → ℕ) (p : ℕ) : ℕ :=
  ((primeTokenLevels n p).filter fun ell =>
    offThreeFaceAddress (primeTokenAddress d p ell)).card

/-- Prime-height levels of p lying outside the two-face corridor. -/
noncomputable def offFaceExponentTwo
    (n : ℕ) (d : Fin 5 → ℕ) (p : ℕ) : ℕ :=
  ((primeTokenLevels n p).filter fun ell =>
    offTwoFaceAddress (primeTokenAddress d p ell)).card

/--
The p-adic exponent of the three-face off-product is exactly the number of
prime-height levels of p outside the three-face corridor.
-/
theorem offFaceProductThree_factorization_apply
    (n : ℕ) (d : Fin 5 → ℕ) (p : ℕ) :
    (offFaceProductThree n d).factorization p =
      offFaceExponentThree n d p := by
  unfold offFaceProductThree offThreeFaceAddresses
  rw [Nat.factorization_prod_apply]
  · simp_rw [atomBucket_factorization_apply]
    unfold atomMultiplicity offFaceExponentThree
    exact sum_addressFiberCount_filter
      (primeTokenLevels n p)
      (primeTokenAddress d p)
      offThreeFaceAddress
  · intro S _hS
    exact (atomBucket_pos n d S).ne'

/--
The p-adic exponent of the two-face off-product is exactly the number of
prime-height levels of p outside the two-face corridor.
-/
theorem offFaceProductTwo_factorization_apply
    (n : ℕ) (d : Fin 5 → ℕ) (p : ℕ) :
    (offFaceProductTwo n d).factorization p =
      offFaceExponentTwo n d p := by
  unfold offFaceProductTwo offTwoFaceAddresses
  rw [Nat.factorization_prod_apply]
  · simp_rw [atomBucket_factorization_apply]
    unfold atomMultiplicity offFaceExponentTwo
    exact sum_addressFiberCount_filter
      (primeTokenLevels n p)
      (primeTokenAddress d p)
      offTwoFaceAddress
  · intro S _hS
    exact (atomBucket_pos n d S).ne'

/-- The orientation-free pressure is bounded by the three-face product. -/
theorem offFacePressureNat_le_three
    (n : ℕ) (d : Fin 5 → ℕ) :
    offFacePressureNat n d ≤ offFaceProductThree n d := by
  unfold offFacePressureNat
  exact Nat.min_le_left _ _

/-- The orientation-free pressure is bounded by the two-face product. -/
theorem offFacePressureNat_le_two
    (n : ℕ) (d : Fin 5 → ℕ) :
    offFacePressureNat n d ≤ offFaceProductTwo n d := by
  unfold offFacePressureNat
  exact Nat.min_le_right _ _

/--
The exact finite off-face pressure packet.  It retains the same two-face state,
positivity of both natural products, and the exact prime-height exponent reads.
No boundedness statement is included.
-/
def off_face_pressure
    (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  two_canonical_clipped_faces n d ∧
    0 < offFaceProductThree n d ∧
    0 < offFaceProductTwo n d ∧
    (∀ p : ℕ,
      (offFaceProductThree n d).factorization p =
        offFaceExponentThree n d p) ∧
    (∀ p : ℕ,
      (offFaceProductTwo n d).factorization p =
        offFaceExponentTwo n d p)

/-- The exact two-face packet produces the exact off-face pressure packet. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.3, Sub-sub-layer 02, Sub-sub-box 02

Incoming state shape:
  two_canonical_clipped_faces n d

Outgoing state shape:
  off_face_pressure n d

Effect:
  Builds the two exact off-corridor products and their minimum defect read in
  the previously introduced corridor coordinate system.  This coordinate
  birth does not restrict the witness to either corridor.

Public theorem:
  derive_off_face_pressure

================================================================================
-/

theorem derive_off_face_pressure
    {n : ℕ} {d : Fin 5 → ℕ}
    (hfaces : two_canonical_clipped_faces n d) :
    off_face_pressure n d := by
  exact
    ⟨hfaces,
     offFaceProductThree_pos n d,
     offFaceProductTwo_pos n d,
     offFaceProductThree_factorization_apply n d,
     offFaceProductTwo_factorization_apply n d⟩

/- # Sub-sub-container 3.4.4: Directed quotients and canonical clipping diagnostics. -/

/- Sub-sub-layer 01 -/
/-
Paper ref: 3.4.4
Sub-sub-box Label: `Directed quotient system: U_{i|j}(W), common edge factors G_ij, and atomized pair quotient reads`
Sub-sub-inputs: `full_atom_model`
Sub-sub-outputs: `Edge_can`
-/
def section_3_4_4_sub_sub_layer_01_sub_sub_box_01_label : String := "Directed quotient system: U_{i|j}(W), common edge factors G_ij, and atomized pair quotient reads"
def section_3_4_4_sub_sub_layer_01_sub_sub_box_01_inputs : List String := ["full_atom_model [read]"]
def section_3_4_4_sub_sub_layer_01_sub_sub_box_01_outputs : List String := ["Edge_can [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.4, Sub-sub-layer 01, Sub-sub-box 01
Birth token: Edge_can

This box reads one already constructed full atom model and defines the exact
finite products

  U_{i|j} = product of X_S over i in S and j notin S,
  G_{ij}  = product of X_S over i,j in S.

It proves the two exact endpoint splits and their denominator-cleared quotient
identity.  No edge labels are selected, no sequence is opened, and no chamber
route is assigned here.
================================================================================
-/

/-- An address loads the directed quotient from i away from j. -/
def directedEdgeAddress
    (i j : Fin 5) (S : SupportAddress) : Prop :=
  i ∈ S ∧ j ∉ S

/-- An address loads the common upper factor on the edge {i,j}. -/
def commonEdgeAddress
    (i j : Fin 5) (S : SupportAddress) : Prop :=
  i ∈ S ∧ j ∈ S

/-- Exact directed quotient product U_{i|j}. -/
noncomputable def directedQuotient
    (n : ℕ) (d : Fin 5 → ℕ) (i j : Fin 5) : ℕ := by
  classical
  exact ∏ S ∈ supportAddresses.filter (directedEdgeAddress i j),
    atomBucket n d S

/-- Exact common upper factor G_{ij}. -/
noncomputable def commonEdgeFactor
    (n : ℕ) (d : Fin 5 → ℕ) (i j : Fin 5) : ℕ := by
  classical
  exact ∏ S ∈ supportAddresses.filter (commonEdgeAddress i j),
    atomBucket n d S

/-- Every directed quotient product is positive. -/
theorem directedQuotient_pos
    (n : ℕ) (d : Fin 5 → ℕ) (i j : Fin 5) :
    0 < directedQuotient n d i j := by
  unfold directedQuotient
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro S _hS
    exact atomBucket_pos n d S)

/-- Every common upper edge factor is positive. -/
theorem commonEdgeFactor_pos
    (n : ℕ) (d : Fin 5 → ℕ) (i j : Fin 5) :
    0 < commonEdgeFactor n d i j := by
  unfold commonEdgeFactor
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro S _hS
    exact atomBucket_pos n d S)

/-- The common edge factor is symmetric in its two endpoints. -/
theorem commonEdgeFactor_comm
    (n : ℕ) (d : Fin 5 → ℕ) (i j : Fin 5) :
    commonEdgeFactor n d i j =
      commonEdgeFactor n d j i := by
  classical
  unfold commonEdgeFactor commonEdgeAddress
  apply Finset.prod_congr
  · ext S
    simp [and_comm]
  · intro S _hS
    rfl

/--
Finite product partition used by the endpoint split. It is an exact identity,
not a routing or asymptotic statement.
-/
theorem nat_prod_filter_partition
    {α : Type*}
    [DecidableEq α]
    (s : Finset α)
    (P Q : α → Prop)
    [DecidablePred P]
    [DecidablePred Q]
    (f : α → ℕ) :
    (∏ x ∈ s.filter P, f x) =
      (∏ x ∈ s.filter (fun x => P x ∧ Q x), f x) *
        (∏ x ∈ s.filter (fun x => P x ∧ ¬ Q x), f x) := by
  let sPQ : Finset α :=
    s.filter (fun x => P x ∧ Q x)

  let sPnQ : Finset α :=
    s.filter (fun x => P x ∧ ¬ Q x)

  have hpartition :
      s.filter P = sPQ ∪ sPnQ := by
    ext x
    by_cases hPx : P x
    · by_cases hQx : Q x
      · simp [sPQ, sPnQ, hPx, hQx]
      · simp [sPQ, sPnQ, hPx, hQx]
    · simp [sPQ, sPnQ, hPx]

  have hdisjoint :
      Disjoint sPQ sPnQ := by
    refine Finset.disjoint_left.2 ?_
    intro x hxPQ hxPnQ
    have hQx : Q x :=
      (Finset.mem_filter.mp hxPQ).2.2
    have hnQx : ¬ Q x :=
      (Finset.mem_filter.mp hxPnQ).2.2
    exact hnQx hQx

  calc
    (∏ x ∈ s.filter P, f x)
        =
        ∏ x ∈ sPQ ∪ sPnQ, f x := by
          rw [hpartition]

    _ =
        (∏ x ∈ sPQ, f x) *
          (∏ x ∈ sPnQ, f x) := by
            exact Finset.prod_union hdisjoint

    _ =
        (∏ x ∈ s.filter (fun x => P x ∧ Q x), f x) *
          (∏ x ∈ s.filter (fun x => P x ∧ ¬ Q x), f x) := by
            rfl

/-- The upper atom read splits into its common and directed parts. -/
theorem upperAtomRead_eq_common_mul_directed
    (n : ℕ) (d : Fin 5 → ℕ) (i j : Fin 5) :
    upperAtomRead n d i =
      commonEdgeFactor n d i j *
        directedQuotient n d i j := by
  classical
  unfold upperAtomRead commonEdgeFactor directedQuotient
    commonEdgeAddress directedEdgeAddress

  simp_rw [Finset.prod_filter]
  rw [← Finset.prod_mul_distrib]

  apply Finset.prod_congr rfl
  intro S _hS

  by_cases hi : i ∈ S
  · by_cases hj : j ∈ S
    · simp [hi, hj]
    · simp [hi, hj]
  · simp [hi]

/--
The exact pointwise directed-edge packet.  The cross identity is the natural
number form of D_j/D_i = U_{j|i}/U_{i|j}; no natural division is used as a
rational operation.
-/
def Edge_can
    (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  full_atom_model n d ∧
    (∀ i j : Fin 5,
      d i = commonEdgeFactor n d i j * directedQuotient n d i j) ∧
    (∀ i j : Fin 5,
      d j = commonEdgeFactor n d i j * directedQuotient n d j i) ∧
    ∀ i j : Fin 5,
      d j * directedQuotient n d i j =
        d i * directedQuotient n d j i

/-- The full atom model produces the exact directed-edge packet. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.4, Sub-sub-layer 01, Sub-sub-box 01

Incoming state shape:
  full_atom_model n d

Outgoing state shape:
  Edge_can n d

Effect:
  Re-encodes every endpoint read into common-edge factors and opposite directed
  quotients, including the exact cross identity.

Public theorem:
  derive_Edge_can

================================================================================
-/

theorem derive_Edge_can
    {n : ℕ} {d : Fin 5 → ℕ}
    (hmodel : full_atom_model n d) :
    Edge_can n d := by
  have hupper : ∀ i : Fin 5, d i = upperAtomRead n d i :=
    hmodel.2.2.1
  refine ⟨hmodel, ?_, ?_, ?_⟩
  · intro i j
    calc
      d i = upperAtomRead n d i := hupper i
      _ = commonEdgeFactor n d i j *
          directedQuotient n d i j :=
        upperAtomRead_eq_common_mul_directed n d i j
  · intro i j
    calc
      d j = upperAtomRead n d j := hupper j
      _ = commonEdgeFactor n d j i *
          directedQuotient n d j i :=
        upperAtomRead_eq_common_mul_directed n d j i
      _ = commonEdgeFactor n d i j *
          directedQuotient n d j i := by
        rw [commonEdgeFactor_comm n d j i]
  · intro i j
    have hi := upperAtomRead_eq_common_mul_directed n d i j
    have hj := upperAtomRead_eq_common_mul_directed n d j i
    rw [commonEdgeFactor_comm n d j i] at hj
    calc
      d j * directedQuotient n d i j
          = (commonEdgeFactor n d i j *
              directedQuotient n d j i) *
              directedQuotient n d i j := by
            rw [hupper j, hj]
      _ = (commonEdgeFactor n d i j *
              directedQuotient n d i j) *
              directedQuotient n d j i := by
            ring
      _ = d i * directedQuotient n d j i := by
            rw [← hi, ← hupper i]

/- Sub-sub-layer 02 -/
/-
Paper ref: 3.4.4
Sub-sub-box Label: `Prime-chain edge loads: L_p(i|j) reads support-address levels loading directed quotients`
Sub-sub-inputs: `Edge_can`
Sub-sub-outputs: `Load_can`
-/
def section_3_4_4_sub_sub_layer_02_sub_sub_box_02_label : String := "Prime-chain edge loads: L_p(i|j) reads support-address levels loading directed quotients"
def section_3_4_4_sub_sub_layer_02_sub_sub_box_02_inputs : List String := ["Edge_can [read]"]
def section_3_4_4_sub_sub_layer_02_sub_sub_box_02_outputs : List String := ["Load_can [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.4, Sub-sub-layer 02, Sub-sub-box 02
Birth token: Load_can

For one prime base p and ordered edge i|j, this box counts the prime-height
levels whose support address contains i and omits j.  It proves that this count
is exactly the p-adic exponent of U_{i|j}.  The result is still one fixed finite
witness; no growth or subsequence statement occurs here.
================================================================================
-/

/-- Prime-chain load on the directed edge i|j. -/
noncomputable def primeChainEdgeLoad
    (n : ℕ) (d : Fin 5 → ℕ)
    (p : ℕ) (i j : Fin 5) : ℕ := by
  classical
  exact ((primeTokenLevels n p).filter fun ell =>
    directedEdgeAddress i j (primeTokenAddress d p ell)).card

/-- The p-adic exponent of U_{i|j} is its exact prime-chain load. -/
theorem directedQuotient_factorization_apply
    (n : ℕ) (d : Fin 5 → ℕ)
    (p : ℕ) (i j : Fin 5) :
    (directedQuotient n d i j).factorization p =
      primeChainEdgeLoad n d p i j := by
  classical
  unfold directedQuotient
  rw [Nat.factorization_prod_apply]
  · simp_rw [atomBucket_factorization_apply]
    unfold atomMultiplicity primeChainEdgeLoad
    exact sum_addressFiberCount_filter
      (primeTokenLevels n p)
      (primeTokenAddress d p)
      (directedEdgeAddress i j)
  · intro S _hS
    exact (atomBucket_pos n d S).ne'

/--
For one prime row, the two opposite directed loads cannot both be nonzero.
This is the exact prime-chain content behind reduced opposite edge factors.
-/
theorem primeChainEdgeLoad_exclusive
    {n : ℕ} {d : Fin 5 → ℕ}
    (hedge : Edge_can n d)
    (p : ℕ) (i j : Fin 5) :
    primeChainEdgeLoad n d p i j = 0 ∨
      primeChainEdgeLoad n d p j i = 0 := by
  classical
  by_cases hij_zero : primeChainEdgeLoad n d p i j = 0
  · exact Or.inl hij_zero
  · by_cases hji_zero : primeChainEdgeLoad n d p j i = 0
    · exact Or.inr hji_zero
    · exfalso
      have hij_pos : 0 < primeChainEdgeLoad n d p i j :=
        Nat.pos_of_ne_zero hij_zero
      have hji_pos : 0 < primeChainEdgeLoad n d p j i :=
        Nat.pos_of_ne_zero hji_zero
      unfold primeChainEdgeLoad at hij_pos hji_pos
      rcases Finset.card_pos.mp hij_pos with ⟨ell_ij, hell_ij⟩
      rcases Finset.card_pos.mp hji_pos with ⟨ell_ji, hell_ji⟩
      have haddr_ij := (Finset.mem_filter.mp hell_ij).2
      have haddr_ji := (Finset.mem_filter.mp hell_ji).2
      unfold directedEdgeAddress at haddr_ij haddr_ji
      rcases haddr_ij with ⟨hi_ij, hj_not_ij⟩
      rcases haddr_ji with ⟨hj_ji, hi_not_ji⟩
      have hchain :
          ∀ p ell₁ ell₂ : ℕ, ell₁ ≤ ell₂ →
            supportSlice d p ell₂ ⊆ supportSlice d p ell₁ :=
        hedge.1.2.2.2.2.2
      rcases le_total ell_ij ell_ji with hle | hle
      · have hj_high : j ∈ supportSlice d p ell_ji := by
          simpa [primeTokenAddress] using hj_ji
        have hj_low : j ∈ supportSlice d p ell_ij :=
          hchain p ell_ij ell_ji hle hj_high
        have hj_addr : j ∈ primeTokenAddress d p ell_ij := by
          simpa [primeTokenAddress] using hj_low
        exact hj_not_ij hj_addr
      · have hi_high : i ∈ supportSlice d p ell_ij := by
          simpa [primeTokenAddress] using hi_ij
        have hi_low : i ∈ supportSlice d p ell_ji :=
          hchain p ell_ji ell_ij hle hi_high
        have hi_addr : i ∈ primeTokenAddress d p ell_ji := by
          simpa [primeTokenAddress] using hi_low
        exact hi_not_ji hi_addr

/-- Exact prime-load packet for every directed edge and every base. -/
def Load_can
    (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  Edge_can n d ∧
    (∀ p : ℕ, ∀ i j : Fin 5,
      (directedQuotient n d i j).factorization p =
        primeChainEdgeLoad n d p i j) ∧
    ∀ p : ℕ, ∀ i j : Fin 5,
      primeChainEdgeLoad n d p i j = 0 ∨
        primeChainEdgeLoad n d p j i = 0

/-- The exact directed-edge packet produces its prime-load packet. -/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.4, Sub-sub-layer 02, Sub-sub-box 02

Incoming state shape:
  Edge_can n d

Outgoing state shape:
  Load_can n d

Effect:
  Reads every directed quotient through its prime-chain edge loads and proves
  opposite-load exclusivity.

Public theorem:
  derive_Load_can

================================================================================
-/

theorem derive_Load_can
    {n : ℕ} {d : Fin 5 → ℕ}
    (hedge : Edge_can n d) :
    Load_can n d := by
  refine ⟨hedge, ?_, ?_⟩
  · intro p i j
    exact directedQuotient_factorization_apply n d p i j
  · intro p i j
    exact primeChainEdgeLoad_exclusive hedge p i j

/- Sub-sub-layer 03 -/
/-
Paper ref: 3.4.4
Sub-sub-box Label: `Directed quotient activity: active directed quotients and bounded edge-gap chamber diagnostics`
Sub-sub-inputs: `Edge_can`, `near_root_pair_context`
Sub-sub-outputs: `pointwiseDirectedQuotientActivityAt`
-/
def section_3_4_4_sub_sub_layer_03_sub_sub_box_03_label : String := "Directed quotient activity: active directed quotients and bounded edge-gap chamber diagnostics"
