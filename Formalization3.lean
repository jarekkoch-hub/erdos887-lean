def incident_growth_section_7_5_sub_layer_02_sub_box_02_label : String := "Balanced max-linear classification: every balanced survivor is uniform, refined left-low, or refined right-low"
def incident_growth_section_7_5_sub_layer_02_sub_box_02_inputs : List String := ["max_linear_comparison_split [construction]", "full_profile_balance [construction]", "refined_branch_alternatives [construction]", "saturation_lemmas [construction]", "max_read_bounds [construction]"]
def incident_growth_section_7_5_sub_layer_02_sub_box_02_outputs : List String := ["balanced_branch_classification [birth]"]


/-
================================================================================
SECTION EXECUTABLE BOX GROUP
Section 7.5

This subsection is the first place where the previously parallel finite states
are recombined.

Sub-layer 01 consumes only the adjacent `profile_balance` chain and closes it
to full pairwise balance.

Sub-layer 02 then consumes exactly the five metadata inputs:

  * the pure five-way comparison split;
  * full profile balance;
  * the three named branch-shape predicates;
  * the reusable saturation packet;
  * the maximum-read packet.

The five comparison cases are not discarded before their corresponding
balanced case derivations are applied.  The result is one pointwise
classification disjunction over the same exact `GSeq`.

No rank, coloring, prefix, affine, endpoint-equation, or terminal state is
introduced.
================================================================================
-/

/-- Full pairwise equality of the five profile sums at one sequence index. -/
/-
================================================================================
EXECUTABLE BOX
Section 7.5, Sub-layer 01, Sub-box 01
Birth token: full_profile_balance

This executable box closes the adjacent profile-balance chain to full pairwise
equality of the five profile sums.
================================================================================
-/

def fullProfileBalanceAt
    (G : MaxLinearProfile) : Prop :=
  ∀ i j : Fin 5,
    maxLinearSigma G i =
      maxLinearSigma G j

/--
Full profile balance retains the adjacent balance state and adds all pairwise
profile-sum equalities.
-/
def full_profile_balance
    (GSeq : MaxLinearProfileSequence) : Prop :=
  profile_balance GSeq ∧
    ∀ m : ℕ,
      fullProfileBalanceAt (GSeq m)

/-
================================================================================
STATE-SHAPE BATCH
Section 7.5, Sub-layer 01, Sub-box 01

Incoming state shape:
  profile_balance GSeq

Outgoing state shape:
  full_profile_balance GSeq

Effect:
  Retains the adjacent balance chain and closes it transitively to all
  endpoint-indexed pairs.  No comparison case, saturation fact, or branch
  predicate is read.

Public theorem:
  build_full_profile_balance
================================================================================
-/

theorem build_full_profile_balance
    {GSeq : MaxLinearProfileSequence}
    (hBalance :
      profile_balance GSeq) :
    full_profile_balance GSeq := by
  refine ⟨hBalance, ?_⟩
  intro m i j

  have h01 :
      maxLinearSigma (GSeq m) 0 =
        maxLinearSigma (GSeq m) 1 :=
    (hBalance m).1

  have h12 :
      maxLinearSigma (GSeq m) 1 =
        maxLinearSigma (GSeq m) 2 :=
    (hBalance m).2.1

  have h23 :
      maxLinearSigma (GSeq m) 2 =
        maxLinearSigma (GSeq m) 3 :=
    (hBalance m).2.2.1

  have h34 :
      maxLinearSigma (GSeq m) 3 =
        maxLinearSigma (GSeq m) 4 :=
    (hBalance m).2.2.2

  fin_cases i <;> fin_cases j

  · rfl
  · exact h01
  · exact h01.trans h12
  · exact h01.trans (h12.trans h23)
  · exact h01.trans (h12.trans (h23.trans h34))

  · exact h01.symm
  · rfl
  · exact h12
  · exact h12.trans h23
  · exact h12.trans (h23.trans h34)

  · exact (h01.trans h12).symm
  · exact h12.symm
  · rfl
  · exact h23
  · exact h23.trans h34

  · exact (h01.trans (h12.trans h23)).symm
  · exact (h12.trans h23).symm
  · exact h23.symm
  · rfl
  · exact h34

  · exact
      (h01.trans
        (h12.trans
          (h23.trans h34))).symm
  · exact
      (h12.trans
        (h23.trans h34)).symm
  · exact (h23.trans h34).symm
  · exact h34.symm
  · rfl

/-
================================================================================
EXECUTABLE BOX
Section 7.5, Sub-layer 02, Sub-box 02
Birth token: balanced_branch_classification

This executable box owns the five balanced case lemmas and recombines the
comparison split, full balance, branch predicates, saturation packet, and
maximum-read bounds into the three-way balanced classification.
================================================================================
-/

/-
The five concrete profile-sum formulas.  These are definitional readout lemmas,
kept separate so the balanced case proofs need no broad simplification pass.
-/

theorem maxLinearSigma_zero_formula
    (G : MaxLinearProfile) :
    maxLinearSigma G 0 =
      G 0 +
        max (G 0) (G 1) +
        maxLinearMax3 (G 0) (G 1) (G 2) +
        maxLinearMax4 (G 0) (G 1) (G 2) (G 3) := by
  rfl

theorem maxLinearSigma_one_formula
    (G : MaxLinearProfile) :
    maxLinearSigma G 1 =
      G 0 + G 1 +
        max (G 1) (G 2) +
        maxLinearMax3 (G 1) (G 2) (G 3) := by
  rfl

theorem maxLinearSigma_two_formula
    (G : MaxLinearProfile) :
    maxLinearSigma G 2 =
      max (G 0) (G 1) +
        G 1 + G 2 +
        max (G 2) (G 3) := by
  rfl

theorem maxLinearSigma_three_formula
    (G : MaxLinearProfile) :
    maxLinearSigma G 3 =
      maxLinearMax3 (G 0) (G 1) (G 2) +
        max (G 1) (G 2) +
        G 2 + G 3 := by
  rfl

theorem maxLinearSigma_four_formula
    (G : MaxLinearProfile) :
    maxLinearSigma G 4 =
      maxLinearMax4 (G 0) (G 1) (G 2) (G 3) +
        maxLinearMax3 (G 1) (G 2) (G 3) +
        max (G 2) (G 3) +
        G 3 := by
  rfl

/-
================================================================================
INTERNAL BOX LEMMA
First endpoint dominance case
================================================================================
-/

theorem first_endpoint_dominance_uniform_equations
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {sigmaSeq : ProfileReadSequence}
    {GSeq : MaxLinearProfileSequence}
    (hFull :
      full_profile_balance GSeq)
    (hSaturation :
      saturation_lemmas)
    (hBounds :
      max_read_bounds
        GammaSeq sigmaSeq GSeq)
    (m : ℕ)
    (hDominance :
      first_endpoint_dominance (GSeq m)) :
    GSeq m 0 = GSeq m 1 ∧
      GSeq m 1 = GSeq m 2 ∧
      GSeq m 2 = GSeq m 3 := by
  let a : ℚ := GSeq m 0
  let b : ℚ := GSeq m 1
  let c : ℚ := GSeq m 2
  let d : ℚ := GSeq m 3

  have hba : b ≤ a := hDominance.1
  have hca : c ≤ a := hDominance.2.1
  have hda : d ≤ a := hDominance.2.2

  have hMax3 :=
    hBounds.2.2.1
  have hMax4 :=
    hBounds.2.2.2.1
  have hMaxLeft :=
    hBounds.2.2.2.2.1

  have hab :
      max a b = a :=
    hMaxLeft a b hba

  have habc :
      maxLinearMax3 a b c = a := by
    apply le_antisymm
    · exact hMax3 a a b c le_rfl hba hca
    · change a ≤ max a (max b c)
      exact le_max_left a (max b c)

  have habcd :
      maxLinearMax4 a b c d = a := by
    apply le_antisymm
    · exact hMax4 a a b c d le_rfl hba hca hda
    · change a ≤ max a (max b (max c d))
      exact le_max_left a (max b (max c d))

  have hbc_le :
      max b c ≤ a :=
    max_le hba hca

  have hbcd_le :
      maxLinearMax3 b c d ≤ a :=
    hMax3 a b c d hba hca hda

  have h01 :
      maxLinearSigma (GSeq m) 0 =
        maxLinearSigma (GSeq m) 1 :=
    hFull.2 m 0 1

  rw [
    maxLinearSigma_zero_formula,
    maxLinearSigma_one_formula
  ] at h01
  change
    a + max a b +
        maxLinearMax3 a b c +
        maxLinearMax4 a b c d =
      a + b + max b c +
        maxLinearMax3 b c d at h01
  rw [hab, habc, habcd] at h01

  have hThreeSum :
      b + max b c +
          maxLinearMax3 b c d =
        3 * a := by
    linarith

  rcases
      hSaturation.2
        a b (max b c)
        (maxLinearMax3 b c d)
        hba hbc_le hbcd_le hThreeSum with
    ⟨hba_eq, hbc_eq, hbcd_eq⟩

  have hab_eq :
      max a b = a := by
    calc
      max a b = max a a := by
        exact congrArg (fun x : ℚ => max a x) hba_eq
      _ = a := max_self a

  have hcd_le :
      max c d ≤ a :=
    max_le hca hda

  have h12 :
      maxLinearSigma (GSeq m) 1 =
        maxLinearSigma (GSeq m) 2 :=
    hFull.2 m 1 2

  rw [
    maxLinearSigma_one_formula,
    maxLinearSigma_two_formula
  ] at h12
  change
    a + b + max b c +
        maxLinearMax3 b c d =
      max a b + b + c + max c d at h12
  rw [
    hbc_eq, hbcd_eq, hab_eq,
    hba_eq
  ] at h12

  have hTwoSum :
      c + max c d = 2 * a := by
    linarith

  rcases
      hSaturation.1
        a c (max c d)
        hca hcd_le hTwoSum with
    ⟨hca_eq, hcd_eq⟩

  have h23 :
      maxLinearSigma (GSeq m) 2 =
        maxLinearSigma (GSeq m) 3 :=
    hFull.2 m 2 3

  rw [
    maxLinearSigma_two_formula,
    maxLinearSigma_three_formula
  ] at h23
  change
    max a b + b + c + max c d =
      maxLinearMax3 a b c +
        max b c + c + d at h23
  rw [
    hab_eq, hcd_eq, habc, hbc_eq,
    hba_eq, hca_eq
  ] at h23

  have hda_eq : d = a := by
    linarith

  change a = b ∧ b = c ∧ c = d
  exact
    ⟨hba_eq.symm,
      hba_eq.trans hca_eq.symm,
      hca_eq.trans hda_eq.symm⟩

/-
================================================================================
INTERNAL BOX LEMMA
Fourth endpoint dominance case
================================================================================
-/

theorem fourth_endpoint_dominance_uniform_equations
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {sigmaSeq : ProfileReadSequence}
    {GSeq : MaxLinearProfileSequence}
    (hFull :
      full_profile_balance GSeq)
    (hSaturation :
      saturation_lemmas)
    (hBounds :
      max_read_bounds
        GammaSeq sigmaSeq GSeq)
    (m : ℕ)
    (hDominance :
      fourth_endpoint_dominance (GSeq m)) :
    GSeq m 0 = GSeq m 1 ∧
      GSeq m 1 = GSeq m 2 ∧
      GSeq m 2 = GSeq m 3 := by
  let a : ℚ := GSeq m 0
  let b : ℚ := GSeq m 1
  let c : ℚ := GSeq m 2
  let d : ℚ := GSeq m 3

  have had : a ≤ d := hDominance.1
  have hbd : b ≤ d := hDominance.2.1
  have hcd : c ≤ d := hDominance.2.2

  have hMax3 :=
    hBounds.2.2.1
  have hMax4 :=
    hBounds.2.2.2.1
  have hMaxLeft :=
    hBounds.2.2.2.2.1
  have hMaxRight :=
    hBounds.2.2.2.2.2

  have hcd_eq :
      max c d = d :=
    hMaxRight c d hcd

  have hbcd :
      maxLinearMax3 b c d = d := by
    apply le_antisymm
    · exact hMax3 d b c d hbd hcd le_rfl
    · change d ≤ max b (max c d)
      exact le_trans (le_max_right c d) (le_max_right b (max c d))

  have habcd :
      maxLinearMax4 a b c d = d := by
    apply le_antisymm
    · exact hMax4 d a b c d had hbd hcd le_rfl
    · change d ≤ max a (max b (max c d))
      exact
        le_trans
          (le_trans
            (le_max_right c d)
            (le_max_right b (max c d)))
          (le_max_right a (max b (max c d)))

  have habc_le :
      maxLinearMax3 a b c ≤ d :=
    hMax3 d a b c had hbd hcd

  have hbc_le :
      max b c ≤ d :=
    max_le hbd hcd

  have h34 :
      maxLinearSigma (GSeq m) 3 =
        maxLinearSigma (GSeq m) 4 :=
    hFull.2 m 3 4

  rw [
    maxLinearSigma_three_formula,
    maxLinearSigma_four_formula
  ] at h34
  change
    maxLinearMax3 a b c +
        max b c + c + d =
      maxLinearMax4 a b c d +
        maxLinearMax3 b c d +
        max c d + d at h34
  rw [hcd_eq, hbcd, habcd] at h34

  have hThreeSum :
      maxLinearMax3 a b c +
          max b c + c =
        3 * d := by
    linarith

  rcases
      hSaturation.2
        d (maxLinearMax3 a b c)
        (max b c) c
        habc_le hbc_le hcd hThreeSum with
    ⟨habc_eq, hbc_eq, hcd_value⟩

  have hab_le :
      max a b ≤ d :=
    max_le had hbd

  have h23 :
      maxLinearSigma (GSeq m) 2 =
        maxLinearSigma (GSeq m) 3 :=
    hFull.2 m 2 3

  rw [
    maxLinearSigma_two_formula,
    maxLinearSigma_three_formula
  ] at h23
  change
    max a b + b + c + max c d =
      maxLinearMax3 a b c +
        max b c + c + d at h23
  rw [
    hcd_eq, habc_eq, hbc_eq,
    hcd_value
  ] at h23

  have hTwoSum :
      max a b + b = 2 * d := by
    linarith

  rcases
      hSaturation.1
        d (max a b) b
        hab_le hbd hTwoSum with
    ⟨hab_eq, hbd_value⟩

  have h12 :
      maxLinearSigma (GSeq m) 1 =
        maxLinearSigma (GSeq m) 2 :=
    hFull.2 m 1 2

  rw [
    maxLinearSigma_one_formula,
    maxLinearSigma_two_formula
  ] at h12
  change
    a + b + max b c +
        maxLinearMax3 b c d =
      max a b + b + c + max c d at h12
  rw [
    hbc_eq, hbcd, hab_eq, hcd_eq,
    hbd_value, hcd_value
  ] at h12

  have had_value : a = d := by
    linarith

  change a = b ∧ b = c ∧ c = d
  exact
    ⟨had_value.trans hbd_value.symm,
      hbd_value.trans hcd_value.symm,
      hcd_value⟩

/-
================================================================================
INTERNAL BOX LEMMA
Central tie case
================================================================================
-/

theorem central_tie_uniform_equations
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {sigmaSeq : ProfileReadSequence}
    {GSeq : MaxLinearProfileSequence}
    (hFull :
      full_profile_balance GSeq)
    (hBounds :
      max_read_bounds
        GammaSeq sigmaSeq GSeq)
    (m : ℕ)
    (hTie :
      central_tie_comparison (GSeq m)) :
    GSeq m 0 = GSeq m 1 ∧
      GSeq m 1 = GSeq m 2 ∧
      GSeq m 2 = GSeq m 3 := by
  let a : ℚ := GSeq m 0
  let b : ℚ := GSeq m 1
  let c : ℚ := GSeq m 2
  let d : ℚ := GSeq m 3

  have hab : a ≤ b := hTie.1
  have hbc : b = c := hTie.2.1
  have hdb : d ≤ b := hTie.2.2

  have hMaxLeft :=
    hBounds.2.2.2.2.1
  have hMaxRight :=
    hBounds.2.2.2.2.2

  have hab_eq :
      max a b = b :=
    hMaxRight a b hab

  have hbc_eq :
      max b c = b := by
    calc
      max b c = max b b := by
        exact congrArg (fun x : ℚ => max b x) hbc.symm
      _ = b := max_self b

  have hdc : d ≤ c := by
    rw [← hbc]
    exact hdb

  have hcd_eq :
      max c d = b := by
    calc
      max c d = c :=
        hMaxLeft c d hdc
      _ = b := hbc.symm

  have habc :
      maxLinearMax3 a b c = b := by
    change max a (max b c) = b
    rw [hbc_eq, hab_eq]

  have hbcd :
      maxLinearMax3 b c d = b := by
    change max b (max c d) = b
    rw [hcd_eq, max_self]

  have habcd :
      maxLinearMax4 a b c d = b := by
    change max a (max b (max c d)) = b
    rw [hcd_eq, max_self, hab_eq]

  have h12 :
      maxLinearSigma (GSeq m) 1 =
        maxLinearSigma (GSeq m) 2 :=
    hFull.2 m 1 2

  rw [
    maxLinearSigma_one_formula,
    maxLinearSigma_two_formula
  ] at h12
  change
    a + b + max b c +
        maxLinearMax3 b c d =
      max a b + b + c + max c d at h12
  rw [hab_eq, hbc_eq, hbcd, hcd_eq] at h12

  have hab_value : a = b := by
    linarith

  have h23 :
      maxLinearSigma (GSeq m) 2 =
        maxLinearSigma (GSeq m) 3 :=
    hFull.2 m 2 3

  rw [
    maxLinearSigma_two_formula,
    maxLinearSigma_three_formula
  ] at h23
  change
    max a b + b + c + max c d =
      maxLinearMax3 a b c +
        max b c + c + d at h23
  rw [hab_eq, hcd_eq, habc, hbc_eq] at h23

  have hdb_value : d = b := by
    linarith

  change a = b ∧ b = c ∧ c = d
  exact
    ⟨hab_value,
      hbc,
      hbc.symm.trans hdb_value.symm⟩

/-
================================================================================
INTERNAL BOX LEMMA
Second strict dominance case
================================================================================
-/

theorem second_strict_dominance_left_low_equations
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {sigmaSeq : ProfileReadSequence}
    {GSeq : MaxLinearProfileSequence}
    (hFull :
      full_profile_balance GSeq)
    (hBounds :
      max_read_bounds
        GammaSeq sigmaSeq GSeq)
    (m : ℕ)
    (hDominance :
      second_strict_dominance (GSeq m)) :
    GSeq m 0 < GSeq m 2 ∧
      GSeq m 2 < GSeq m 1 ∧
      GSeq m 2 = GSeq m 3 ∧
      GSeq m 0 + GSeq m 1 =
        2 * GSeq m 2 := by
  let a : ℚ := GSeq m 0
  let b : ℚ := GSeq m 1
  let c : ℚ := GSeq m 2
  let d : ℚ := GSeq m 3

  have hab : a < b := hDominance.1
  have hcb : c < b := hDominance.2.1
  have hdb : d < b := hDominance.2.2

  have hMaxLeft :=
    hBounds.2.2.2.2.1
  have hMaxRight :=
    hBounds.2.2.2.2.2

  have hab_eq :
      max a b = b :=
    hMaxRight a b (le_of_lt hab)

  have hbc_eq :
      max b c = b :=
    hMaxLeft b c (le_of_lt hcb)

  have hcd_le :
      max c d ≤ b :=
    max_le (le_of_lt hcb) (le_of_lt hdb)

  have hbcd :
      maxLinearMax3 b c d = b := by
    unfold maxLinearMax3
    exact hMaxLeft b (max c d) hcd_le

  have habc :
      maxLinearMax3 a b c = b := by
    change max a (max b c) = b
    rw [hbc_eq, hab_eq]

  have habcd :
      maxLinearMax4 a b c d = b := by
    change max a (maxLinearMax3 b c d) = b
    rw [hbcd, hab_eq]

  have h23 :
      maxLinearSigma (GSeq m) 2 =
        maxLinearSigma (GSeq m) 3 :=
    hFull.2 m 2 3

  rw [
    maxLinearSigma_two_formula,
    maxLinearSigma_three_formula
  ] at h23
  change
    max a b + b + c + max c d =
      maxLinearMax3 a b c +
        max b c + c + d at h23
  rw [hab_eq, habc, hbc_eq] at h23

  have hcd_equals_d :
      max c d = d := by
    linarith

  have hcle_d : c ≤ d := by
    have hle : c ≤ max c d :=
      le_max_left c d
    rw [hcd_equals_d] at hle
    exact hle

  have h34 :
      maxLinearSigma (GSeq m) 3 =
        maxLinearSigma (GSeq m) 4 :=
    hFull.2 m 3 4

  rw [
    maxLinearSigma_three_formula,
    maxLinearSigma_four_formula
  ] at h34
  change
    maxLinearMax3 a b c +
        max b c + c + d =
      maxLinearMax4 a b c d +
        maxLinearMax3 b c d +
        max c d + d at h34
  rw [habc, hbc_eq, habcd, hbcd] at h34

  have hc_equals_max :
      c = max c d := by
    linarith

  have hdle_c : d ≤ c := by
    have hle : d ≤ max c d :=
      le_max_right c d
    rw [← hc_equals_max] at hle
    exact hle

  have hcd_value : c = d :=
    le_antisymm hcle_d hdle_c

  have h12 :
      maxLinearSigma (GSeq m) 1 =
        maxLinearSigma (GSeq m) 2 :=
    hFull.2 m 1 2

  rw [
    maxLinearSigma_one_formula,
    maxLinearSigma_two_formula
  ] at h12
  change
    a + b + max b c +
        maxLinearMax3 b c d =
      max a b + b + c + max c d at h12
  rw [
    hab_eq, hbc_eq, hbcd,
    hcd_value, max_self
  ] at h12

  have hsum :
      a + b = 2 * c := by
    linarith

  have hac : a < c := by
    linarith

  change
    a < c ∧ c < b ∧ c = d ∧
      a + b = 2 * c
  exact
    ⟨hac, hcb, hcd_value, hsum⟩

