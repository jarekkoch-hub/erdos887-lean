theorem build_rank_source
    {opening : CanonicalIntervalOverloadOpeningData}
    {leadingData : LeadingDescendantExtractionData}
    {regimeData : RankRegimeSourceData}
    (hLeading :
      leading_descendant_matrix opening leadingData)
    (hRegime :
      rank_regime_source opening leadingData regimeData) :
    rank_source opening leadingData regimeData := by
  refine ⟨hLeading, rfl, ?_, hRegime⟩
  have hRank :=
    Matrix.rank_le_card_width (leadingMatrix leadingData)
  simpa using hRank

/-- The complete Section 8.3 output with one selected source datum. -/
def section_8_3_frontier
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∃ leadingData : LeadingDescendantExtractionData,
    ∃ regimeData : RankRegimeSourceData,
      rank_source opening leadingData regimeData ∧
        Section6.Legacy.legacy_S_0
          C nSeq dSeq
          (openingTSeq opening)
          (openingBSeq opening)
          (openingZSeq opening)

