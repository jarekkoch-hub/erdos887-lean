  Transports the adjacent incident-product balance chain through the equations
  nu_i=sigma_i and sigma_i=sigma_i(G).  No balance assumption is reintroduced
  after I_grow.

Public theorem:
  incident_growth_law_gives_profile_balance
================================================================================
-/

theorem incident_growth_law_gives_profile_balance
    {opening : CanonicalIntervalOverloadOpeningData}
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {nuSeq : IncidentGrowthExponentSequence}
    {sigmaSeq : ProfileReadSequence}
    {GSeq : MaxLinearProfileSequence}
    (hGrow :
      I_grow opening GammaSeq nuSeq sigmaSeq)
    (hProfile :
      max_linear_profile
        GammaSeq sigmaSeq GSeq) :
    profile_balance GSeq := by
  intro m
  have hNuSigma :
      ∀ i : Fin 5,
        nuSeq m i = sigmaSeq m i :=
    hGrow.2.2.1 m
  have hBalance :
      incidentGrowthBalance (nuSeq m) :=
    hGrow.2.2.2.1 m

  refine ⟨?_, ?_, ?_, ?_⟩

  · calc
      maxLinearSigma (GSeq m) 0 = sigmaSeq m 0 :=
        (hProfile.2 m 0).symm
      _ = nuSeq m 0 :=
        (hNuSigma 0).symm
      _ = nuSeq m 1 :=
        hBalance.1
      _ = sigmaSeq m 1 :=
        hNuSigma 1
      _ = maxLinearSigma (GSeq m) 1 :=
        hProfile.2 m 1

  · calc
      maxLinearSigma (GSeq m) 1 = sigmaSeq m 1 :=
        (hProfile.2 m 1).symm
      _ = nuSeq m 1 :=
        (hNuSigma 1).symm
      _ = nuSeq m 2 :=
        hBalance.2.1
      _ = sigmaSeq m 2 :=
        hNuSigma 2
      _ = maxLinearSigma (GSeq m) 2 :=
        hProfile.2 m 2

  · calc
      maxLinearSigma (GSeq m) 2 = sigmaSeq m 2 :=
        (hProfile.2 m 2).symm
      _ = nuSeq m 2 :=
        (hNuSigma 2).symm
      _ = nuSeq m 3 :=
        hBalance.2.2.1
      _ = sigmaSeq m 3 :=
        hNuSigma 3
      _ = maxLinearSigma (GSeq m) 3 :=
        hProfile.2 m 3

  · calc
      maxLinearSigma (GSeq m) 3 = sigmaSeq m 3 :=
        (hProfile.2 m 3).symm
      _ = nuSeq m 3 :=
        (hNuSigma 3).symm
      _ = nuSeq m 4 :=
        hBalance.2.2.2
      _ = sigmaSeq m 4 :=
        hNuSigma 4
      _ = maxLinearSigma (GSeq m) 4 :=
        hProfile.2 m 4

/--
The complete Section 7.1 output remains indexed by the exact opening,
Gamma_W branch, incident exponents, and stored sigma values that entered the
first batch.
-/
def section_7_1_output
    (opening : CanonicalIntervalOverloadOpeningData)
    (GammaSeq : Gamma_W_adjacent_growth_profile)
    (nuSeq : IncidentGrowthExponentSequence)
    (sigmaSeq : ProfileReadSequence)
    (GSeq : MaxLinearProfileSequence) : Prop :=
  I_grow opening GammaSeq nuSeq sigmaSeq ∧
    max_linear_profile GammaSeq sigmaSeq GSeq ∧
    profile_balance GSeq

