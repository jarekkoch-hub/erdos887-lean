theorem test_fixed_witness_parent_route
    {C : ℝ} {n : ℕ}
    (h5 : 5 ≤ D_C C n) :
    ∃ d : Fin 5 → ℕ,
      fixed_witness_parent_route_output C n d := by
  obtain ⟨d, hW⟩ :=
    Five_ext h5

  have hArithmetic : extracted_arithmetic_state C n d :=
    close_extracted_arithmetic_state hW

  have hAtomized : atomized_reconstruction_state C n d :=
    advance_to_atomized_reconstruction_state hArithmetic

  have hEdge : edge_reconstruction_state C n d :=
    advance_to_edge_reconstruction_state hAtomized

  have hLoad : load_reconstruction_state C n d :=
    advance_to_load_reconstruction_state hEdge

  have hActivity : activity_reconstruction_state C n d :=
    advance_to_activity_reconstruction_state hLoad

  exact ⟨d, hActivity⟩





/-
================================================================================
ROUTE BRIDGE

A sequence of the connected fixed-witness route states supplies exactly the
same-sequence Edge_can and Act_can packets consumed by Bdg_can. The theorem does
not assert where the sequence was selected; it transforms the supplied sequence
state into the classifier input without reselecting any witness.
================================================================================
-/

def activity_reconstruction_sequence_state
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  ∀ m : ℕ,
    activity_reconstruction_state C (nSeq m) (dSeq m)

/--
One coherent sequence selected from the original infinite-violation state.

Every pointwise reconstruction field is built from the same witness
`dSeq m` for the same integer `nSeq m`.  This is the production ingress for
the chamber classifier; it is not an arbitrary pair of supplied functions.
-/
abbrev external_violation_sequence_state :=
  Section3.external_violation_sequence_state

/--
Regression projection: the production ingress retains the complete materialized
Section 3 arithmetic frontier at every exact sequence index.
-/
theorem external_violation_sequence_state_arithmetic
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq) :
    ∀ m : ℕ,
      Section3.section_3_arithmetic_state
        C (nSeq m) (dSeq m) :=
  hSeq.2.2.1

/--
The honest positive content obtained directly from active gap escape: an
unbounded directed-gap trace on the exact external sequence.  This is not yet
called a lower-dimensional reconstruction.
-/
def gapEscapeUnboundedDirectedGapTrace
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  external_violation_sequence_state C nSeq dSeq ∧
    Section3.GapEsc C nSeq dSeq ∧
    ∀ B : ℕ,
      ∃ m : ℕ,
        ∃ i j : Fin 5,
          i < j ∧
            B <
              Section3.directedEdgeGap
                (nSeq m) (dSeq m) i j

/-- Active gap escape produces exactly the unbounded directed-gap trace. -/
theorem derive_gapEscapeUnboundedDirectedGapTrace
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq)
    (hGap : Section3.GapEsc C nSeq dSeq) :
    gapEscapeUnboundedDirectedGapTrace C nSeq dSeq := by
  refine ⟨hSeq, hGap, ?_⟩
  intro B
  by_contra hNoEscapingGap
  have hBounded :
      Section3.boundedEdgeGapChamber nSeq dSeq := by
    refine ⟨B, ?_⟩
    intro m i j hij
    have hAct :
        Section3.Act_can C (nSeq m) (dSeq m) i j :=
      hGap.1.2 m i j hij
    have hOne :
        1 ≤ Section3.directedEdgeGap (nSeq m) (dSeq m) i j :=
      hAct.2.2.2.2.2.2
    have hUpper :
        Section3.directedEdgeGap (nSeq m) (dSeq m) i j ≤ B := by
      apply Nat.le_of_not_gt
      intro hGreater
      exact hNoEscapingGap ⟨m, i, j, hij, hGreater⟩
    exact ⟨hOne, hUpper⟩
  exact hGap.2.2 hBounded

/--
The actual deleted-endpoint reconstruction object assigned to an active
gap-escape trace.

One fixed omitted endpoint and one fixed escaping edge survive on a strict
subsequence.  The edge lies in the retained four-face.  Every collapsed atom,
upper read, lower read, and directed quotient is the exact deleted-endpoint
projection of the same original atomization.  This is the paper's
lower-dimensional route object, not merely the negation of the full bounded
chamber.
-/
def gapEscapeLowerDimensionalReconstructionState
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  gapEscapeUnboundedDirectedGapTrace C nSeq dSeq ∧
    ∃ phi : ℕ → ℕ,
      ∃ omitted i j : Fin 5,
        StrictMono phi ∧
          i < j ∧
          i ≠ omitted ∧
          j ≠ omitted ∧
          (∀ m : ℕ,
            ∀ T ∈ Section3.fourFaceAddresses omitted,
              0 <
                Section3.collapsedFourFaceAtom
                  (nSeq (phi m)) (dSeq (phi m)) omitted T) ∧
          (∀ m : ℕ,
            ∀ v : Fin 5,
              v ≠ omitted →
                dSeq (phi m) v =
                  Section3.fourFaceUpperRead
                    (nSeq (phi m)) (dSeq (phi m)) omitted v) ∧
          (∀ m : ℕ,
            ∀ v : Fin 5,
              v ≠ omitted →
                nSeq (phi m) / dSeq (phi m) v =
                  Section3.fourFaceLowerRead
                    (nSeq (phi m)) (dSeq (phi m)) omitted v) ∧
          (∀ m : ℕ,
            Section3.fourFaceDirectedQuotient
                (nSeq (phi m)) (dSeq (phi m)) omitted i j =
              Section3.directedQuotient
                (nSeq (phi m)) (dSeq (phi m)) i j) ∧
          ∀ B : ℕ,
            ∃ m : ℕ,
              B <
                Section3.directedEdgeGap
                  (nSeq (phi m)) (dSeq (phi m)) i j

/--
The external reconstruction component which turns the unbounded trace into
the exact deleted-endpoint object above.  Its target is now strong enough that
the earlier one-line expansion of `¬ boundedEdgeGapChamber` cannot prove it.
-/
def gapEscapeLowerDimensionalReconstructionProduction : Prop :=
  ∀ {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ},
    gapEscapeUnboundedDirectedGapTrace C nSeq dSeq →
      gapEscapeLowerDimensionalReconstructionState C nSeq dSeq

/--
The paper owner that eliminates the genuine deleted-endpoint reconstruction
object.
-/
def gapEscapeLowerDimensionalObstruction : Prop :=
  ∀ {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ},
    gapEscapeLowerDimensionalReconstructionState C nSeq dSeq →
      False

/--
Close `GapEsc` only after the trace has first been reconstructed as the actual
deleted-endpoint object and that object has then been eliminated.
-/
theorem resolve_GapEsc_by_lower_dimensional_reconstruction
    (hProduction : gapEscapeLowerDimensionalReconstructionProduction)
    (hObstruction : gapEscapeLowerDimensionalObstruction)
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq)
    (hGap : Section3.GapEsc C nSeq dSeq) :
    False :=
  hObstruction
    (hProduction
      (derive_gapEscapeUnboundedDirectedGapTrace hSeq hGap))

/-- Every field of the coherent external sequence is inherited by a strict subsequence. -/
theorem external_violation_sequence_state_strict_subsequence
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {phi : ℕ → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq)
    (hPhi : StrictMono phi) :
    external_violation_sequence_state
      C
      (fun m => nSeq (phi m))
      (fun m => dSeq (phi m)) := by
  exact
    ⟨hSeq.1,
      Section3.natSequenceTendsToInfinity_strict_subsequence
        hSeq.2.1 hPhi,
      (fun m => hSeq.2.2.1 (phi m)),
      (fun m => hSeq.2.2.2.1 (phi m)),
      (fun m => hSeq.2.2.2.2.1 (phi m)),
      (fun m => hSeq.2.2.2.2.2.1 (phi m)),
      (fun m => hSeq.2.2.2.2.2.2.1 (phi m)),
      (fun m => hSeq.2.2.2.2.2.2.2 (phi m))⟩

/--
The production state after canonical-corridor stabilization.  It retains the
parent sequence, the explicit subsequence map and coherence equations, and all
same-index external reconstruction fields on the materialized subsequence.
-/
def stabilized_external_corridor_state
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (nSub : ℕ → ℕ)
    (dSub : ℕ → Fin 5 → ℕ) : Prop :=
  external_violation_sequence_state C nSeq dSeq ∧
    Section3.stableCanonicalCorridorSubsequence
      C nSeq dSeq nSub dSub ∧
    external_violation_sequence_state C nSub dSub

/-
================================================================================
STATE-SHAPE BATCH
External sequence to stable canonical corridor

Incoming state shape:
  external_violation_sequence_state C nSeq dSeq
  bounded_full_K5_branch C nSeq dSeq
  Clip_can C nSeq dSeq

Outgoing state shape:
  ∃ nSub dSub,
    stabilized_external_corridor_state
      C nSeq dSeq nSub dSub

Effect:
  Materializes the strict F2-or-F3 subsequence and proves that every witness,
  atom, edge, load, and activity field is inherited at the exact extraction
  index.  The corridor orientation is fixed once on the surviving subsequence.

Public theorem:
  stabilize_external_violation_sequence_corridor
================================================================================
-/

theorem stabilize_external_violation_sequence_corridor
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq)
    (hBranch : Section3.bounded_full_K5_branch C nSeq dSeq)
    (hClip : Section3.Clip_can C nSeq dSeq) :
    ∃ nSub : ℕ → ℕ,
      ∃ dSub : ℕ → Fin 5 → ℕ,
        stabilized_external_corridor_state
          C nSeq dSeq nSub dSub := by
  rcases
      Section3.stabilize_Clip_can_to_fixed_canonical_corridor
        hSeq.2.1 hBranch hClip with
    ⟨nSub, dSub, hStable⟩
  rcases hStable with
    ⟨phi, hPhi, hnSub, hdSub, hCorridor⟩
  have hSub :
      external_violation_sequence_state
        C
        (fun m => nSeq (phi m))
        (fun m => dSeq (phi m)) :=
    external_violation_sequence_state_strict_subsequence hSeq hPhi
  have hnEq :
      nSub = fun m => nSeq (phi m) :=
    funext hnSub
  have hdEq :
      dSub = fun m => dSeq (phi m) :=
    funext hdSub
  refine
    ⟨nSub, dSub, hSeq,
      ⟨phi, hPhi, hnSub, hdSub, hCorridor⟩, ?_⟩
  rw [hnEq, hdEq]
  exact hSub

