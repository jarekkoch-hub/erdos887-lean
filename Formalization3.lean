EXECUTABLE BOX
Section 3.4.7, Sub-sub-layer 01, Sub-sub-box 01
Birth token: FirstOff_vec

This box looks backward to the exact support corridors and off-face products
already born in Section 3.4.3.  It does not introduce a parallel face model.
For an orientation `o` with `o = 3` or `o = 2`, it reuses respectively

  threeFaceAddress / offThreeFaceAddress / offFaceProductThree,
  twoFaceAddress   / offTwoFaceAddress   / offFaceProductTwo.

The executable output is the finite limit-shape packet of a first active layer:
nonnegative support mass, zero mass on the selected canonical corridor, total
mass one on the corresponding off-profile addresses, and hence at least one
strictly positive off-profile coordinate.

The analytic existence of this packet from logarithmic ratios along a divergent
subsequence is not reconstructed here.  In particular, this box does not choose
an orientation from a sequence, pass to a subsequence, prove divergence of an
off-face product, take logarithms, construct coordinatewise limits, activate
`scale_discipline`, or connect any clipping wire.  See
[CONNECTION-AUDIT: FIRST-OFF-PROFILE-LIMIT-BIRTH].
================================================================================
-/

/-- The two paper orientations are represented exactly by the naturals 2 and 3. -/
def offProfileOrientation (o : ℕ) : Prop :=
  o = 2 ∨ o = 3

/--
The selected canonical support corridor.  Orientation 3 reuses the exact
levels-0-and-3 corridor; orientation 2 reuses the exact levels-2-and-5 corridor.
-/
def canonicalSupportCorridor
    (o : ℕ) (S : SupportAddress) : Prop :=
  (o = 3 ∧ threeFaceAddress S) ∨
    (o = 2 ∧ twoFaceAddress S)

/-- Decidability of membership in an orientation-selected corridor. -/
instance decidablePredCanonicalSupportCorridor (o : ℕ) :
    DecidablePred (canonicalSupportCorridor o) := by
  intro S
  unfold canonicalSupportCorridor
  infer_instance

/-- An address is off-profile for the selected canonical orientation. -/
def offProfileAddress
    (o : ℕ) (S : SupportAddress) : Prop :=
  ¬ canonicalSupportCorridor o S

/-- Decidability of orientation-specific off-profile membership. -/
instance decidablePredOffProfileAddress (o : ℕ) :
    DecidablePred (offProfileAddress o) := by
  intro S
  unfold offProfileAddress
  infer_instance

/-- The finite support-address alphabet of the selected canonical corridor. -/
def canonicalSupportCorridorAddresses
    (o : ℕ) : Finset SupportAddress :=
  supportAddresses.filter (canonicalSupportCorridor o)

/-- The finite support-address alphabet outside the selected corridor. -/
def offProfileAddresses
    (o : ℕ) : Finset SupportAddress :=
  supportAddresses.filter (offProfileAddress o)

@[simp]
theorem mem_canonicalSupportCorridorAddresses
    {o : ℕ} {S : SupportAddress} :
    S ∈ canonicalSupportCorridorAddresses o ↔
      canonicalSupportCorridor o S := by
  simp [canonicalSupportCorridorAddresses]

@[simp]
theorem mem_offProfileAddresses
    {o : ℕ} {S : SupportAddress} :
    S ∈ offProfileAddresses o ↔ offProfileAddress o S := by
  simp [offProfileAddresses]

/-- Orientation 3 is exactly the previously defined three-face corridor. -/
@[simp]
theorem canonicalSupportCorridor_three
    (S : SupportAddress) :
    canonicalSupportCorridor 3 S ↔ threeFaceAddress S := by
  simp [canonicalSupportCorridor]

/-- Orientation 2 is exactly the previously defined two-face corridor. -/
@[simp]
theorem canonicalSupportCorridor_two
    (S : SupportAddress) :
    canonicalSupportCorridor 2 S ↔ twoFaceAddress S := by
  simp [canonicalSupportCorridor]

/-- Orientation 3 is off-profile exactly outside the three-face corridor. -/
@[simp]
theorem offProfileAddress_three
    (S : SupportAddress) :
    offProfileAddress 3 S ↔ offThreeFaceAddress S := by
  simp [offProfileAddress, offThreeFaceAddress]

/-- Orientation 2 is off-profile exactly outside the two-face corridor. -/
@[simp]
theorem offProfileAddress_two
    (S : SupportAddress) :
    offProfileAddress 2 S ↔ offTwoFaceAddress S := by
  simp [offProfileAddress, offTwoFaceAddress]

/-- The orientation-3 corridor finset is the existing three-face finset. -/
theorem canonicalSupportCorridorAddresses_three :
    canonicalSupportCorridorAddresses 3 = threeFaceAddresses := by
  ext S
  simp [canonicalSupportCorridorAddresses, threeFaceAddresses]

/-- The orientation-2 corridor finset is the existing two-face finset. -/
theorem canonicalSupportCorridorAddresses_two :
    canonicalSupportCorridorAddresses 2 = twoFaceAddresses := by
  ext S
  simp [canonicalSupportCorridorAddresses, twoFaceAddresses]

/-- The orientation-3 off-profile finset is the existing three-face complement. -/
theorem offProfileAddresses_three :
    offProfileAddresses 3 = offThreeFaceAddresses := by
  ext S
  simp [offProfileAddresses, offThreeFaceAddresses]

/-- The orientation-2 off-profile finset is the existing two-face complement. -/
theorem offProfileAddresses_two :
    offProfileAddresses 2 = offTwoFaceAddresses := by
  ext S
  simp [offProfileAddresses, offTwoFaceAddresses]

/-- Exact natural off-profile product for a selected orientation. -/
noncomputable def orientationOffFaceProduct
    (o n : ℕ) (d : Fin 5 → ℕ) : ℕ :=
  ∏ S ∈ offProfileAddresses o, atomBucket n d S

/-- Orientation 3 reuses `offFaceProductThree` definitionally by its address set. -/
theorem orientationOffFaceProduct_three
    (n : ℕ) (d : Fin 5 → ℕ) :
    orientationOffFaceProduct 3 n d = offFaceProductThree n d := by
  unfold orientationOffFaceProduct offFaceProductThree
  rw [offProfileAddresses_three]

/-- Orientation 2 reuses `offFaceProductTwo` definitionally by its address set. -/
theorem orientationOffFaceProduct_two
    (n : ℕ) (d : Fin 5 → ℕ) :
    orientationOffFaceProduct 2 n d = offFaceProductTwo n d := by
  unfold orientationOffFaceProduct offFaceProductTwo
  rw [offProfileAddresses_two]

/-- The earlier orientation-free pressure is the minimum of the same products. -/
theorem offFacePressureNat_eq_orientation_min
    (n : ℕ) (d : Fin 5 → ℕ) :
    offFacePressureNat n d =
      Nat.min
        (orientationOffFaceProduct 3 n d)
        (orientationOffFaceProduct 2 n d) := by
  rw [orientationOffFaceProduct_three,
    orientationOffFaceProduct_two]
  rfl

