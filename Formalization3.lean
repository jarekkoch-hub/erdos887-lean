Section 7.1 parent

Incoming state shape:
  Section6.endpoint_address_S_0_state
    (Section3.O_can_T opening)
  canonical_incident_product_growth_state
    opening GammaSeq nuSeq sigmaSeq

Outgoing state shape:
  section_7_1_output
    opening GammaSeq nuSeq sigmaSeq
    (fun m => rationalMaxLinearProfile GammaSeq m)

Effect:
  Calls the three Section 7.1 public batches in order over one exact opening.
  The same Gamma_W branch, nu family, sigma family, and max-linear profile are
  reused throughout.  The result is ready for the Section 7.2 branch-shape
  restriction without reopening O_can or introducing a detached source island.

Public theorem:
  close_incident_growth_section_7_1
================================================================================
-/

theorem close_incident_growth_section_7_1
    {opening : CanonicalIntervalOverloadOpeningData}
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {nuSeq : IncidentGrowthExponentSequence}
    {sigmaSeq : ProfileReadSequence}
    (hAddress :
      Section6.endpoint_address_S_0_state
        (Section3.O_can_T opening))
    (hGrowth :
      canonical_incident_product_growth_state
        opening GammaSeq nuSeq sigmaSeq) :
    section_7_1_output
      opening GammaSeq nuSeq sigmaSeq
      (fun m => rationalMaxLinearProfile GammaSeq m) := by
  have hGrow :
      I_grow opening GammaSeq nuSeq sigmaSeq :=
    build_I_grow hAddress hGrowth

  have hProfile :
      max_linear_profile
        GammaSeq sigmaSeq
        (fun m => rationalMaxLinearProfile GammaSeq m) :=
    build_max_linear_profile hGrow

  have hBalance :
      profile_balance
        (fun m => rationalMaxLinearProfile GammaSeq m) :=
    incident_growth_law_gives_profile_balance
      hGrow hProfile

  exact
    ⟨hGrow, hProfile, hBalance⟩

