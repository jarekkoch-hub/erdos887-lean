def section_6_5_sub_layer_02_sub_box_02_label : String := "Closed Boolean degree laws and the final address-only Section 6 state"
def section_6_5_sub_layer_02_sub_box_02_inputs : List String := ["endpoint_boolean_degree_state [read]"]
def section_6_5_sub_layer_02_sub_box_02_outputs : List String := ["endpoint_address_S_0_state [birth]"]


/-
================================================================================
EXECUTABLE BOX
Section 6.5, Sub-layer 02, Sub-box 02
Birth token: endpoint_address_S_0_state

This box proves the generic finite Boolean degree laws on the fixed ten-edge
address system and retains them beside the exact cumulative state produced by
the first Section 6.5 box.

No selected coloring, growth law, rank reduction, prefix closure, affine
synchronization, coefficient family, sector family, or terminal endpoint datum
is introduced.
================================================================================
-/

/-
A sum of four Boolean indicator values is at most four.

This arithmetic lemma is independent of the K5 tables.  The vertex theorem
below only reduces each concrete degree row to one use of this lemma.
-/
theorem boolean_four_value_sum_le_four
    (a b c d : Bool) :
    booleanIndicatorValue a +
        booleanIndicatorValue b +
        booleanIndicatorValue c +
        booleanIndicatorValue d ≤ 4 := by
  have ha := booleanIndicatorValue_le_one a
  have hb := booleanIndicatorValue_le_one b
  have hc := booleanIndicatorValue_le_one c
  have hd := booleanIndicatorValue_le_one d
  nlinarith

theorem boolean_vertex_degree_bound
    (chi : BooleanEdgeIndicator)
    (v : EndpointAddress) :
    booleanVertexDegree chi v ≤ 4 := by
  fin_cases v
  · change
      booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 3) ≤ 4
    exact
      boolean_four_value_sum_le_four
        (chi 0) (chi 1) (chi 2) (chi 3)
  · change
      booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 6) ≤ 4
    exact
      boolean_four_value_sum_le_four
        (chi 0) (chi 4) (chi 5) (chi 6)
  · change
      booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 7) +
          booleanIndicatorValue (chi 8) ≤ 4
    exact
      boolean_four_value_sum_le_four
        (chi 1) (chi 4) (chi 7) (chi 8)
  · change
      booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 7) +
          booleanIndicatorValue (chi 9) ≤ 4
    exact
      boolean_four_value_sum_le_four
        (chi 2) (chi 5) (chi 7) (chi 9)
  · change
      booleanIndicatorValue (chi 3) +
          booleanIndicatorValue (chi 6) +
          booleanIndicatorValue (chi 8) +
          booleanIndicatorValue (chi 9) ≤ 4
    exact
      boolean_four_value_sum_le_four
        (chi 3) (chi 6) (chi 8) (chi 9)

theorem boolean_handshake_identity
    (chi : BooleanEdgeIndicator) :
    booleanTotalVertexDegree chi =
      2 * booleanSelectedEdgeCount chi := by
  change
    (booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 3)) +
        (booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 6)) +
        (booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 7) +
          booleanIndicatorValue (chi 8)) +
        (booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 7) +
          booleanIndicatorValue (chi 9)) +
        (booleanIndicatorValue (chi 3) +
          booleanIndicatorValue (chi 6) +
          booleanIndicatorValue (chi 8) +
          booleanIndicatorValue (chi 9)) =
      2 *
        (booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 3) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 6) +
          booleanIndicatorValue (chi 7) +
          booleanIndicatorValue (chi 8) +
          booleanIndicatorValue (chi 9))
  ring

/-
Each of the four summands is bounded by their total.
These helpers contain no endpoint or edge-table reduction.
-/
theorem nat_first_le_sum_four
    (a b c d : ℕ) :
    a ≤ a + b + c + d := by
  nlinarith

theorem nat_second_le_sum_four
    (a b c d : ℕ) :
    b ≤ a + b + c + d := by
  nlinarith

theorem nat_third_le_sum_four
    (a b c d : ℕ) :
    c ≤ a + b + c + d := by
  nlinarith

theorem nat_fourth_le_sum_four
    (a b c d : ℕ) :
    d ≤ a + b + c + d := by
  nlinarith

/-
Every edge contribution is bounded by the degree at the first endpoint in the
fixed boundary table.
-/
theorem boolean_edge_value_le_first_endpoint_degree
    (chi : BooleanEdgeIndicator)
    (e : K5EdgeAddress) :
    booleanIndicatorValue (chi e) ≤
      booleanVertexDegree chi (k5EdgeBoundary e).1 := by
  fin_cases e
  · change
      booleanIndicatorValue (chi 0) ≤
        booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 3)
    exact
      nat_first_le_sum_four
        _ _ _ _
  · change
      booleanIndicatorValue (chi 1) ≤
        booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 3)
    exact
      nat_second_le_sum_four
        _ _ _ _
  · change
      booleanIndicatorValue (chi 2) ≤
        booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 3)
    exact
      nat_third_le_sum_four
        _ _ _ _
  · change
      booleanIndicatorValue (chi 3) ≤
        booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 3)
    exact
      nat_fourth_le_sum_four
        _ _ _ _
  · change
      booleanIndicatorValue (chi 4) ≤
        booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 6)
    exact
      nat_second_le_sum_four
        _ _ _ _
  · change
      booleanIndicatorValue (chi 5) ≤
        booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 6)
    exact
      nat_third_le_sum_four
        _ _ _ _
  · change
      booleanIndicatorValue (chi 6) ≤
        booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 6)
    exact
      nat_fourth_le_sum_four
        _ _ _ _
  · change
      booleanIndicatorValue (chi 7) ≤
        booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 7) +
          booleanIndicatorValue (chi 8)
    exact
      nat_third_le_sum_four
        _ _ _ _
  · change
      booleanIndicatorValue (chi 8) ≤
        booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 7) +
          booleanIndicatorValue (chi 8)
    exact
      nat_fourth_le_sum_four
        _ _ _ _
  · change
