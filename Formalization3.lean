                  CanonicalSectorLawFamily Dcan →
                    CanonicalReducedCubicLawFamily Dcan →
                      Prop

/-- The minimal source-selection certificate for one exact internal tuple. -/
def canonical_internal_selection_at
    {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (polynomialData :
      SameKEndpointPolynomial.EndpointPolynomialSourceData D)
    (productRowData : ProductRowExtraction.SameKProductRowSourceData D)
    (sourceData : RatioCollapse.SameKPrefixAverageFormulaSourceData D)
    (Dcan : Type)
    (dcan : Dcan)
    (selection : CanonicalInternalSelectionRelation)
    (sectorLaw : CanonicalSectorLawFamily Dcan)
    (reducedCubicLaw : CanonicalReducedCubicLawFamily Dcan) : Prop :=
  selection
    survivorData affineData polynomialData productRowData sourceData
    Dcan dcan sectorLaw reducedCubicLaw

/--
The section-level monochrome datum read constantly over the canonical internal
datum type. The datum argument indexes the later canonical extraction; it does not
select a new monochrome packet.
-/
def canonical_internal_FG_pointwise_read
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (Dcan : Type) : Dcan → Prop :=
  fun _ => PrefixConflict.FG_mono C nSeq dSeq opening

/--
The section-level affine endpoint-equation datum read constantly over the
canonical internal datum type.  No affine chamber or endpoint state is
reselected.
-/
def canonical_internal_HI_pointwise_read
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (Dcan : Type) : Dcan → Prop :=
  fun _ => AffineChamber.HI_aff C nSeq dSeq opening


/--
One exact terminal index read from the retained affine endpoint-equation state.
This is the m-indexed tail of Section 14's terminal_endpoint_equation_read_at.
It records that m is not freely chosen: one valid terminal parameter produces
cubic equations against openingBSeq opening m on the exact affine/product-row
payload.
-/
def canonical_internal_terminal_index_at
    (opening : CanonicalIntervalOverloadOpeningData)
    {D : Type}
    (_survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (polynomialData :
      SameKEndpointPolynomial.EndpointPolynomialSourceData D)
    (productRowData : ProductRowExtraction.SameKProductRowSourceData D)
    (_sourceData : RatioCollapse.SameKPrefixAverageFormulaSourceData D)
    (m : ℕ) : Prop :=
  ∃ lambda : ℚ,
    lambda ∈
        SameKEndpointPolynomial.endpointPolynomialValidSet polynomialData ∧
      ∀ e : Section6.K5EdgeAddress,
        (SameKEndpointPolynomial.sameKAffineAlpha affineData
                (ProductRowExtraction.productRowLeftFactorAddresses
                  productRowData e 0) * lambda +
              SameKEndpointPolynomial.sameKAffineBeta affineData
                (ProductRowExtraction.productRowLeftFactorAddresses
                  productRowData e 0)) *
            (SameKEndpointPolynomial.sameKAffineAlpha affineData
                (ProductRowExtraction.productRowLeftFactorAddresses
                  productRowData e 1) * lambda +
              SameKEndpointPolynomial.sameKAffineBeta affineData
                (ProductRowExtraction.productRowLeftFactorAddresses
                  productRowData e 1)) *
            (SameKEndpointPolynomial.sameKAffineAlpha affineData
                (ProductRowExtraction.productRowLeftFactorAddresses
                  productRowData e 2) * lambda +
              SameKEndpointPolynomial.sameKAffineBeta affineData
                (ProductRowExtraction.productRowLeftFactorAddresses
                  productRowData e 2)) -
          (SameKEndpointPolynomial.sameKAffineAlpha affineData
                (ProductRowExtraction.productRowRightFactorAddresses
                  productRowData e 0) * lambda +
              SameKEndpointPolynomial.sameKAffineBeta affineData
                (ProductRowExtraction.productRowRightFactorAddresses
                  productRowData e 0)) *
            (SameKEndpointPolynomial.sameKAffineAlpha affineData
                (ProductRowExtraction.productRowRightFactorAddresses
                  productRowData e 1) * lambda +
              SameKEndpointPolynomial.sameKAffineBeta affineData
                (ProductRowExtraction.productRowRightFactorAddresses
                  productRowData e 1)) *
            (SameKEndpointPolynomial.sameKAffineAlpha affineData
                (ProductRowExtraction.productRowRightFactorAddresses
                  productRowData e 2) * lambda +
              SameKEndpointPolynomial.sameKAffineBeta affineData
                (ProductRowExtraction.productRowRightFactorAddresses
                  productRowData e 2)) =
        (openingBSeq opening m
          (Section6.k5EdgeBoundary e).1
          (Section6.k5EdgeBoundary e).2 : ℚ)

/--
The selected datum's canonical endpoint table is identified with the endpoint
coefficient table at one exact terminal index from the same opening.
-/
def canonical_internal_coefficient_read_at
    (opening : CanonicalIntervalOverloadOpeningData)
    (m : ℕ)
    (rho : Section6.K5EdgeAddress → ℚ) : Prop :=
  ∀ e : Section6.K5EdgeAddress,
    rho e =
      (openingBSeq opening m
        (Section6.k5EdgeBoundary e).1
        (Section6.k5EdgeBoundary e).2 : ℚ)

/--
The source-owned executable meaning of the selected datum together with its
sector-law and reduced-cubic witnesses. The capability cannot be used until the
actual two law witnesses and an exact terminal index from the same HI_aff
payload are supplied. It then returns the selected canonical coefficient table,
its identification with the opened endpoint constants, and the terminal
nonzero condition.
-/
def canonical_internal_law_bearing_coefficient_capability_at
    (opening : CanonicalIntervalOverloadOpeningData)
    {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (polynomialData :
      SameKEndpointPolynomial.EndpointPolynomialSourceData D)
    (productRowData : ProductRowExtraction.SameKProductRowSourceData D)
    (sourceData : RatioCollapse.SameKPrefixAverageFormulaSourceData D)
    (Dcan : Type)
    (dcan : Dcan)
    (sectorLaw : CanonicalSectorLawFamily Dcan)
    (reducedCubicLaw : CanonicalReducedCubicLawFamily Dcan) : Prop :=
  sectorLaw dcan →
    reducedCubicLaw dcan →
      ∀ m : ℕ,
        canonical_internal_terminal_index_at
            opening survivorData affineData polynomialData productRowData
            sourceData m →
          ∃ rho : Section6.K5EdgeAddress → ℚ,
            canonical_internal_coefficient_read_at opening m rho ∧
              ∃ e : Section6.K5EdgeAddress, rho e ≠ 0

/--
The complete temporary source realization on one exact affine endpoint state.
It contains the selection certificate, both law witnesses, and the source-owned
coefficient capability. Its projections are separated immediately by the child
boxes; no terminal theorem map is present.
-/
def canonical_internal_source_payload_at
    (_C : ℝ)
    (_nSeq : ℕ → ℕ)
    (_dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (_GammaSeq : Gamma_W_adjacent_growth_profile)
    (_nuSeq : IncidentGrowth.IncidentGrowthExponentSequence)
    (_sigmaSeq : IncidentGrowth.ProfileReadSequence)
    (_GSeq : IncidentGrowth.MaxLinearProfileSequence)
    {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (polynomialData :
      SameKEndpointPolynomial.EndpointPolynomialSourceData D)
    (productRowData : ProductRowExtraction.SameKProductRowSourceData D)
    (sourceData : RatioCollapse.SameKPrefixAverageFormulaSourceData D)
    (Dcan : Type)
    (dcan : Dcan)
    (selection : CanonicalInternalSelectionRelation)
    (sectorLaw : CanonicalSectorLawFamily Dcan)
    (reducedCubicLaw : CanonicalReducedCubicLawFamily Dcan) : Prop :=
  canonical_internal_selection_at
      survivorData affineData polynomialData productRowData sourceData
      Dcan dcan selection sectorLaw reducedCubicLaw ∧
    sectorLaw dcan ∧
      reducedCubicLaw dcan ∧
        canonical_internal_law_bearing_coefficient_capability_at
          opening survivorData affineData polynomialData productRowData sourceData
          Dcan dcan sectorLaw reducedCubicLaw

/--
The retained canonical internal source port.  Its internal datum, selection
relation, and law families are fixed parameters of the port.  Applying it to an
exact HI_aff_at state returns the complete temporary source realization on that
same endpoint state.
-/
def canonical_internal_source
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (GammaSeq : Gamma_W_adjacent_growth_profile)
    (nuSeq : IncidentGrowth.IncidentGrowthExponentSequence)
    (sigmaSeq : IncidentGrowth.ProfileReadSequence)
    (GSeq : IncidentGrowth.MaxLinearProfileSequence)
    {Dcan : Type}
    (dcan : Dcan)
    (selection : CanonicalInternalSelectionRelation)
    (sectorLaw : CanonicalSectorLawFamily Dcan)
    (reducedCubicLaw : CanonicalReducedCubicLawFamily Dcan) : Prop :=
  ∀ {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (polynomialData :
      SameKEndpointPolynomial.EndpointPolynomialSourceData D)
    (productRowData : ProductRowExtraction.SameKProductRowSourceData D)
    (sourceData : RatioCollapse.SameKPrefixAverageFormulaSourceData D),
    AffineChamber.HI_aff_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData →
      canonical_internal_source_payload_at
        C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
        survivorData affineData polynomialData productRowData sourceData
        Dcan dcan selection sectorLaw reducedCubicLaw


/-
================================================================================
EXECUTABLE BOX
Section 15, Sub-layer 00, Sub-box 00
Birth token: canonical_internal_context

This box opens the exact existential payload of HI_aff once and applies the
fixed canonical internal source to that exact endpoint state.  The context is
the temporary fork point containing the complete source realization.

The later selected, sector, reduced-cubic, retained-datum, readable-signature,
packets do not copy this complete context as their exact payload.  They project only their owned fields.
================================================================================
-/

/-- The exact Section 15 entry state over one affine and one source payload. -/
def canonical_internal_context_at
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (GammaSeq : Gamma_W_adjacent_growth_profile)
    (nuSeq : IncidentGrowth.IncidentGrowthExponentSequence)
    (sigmaSeq : IncidentGrowth.ProfileReadSequence)
    (GSeq : IncidentGrowth.MaxLinearProfileSequence)
    {D : Type}
    (survivorData : PrefixConflict.ClosedPrefixSurvivorData D)
    (affineData : SameKEndpointPolynomial.SameKAffinePencilData D)
    (polynomialData :
      SameKEndpointPolynomial.EndpointPolynomialSourceData D)
    (productRowData : ProductRowExtraction.SameKProductRowSourceData D)
    (sourceData : RatioCollapse.SameKPrefixAverageFormulaSourceData D)
    (Dcan : Type)
    (dcan : Dcan)
    (selection : CanonicalInternalSelectionRelation)
    (sectorLaw : CanonicalSectorLawFamily Dcan)
    (reducedCubicLaw : CanonicalReducedCubicLawFamily Dcan) : Prop :=
  AffineChamber.HI_aff_at
      C nSeq dSeq opening
      survivorData affineData polynomialData productRowData sourceData ∧
    canonical_internal_source_payload_at
      C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
      survivorData affineData polynomialData productRowData sourceData
      Dcan dcan selection sectorLaw reducedCubicLaw

/--
The Section 15 boundary context.  The four declared public inputs remain
visible.  The final existential seals one exact affine endpoint state and the
complete temporary source realization for the fixed internal parameters.
-/
def canonical_internal_context
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (GammaSeq : Gamma_W_adjacent_growth_profile)
    (nuSeq : IncidentGrowth.IncidentGrowthExponentSequence)
    (sigmaSeq : IncidentGrowth.ProfileReadSequence)
    (GSeq : IncidentGrowth.MaxLinearProfileSequence)
    {Dcan : Type}
    (dcan : Dcan)
    (selection : CanonicalInternalSelectionRelation)
    (sectorLaw : CanonicalSectorLawFamily Dcan)
    (reducedCubicLaw : CanonicalReducedCubicLawFamily Dcan) : Prop :=
  IncidentGrowth.B_unif
      opening GammaSeq nuSeq sigmaSeq GSeq ∧
    PrefixConflict.FG_mono C nSeq dSeq opening ∧
    AffineChamber.HI_aff C nSeq dSeq opening ∧
    canonical_internal_source
      C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
      dcan selection sectorLaw reducedCubicLaw ∧
    ∃ D : Type,
      ∃ survivorData : PrefixConflict.ClosedPrefixSurvivorData D,
        ∃ affineData : SameKEndpointPolynomial.SameKAffinePencilData D,
          ∃ polynomialData :
              SameKEndpointPolynomial.EndpointPolynomialSourceData D,
            ∃ productRowData :
                ProductRowExtraction.SameKProductRowSourceData D,
              ∃ sourceData :
                  RatioCollapse.SameKPrefixAverageFormulaSourceData D,
                canonical_internal_context_at
                  C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
                  survivorData affineData polynomialData productRowData sourceData
                  Dcan dcan selection sectorLaw reducedCubicLaw

/-
================================================================================
STATE-SHAPE BATCH
Section 15, Sub-layer 00, Sub-box 00

Incoming state shape:
  IncidentGrowth.B_unif opening GammaSeq nuSeq sigmaSeq GSeq
  PrefixConflict.FG_mono C nSeq dSeq opening
  AffineChamber.HI_aff C nSeq dSeq opening
  canonical_internal_source
    C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
    dcan selection sectorLaw reducedCubicLaw

Outgoing state shape:
  canonical_internal_context
    C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
    dcan selection sectorLaw reducedCubicLaw

Effect:
  Opens one exact HI_aff payload and applies the fixed source port on that same
  endpoint state.  The context is the temporary complete source realization.
  It does not identify Dcan with the affine survivor type and does not perform
  terminal extraction.

Public theorem:
  build_canonical_internal_context
================================================================================
-/

theorem build_canonical_internal_context
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {nuSeq : IncidentGrowth.IncidentGrowthExponentSequence}
    {sigmaSeq : IncidentGrowth.ProfileReadSequence}
    {GSeq : IncidentGrowth.MaxLinearProfileSequence}
    {Dcan : Type}
    {dcan : Dcan}
    {selection : CanonicalInternalSelectionRelation}
    {sectorLaw : CanonicalSectorLawFamily Dcan}
    {reducedCubicLaw : CanonicalReducedCubicLawFamily Dcan}
    (hB :
      IncidentGrowth.B_unif
        opening GammaSeq nuSeq sigmaSeq GSeq)
    (hMono :
      PrefixConflict.FG_mono C nSeq dSeq opening)
    (hAffine :
      AffineChamber.HI_aff C nSeq dSeq opening)
    (hSource :
      canonical_internal_source
        C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
        dcan selection sectorLaw reducedCubicLaw) :
    canonical_internal_context
      C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
      dcan selection sectorLaw reducedCubicLaw := by
  rcases hAffine.2.2.2.2.2.2.2.2 with
    ⟨D, survivorData, affineData, polynomialData, productRowData,
      sourceData, hAffineAt⟩
  have hPayloadAt :
      canonical_internal_source_payload_at
        C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
        survivorData affineData polynomialData productRowData sourceData
        Dcan dcan selection sectorLaw reducedCubicLaw :=
    hSource
      survivorData affineData polynomialData productRowData sourceData
      hAffineAt
  have hContextAt :
      canonical_internal_context_at
        C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
        survivorData affineData polynomialData productRowData sourceData
        Dcan dcan selection sectorLaw reducedCubicLaw :=
    ⟨hAffineAt, hPayloadAt⟩
  exact
    ⟨hB, hMono, hAffine, hSource,
      D, survivorData, affineData, polynomialData, productRowData,
      sourceData, hContextAt⟩


