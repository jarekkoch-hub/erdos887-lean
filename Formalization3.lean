-/
def normalizedLegalSurvivorLaw
    (_C : ℝ) (O : Section3.O_can_data) : Prop :=
  Function.Injective (Section3.O_can_T O)

/--
A normalized legal survivor is a genuine wrapper around its canonical datum.
No unrelated finite witness can be paired with an independently chosen datum.
-/
abbrev NormalizedLegalFiveEndpointSurvivor (C : ℝ) : Type :=
  Σ O : Section3.O_can_data,
    PLift (
      0 < C ∧
      Section3.O_can_state O ∧
      normalizedLegalSurvivorLaw C O)

/-- Read the exact canonical datum carried by one normalized legal survivor. -/
def legalSurvivorCanonicalDatum
    {C : ℝ}
    (S : NormalizedLegalFiveEndpointSurvivor C) :
    Section3.O_can_data :=
  S.1

/-- Read the proposition-valued laws of the survivor's exact canonical datum. -/
theorem legalSurvivorCanonicalDatum_state
    {C : ℝ}
    (S : NormalizedLegalFiveEndpointSurvivor C) :
    Section3.O_can_state (legalSurvivorCanonicalDatum S) :=
  S.2.down.2.1

/-- Read positivity of the fixed window constant carried by a legal survivor. -/
theorem legalSurvivorWindowPositive
    {C : ℝ}
    (S : NormalizedLegalFiveEndpointSurvivor C) :
    0 < C :=
  S.2.down.1

/-- Read the five-endpoint legality condition. -/
theorem legalSurvivorEndpointsInjective
    {C : ℝ}
    (S : NormalizedLegalFiveEndpointSurvivor C) :
    Function.Injective
      (Section3.O_can_T (legalSurvivorCanonicalDatum S)) :=
  S.2.down.2.2

/--
The paper's survivor-realization step is direct packaging of one completed
canonical datum.  External finite-witness provenance remains private to the
proof that produced `O`.
-/
theorem realize_normalized_legal_survivor_from_O_can
    {C : ℝ} {O : Section3.O_can_data}
    (hC : 0 < C)
    (hO : Section3.O_can_state O) :
    Nonempty (NormalizedLegalFiveEndpointSurvivor C) := by
  exact
    ⟨⟨O,
      ⟨hC, hO, O_can_endpointValues_injective hO⟩⟩⟩

/--
The strongest honest reconstruction threshold currently available.  It stores
mathematical constants and the resulting pointwise reconstruction map through
the exact endpoint-sector display.  Source capabilities are consumed by its
builder and are not retained as packet fields.  Adjacent growth and `O_can`
packaging remain unavailable at the paper-specification blocker.
-/
def canonicalReconstructionThresholdPacket
    (C : ℝ) (Nrec : ℕ) : Prop :=
  ∃ Nedge Medge B Nclip Nsector Msector Ncurvature : ℕ,
    Nedge ≤ Nrec ∧
    Nclip ≤ Nrec ∧
    Nsector ≤ Nrec ∧
    Ncurvature ≤ Nrec ∧
    (∀ n : ℕ, ∀ d : Fin 5 → ℕ,
      Ncurvature ≤ n →
      Section3.five_near_root_divisor_witness C n d →
      ∀ i : Fin 5,
        Section3.curvatureTerm n (d i) ≤ C ^ 2) ∧
    ∀ n : ℕ, ∀ d : Fin 5 → ℕ,
      Nrec ≤ n →
      Section3.five_near_root_divisor_witness C n d →
      ∃ o : ℕ,
        ∃ Z : Section3.SectorProductFamily,
          ∃ b : Section3.EndpointCoefficientFamily,
            ∃ mW : ℕ,
              Section3.pointwiseClippedFaceState
                  C Medge B Nclip n d o ∧
                Section3.PointwiseEndpointSectorDisplayAt
                  C n d o Z b Msector mW

/--
Build the external reconstruction frontier from the three pointwise source
owners.  The chamber source selects `Medge`; clipping is then requested at
that exact bound, and the sector source is finally requested at the exact
`Medge`, `B`, and `Nclip` selected upstream.
-/
theorem build_canonicalReconstructionThresholdPacket_from_sources
    (C : ℝ)
    (hC : 0 < C)
    (hResolvedSource :
      Section3.canonicalPointwiseResolvedChamberSource)
    (hClippingSource :
      Section3.derive_canonicalPointwiseClippingSource)
    (hSectorSource :
      Section3.derive_canonicalPointwiseSectorChamberSource) :
    ∃ Nrec : ℕ,
      canonicalReconstructionThresholdPacket C Nrec := by
  rcases hResolvedSource C hC with
    ⟨Nedge, Medge, hResolved⟩
  rcases hClippingSource hC hResolved with
    ⟨B, Nclip, hClipping⟩
  rcases hSectorSource hC hResolved hClipping with
    ⟨Nsector, Msector, hSector⟩
  let Ncurvature := Nedge
  let Nrec :=
    Nat.max Nedge
      (Nat.max Nclip (Nat.max Nsector Ncurvature))
  have hCurvature :
      ∀ n : ℕ, ∀ d : Fin 5 → ℕ,
        Section3.five_near_root_divisor_witness C n d →
        ∀ i : Fin 5,
          Section3.curvatureTerm n (d i) ≤ C ^ 2 := by
    intro n d hWitness i
    exact
      ((Section3.derive_paired_root_split hWitness).2 i).2.2.2.2.2.2
  refine ⟨Nrec, Nedge, Medge, B, Nclip,
    Nsector, Msector, Ncurvature, ?_, ?_, ?_, ?_,
    ?_, ?_⟩
  · dsimp [Nrec]
    exact Nat.le_max_left _ _
  · dsimp [Nrec]
    exact le_trans
      (Nat.le_max_left _ _)
      (Nat.le_max_right _ _)
  · dsimp [Nrec]
    exact le_trans
      (Nat.le_max_left _ _)
      (le_trans
        (Nat.le_max_right _ _)
        (Nat.le_max_right _ _))
  · dsimp [Nrec]
    exact le_trans
      (Nat.le_max_right _ _)
      (le_trans
        (Nat.le_max_right _ _)
        (Nat.le_max_right _ _))
  · intro n d _hCurvatureThreshold hWitness
    exact hCurvature n d hWitness
  · intro n d hRecThreshold hWitness
    have hNedge : Nedge ≤ n := by
      exact le_trans
        (Nat.le_max_left _ _)
        hRecThreshold
    have hNclip : Nclip ≤ n := by
      exact le_trans
        (le_trans
          (Nat.le_max_left _ _)
          (Nat.le_max_right _ _))
        hRecThreshold
    have hNsector : Nsector ≤ n := by
      exact le_trans
        (le_trans
          (Nat.le_max_left _ _)
          (le_trans
            (Nat.le_max_right _ _)
            (Nat.le_max_right _ _)))
        hRecThreshold
    have hBounded :
        Section3.boundedPointwiseCanonicalChamberData
          C Medge n d :=
      hResolved n d hNedge hWitness
    rcases
        Section3.pointwiseClippedFaceState_of_source
          hClipping hNclip hBounded with
      ⟨o, hClipped⟩
    rcases hSector n d o hNsector hClipped with
      ⟨Z, b, mW, hChamber⟩
    have hDisplay :
        Section3.PointwiseEndpointSectorDisplayAt
          C n d o Z b Msector mW :=
      Section3.build_PointwiseEndpointSectorDisplayAt hChamber
    exact
      ⟨o, Z, b, mW, hClipped, hDisplay⟩

/--
The root-band reconstruction theorem surface.

Its public output is exactly the normalized legal survivor.  The reconstruction
threshold and every sequence/subsequence diagnostic remain private to the
eventual proof.  That proof must consume
`canonicalPointwiseResolvedChamberSource`,
`derive_canonicalPointwiseClippingSource`, and
`derive_canonicalPointwiseSectorChamberSource`; the current route remains open
later at adjacent-growth production and `O_can` packaging.
-/
def root_band_survivor_reconstruction : Prop :=
  ∀ C : ℝ,
    0 < C →
      ExternalInfiniteViolations C →
        Nonempty (NormalizedLegalFiveEndpointSurvivor C)

/-- The paper's eventual four-divisor conclusion. -/
def Erdos887BoundFour : Prop :=
  ∀ C : ℝ,
    0 < C →
      ∃ N : ℕ,
        ∀ n : ℕ,
          N ≤ n → D_C C n ≤ 4

