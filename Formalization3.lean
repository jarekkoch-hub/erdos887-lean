Note: These frames are finite address primitives, not algebraic equations.
-/
def section_6_4_sub_layer_02_sub_box_02_label : String := "Incident frames: six incident edge references and three associated pair-product frames"
def section_6_4_sub_layer_02_sub_box_02_inputs : List String := ["endpoint_pair_product_frame_state [construction]"]
def section_6_4_sub_layer_02_sub_box_02_outputs : List String := ["endpoint_incident_frame_state [birth]"]


/-
================================================================================
EXECUTABLE BOX
Section 6.4, Sub-layer 02, Sub-box 02
Birth token: endpoint_incident_frame_state

This box extends the exact pair-product-frame state with the permanent incident
frames used by later rank and product-row calculations.

A no-repetition listing `(i,j,r,s,t)` supplies the six incident references

  epsilon_ir, epsilon_is, epsilon_it,
  epsilon_jr, epsilon_js, epsilon_jt,

and the three associated pair-product frames obtained by treating `r`, `s`,
and `t` in turn as the omitted endpoint.

The edge names in those pair-product frames are definitionally the same
`endpointEdgeReference` values already present in the incident frame.  No new
finite choice and no algebraic equation is introduced.
================================================================================
-/

/-- One legal incident frame and its three associated pair-product frames. -/
def incident_frame
    (i j r s t : EndpointAddress) : Prop :=
  fiveEndpointListingNoDup i j r s t ∧
    k5EdgeBoundary (endpointEdgeReference i r) =
      orderedEndpointPair i r ∧
    k5EdgeBoundary (endpointEdgeReference i s) =
      orderedEndpointPair i s ∧
    k5EdgeBoundary (endpointEdgeReference i t) =
      orderedEndpointPair i t ∧
    k5EdgeBoundary (endpointEdgeReference j r) =
      orderedEndpointPair j r ∧
    k5EdgeBoundary (endpointEdgeReference j s) =
      orderedEndpointPair j s ∧
    k5EdgeBoundary (endpointEdgeReference j t) =
      orderedEndpointPair j t ∧
    pair_product_frame i j r s t ∧
    pair_product_frame i j s r t ∧
    pair_product_frame i j t r s

/--
Every no-repetition five-endpoint listing determines an incident frame and its
three legal pair-product subframes.  This is also a pure finite address state.
-/
def incident_frames : Prop :=
  ∀ i j r s t : EndpointAddress,
    fiveEndpointListingNoDup i j r s t →
      incident_frame i j r s t

/-
================================================================================
INTERNAL BOX LEMMA
Section 6.4 finite incident-frame packet

Incoming state shape:
  five_vertex_distinctness
  pair_product_frames
  edge_references

Outgoing state shape:
  incident_frames

Effect:
  Reads the six fixed incident-edge references, applies the two legal listing
  reorderings, and attaches the three exact pair-product frames.  The edge
  identities are address identities in the one fixed table, not algebraic laws.

Internal theorem:
  build_incident_frames
================================================================================
-/

theorem build_incident_frames
    (hDistinct : five_vertex_distinctness)
    (hPairFrames : pair_product_frames)
    (hReferences : edge_references) :
    incident_frames := by
  rcases hReferences with
    ⟨_hNonloops, hBoundary, _hSymm, _hUnique⟩
  intro i j r s t hNoDup
  rcases hDistinct i j r s t hNoDup with
    ⟨hPairwise, hReorderRS, hReorderTRS⟩
  rcases hPairwise with
    ⟨⟨_hij, hir, his, hit⟩,
      ⟨hjr, hjs, hjt⟩,
      ⟨_hrs, _hrt⟩,
      _hst⟩

  have hPairR :
      pair_product_frame i j r s t :=
    hPairFrames i j r s t hNoDup

  have hPairS :
      pair_product_frame i j s r t :=
    hPairFrames i j s r t hReorderRS

  have hPairT :
      pair_product_frame i j t r s :=
    hPairFrames i j t r s hReorderTRS

  exact
    ⟨hNoDup,
      hBoundary i r hir,
      hBoundary i s his,
      hBoundary i t hit,
      hBoundary j r hjr,
      hBoundary j s hjs,
      hBoundary j t hjt,
      hPairR,
      hPairS,
      hPairT⟩

/--
The cumulative Section 6.4 output state over the exact pair-product-frame state.

It retains every earlier endpoint-address restriction and the permanent pair-
product-frame conventions, then adds the six-edge incident frames and their
three associated pair-product frames.  The result remains pure address data.
-/
def endpoint_incident_frame_state
    (v : Section3.EndpointValueFamily) : Prop :=
  endpoint_pair_product_frame_state v ∧
    incident_frames

/-
================================================================================
STATE-SHAPE BATCH
Section 6.4, Sub-layer 02, Sub-box 02

Incoming state shape:
  endpoint_pair_product_frame_state v

Outgoing state shape:
  endpoint_incident_frame_state v

Effect:
  Retains the exact first Section 6.4 state and constructs the incident-frame
  packet from its exact distinctness, pair-product-frame, and edge-reference
  fields.  It adds only permanent address conventions, not algebraic data.

Public theorem:
  build_endpoint_incident_frame_state
================================================================================
-/

theorem build_endpoint_incident_frame_state
    {v : Section3.EndpointValueFamily}
    (hState : endpoint_pair_product_frame_state v) :
    endpoint_incident_frame_state v := by
  exact
    ⟨hState,
      build_incident_frames
        hState.1.2
        hState.2
        hState.1.1.2⟩

/-
================================================================================
STATE-SHAPE PARENT BATCH
Section 6 boundary input through Section 6.4

Incoming state shape:
  StrictMono v

Outgoing state shape:
  endpoint_incident_frame_state v

Effect:
  Starting from the explicit ordered-endpoint boundary input, calls every
  designated Section 6 constructor through Section 6.4 in exact handoff order
  on the same pointwise family `v`:

    StrictMono v
      -> endpoint_address_state v
      -> endpoint_address_interval_state v
      -> endpoint_edge_reference_state v
      -> endpoint_five_vertex_distinctness_state v
      -> endpoint_pair_product_frame_state v
      -> endpoint_incident_frame_state v.

  This is a conditional parent composition from the Section 6 boundary input,
  not a zero-assumption closure theorem and not a connection to `O_can`, `E_W`,
  `S_0`, or any downstream route.  It adds only the permanent finite address
  conventions owned through Section 6.4.

Public theorem:
  build_section_6_through_incident_frames_from_order
================================================================================
-/

theorem build_section_6_through_incident_frames_from_order
    {v : Section3.EndpointValueFamily}
    (hOrdered : StrictMono v) :
    endpoint_incident_frame_state v := by
  have hAddress : endpoint_address_state v :=
    build_endpoint_address_state hOrdered

  have hIntervals : endpoint_address_interval_state v :=
    build_endpoint_address_interval_state hAddress

  have hReferences : endpoint_edge_reference_state v :=
    build_endpoint_edge_reference_state hIntervals

  have hDistinct : endpoint_five_vertex_distinctness_state v :=
    build_endpoint_five_vertex_distinctness_state hReferences

  have hPairFrames : endpoint_pair_product_frame_state v :=
    build_endpoint_pair_product_frame_state hDistinct

  exact build_endpoint_incident_frame_state hPairFrames


/- ## Sub-container 6.5: Boolean edge indicators and degree bookkeeping. -/

/- Sub-layer 01 -/
/-
Paper ref: 6.5
Sub-box Label: `Generic Boolean reads and degree bookkeeping on the exact retained K5 address ledger`
Sub-inputs: `endpoint_incident_frame_state`
Sub-outputs: `endpoint_boolean_degree_state`
-/
def section_6_5_sub_layer_01_sub_box_01_label : String := "Generic Boolean reads and degree bookkeeping on the exact retained K5 address ledger"
def section_6_5_sub_layer_01_sub_box_01_inputs : List String := ["endpoint_incident_frame_state [construction]"]
def section_6_5_sub_layer_01_sub_box_01_outputs : List String := ["endpoint_boolean_degree_state [birth]"]


/-
================================================================================
EXECUTABLE BOX
Section 6.5, Sub-layer 01, Sub-box 01
Birth token: endpoint_boolean_degree_state

The Boolean indicator in this box is generic. It is not a selected rank
coloring and is not the later prefix coloring.

The box consumes the exact Section 6.4 cumulative state, extracts its retained
edge-reference packet, and adds the generic Boolean endpoint-read interface on
that same fixed K5 ledger. The complete incident-frame state is retained
unchanged. No coloring, monochromatic survivor, growth state, rank state,
prefix certificate, affine datum, or terminal datum is selected.
================================================================================
-/

/-- A generic Boolean indicator on the ten fixed K5 edge addresses. -/
abbrev BooleanEdgeIndicator :=
  K5EdgeAddress → Bool

/-- The natural-number bracket value `[b]` of a Boolean value. -/
def booleanIndicatorValue : Bool → ℕ
  | false => 0
  | true => 1

theorem booleanIndicatorValue_le_one
    (b : Bool) :
    booleanIndicatorValue b ≤ 1 := by
  cases b <;> simp [booleanIndicatorValue]

theorem booleanIndicatorValue_eq_zero_iff
    (b : Bool) :
    booleanIndicatorValue b = 0 ↔ b = false := by
  cases b <;> simp [booleanIndicatorValue]

theorem booleanIndicatorValue_eq_one_iff
    (b : Bool) :
    booleanIndicatorValue b = 1 ↔ b = true := by
  cases b <;> simp [booleanIndicatorValue]

/--
The total Boolean read on the symmetric lookup table.

For `i ≠ j`, this is the paper-level value `χ_ij = χ(ε_ij)` on the
already-fixed endpoint edge. Diagonal reads are implementation-only values of
the total lookup and carry no endpoint-edge semantics.
-/
def endpointBooleanRead
    (chi : BooleanEdgeIndicator)
    (i j : EndpointAddress) : Bool :=
  chi (endpointEdgeReference i j)

/-- The natural-number bracket read `[χ_ij]`. -/
def endpointIndicatorRead
    (chi : BooleanEdgeIndicator)
    (i j : EndpointAddress) : ℕ :=
  booleanIndicatorValue
    (endpointBooleanRead chi i j)

/-- The five explicit vertex degrees from the paper. -/
def booleanVertexDegree
    (chi : BooleanEdgeIndicator) :
    EndpointAddress → ℕ :=
  ![
    endpointIndicatorRead chi 0 1 +
      endpointIndicatorRead chi 0 2 +
      endpointIndicatorRead chi 0 3 +
      endpointIndicatorRead chi 0 4,

    endpointIndicatorRead chi 0 1 +
      endpointIndicatorRead chi 1 2 +
      endpointIndicatorRead chi 1 3 +
      endpointIndicatorRead chi 1 4,

    endpointIndicatorRead chi 0 2 +
      endpointIndicatorRead chi 1 2 +
      endpointIndicatorRead chi 2 3 +
      endpointIndicatorRead chi 2 4,

    endpointIndicatorRead chi 0 3 +
      endpointIndicatorRead chi 1 3 +
      endpointIndicatorRead chi 2 3 +
      endpointIndicatorRead chi 3 4,

    endpointIndicatorRead chi 0 4 +
      endpointIndicatorRead chi 1 4 +
      endpointIndicatorRead chi 2 4 +
      endpointIndicatorRead chi 3 4
  ]

/-- The number of selected edges among the ten fixed addresses. -/
def booleanSelectedEdgeCount
    (chi : BooleanEdgeIndicator) : ℕ :=
  booleanIndicatorValue (chi 0) +
    booleanIndicatorValue (chi 1) +
    booleanIndicatorValue (chi 2) +
    booleanIndicatorValue (chi 3) +
    booleanIndicatorValue (chi 4) +
    booleanIndicatorValue (chi 5) +
    booleanIndicatorValue (chi 6) +
    booleanIndicatorValue (chi 7) +
    booleanIndicatorValue (chi 8) +
    booleanIndicatorValue (chi 9)

/-- The sum of the five displayed vertex degrees. -/
def booleanTotalVertexDegree
    (chi : BooleanEdgeIndicator) : ℕ :=
  booleanVertexDegree chi 0 +
    booleanVertexDegree chi 1 +
    booleanVertexDegree chi 2 +
    booleanVertexDegree chi 3 +
    booleanVertexDegree chi 4

/-- Reversing an endpoint pair reads the same Boolean edge value. -/
theorem endpointBooleanRead_symm
    (chi : BooleanEdgeIndicator)
    (i j : EndpointAddress) :
    endpointBooleanRead chi i j =
      endpointBooleanRead chi j i := by
  unfold endpointBooleanRead
  rw [endpointEdgeReference_symm]

/-- The corresponding bracket values are symmetric. -/
theorem endpointIndicatorRead_symm
    (chi : BooleanEdgeIndicator)
    (i j : EndpointAddress) :
    endpointIndicatorRead chi i j =
      endpointIndicatorRead chi j i := by
  unfold endpointIndicatorRead
  exact congrArg booleanIndicatorValue
    (endpointBooleanRead_symm chi i j)

/--
The first generic Boolean packet on the one fixed K5 ledger.

Despite the legacy name, this packet records only endpoint-read symmetry. The
degree bound, handshake identity, extremals, and three-term permutation law are
added by the second Section 6.5 box. No particular indicator is retained: the
statement is universal over `chi`.
-/
def boolean_degree_bookkeeping : Prop :=
  ∀ chi : BooleanEdgeIndicator,
    ∀ i j : EndpointAddress,
      endpointBooleanRead chi i j =
        endpointBooleanRead chi j i

/-
================================================================================
INTERNAL BOX LEMMA
Section 6.5, Sub-layer 01, Sub-box 01

The exact retained edge-reference symmetry field constructs the generic Boolean
read packet. This helper does not create or retain a cumulative state.
================================================================================
-/

theorem build_boolean_degree_bookkeeping
    (hReferences : edge_references) :
    boolean_degree_bookkeeping := by
  rcases hReferences with
    ⟨_hNonloops, _hBoundary, hSymm, _hUnique⟩
  intro chi i j
  unfold endpointBooleanRead
  rw [hSymm]

/--
The first cumulative Section 6.5 state.

It retains the exact Section 6.4 incident-frame state and adds only the generic
Boolean endpoint-read packet on its already-fixed edge ledger.
-/
def endpoint_boolean_degree_state
    (v : Section3.EndpointValueFamily) : Prop :=
  endpoint_incident_frame_state v ∧
    boolean_degree_bookkeeping

/-
================================================================================
STATE-SHAPE BATCH
Section 6.5, Sub-layer 01, Sub-box 01

Incoming state shape:
  endpoint_incident_frame_state v

Outgoing state shape:
  endpoint_boolean_degree_state v

Effect:
  Reads the exact edge-reference field retained inside the Section 6.4 state,
  constructs the universal Boolean endpoint-read law on that same ledger, and
  retains the complete incoming frame state. No `chi` is selected.

Public theorem:
  build_endpoint_boolean_degree_state
================================================================================
-/

theorem build_endpoint_boolean_degree_state
    {v : Section3.EndpointValueFamily}
    (hFrames : endpoint_incident_frame_state v) :
    endpoint_boolean_degree_state v := by
  have hReferences : edge_references :=
    hFrames.1.1.1.2
  exact
    ⟨hFrames,
      build_boolean_degree_bookkeeping hReferences⟩


