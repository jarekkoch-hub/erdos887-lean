theorem external_violation_sequence_to_chamber_context
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hSeq : external_violation_sequence_state C nSeq dSeq) :
    Section3.chamberSequenceContext C nSeq dSeq := by
