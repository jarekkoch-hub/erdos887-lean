      SameKEndpointPolynomial.EndpointPolynomialSourceData D)
    (productRowData : SameKProductRowSourceData D) : Prop :=
  product_difference_row_source_at
      C nSeq dSeq opening
      survivorData affineData polynomialData productRowData ∧
    ∀ e : Section6.K5EdgeAddress,
      SameKEndpointPolynomial.endpointPolynomialFamily polynomialData e =
          endpointCoefficientPolynomial productRowData e ∧
        endpointCoefficientC3 productRowData e =
          (SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e).coeff 3 ∧
        endpointCoefficientC2 productRowData e =
          (SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e).coeff 2 ∧
        endpointCoefficientC1 productRowData e =
          (SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e).coeff 1 ∧
        endpointCoefficientC0 productRowData e =
          (SameKEndpointPolynomial.endpointPolynomialFamily
            polynomialData e).coeff 0

/--
The complete Section 11.1 coefficient-table transformation.  It deterministically
names the four coefficients and the full cubic expansion on every exact product
