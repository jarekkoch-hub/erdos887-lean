/-
================================================================================
STATE-SHAPE PARENT BATCH
Container 4, Layer 09, Box 36
Section 15 complete canonical internal retained-data assembly

Incoming state shape:
  B_unif
  FG_mono
  HI_aff
  canonical_internal_source
    ... dcan selection sectorLaw reducedCubicLaw

Outgoing state shape:
  canonical_internal_outputs
    ... dcan selection sectorLaw reducedCubicLaw

Effect:
  Opens the complete source context once, projects the endpoint-attached selected
  certificate and the two sibling laws, assembles the map-free D_can_int, constructs the constant pointwise reads used
  by the later canonical extraction, and records the map-free readable I_can
  signature.  Every child theorem
  is invoked in metadata order.  The shared retained state and terminal
  contradiction remain outside Section 15.

Public theorem:
  close_canonical_internal_section_15
================================================================================
-/

theorem close_canonical_internal_section_15
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {GammaSeq : Gamma_W_adjacent_growth_profile}
    {nuSeq : IncidentGrowth.IncidentGrowthExponentSequence}
    {sigmaSeq : IncidentGrowth.ProfileReadSequence}
    {GSeq : IncidentGrowth.MaxLinearProfileSequence}
    {Dcan : Type}
    {dcan : Dcan}
    {selection : CanonicalInternalSelectionRelation}
    {sectorLaw : CanonicalSectorLawFamily Dcan}
    {reducedCubicLaw : CanonicalReducedCubicLawFamily Dcan}
    (hB : IncidentGrowth.B_unif opening GammaSeq nuSeq sigmaSeq GSeq)
    (hMono : PrefixConflict.FG_mono C nSeq dSeq opening)
    (hAffine : AffineChamber.HI_aff C nSeq dSeq opening)
    (hSource :
      canonical_internal_source
        C nSeq dSeq opening GammaSeq nuSeq sigmaSeq GSeq
        dcan selection sectorLaw reducedCubicLaw) :
    canonical_internal_outputs
      dcan sectorLaw reducedCubicLaw := by
  have hContext :=
    build_canonical_internal_context hB hMono hAffine hSource
  have hSelected :=
    build_selected_canonical_datum hContext hSource
  have hSector :=
    build_sector_law_witnesses hSelected hSource
  have hReduced :=
    build_reduced_cubic_witnesses hSelected hSource
  have hDatum :=
    build_D_can_int hSelected hSector hReduced
  exact hDatum



