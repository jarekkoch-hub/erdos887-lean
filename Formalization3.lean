theorem build_A_sync
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hIdentity :
      SameKEndpointPolynomial.same_K_endpoint_polynomial_identity_data
        C nSeq dSeq opening)
    (hProduct :
      ProductRowExtraction.product_row_coefficient_data
        C nSeq dSeq opening)
    (hRatio : RatioCollapse.same_K_common_ratio_data C nSeq dSeq opening)
    (hCore : affine_pencil_ratio_core C nSeq dSeq opening)
    (hCoherence : same_k_affine_coherence C nSeq dSeq opening) :
    A_sync C nSeq dSeq opening := by
  have hIdentityState :
      SameKEndpointPolynomial.same_K_endpoint_polynomial_identity_data
        C nSeq dSeq opening :=
    hIdentity
  have hProductState :
      ProductRowExtraction.product_row_coefficient_data
        C nSeq dSeq opening :=
    hProduct
  have hRatioState :
      RatioCollapse.same_K_common_ratio_data C nSeq dSeq opening :=
    hRatio
  have hCoreState : affine_pencil_ratio_core C nSeq dSeq opening :=
    hCore
  have hCoherenceState : same_k_affine_coherence C nSeq dSeq opening :=
    hCoherence
  have hContext : synchronized_affine_context C nSeq dSeq opening :=
    hCore.1
  rcases hContext.2.2.2 with
    ⟨D, survivorData, affineData, polynomialData, productRowData,
      sourceData, hContextAt⟩
  have hCoreAt :
      affine_pencil_ratio_core_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hCore.2.2
      survivorData affineData polynomialData productRowData sourceData
      hContextAt
  have hCoherenceAt :
      same_k_affine_coherence_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    hCoherence.2.2.2.2
      survivorData affineData polynomialData productRowData sourceData
      hContextAt
  rcases hContextAt with ⟨hIdentityAt, hProductAt, hRatioAt⟩
  have hSyncAt :
      A_sync_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    ⟨hIdentityAt, hProductAt, hRatioAt, hCoreAt, hCoherenceAt⟩
  exact
    ⟨hIdentityState, hProductState, hRatioState, hCoreState,
      hCoherenceState,
      D, survivorData, affineData, polynomialData, productRowData,
      sourceData, hSyncAt⟩


