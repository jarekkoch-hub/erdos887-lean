/-
================================================================================
INTERNAL BOX LEMMA
Section 12.3, Sub-layer 02, Sub-box 02

A left-anchored weighted balance forces the right ratio to equal the left
ratio.  Both positive weights are retained in the paper-facing statement;
only the right weight is algebraically cancelled.
================================================================================
-/

theorem left_anchored_weighted_balance_forces_neighbor_equality
    {h h' tau tau' : ℚ}
    (hPositive : 0 < h)
    (hPrimePositive : 0 < h')
    (hBalance : h * tau + h' * tau' = (h + h') * tau) :
    tau' = tau := by
  have hNonzero : h ≠ 0 ∧ h' ≠ 0 :=
    ⟨ne_of_gt hPositive, ne_of_gt hPrimePositive⟩
  have hProduct : h' * (tau' - tau) = 0 := by
    calc
      h' * (tau' - tau) =
          h * tau + h' * tau' - (h + h') * tau := by
            ring
      _ = 0 := by
        rw [hBalance]
        ring
  have hDifference : tau' - tau = 0 :=
    (mul_eq_zero.mp hProduct).resolve_left hNonzero.2
  exact sub_eq_zero.mp hDifference

/-- The right adjacent ratio equals the left adjacent ratio on one pair. -/
def neighborRatioEquality
    {D : Type}
    (sourceData : SameKPrefixAverageFormulaSourceData D)
    (i : Fin 3) : Prop :=
  adjacentAffineRatio sourceData (adjacentPairRightAddress i) =
    adjacentAffineRatio sourceData (adjacentPairLeftAddress i)

