-/

/-
================================================================================
STATE-SHAPE BATCH
Section 8.4, Sub-layer 05, Sub-box 05

Incoming state shape:
  rank_source opening leadingData regimeData
  top_product_frame_data leadingData regimeData
  Section6.Legacy.legacy_S_0 C nSeq dSeq
    (openingTSeq opening)
    (openingBSeq opening)
    (openingZSeq opening)

Outgoing state shape:
  low_rank_coloring_datum
    C nSeq dSeq opening leadingData regimeData

Effect:
  On the rank-at-most-two branch, materializes the selected coloring, incident
  and endpoint inventory balances, exact two-direction coherence, descendant
  row applicability, lower-layer closure, and every top-product frame identity.

Public theorem:
  build_low_rank_coloring_datum
================================================================================
-/

theorem build_low_rank_coloring_datum
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {leadingData : LeadingDescendantExtractionData}
    {regimeData : RankRegimeSourceData}
    (hRank : rank_source opening leadingData regimeData)
    (hTop : top_product_frame_data leadingData regimeData)
    (hS0 :
      Section6.Legacy.legacy_S_0
        C nSeq dSeq
        (openingTSeq opening)
        (openingBSeq opening)
        (openingZSeq opening)) :
    low_rank_coloring_datum
      C nSeq dSeq opening leadingData regimeData := by
  intro hLow
  have hSource := hRank.2.2.2.2.2 hLow
  rcases hSource with
    ⟨hColor, hIncident, hNoThird,
      hNoLower, hApplicable, hFrameSource⟩
  exact
    ⟨hLow,
      hColor,
      hIncident,
      hIncident,
      hRank.1.1,
      hNoThird,
      hNoLower,
      hApplicable,
      hTop hLow,
      hS0⟩


