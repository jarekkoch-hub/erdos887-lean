  derive_logical_chamber_partition

================================================================================
-/

theorem derive_logical_chamber_partition
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hctx : chamberSequenceContext C nSeq dSeq) :
    DirCollapse C nSeq dSeq ∨
      GapEsc C nSeq dSeq ∨
      bounded_full_K5_branch C nSeq dSeq := by
  classical
  by_cases hactivity : directedQuotientActivity nSeq dSeq
  · by_cases hbounded : boundedEdgeGapChamber nSeq dSeq
    · exact Or.inr (Or.inr ⟨hctx, hactivity, hbounded⟩)
    · exact Or.inr (Or.inl ⟨hctx, hactivity, hbounded⟩)
  · exact Or.inl ⟨hctx, hactivity⟩

/--
Compatibility theorem for older callers.  This is only the same excluded-middle
partition; it is not the paper's chamber-entry source.
-/
theorem derive_chamber_entry_trichotomy
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    (hctx : chamberSequenceContext C nSeq dSeq) :
    DirCollapse C nSeq dSeq ∨
      GapEsc C nSeq dSeq ∨
      bounded_full_K5_branch C nSeq dSeq :=
  derive_logical_chamber_partition hctx

/-- Pointwise bounded full K5 chamber at the source-wide bound `M`. -/
def pointwiseBoundedFullK5Chamber
    (C : ℝ) (M n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  (∀ i j : Fin 5, i < j →
    pointwiseDirectedQuotientActivityAt C n d i j) ∧
  ∀ i j : Fin 5, i < j →
    1 ≤ directedEdgeGap n d i j ∧
      directedEdgeGap n d i j ≤ M

/--
The coherent external production ingress, kept inside Section 3 so every
analytic and chamber theorem can consume the exact same source type.

Semantic kind: retained production ancestry.
-/
def external_violation_sequence_state
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ) : Prop :=
  0 < C ∧
    natSequenceTendsToInfinity nSeq ∧
    (∀ m : ℕ,
      section_3_arithmetic_state C (nSeq m) (dSeq m)) ∧
    (∀ m : ℕ,
      paired_root_split C (nSeq m) (dSeq m)) ∧
    (∀ m : ℕ,
      full_atom_model (nSeq m) (dSeq m)) ∧
    (∀ m : ℕ,
      Edge_can (nSeq m) (dSeq m)) ∧
    (∀ m : ℕ,
      Load_can (nSeq m) (dSeq m)) ∧
    ∀ m : ℕ,
      pointwiseDirectedQuotientActivityAllEdges
        C (nSeq m) (dSeq m)

