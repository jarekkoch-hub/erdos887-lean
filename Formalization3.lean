def finite_prefix_conflict_low_rank_coherence
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (data : RegularColoringProblemData)
    (lowRankData : RankTrichotomy.LowRankSourceData) : Prop :=
  ∃ leadingData : RankTrichotomy.LeadingDescendantExtractionData,
    ∃ regimeData : RankTrichotomy.RankRegimeSourceData,
      RankTrichotomy.rank_source
          opening leadingData regimeData ∧
        RankTrichotomy.S_rank_components
            C nSeq dSeq opening leadingData regimeData ∧
          RankTrichotomy.low_rank_coloring_packet
              C nSeq dSeq opening leadingData regimeData ∧
            regularColoringChi data =
              RankTrichotomy.lowRankSelectedColoring
                (RankTrichotomy.lowRankSourceData regimeData) ∧
              lowRankData =
                RankTrichotomy.lowRankSourceData regimeData

