/-
================================================================================
THEOREM-SOURCE PAYLOAD COMPARTMENT
Section 9 finite prefix certificate

The finite prefix certificate is a retained source port attached to the exact
low-rank coloring opened from `S_rank`.  Its twelve branch addresses are the
fixed undirected Hamiltonian-cycle inventory of K5.  For a branch whose cycle
coloring agrees with the selected coloring, the source supplies one projective
conflict row.  The source supplies row data, not a contradiction theorem.

The direction type and projective relations are existentially sealed by the
source.  No custom structure or record is introduced.
================================================================================
-/

/-- The twelve undirected Hamiltonian five-cycle addresses of the fixed K5. -/
abbrev PrefixCycleAddress := Fin 12

/-- Same-line relation carried by one projective prefix source. -/
abbrev PrefixSameLineRelation (D : Type) :=
  D → D → Prop

/-- `positiveCone X Y Z` means that `Z` lies in the positive cone of `X,Y`. -/
abbrev PrefixPositiveConeRelation (D : Type) :=
  D → D → D → Prop

/-- The three projective directions attached to every cycle-addressed row. -/
abbrev PrefixCertificateDirectionFamily (D : Type) :=
  PrefixCycleAddress → Fin 3 → D

/-- The conflict edge attached to every cycle-addressed row. -/
abbrev PrefixCertificateConflictEdgeFamily :=
  PrefixCycleAddress → Section6.K5EdgeAddress

/-- The two adjacent-gap addresses attached to every cycle-addressed row. -/
abbrev PrefixCertificateGapFamily :=
  PrefixCycleAddress → Fin 2 → Section6.AdjacentGapAddress

/--
The raw finite prefix-certificate payload.

The entries are, in order, the same-line relation, the positive-cone relation,
the three row directions, the conflict-edge family, and the two gap witnesses.
-/
abbrev FinitePrefixCertificateSourceData (D : Type) :=
  PrefixSameLineRelation D ×
    (PrefixPositiveConeRelation D ×
      (PrefixCertificateDirectionFamily D ×
        (PrefixCertificateConflictEdgeFamily ×
          PrefixCertificateGapFamily)))

/-- The same-line projection of the source payload. -/
def prefixCertificateSameLine
    {D : Type}
    (data : FinitePrefixCertificateSourceData D) :
    PrefixSameLineRelation D :=
  data.1

/-- The positive-cone projection of the source payload. -/
def prefixCertificatePositiveCone
    {D : Type}
    (data : FinitePrefixCertificateSourceData D) :
    PrefixPositiveConeRelation D :=
  data.2.1

/-- The three-direction row projection. -/
def prefixCertificateDirection
    {D : Type}
    (data : FinitePrefixCertificateSourceData D) :
    PrefixCertificateDirectionFamily D :=
  data.2.2.1

/-- The conflict-edge row projection. -/
def prefixCertificateConflictEdge
    {D : Type}
    (data : FinitePrefixCertificateSourceData D) :
    PrefixCertificateConflictEdgeFamily :=
  data.2.2.2.1

/-- The adjacent-gap witness projection. -/
def prefixCertificateGap
    {D : Type}
    (data : FinitePrefixCertificateSourceData D) :
    PrefixCertificateGapFamily :=
  data.2.2.2.2

/-- The left adjacent-gap direction `X`. -/
def prefixCertificateX
    {D : Type}
    (data : FinitePrefixCertificateSourceData D)
    (C : PrefixCycleAddress) : D :=
  prefixCertificateDirection data C 0

/-- The right adjacent-gap direction `Y`. -/
def prefixCertificateY
    {D : Type}
    (data : FinitePrefixCertificateSourceData D)
    (C : PrefixCycleAddress) : D :=
  prefixCertificateDirection data C 1

/-- The interval-sector direction `Z`. -/
def prefixCertificateZ
    {D : Type}
    (data : FinitePrefixCertificateSourceData D)
    (C : PrefixCycleAddress) : D :=
  prefixCertificateDirection data C 2

/-- The left adjacent-gap witness. -/
def prefixCertificateLeftGap
    {D : Type}
    (data : FinitePrefixCertificateSourceData D)
    (C : PrefixCycleAddress) : Section6.AdjacentGapAddress :=
  prefixCertificateGap data C 0

/-- The right adjacent-gap witness. -/
def prefixCertificateRightGap
    {D : Type}
    (data : FinitePrefixCertificateSourceData D)
    (C : PrefixCycleAddress) : Section6.AdjacentGapAddress :=
  prefixCertificateGap data C 1

/--
The twelve true-edge Hamiltonian-cycle colorings in the fixed Section 6 edge
order `01,02,03,04,12,13,14,23,24,34`.
-/
def prefixHamiltonianCycleColoring :
    PrefixCycleAddress → Section6.BooleanEdgeIndicator :=
  ![
    ![true,  false, false, true,  true,  false, false, true,  false, true],
    ![true,  false, true,  false, true,  false, false, false, true,  true],
    ![true,  false, false, true,  false, true,  false, true,  true,  false],
    ![true,  true,  false, false, false, true,  false, false, true,  true],
    ![true,  false, true,  false, false, false, true,  true,  true,  false],
    ![true,  true,  false, false, false, false, true,  true,  false, true],
    ![false, true,  false, true,  true,  true,  false, false, false, true],
    ![false, true,  true,  false, true,  false, true,  false, false, true],
    ![false, true,  false, true,  false, true,  true,  true,  false, false],
    ![false, true,  true,  false, false, true,  true,  false, true,  false],
    ![false, false, true,  true,  true,  true,  false, false, true,  false],
    ![false, false, true,  true,  true,  false, true,  true,  false, false]
  ]

/-- A cycle address is compatible with the exact selected coloring. -/
def prefixCycleCompatible
    (chi : Section6.BooleanEdgeIndicator)
    (C : PrefixCycleAddress) : Prop :=
  ∀ e : Section6.K5EdgeAddress,
    chi e = prefixHamiltonianCycleColoring C e

/-- The retained endpoint-exclusion law of the abstract projective model. -/
def prefix_projective_cone_model_source
    {D : Type}
    (data : FinitePrefixCertificateSourceData D) : Prop :=
  ∀ X Y Z : D,
    ¬ prefixCertificateSameLine data X Y →
      prefixCertificatePositiveCone data X Y Z →
        ¬ prefixCertificateSameLine data Z X ∧
          ¬ prefixCertificateSameLine data Z Y

/--
The branch-indexed raw row laws supplied by the finite certificate.

The laws are required only when the selected coloring agrees with the fixed
cycle coloring at the row address.  The interval witnesses are tied to the
same fixed Section 6 edge address.  The lower-layer closure field is supplied
later from the exact low-rank packet opened in the contract box.
-/
def prefix_certificate_row_source
    {D : Type}
    (chi : Section6.BooleanEdgeIndicator)
    (data : FinitePrefixCertificateSourceData D) : Prop :=
  ∀ C : PrefixCycleAddress,
    prefixCycleCompatible chi C →
      ¬ prefixCertificateSameLine data
          (prefixCertificateX data C)
          (prefixCertificateY data C) ∧
        prefixCertificatePositiveCone data
          (prefixCertificateX data C)
          (prefixCertificateY data C)
          (prefixCertificateZ data C) ∧
        (prefixCertificateSameLine data
            (prefixCertificateZ data C)
            (prefixCertificateX data C) ∨
          prefixCertificateSameLine data
            (prefixCertificateZ data C)
            (prefixCertificateY data C)) ∧
        prefixCertificateLeftGap data C ≠
          prefixCertificateRightGap data C ∧
        RankTrichotomy.adjacentGapLiesInEdge
          (prefixCertificateConflictEdge data C)
          (prefixCertificateLeftGap data C) ∧
        RankTrichotomy.adjacentGapLiesInEdge
          (prefixCertificateConflictEdge data C)
          (prefixCertificateRightGap data C)

/-- The complete certificate payload attached to one selected coloring. -/
def finite_prefix_certificate_at
    {D : Type}
    (chi : Section6.BooleanEdgeIndicator)
    (data : FinitePrefixCertificateSourceData D) : Prop :=
  prefix_projective_cone_model_source data ∧
    prefix_certificate_row_source chi data

/--
The Section 9 theorem-source port.

For the exact source selection sealed by `S_rank`, this port certifies that the
active route is the rank-at-most-two selected-coloring route and opens one
finite branch-to-conflict payload attached to that exact coloring.  The port
contains no terminal contradiction map.
-/
def finite_prefix_certificate
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∀ leadingData : RankTrichotomy.LeadingDescendantExtractionData,
    ∀ regimeData : RankTrichotomy.RankRegimeSourceData,
      RankTrichotomy.rank_source
          opening leadingData regimeData →
        RankTrichotomy.low_rank_coloring_packet
            C nSeq dSeq opening leadingData regimeData →
          ∃ D : Type,
            ∃ certificateData : FinitePrefixCertificateSourceData D,
              finite_prefix_certificate_at
                (RankTrichotomy.lowRankSelectedColoring
                  (RankTrichotomy.lowRankSourceData regimeData))
                certificateData

/-
================================================================================
BOUNDARY INPUT SIGNATURE
Section 9

The section starts from the exact low-rank route split from the Section 8
output.  The finite prefix source is indexed by that already-selected route and
does not choose a branch from forked `S_rank`.  The direct
`S_0` wire retains the exact endpoint-address system.  The certificate is a
separate theorem-source port and is not a component of `O_can`.
================================================================================
-/

def section_9_input_frontier
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  RankTrichotomy.low_rank_route C nSeq dSeq opening ∧
    Section6.Legacy.legacy_S_0
      C nSeq dSeq
      (openingTSeq opening)
      (openingBSeq opening)
      (openingZSeq opening) ∧
    finite_prefix_certificate C nSeq dSeq opening

/-
================================================================================
EXECUTABLE BOX
Section 9, Sub-layer 00, Sub-box 00
Birth token: prefix_layer_context

This box opens the exact source witnesses sealed by the low-rank route and
reads the already-materialized rank-at-most-two selected-coloring packet.
and retains the direct Section 6 endpoint-address state.  The exact leading
source remains present, so the frozen coefficient pattern and its canonical
coherence are available to Section 9.2 without reselection.

The rank-three affine handoff is neither consumed nor contradicted.  No affine
identity, product-row extraction, ratio collapse, or terminal endpoint algebra
is introduced.
================================================================================
-/

/--
The synchronized low-rank prefix-layer context.

The context keeps the exact Section 8 source selection, the exact low-rank
packet, the direct endpoint-address state, and the selected finite certificate
payload.  All later Section 9 boxes open these same witnesses.
-/
def prefix_layer_context
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∃ leadingData : RankTrichotomy.LeadingDescendantExtractionData,
    ∃ regimeData : RankTrichotomy.RankRegimeSourceData,
      RankTrichotomy.rank_source
          opening leadingData regimeData ∧
        RankTrichotomy.S_rank_components
            C nSeq dSeq opening leadingData regimeData ∧
          RankTrichotomy.low_rank_coloring_packet
              C nSeq dSeq opening leadingData regimeData ∧
            Section6.Legacy.legacy_S_0
              C nSeq dSeq
              (openingTSeq opening)
              (openingBSeq opening)
              (openingZSeq opening) ∧
              ∃ D : Type,
                ∃ certificateData : FinitePrefixCertificateSourceData D,
                  finite_prefix_certificate_at
                    (RankTrichotomy.lowRankSelectedColoring
                      (RankTrichotomy.lowRankSourceData regimeData))
                    certificateData

/-
================================================================================
INTERNAL BOX LEMMA
Section 9, Sub-layer 00, Sub-box 00

A rank-at-most-two read of the exact forked components selects the low-rank
packet.  The rank-three alternative is arithmetically incompatible with the
same retained rank bound.
================================================================================
-/

theorem low_rank_coloring_packet_of_rank_components
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {leadingData : RankTrichotomy.LeadingDescendantExtractionData}
    {regimeData : RankTrichotomy.RankRegimeSourceData}
    (hComponents :
      RankTrichotomy.S_rank_components
        C nSeq dSeq opening leadingData regimeData)
    (hRankLow :
      RankTrichotomy.leadingDescendantRank leadingData ≤ 2) :
    RankTrichotomy.low_rank_coloring_packet
      C nSeq dSeq opening leadingData regimeData := by
  rcases hComponents.2.1 with hThree | hLow
  · exfalso
    nlinarith [hRankLow, hThree.1]
  · exact hLow.2

/-
================================================================================
STATE-SHAPE BATCH
Section 9, Sub-layer 00, Sub-box 00

Incoming state shape:
  RankTrichotomy.low_rank_route C nSeq dSeq opening
  Section6.Legacy.legacy_S_0
    C nSeq dSeq
    (openingTSeq opening)
    (openingBSeq opening)
    (openingZSeq opening)
  finite_prefix_certificate C nSeq dSeq opening

Outgoing state shape:
  prefix_layer_context C nSeq dSeq opening

Effect:
  Opens the exact `leadingData`, `regimeData`, and low-rank coloring packet
  already sealed by the Section 8 branch split, retains
  the direct fixed endpoint-address state, and opens the finite projective row
  payload over the same selected coloring.  The exact rank source remains
  retained, including the frozen coefficient pattern and endpoint-interval
  extraction provenance.  The rank-three route remains outside this context.

Public theorem:
  build_prefix_layer_context
================================================================================
-/

theorem build_prefix_layer_context
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hLowRoute :
      RankTrichotomy.low_rank_route C nSeq dSeq opening)
    (hS0 :
      Section6.Legacy.legacy_S_0
        C nSeq dSeq
        (openingTSeq opening)
        (openingBSeq opening)
        (openingZSeq opening))
    (hCertificate :
      finite_prefix_certificate C nSeq dSeq opening) :
    prefix_layer_context C nSeq dSeq opening := by
  rcases hLowRoute with
    ⟨leadingData, regimeData, hRankSource, hComponents, hLowPacket⟩
  rcases
      hCertificate leadingData regimeData hRankSource hLowPacket with
    ⟨directionType, certificateData, hCertificateAt⟩
  exact
    ⟨leadingData, regimeData,
      hRankSource, hComponents, hLowPacket, hS0,
      directionType, certificateData, hCertificateAt⟩

/- ## Sub-container 9.1: Regular coloring alternatives. -/

/- Sub-layer 01 -/
/-
Paper ref: 9.1
Sub-box Label: `Regular endpoint coloring problem: coloring chi: E_K5 -> {0,1} with incident multiset balance per no-repetition frame, endpoint inventory balance (common true-edge degree d_chi), over the fixed K5 edge-reference system`
Sub-inputs: `prefix_layer_context`, `S_rank`, `S_0`
Sub-outputs: `regular_coloring_problem`
Note: The low-rank incident/inventory balances are read at the prefix layer as a regular K5 coloring problem. The edge-reference system is the fixed one from the endpoint-address section S_0; no new edge system is chosen.
-/
def prefix_conflict_section_9_1_sub_layer_01_sub_box_01_label : String := "Regular endpoint coloring problem: coloring chi: E_K5 -> {0,1} with incident multiset balance per no-repetition frame, endpoint inventory balance (common true-edge degree d_chi), over the fixed K5 edge-reference system"
def prefix_conflict_section_9_1_sub_layer_01_sub_box_01_inputs : List String := ["prefix_layer_context [read]", "S_rank [construction]", "S_0 [construction]"]
def prefix_conflict_section_9_1_sub_layer_01_sub_box_01_outputs : List String := ["regular_coloring_problem [birth]"]
/-
================================================================================
EXECUTABLE BOX
Section 9.1, Sub-layer 01, Sub-box 01
Birth token: regular_coloring_problem

The selected coloring is read from the exact low-rank source witnesses already
opened by `prefix_layer_context`.  The direct `S_rank` and `S_0` wires remain
visible.  Incident multiset balance is converted into one common endpoint
degree on the same fixed K5 edge-reference system.

No new coloring, edge table, cycle branch, prefix certificate row, affine
object, or terminal equation is introduced.
================================================================================
-/

/-- The selected coloring and its common true-edge degree. -/
abbrev RegularColoringProblemData :=
  Section6.BooleanEdgeIndicator × ℕ

/-- The selected coloring projection. -/
def regularColoringChi
    (data : RegularColoringProblemData) :
    Section6.BooleanEdgeIndicator :=
  data.1

/-- The common endpoint degree projection `d_chi`. -/
def regularColoringCommonDegree
    (data : RegularColoringProblemData) : ℕ :=
  data.2

/--
The paper-grain regular coloring packet over one selected coloring.

The inventory condition is retained in its source form and is also read as one
common endpoint degree.  The fixed edge-reference packet is the Section 6
packet, not a newly chosen graph.
-/
def regular_coloring_problem_at
    (data : RegularColoringProblemData) : Prop :=
  RankTrichotomy.lowRankIncidentMultisetBalance
      (regularColoringChi data) ∧
    RankTrichotomy.lowRankEndpointInventoryBalance
      (regularColoringChi data) ∧
    (∀ v : Section6.EndpointAddress,
      Section6.booleanVertexDegree
          (regularColoringChi data) v =
        regularColoringCommonDegree data) ∧
    Section6.edge_references

/--
The exact Section 8 source selection from which one regular coloring datum is
read.  This is a coherence predicate, not a second choice of coloring.
-/
def regular_coloring_source_coherence
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (data : RegularColoringProblemData) : Prop :=
  ∃ leadingData : RankTrichotomy.LeadingDescendantExtractionData,
    ∃ regimeData : RankTrichotomy.RankRegimeSourceData,
      RankTrichotomy.rank_source
          opening leadingData regimeData ∧
        RankTrichotomy.S_rank_components
            C nSeq dSeq opening leadingData regimeData ∧
          RankTrichotomy.low_rank_coloring_packet
              C nSeq dSeq opening leadingData regimeData ∧
            regularColoringChi data =
              RankTrichotomy.lowRankSelectedColoring
                (RankTrichotomy.lowRankSourceData regimeData) ∧
              regularColoringCommonDegree data =
                Section6.booleanVertexDegree
                  (RankTrichotomy.lowRankSelectedColoring
                    (RankTrichotomy.lowRankSourceData regimeData)) 0 ∧
                Section6.Legacy.legacy_S_0
                  C nSeq dSeq
                  (openingTSeq opening)
                  (openingBSeq opening)
                  (openingZSeq opening)

/--
Incident multiset balance gives equal full endpoint inventories.

For each endpoint `v`, compare endpoint `0` with `v` on the incident frame
whose remaining three vertices are the complement of `{0,v}`.  The shared edge
is then added to the equal three-edge sums.
-/
theorem incident_multiset_balance_common_degree
    (chi : Section6.BooleanEdgeIndicator)
    (hBalance :
      RankTrichotomy.lowRankIncidentMultisetBalance chi) :
    ∀ v : Section6.EndpointAddress,
      Section6.booleanVertexDegree chi v =
        Section6.booleanVertexDegree chi 0 := by
  intro v
  fin_cases v
  · rfl
  · have hPermutation :=
      hBalance 0 1 2 3 4 (by decide)
    have hTriple :=
      Section6.boolean_three_term_sum_permutation
        hPermutation
    change
      Section6.booleanIndicatorValue (chi 1) +
          Section6.booleanIndicatorValue (chi 2) +
          Section6.booleanIndicatorValue (chi 3) =
        Section6.booleanIndicatorValue (chi 4) +
          Section6.booleanIndicatorValue (chi 5) +
          Section6.booleanIndicatorValue (chi 6) at hTriple
    change
      Section6.booleanIndicatorValue (chi 0) +
          Section6.booleanIndicatorValue (chi 4) +
          Section6.booleanIndicatorValue (chi 5) +
          Section6.booleanIndicatorValue (chi 6) =
        Section6.booleanIndicatorValue (chi 0) +
          Section6.booleanIndicatorValue (chi 1) +
          Section6.booleanIndicatorValue (chi 2) +
          Section6.booleanIndicatorValue (chi 3)
    nlinarith
  · have hPermutation :=
      hBalance 0 2 1 3 4 (by decide)
    have hTriple :=
      Section6.boolean_three_term_sum_permutation
        hPermutation
    change
      Section6.booleanIndicatorValue (chi 0) +
          Section6.booleanIndicatorValue (chi 2) +
          Section6.booleanIndicatorValue (chi 3) =
        Section6.booleanIndicatorValue (chi 4) +
          Section6.booleanIndicatorValue (chi 7) +
          Section6.booleanIndicatorValue (chi 8) at hTriple
    change
      Section6.booleanIndicatorValue (chi 1) +
          Section6.booleanIndicatorValue (chi 4) +
          Section6.booleanIndicatorValue (chi 7) +
          Section6.booleanIndicatorValue (chi 8) =
        Section6.booleanIndicatorValue (chi 0) +
          Section6.booleanIndicatorValue (chi 1) +
          Section6.booleanIndicatorValue (chi 2) +
          Section6.booleanIndicatorValue (chi 3)
    nlinarith
  · have hPermutation :=
      hBalance 0 3 1 2 4 (by decide)
    have hTriple :=
      Section6.boolean_three_term_sum_permutation
        hPermutation
    change
      Section6.booleanIndicatorValue (chi 0) +
          Section6.booleanIndicatorValue (chi 1) +
          Section6.booleanIndicatorValue (chi 3) =
        Section6.booleanIndicatorValue (chi 5) +
          Section6.booleanIndicatorValue (chi 7) +
          Section6.booleanIndicatorValue (chi 9) at hTriple
    change
      Section6.booleanIndicatorValue (chi 2) +
          Section6.booleanIndicatorValue (chi 5) +
          Section6.booleanIndicatorValue (chi 7) +
          Section6.booleanIndicatorValue (chi 9) =
        Section6.booleanIndicatorValue (chi 0) +
          Section6.booleanIndicatorValue (chi 1) +
          Section6.booleanIndicatorValue (chi 2) +
          Section6.booleanIndicatorValue (chi 3)
    nlinarith
  · have hPermutation :=
      hBalance 0 4 1 2 3 (by decide)
    have hTriple :=
      Section6.boolean_three_term_sum_permutation
        hPermutation
    change
      Section6.booleanIndicatorValue (chi 0) +
          Section6.booleanIndicatorValue (chi 1) +
          Section6.booleanIndicatorValue (chi 2) =
        Section6.booleanIndicatorValue (chi 6) +
          Section6.booleanIndicatorValue (chi 8) +
          Section6.booleanIndicatorValue (chi 9) at hTriple
    change
      Section6.booleanIndicatorValue (chi 3) +
          Section6.booleanIndicatorValue (chi 6) +
          Section6.booleanIndicatorValue (chi 8) +
          Section6.booleanIndicatorValue (chi 9) =
        Section6.booleanIndicatorValue (chi 0) +
          Section6.booleanIndicatorValue (chi 1) +
          Section6.booleanIndicatorValue (chi 2) +
          Section6.booleanIndicatorValue (chi 3)
    nlinarith

/-- The Section 9.1 regular-coloring output over the selected low-rank route. -/
def regular_coloring_problem
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  RankTrichotomy.S_rank C nSeq dSeq opening ∧
    ∃ data : RegularColoringProblemData,
      regular_coloring_source_coherence
          C nSeq dSeq opening data ∧
        regular_coloring_problem_at data

/-
================================================================================
STATE-SHAPE BATCH
Section 9.1, Sub-layer 01, Sub-box 01

Incoming state shape:
  prefix_layer_context C nSeq dSeq opening
  RankTrichotomy.S_rank C nSeq dSeq opening
  Section6.Legacy.legacy_S_0
    C nSeq dSeq
    (openingTSeq opening)
    (openingBSeq opening)
    (openingZSeq opening)

Outgoing state shape:
  regular_coloring_problem C nSeq dSeq opening

Effect:
  Reads the exact selected low-rank coloring from the context witnesses,
  derives its common endpoint degree from incident multiset balance, and
  retains the same Section 8 rank state and Section 6 edge-reference system.
  No branch family or monochrome choice is made.

Public theorem:
  build_regular_coloring_problem
================================================================================
-/

theorem build_regular_coloring_problem
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hContext :
      prefix_layer_context C nSeq dSeq opening)
    (hRank :
      RankTrichotomy.S_rank C nSeq dSeq opening)
    (hS0 :
      Section6.Legacy.legacy_S_0
        C nSeq dSeq
        (openingTSeq opening)
        (openingBSeq opening)
        (openingZSeq opening)) :
    regular_coloring_problem C nSeq dSeq opening := by
  rcases hContext with
    ⟨leadingData, regimeData,
      hRankSource, hComponents, hLowPacket,
      _hContextS0, directionType, certificateData,
      _hCertificateAt⟩

  let selectedChi : Section6.BooleanEdgeIndicator :=
    RankTrichotomy.lowRankSelectedColoring
      (RankTrichotomy.lowRankSourceData regimeData)

  let data : RegularColoringProblemData :=
    (selectedChi,
      Section6.booleanVertexDegree selectedChi 0)

  have hIncident :
      RankTrichotomy.lowRankIncidentMultisetBalance
        selectedChi := by
    simpa [selectedChi] using hLowPacket.2.2.1

  have hInventory :
      RankTrichotomy.lowRankEndpointInventoryBalance
        selectedChi := by
    simpa [selectedChi] using hLowPacket.2.2.2.1

  have hCommon :
      ∀ v : Section6.EndpointAddress,
        Section6.booleanVertexDegree selectedChi v =
          Section6.booleanVertexDegree selectedChi 0 :=
    incident_multiset_balance_common_degree
      selectedChi hIncident

  have hReferences : Section6.edge_references :=
    hS0.2.2.2.1

  have hSource :
      regular_coloring_source_coherence
        C nSeq dSeq opening data := by
    refine
      ⟨leadingData, regimeData,
        hRankSource, hComponents, hLowPacket, ?_, ?_, hS0⟩
    · rfl
    · rfl

  have hRegularAt :
      regular_coloring_problem_at data := by
    dsimp
      [regular_coloring_problem_at,
        regularColoringChi,
        regularColoringCommonDegree,
        data]
    exact
      ⟨hIncident, hInventory, hCommon, hReferences⟩

  exact ⟨hRank, data, hSource, hRegularAt⟩


/- Sub-layer 02 -/
/-
Paper ref: 9.1
Sub-box Label: `Monochrome and degree-two branches: monochrome (all ten edges one color) vs compatible degree-two branch (true edges a Hamiltonian 5-cycle, false edges the complementary 5-cycle); finite family C_2(chi) via the finite K5 degree-two classifier; twelve undirected Hamiltonian 5-cycles give a finite certificate domain`
Sub-inputs: `regular_coloring_problem`
Sub-outputs: `degree_two_branch_family`
Note: C_2(chi) here is the degree-two coloring branch family, distinct from the external two-face off-profile product C_2(W). The compatible degree-two alternatives form a finite branch list indexed by the twelve Hamiltonian 5-cycles.
-/
def prefix_conflict_section_9_1_sub_layer_02_sub_box_02_label : String := "Monochrome and degree-two branches: monochrome (all ten edges one color) vs compatible degree-two branch (true edges a Hamiltonian 5-cycle, false edges the complementary 5-cycle); finite family C_2(chi) via the finite K5 degree-two classifier; twelve undirected Hamiltonian 5-cycles give a finite certificate domain"
def prefix_conflict_section_9_1_sub_layer_02_sub_box_02_inputs : List String := ["regular_coloring_problem [construction]"]
def prefix_conflict_section_9_1_sub_layer_02_sub_box_02_outputs : List String := ["degree_two_branch_family [birth]"]
/-
================================================================================
EXECUTABLE BOX
Section 9.1, Sub-layer 02, Sub-box 02
Birth token: degree_two_branch_family

The compatible degree-two domain is the fixed twelve-address Hamiltonian-cycle
inventory already used by the finite prefix certificate.  The selected
coloring is not replaced.  A branch is compatible only when it is the exact
cycle coloring at its address, has true degree two, and its false complement is
the complementary Hamiltonian cycle.

This box constructs the finite branch family and its classifier.  It does not
select an active branch and does not apply any prefix conflict row.
================================================================================
-/

/-- A monochrome branch records the selected constant Boolean color. -/
def prefix_monochrome_branch
    (chi : Section6.BooleanEdgeIndicator) : Prop :=
  ∃ color : Bool,
    ∀ e : Section6.K5EdgeAddress,
      chi e = color

/-- The complementary Hamiltonian-cycle address in the fixed twelve-row table. -/
def prefixHamiltonianComplementAddress :
    PrefixCycleAddress → PrefixCycleAddress :=
  ![9, 8, 7, 11, 6, 10, 4, 2, 1, 0, 5, 3]

/-- Every row of the fixed cycle table has true degree two. -/
theorem prefix_hamiltonian_cycle_degree_two
    (C : PrefixCycleAddress)
    (v : Section6.EndpointAddress) :
    Section6.booleanVertexDegree
        (prefixHamiltonianCycleColoring C) v = 2 := by
  fin_cases C <;> fin_cases v <;> rfl

/-- The Boolean complement of every cycle row is its fixed complementary row. -/
theorem prefix_hamiltonian_cycle_complement
    (C : PrefixCycleAddress)
    (e : Section6.K5EdgeAddress) :
    Section6.booleanIndicatorComplement
        (prefixHamiltonianCycleColoring C) e =
      prefixHamiltonianCycleColoring
        (prefixHamiltonianComplementAddress C) e := by
  fin_cases C <;> fin_cases e <;> rfl

/--
A compatible degree-two branch over the selected coloring.

The first field ties the branch to one exact address in the twelve-row table.
The second reads the true-color degree-two condition.  The third records that
the false edges are the complementary Hamiltonian cycle.
-/
def compatible_degree_two_branch
    (chi : Section6.BooleanEdgeIndicator)
    (C : PrefixCycleAddress) : Prop :=
  prefixCycleCompatible chi C ∧
    (∀ v : Section6.EndpointAddress,
      Section6.booleanVertexDegree chi v = 2) ∧
    prefixCycleCompatible
      (Section6.booleanIndicatorComplement chi)
      (prefixHamiltonianComplementAddress C)

/-- Every exact cycle-table match is a compatible degree-two branch. -/
theorem compatible_degree_two_branch_of_cycle
    (chi : Section6.BooleanEdgeIndicator)
    (C : PrefixCycleAddress)
    (hCompatible : prefixCycleCompatible chi C) :
    compatible_degree_two_branch chi C := by
  have hChi :
      chi = prefixHamiltonianCycleColoring C :=
    funext hCompatible

  refine ⟨hCompatible, ?_, ?_⟩
  · intro v
    rw [hChi]
    exact prefix_hamiltonian_cycle_degree_two C v
  · intro e
    unfold Section6.booleanIndicatorComplement
    rw [hCompatible e]
    exact prefix_hamiltonian_cycle_complement C e

/--
The deterministic cycle-row address read from one fixed ten-edge coloring.

This is not a new branch choice.  It is the finite read map from the exact
selected coloring to the already-fixed twelve-row certificate inventory.  Only
the twelve degree-two assignments are used by the classifier theorem below;
the default row is unreachable after the five retained degree equations have
constricted the state space.
-/
def prefixCycleClassifierAddress
    (chi : Section6.BooleanEdgeIndicator) :
    PrefixCycleAddress :=
  match
      chi 0, chi 1, chi 2, chi 3, chi 4,
      chi 5, chi 6, chi 7, chi 8, chi 9 with
  | true,  false, false, true,  true,
      false, false, true,  false, true  => 0
  | true,  false, true,  false, true,
      false, false, false, true,  true  => 1
  | true,  false, false, true,  false,
      true,  false, true,  true,  false => 2
  | true,  true,  false, false, false,
      true,  false, false, true,  true  => 3
  | true,  false, true,  false, false,
      false, true,  true,  true,  false => 4
  | true,  true,  false, false, false,
      false, true,  true,  false, true  => 5
  | false, true,  false, true,  true,
      true,  false, false, false, true  => 6
  | false, true,  true,  false, true,
      false, true,  false, false, true  => 7
  | false, true,  false, true,  false,
      true,  true,  true,  false, false => 8
  | false, true,  true,  false, false,
      true,  true,  false, true,  false => 9
  | false, false, true,  true,  true,
      true,  false, false, true,  false => 10
  | false, false, true,  true,  true,
      false, true,  true,  false, false => 11
  | _, _, _, _, _, _, _, _, _, _ => 0

/--
Finite completeness of the twelve Hamiltonian-cycle rows inside one exact
regular-coloring batch.

The classifier does not accept an arbitrary detached Boolean coloring.  It
consumes the selected `RegularColoringProblemData`, the complete
`regular_coloring_problem_at` state already established for that datum, and the
branch condition that its retained common degree is two.

The five retained degree equations first constrict the ten-edge Boolean state
space to the twelve legal assignments.  Only after that constriction does
`prefixCycleClassifierAddress` read the matching address in the fixed
certificate inventory.
-/
theorem finite_degree_two_k5_classifier
    (data : RegularColoringProblemData)
    (hRegular :
      regular_coloring_problem_at data)
    (hCommonDegreeTwo :
      regularColoringCommonDegree data = 2) :
    ∃ C : PrefixCycleAddress,
      prefixCycleCompatible
        (regularColoringChi data) C := by
  have hDegree :
      ∀ v : Section6.EndpointAddress,
        Section6.booleanVertexDegree
            (regularColoringChi data) v = 2 := by
    intro v
    rw [hRegular.2.2.1 v, hCommonDegreeTwo]

  let chi : Section6.BooleanEdgeIndicator :=
    regularColoringChi data

  have h0 := hDegree 0
  have h1 := hDegree 1
  have h2 := hDegree 2
  have h3 := hDegree 3
  have h4 := hDegree 4

  change
    Section6.booleanIndicatorValue (chi 0) +
        Section6.booleanIndicatorValue (chi 1) +
        Section6.booleanIndicatorValue (chi 2) +
        Section6.booleanIndicatorValue (chi 3) = 2 at h0
  change
    Section6.booleanIndicatorValue (chi 0) +
        Section6.booleanIndicatorValue (chi 4) +
        Section6.booleanIndicatorValue (chi 5) +
        Section6.booleanIndicatorValue (chi 6) = 2 at h1
  change
    Section6.booleanIndicatorValue (chi 1) +
        Section6.booleanIndicatorValue (chi 4) +
        Section6.booleanIndicatorValue (chi 7) +
        Section6.booleanIndicatorValue (chi 8) = 2 at h2
  change
    Section6.booleanIndicatorValue (chi 2) +
        Section6.booleanIndicatorValue (chi 5) +
        Section6.booleanIndicatorValue (chi 7) +
        Section6.booleanIndicatorValue (chi 9) = 2 at h3
  change
    Section6.booleanIndicatorValue (chi 3) +
        Section6.booleanIndicatorValue (chi 6) +
        Section6.booleanIndicatorValue (chi 8) +
        Section6.booleanIndicatorValue (chi 9) = 2 at h4

  cases hE0 : chi 0 <;>
  cases hE1 : chi 1 <;>
  cases hE2 : chi 2 <;>
  cases hE3 : chi 3 <;>
  cases hE4 : chi 4 <;>
  cases hE5 : chi 5 <;>
  cases hE6 : chi 6 <;>
  cases hE7 : chi 7 <;>
  cases hE8 : chi 8 <;>
  cases hE9 : chi 9

  all_goals
    simp [Section6.booleanIndicatorValue,
      hE0, hE1, hE2, hE3] at h0
  all_goals
    simp [Section6.booleanIndicatorValue,
      hE0, hE4, hE5, hE6] at h1
  all_goals
    simp [Section6.booleanIndicatorValue,
      hE1, hE4, hE7, hE8] at h2
  all_goals
    simp [Section6.booleanIndicatorValue,
      hE2, hE5, hE7, hE9] at h3
  all_goals
    simp [Section6.booleanIndicatorValue,
      hE3, hE6, hE8, hE9] at h4

  all_goals
    refine ⟨prefixCycleClassifierAddress chi, ?_⟩
    intro e
    fin_cases e <;>
      simp [chi, prefixCycleClassifierAddress,
        prefixHamiltonianCycleColoring,
        hE0, hE1, hE2, hE3, hE4,
        hE5, hE6, hE7, hE8, hE9]

/-- The exact finite degree-two family attached to one regular coloring datum. -/
def degree_two_branch_family_at
    (data : RegularColoringProblemData) : Prop :=
  (∀ C : PrefixCycleAddress,
    compatible_degree_two_branch
        (regularColoringChi data) C ↔
      prefixCycleCompatible
        (regularColoringChi data) C) ∧
    (regularColoringCommonDegree data = 2 →
      ∃ C : PrefixCycleAddress,
        compatible_degree_two_branch
          (regularColoringChi data) C)

/--
The twelve-row family is exact and complete inside the already-built regular
coloring batch.  The `hRegular` input is the state-space gate: it fixes the
selected coloring, its common-degree read, both retained balance conditions,
and the Section 6 edge-reference system before the finite classifier runs.
-/
theorem build_degree_two_branch_family_at
    (data : RegularColoringProblemData)
    (hRegular :
      regular_coloring_problem_at data) :
    degree_two_branch_family_at data := by
  constructor
  · intro C
    constructor
    · intro hBranch
      exact hBranch.1
    · intro hCompatible
      exact
        compatible_degree_two_branch_of_cycle
          (regularColoringChi data) C hCompatible
  · intro hCommonDegreeTwo
    rcases
        finite_degree_two_k5_classifier
          data hRegular hCommonDegreeTwo with
      ⟨C, hCompatible⟩
    exact
      ⟨C,
        compatible_degree_two_branch_of_cycle
          (regularColoringChi data) C hCompatible⟩

/--
The Section 9.1 degree-two-family state extends the exact regular-coloring
state.  Its universal field applies to the same source-tied data object opened
from that state and therefore cannot reselect a different coloring.
-/
def degree_two_branch_family
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  regular_coloring_problem C nSeq dSeq opening ∧
    ∀ data : RegularColoringProblemData,
      regular_coloring_source_coherence
          C nSeq dSeq opening data →
        regular_coloring_problem_at data →
          degree_two_branch_family_at data

