theorem build_endpoint_pair_product_frame_state
    {v : Section3.EndpointValueFamily}
    (hState : endpoint_five_vertex_distinctness_state v) :
    endpoint_pair_product_frame_state v := by
  exact
    ⟨hState,
      build_pair_product_frames
        hState.2
        hState.1.2⟩

