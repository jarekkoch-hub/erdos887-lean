proves the ten telescoping identities from the paper.

The gaps here are internal address variables.  They are not Section 3 pair
gcds, root-band deviations, or the later max-linear growth profile.
================================================================================
-/

/-- The adjacent address gap `g_k = v_(k+1) - v_k`. -/
def adjacentEndpointGap
    (v : Section3.EndpointValueFamily)
    (k : AdjacentGapAddress) : ℤ :=
  v (Fin.succ k) - v (Fin.castSucc k)

/-- The endpoint interval `I_ij = v_j - v_i`. -/
def endpointInterval
    (v : Section3.EndpointValueFamily)
    (i j : EndpointAddress) : ℤ :=
  v j - v i

/-- The ten endpoint-interval identities in the paper's fixed edge order. -/
def endpoint_interval_identities
    (v : Section3.EndpointValueFamily) : Prop :=
  endpointInterval v 0 1 = adjacentEndpointGap v 0 ∧
    endpointInterval v 0 2 =
      adjacentEndpointGap v 0 + adjacentEndpointGap v 1 ∧
    endpointInterval v 0 3 =
      adjacentEndpointGap v 0 + adjacentEndpointGap v 1 +
        adjacentEndpointGap v 2 ∧
    endpointInterval v 0 4 =
      adjacentEndpointGap v 0 + adjacentEndpointGap v 1 +
        adjacentEndpointGap v 2 + adjacentEndpointGap v 3 ∧
    endpointInterval v 1 2 = adjacentEndpointGap v 1 ∧
    endpointInterval v 1 3 =
      adjacentEndpointGap v 1 + adjacentEndpointGap v 2 ∧
    endpointInterval v 1 4 =
      adjacentEndpointGap v 1 + adjacentEndpointGap v 2 +
        adjacentEndpointGap v 3 ∧
    endpointInterval v 2 3 = adjacentEndpointGap v 2 ∧
    endpointInterval v 2 4 =
      adjacentEndpointGap v 2 + adjacentEndpointGap v 3 ∧
    endpointInterval v 3 4 = adjacentEndpointGap v 3

/-- The retained ordered endpoint family gives four positive adjacent gaps. -/
theorem adjacentEndpointGap_pos_of_strictMono
    {v : Section3.EndpointValueFamily}
    (hOrdered : StrictMono v) :
    ∀ k : AdjacentGapAddress,
      0 < adjacentEndpointGap v k := by
  intro k
  have hValue :
      v (Fin.castSucc k) < v (Fin.succ k) :=
    hOrdered Fin.castSucc_lt_succ
  simpa [adjacentEndpointGap] using
    (sub_pos.mpr hValue)

/-- The ten displayed identities are exact telescoping identities. -/
theorem endpoint_interval_identities_hold
    (v : Section3.EndpointValueFamily) :
    endpoint_interval_identities v := by
  unfold endpoint_interval_identities
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    simp [endpointInterval, adjacentEndpointGap]

/--
The cumulative Section 6.1 state over the exact endpoint-address state.

It retains the incoming address state and adds the positive adjacent gaps and
ten telescoping identities for that exact pointwise family.
-/
def endpoint_address_interval_state
    (v : Section3.EndpointValueFamily) : Prop :=
  endpoint_address_state v ∧
    endpoint_interval_identities v ∧
    ∀ k : AdjacentGapAddress,
      0 < adjacentEndpointGap v k

/-
================================================================================
STATE-SHAPE BATCH
Section 6.1, Sub-layer 01, Sub-box 01

Incoming state shape:
  endpoint_address_state v

Outgoing state shape:
  endpoint_address_interval_state v

Effect:
  Applies the endpoint-interval theorem to the exact ordered-address state
  supplied by the Section 6 opening batch. The output retains that state and adds
  unconditional positive adjacent gaps and the ten exact interval identities.

Public theorem:
  build_endpoint_address_interval_state
================================================================================
-/

theorem build_endpoint_address_interval_state
    {v : Section3.EndpointValueFamily}
    (hAddress : endpoint_address_state v) :
    endpoint_address_interval_state v := by
  exact
    ⟨hAddress,
      endpoint_interval_identities_hold v,
      adjacentEndpointGap_pos_of_strictMono hAddress.1⟩

def endpoint_intervals
    (vSeq : ℕ → Section3.EndpointValueFamily) : Prop :=
  ∀ m : ℕ,
    endpoint_interval_identities (vSeq m) ∧
      (StrictMono (vSeq m) →
        ∀ k : AdjacentGapAddress,
          0 < adjacentEndpointGap (vSeq m) k)

theorem derive_endpoint_intervals
    (vSeq : ℕ → Section3.EndpointValueFamily) :
    endpoint_intervals vSeq := by
  intro m
  exact
    ⟨endpoint_interval_identities_hold (vSeq m),
      adjacentEndpointGap_pos_of_strictMono⟩


/- ## Sub-container 6.2: Edge references and non-loop edges. -/

/- Sub-layer 01 -/
/-
Paper ref: 6.2
Sub-box Label: `Edge references and non-loop edges: fixed edge table, endpoint edge references epsilon_ij, and ten unordered non-loop K5 edges`
Sub-inputs: `endpoint_address_interval_state`
Sub-outputs: `endpoint_edge_reference_state`
-/
def section_6_2_sub_layer_01_sub_box_01_label : String := "Edge references and non-loop edges: fixed edge table, endpoint edge references epsilon_ij, and ten unordered non-loop K5 edges"
def section_6_2_sub_layer_01_sub_box_01_inputs : List String := ["endpoint_address_interval_state [read]"]
def section_6_2_sub_layer_01_sub_box_01_outputs : List String := ["endpoint_edge_reference_state [birth]"]


/-
================================================================================
EXECUTABLE BOX
Section 6.2, Sub-layer 01, Sub-box 01
Birth token: endpoint_edge_reference_state

This box retains the exact Section 6.1 endpoint-address interval state and adds
the reusable edge-reference packet on the same fixed ten-entry boundary table.

For distinct endpoint addresses `i` and `j`, `endpointEdgeReference i j` is the
unique address of the unordered edge `{i,j}`.  Reversing the endpoint order
returns the same address.  No theorem assigns edge semantics to a diagonal
lookup, and no later section may select a second edge address or silently
reorder the ten-edge ledger.
================================================================================
-/

/--
The ordered presentation of an unordered pair of endpoint addresses.
For distinct endpoints it places the smaller address first.
-/
def orderedEndpointPair
    (i j : EndpointAddress) :
    EndpointAddress × EndpointAddress :=
  if i < j then (i, j) else (j, i)

/--
The raw fixed endpoint-edge table.

Its diagonal entries are implementation defaults only.  The mathematical
boundary, existence, and uniqueness theorems below require distinct endpoints.
-/
private def endpointEdgeReferenceTable :
    EndpointAddress → EndpointAddress → K5EdgeAddress :=
  ![
    ![0, 0, 1, 2, 3],
    ![0, 0, 4, 5, 6],
    ![1, 4, 0, 7, 8],
    ![2, 5, 7, 0, 9],
    ![3, 6, 8, 9, 0]
  ]

/--
The fixed endpoint-pair lookup in the one ten-edge address table.

For distinct endpoints its edge semantics are supplied by
`endpointEdgeReference_boundary`.  No theorem treats a diagonal lookup as an
endpoint edge.
-/
def endpointEdgeReference
    (i j : EndpointAddress) : K5EdgeAddress :=
  endpointEdgeReferenceTable i j

/-- The ten boundary rows are pairwise distinct. -/
theorem k5EdgeBoundary_injective :
    Function.Injective k5EdgeBoundary := by
  intro e f hef
  fin_cases e <;> fin_cases f <;>
    first
    | rfl
    | cases hef

/-- Every endpoint edge in the fixed table is a non-loop. -/
theorem endpoint_edges_nonloops :
    ∀ e : K5EdgeAddress,
      (k5EdgeBoundary e).1 ≠
        (k5EdgeBoundary e).2 := by
  intro e
  exact ne_of_lt (k5EdgeBoundary_ordered e)

/-- Reversing endpoint order does not change the fixed table lookup. -/
theorem endpointEdgeReference_symm
    (i j : EndpointAddress) :
    endpointEdgeReference i j =
      endpointEdgeReference j i := by
  fin_cases i <;> fin_cases j <;>
    rfl

/--
For distinct endpoints, the selected reference has exactly the ordered boundary
representing their unordered pair.
-/
theorem endpointEdgeReference_boundary
    {i j : EndpointAddress}
    (hij : i ≠ j) :
    k5EdgeBoundary (endpointEdgeReference i j) =
      orderedEndpointPair i j := by
  fin_cases i <;> fin_cases j <;>
    first
    | exact (hij rfl).elim
    | rfl

/-- The reference determined by a distinct endpoint pair is unique. -/
theorem endpointEdgeReference_unique
    {i j : EndpointAddress}
    (hij : i ≠ j)
    {e : K5EdgeAddress}
    (he :
      k5EdgeBoundary e =
        orderedEndpointPair i j) :
    e = endpointEdgeReference i j := by
  apply k5EdgeBoundary_injective
  calc
    k5EdgeBoundary e =
        orderedEndpointPair i j :=
      he
    _ =
        k5EdgeBoundary (endpointEdgeReference i j) :=
      (endpointEdgeReference_boundary hij).symm

/-- Every distinct endpoint pair has exactly one reference in the fixed table. -/
theorem endpointEdgeReference_exists_unique
    {i j : EndpointAddress}
    (hij : i ≠ j) :
    ∃! e : K5EdgeAddress,
      k5EdgeBoundary e =
        orderedEndpointPair i j := by
  refine
    ⟨endpointEdgeReference i j,
      endpointEdgeReference_boundary hij,
      ?_⟩
  intro e he
  exact endpointEdgeReference_unique hij he

/--
For ordered endpoints `i < j`, the unique-reference theorem reduces to the
original ten-row table statement.
-/
theorem k5EdgeBoundary_complete_unique
    (i j : EndpointAddress)
    (hij : i < j) :
    ∃! e : K5EdgeAddress,
      k5EdgeBoundary e = (i, j) := by
  have hne : i ≠ j :=
    ne_of_lt hij
  simpa [orderedEndpointPair, hij] using
    endpointEdgeReference_exists_unique hne

/--
The fixed Section 6.2 edge-reference packet.

It records non-loop edges, correct symmetric endpoint reads, and unique
coverage of every distinct endpoint pair in the one fixed K5 table.
-/
def edge_references : Prop :=
  (∀ e : K5EdgeAddress,
    (k5EdgeBoundary e).1 ≠
      (k5EdgeBoundary e).2) ∧
    (∀ i j : EndpointAddress, i ≠ j →
      k5EdgeBoundary (endpointEdgeReference i j) =
        orderedEndpointPair i j) ∧
    (∀ i j : EndpointAddress,
      endpointEdgeReference i j =
        endpointEdgeReference j i) ∧
    ∀ i j : EndpointAddress, i ≠ j →
      ∃! e : K5EdgeAddress,
        k5EdgeBoundary e =
          orderedEndpointPair i j

/-
================================================================================
INTERNAL BOX LEMMA
Section 6.2 finite edge-reference packet

Incoming state shape:
  none

Outgoing state shape:
  edge_references

Effect:
  Closes the symmetric, non-loop, unique edge-reference interface on the fixed
  ten-edge ledger.  It creates no second address table.

Internal theorem:
  build_edge_references
================================================================================
-/

theorem build_edge_references :
    edge_references := by
  exact
    ⟨endpoint_edges_nonloops,
      fun i j hij =>
        endpointEdgeReference_boundary hij,
      endpointEdgeReference_symm,
      fun i j hij =>
        endpointEdgeReference_exists_unique hij⟩

/--
The cumulative Section 6.2 state over the exact Section 6.1 interval state.

It retains the ordered endpoint family, fixed address context, interval
identities, and positive adjacent gaps, then adds the one fixed edge-reference
packet.  No endpoint family, edge table, or edge reference is reselected.
-/
def endpoint_edge_reference_state
    (v : Section3.EndpointValueFamily) : Prop :=
  endpoint_address_interval_state v ∧
    edge_references

/-
================================================================================
STATE-SHAPE BATCH
Section 6.2, Sub-layer 01, Sub-box 01

Incoming state shape:
  endpoint_address_interval_state v

Outgoing state shape:
  endpoint_edge_reference_state v

Effect:
  Retains the exact Section 6.1 endpoint-address interval state and adds the
  fixed symmetric, non-loop, unique edge-reference packet on the same address
  ledger.  No endpoint family, edge table, or edge reference is reselected.

Public theorem:
  build_endpoint_edge_reference_state
================================================================================
-/

theorem build_endpoint_edge_reference_state
    {v : Section3.EndpointValueFamily}
    (hIntervals : endpoint_address_interval_state v) :
    endpoint_edge_reference_state v := by
  exact ⟨hIntervals, build_edge_references⟩

/-
================================================================================
STATE-SHAPE PARENT BATCH
Section 6 opening through Section 6.2

Incoming state shape:
  StrictMono v

Outgoing state shape:
  endpoint_edge_reference_state v

Effect:
  This is a conditional parent composition from the ordered endpoint boundary
  input, not a zero-assumption closure theorem.  It calls the Section 6 opening
  constructor, the Section 6.1 interval constructor, and the Section 6.2
  edge-reference constructor in order on the same pointwise endpoint family.
  Every new finite packet is closed; no canonical family, edge table, or edge
  address is selected or assumed inside this parent.

Public theorem:
  build_section_6_through_edge_references_from_order
================================================================================
-/

theorem build_section_6_through_edge_references_from_order
    {v : Section3.EndpointValueFamily}
    (hOrdered : StrictMono v) :
    endpoint_edge_reference_state v := by
  have hAddress : endpoint_address_state v :=
    build_endpoint_address_state hOrdered
  have hIntervals : endpoint_address_interval_state v :=
    build_endpoint_address_interval_state hAddress
  exact build_endpoint_edge_reference_state hIntervals


/- ## Sub-container 6.3: Five-vertex distinctness bookkeeping. -/

/- Sub-layer 01 -/
/-
Paper ref: 6.3
Sub-box Label: `Five-vertex distinctness bookkeeping: no-repetition listings give pairwise endpoint distinctness and legal reorderings`
Sub-inputs: `endpoint_edge_reference_state`
Sub-outputs: `endpoint_five_vertex_distinctness_state`
-/
def section_6_3_sub_layer_01_sub_box_01_label : String := "Five-vertex distinctness bookkeeping: no-repetition listings give pairwise endpoint distinctness and legal reorderings"
def section_6_3_sub_layer_01_sub_box_01_inputs : List String := ["endpoint_edge_reference_state [read]"]
def section_6_3_sub_layer_01_sub_box_01_outputs : List String := ["endpoint_five_vertex_distinctness_state [birth]"]


/-
================================================================================
EXECUTABLE BOX
Section 6.3, Sub-layer 01, Sub-box 01
Birth token: endpoint_five_vertex_distinctness_state

This box retains the exact cumulative Section 6.2 endpoint-edge-reference state
and adds the closed five-vertex distinctness bookkeeping from the paper.

A no-repetition listing `(i,j,r,s,t)` is represented by `List.Nodup` on the
five fixed endpoint addresses.  The box reads the ten position pairs, records
the ten pairwise inequalities, and proves that the two displayed reorderings
remain no-repetition listings.

The new bookkeeping is closed finite mathematics.  It does not select an edge,
rebuild the edge-reference table, choose a new endpoint family, or add any
algebraic law.
================================================================================
-/

/-- The five endpoint addresses in one ordered bookkeeping frame. -/
def fiveEndpointListing
    (i j r s t : EndpointAddress) :
    List EndpointAddress :=
  [i, j, r, s, t]

/-- No endpoint occurs twice in the five-position listing. -/
def fiveEndpointListingNoDup
    (i j r s t : EndpointAddress) : Prop :=
  (fiveEndpointListing i j r s t).Nodup

/-- The ten pairwise inequalities read from a five-position listing. -/
def fiveEndpointPairwiseDistinct
    (i j r s t : EndpointAddress) : Prop :=
  (i ≠ j ∧ i ≠ r ∧ i ≠ s ∧ i ≠ t) ∧
    (j ≠ r ∧ j ≠ s ∧ j ≠ t) ∧
    (r ≠ s ∧ r ≠ t) ∧
    s ≠ t

/-- A five-position listing is repetition-free exactly when all ten pairs differ. -/
theorem fiveEndpointListingNoDup_iff_pairwise
    (i j r s t : EndpointAddress) :
    fiveEndpointListingNoDup i j r s t ↔
      fiveEndpointPairwiseDistinct i j r s t := by
  simp
    [fiveEndpointListingNoDup,
      fiveEndpointListing,
      fiveEndpointPairwiseDistinct]

/-- Read the ten displayed inequalities from one no-repetition listing. -/
theorem pairwise_distinctness_from_five_listing
    {i j r s t : EndpointAddress}
    (hNoDup : fiveEndpointListingNoDup i j r s t) :
    fiveEndpointPairwiseDistinct i j r s t :=
  (fiveEndpointListingNoDup_iff_pairwise i j r s t).1 hNoDup

/-- Swapping the third and fourth positions preserves no repetition. -/
theorem fiveEndpointListingNoDup_reorder_rs
    {i j r s t : EndpointAddress}
    (hNoDup : fiveEndpointListingNoDup i j r s t) :
    fiveEndpointListingNoDup i j s r t := by
  rcases pairwise_distinctness_from_five_listing hNoDup with
    ⟨⟨hij, hir, his, hit⟩,
      ⟨hjr, hjs, hjt⟩,
      ⟨hrs, hrt⟩,
      hst⟩
  apply
    (fiveEndpointListingNoDup_iff_pairwise
      i j s r t).2
  exact
    ⟨⟨hij, his, hir, hit⟩,
      ⟨hjs, hjr, hjt⟩,
      ⟨hrs.symm, hst⟩,
      hrt⟩

/-- Moving the fifth position into the third slot preserves no repetition. -/
theorem fiveEndpointListingNoDup_reorder_trs
    {i j r s t : EndpointAddress}
    (hNoDup : fiveEndpointListingNoDup i j r s t) :
    fiveEndpointListingNoDup i j t r s := by
  rcases pairwise_distinctness_from_five_listing hNoDup with
    ⟨⟨hij, hir, his, hit⟩,
      ⟨hjr, hjs, hjt⟩,
      ⟨hrs, hrt⟩,
      hst⟩
  apply
    (fiveEndpointListingNoDup_iff_pairwise
      i j t r s).2
  exact
    ⟨⟨hij, hit, hir, his⟩,
      ⟨hjt, hjr, hjs⟩,
      ⟨hrt.symm, hst.symm⟩,
      hrs⟩

/--
The closed Section 6.3 five-listing packet.

For every no-repetition five-endpoint listing, it retains exactly the ten
pairwise inequalities and the two reorderings displayed in the paper.
-/
def five_vertex_distinctness : Prop :=
  ∀ i j r s t : EndpointAddress,
    fiveEndpointListingNoDup i j r s t →
      fiveEndpointPairwiseDistinct i j r s t ∧
      fiveEndpointListingNoDup i j s r t ∧
      fiveEndpointListingNoDup i j t r s

/-
================================================================================
INTERNAL BOX LEMMA
Section 6.3 finite distinctness packet

Incoming state shape:
  none

Outgoing state shape:
  five_vertex_distinctness

Effect:
  Closes the ten pairwise inequalities and the two legal reorderings for every
  no-repetition five-endpoint listing.

Internal theorem:
  build_five_vertex_distinctness
================================================================================
-/

theorem build_five_vertex_distinctness :
    five_vertex_distinctness := by
  intro i j r s t hNoDup
  exact
    ⟨pairwise_distinctness_from_five_listing hNoDup,
      fiveEndpointListingNoDup_reorder_rs hNoDup,
      fiveEndpointListingNoDup_reorder_trs hNoDup⟩

/--
The cumulative Section 6.3 state over the exact Section 6.2 state.

It retains the same ordered endpoint family, interval identities, positive
gaps, and fixed edge-reference ledger, then adds the five-listing distinctness
and reordering packet.  Nothing is reselected or reconstructed.
-/
def endpoint_five_vertex_distinctness_state
    (v : Section3.EndpointValueFamily) : Prop :=
  endpoint_edge_reference_state v ∧
    five_vertex_distinctness

/-
================================================================================
STATE-SHAPE BATCH
Section 6.3, Sub-layer 01, Sub-box 01

Incoming state shape:
  endpoint_edge_reference_state v

Outgoing state shape:
  endpoint_five_vertex_distinctness_state v

Effect:
  Retains the exact cumulative Section 6.2 state and adds the closed pairwise-
  distinctness and reordering packet for five-endpoint no-repetition listings.
  No endpoint family, edge table, or edge reference is reselected.

Public theorem:
  build_endpoint_five_vertex_distinctness_state
================================================================================
-/

theorem build_endpoint_five_vertex_distinctness_state
    {v : Section3.EndpointValueFamily}
    (hReferences : endpoint_edge_reference_state v) :
    endpoint_five_vertex_distinctness_state v := by
  exact ⟨hReferences, build_five_vertex_distinctness⟩

/-
================================================================================
STATE-SHAPE PARENT BATCH
Section 6 opening through Section 6.3

Incoming state shape:
  StrictMono v

Outgoing state shape:
  endpoint_five_vertex_distinctness_state v

Effect:
  This is a conditional parent composition from the ordered endpoint boundary
  input, not a zero-assumption closure theorem.  It reuses the exact Section 6.2
  cumulative output on the same pointwise endpoint family and applies the
  Section 6.3 constructor.  All distinctness and reordering mathematics is
  closed finite bookkeeping.

Public theorem:
  build_section_6_through_five_vertex_distinctness_from_order
================================================================================
-/

theorem build_section_6_through_five_vertex_distinctness_from_order
    {v : Section3.EndpointValueFamily}
    (hOrdered : StrictMono v) :
    endpoint_five_vertex_distinctness_state v := by
  have hReferences : endpoint_edge_reference_state v :=
    build_section_6_through_edge_references_from_order hOrdered
  exact build_endpoint_five_vertex_distinctness_state hReferences


/- ## Sub-container 6.4: Pair-product and incident frames. -/

/- Sub-layer 01 -/
/-
Paper ref: 6.4
Sub-box Label: `Pair-product frames: five distinct endpoints and four fixed product-edge references`
Sub-inputs: `endpoint_five_vertex_distinctness_state`
Sub-outputs: `endpoint_pair_product_frame_state`
-/
def section_6_4_sub_layer_01_sub_box_01_label : String := "Pair-product frames: five distinct endpoints and four fixed product-edge references"
def section_6_4_sub_layer_01_sub_box_01_inputs : List String := ["endpoint_five_vertex_distinctness_state [construction]"]
def section_6_4_sub_layer_01_sub_box_01_outputs : List String := ["endpoint_pair_product_frame_state [birth]"]


/-
================================================================================
EXECUTABLE BOX
Section 6.4, Sub-layer 01, Sub-box 01
Birth token: endpoint_pair_product_frame_state

This box extends the exact cumulative Section 6.3 endpoint state with the
pair-product-frame conventions fixed before algebraic compression.

A pair-product frame is purely an address object.  A no-repetition listing
`(i,j,k,a,b)` supplies the remaining endpoint `k` and the four already fixed
edge references

  epsilon_ia, epsilon_ib, epsilon_ja, epsilon_jb.

No product values or algebraic equalities are asserted here.  The endpoint
family, interval state, edge ledger, and distinctness packet are retained
without reselection.
================================================================================
-/

/-- One legal pair-product frame on five distinct endpoint addresses. -/
def pair_product_frame
    (i j k a b : EndpointAddress) : Prop :=
  fiveEndpointListingNoDup i j k a b ∧
    k5EdgeBoundary (endpointEdgeReference i a) =
      orderedEndpointPair i a ∧
    k5EdgeBoundary (endpointEdgeReference i b) =
      orderedEndpointPair i b ∧
    k5EdgeBoundary (endpointEdgeReference j a) =
      orderedEndpointPair j a ∧
    k5EdgeBoundary (endpointEdgeReference j b) =
      orderedEndpointPair j b

/--
Every no-repetition five-endpoint listing determines its pair-product frame
using only the fixed endpoint-reference table.  This is a pure finite address
state and therefore carries no unused `C`, `nSeq`, or `dSeq` parameters.
-/
def pair_product_frames : Prop :=
  ∀ i j k a b : EndpointAddress,
    fiveEndpointListingNoDup i j k a b →
      pair_product_frame i j k a b

/-
================================================================================
INTERNAL BOX LEMMA
Section 6.4 finite pair-product-frame packet

Incoming state shape:
  five_vertex_distinctness
  edge_references

Outgoing state shape:
  pair_product_frames

Effect:
  Uses the five-listing distinctness packet to certify the four endpoint pairs
  are non-diagonal, then reads their exact references from the one fixed K5
  table.  It introduces no algebraic equation or new finite choice.

Internal theorem:
  build_pair_product_frames
================================================================================
-/

theorem build_pair_product_frames
    (hDistinct : five_vertex_distinctness)
    (hReferences : edge_references) :
    pair_product_frames := by
  rcases hReferences with
    ⟨_hNonloops, hBoundary, _hSymm, _hUnique⟩
  intro i j k a b hNoDup
  rcases (hDistinct i j k a b hNoDup).1 with
    ⟨⟨_hij, _hik, hia, hib⟩,
      ⟨_hjk, hja, hjb⟩,
      ⟨_hka, _hkb⟩,
      _hab⟩
  exact
    ⟨hNoDup,
      hBoundary i a hia,
      hBoundary i b hib,
      hBoundary j a hja,
      hBoundary j b hjb⟩

/--
The cumulative first Section 6.4 state over the exact Section 6.3 state.

It retains the ordered endpoint family, interval identities, positive gaps,
fixed edge-reference ledger, and five-listing distinctness packet, then adds
the permanent pair-product-frame address conventions.  No endpoint or edge is
selected again.
-/
def endpoint_pair_product_frame_state
    (v : Section3.EndpointValueFamily) : Prop :=
  endpoint_five_vertex_distinctness_state v ∧
    pair_product_frames

/-
================================================================================
STATE-SHAPE BATCH
Section 6.4, Sub-layer 01, Sub-box 01

Incoming state shape:
  endpoint_five_vertex_distinctness_state v

Outgoing state shape:
