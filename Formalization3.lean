/--
The branch bound is the sum of the absolute values over the exact fixed
Section 6 edge-address domain.  It is attached to the already-selected frozen
pattern and introduces no new coefficient family.
-/
def prefixFrozenCoefficientBoundValue
    (b : RankTrichotomy.FrozenEndpointCoefficientPattern) : ℚ :=
  (Finset.univ : Finset Section6.K5EdgeAddress).sum
    (fun e => |b e|)

/-- Every fixed rational coefficient pattern on the ten edge addresses is bounded. -/
theorem prefix_frozen_coefficient_pattern_bounded
    (b : RankTrichotomy.FrozenEndpointCoefficientPattern) :
    0 ≤ prefixFrozenCoefficientBoundValue b ∧
      ∀ e : Section6.K5EdgeAddress,
        |b e| ≤ prefixFrozenCoefficientBoundValue b := by
  constructor
  · unfold prefixFrozenCoefficientBoundValue
    exact
      Finset.sum_nonneg
        (fun e _ => abs_nonneg (b e))
  · intro e
    unfold prefixFrozenCoefficientBoundValue
    exact
      Finset.single_le_sum
        (fun i _ => abs_nonneg (b i))
        (Finset.mem_univ e)

/--
The paper-grain frozen coefficient packet over one exact rational edge pattern.

The first field is the same canonical read already carried by the leading
extraction source.  The second is off-diagonal nonvanishing on every fixed edge
address.  The final two fields retain one explicit branch bound.
-/
def frozen_coefficient_pattern_at
    (opening : CanonicalIntervalOverloadOpeningData)
    (b : RankTrichotomy.FrozenEndpointCoefficientPattern) : Prop :=
  RankTrichotomy.frozen_endpoint_coefficient_pattern opening b ∧
    (∀ e : Section6.K5EdgeAddress, b e ≠ 0) ∧
    0 ≤ prefixFrozenCoefficientBoundValue b ∧
    ∀ e : Section6.K5EdgeAddress,
      |b e| ≤ prefixFrozenCoefficientBoundValue b

/--
The exact Section 8 source selection from which the frozen prefix coefficient
pattern is read.  This is a no-reselection predicate.
-/
def frozen_coefficient_source_coherence
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData)
    (b : RankTrichotomy.FrozenEndpointCoefficientPattern) : Prop :=
  ∃ leadingData : RankTrichotomy.LeadingDescendantExtractionData,
    ∃ regimeData : RankTrichotomy.RankRegimeSourceData,
      RankTrichotomy.rank_source
          opening leadingData regimeData ∧
        RankTrichotomy.S_rank_components
            C nSeq dSeq opening leadingData regimeData ∧
          RankTrichotomy.low_rank_coloring_packet
              C nSeq dSeq opening leadingData regimeData ∧
            b = RankTrichotomy.leadingFrozenCoefficientPattern leadingData ∧
              Section6.Legacy.legacy_S_0
                C nSeq dSeq
                (openingTSeq opening)
                (openingBSeq opening)
                (openingZSeq opening)

/-- The frozen edge read is exactly the canonical coefficient at every retained index. -/
theorem frozen_coefficient_pattern_edge_read
    {opening : CanonicalIntervalOverloadOpeningData}
    {b : RankTrichotomy.FrozenEndpointCoefficientPattern}
    (hPattern : frozen_coefficient_pattern_at opening b)
    (m : ℕ)
    (e : Section6.K5EdgeAddress) :
    b e = RankTrichotomy.rationalEndpointCoefficientAtEdge opening m e :=
  hPattern.1 m e

/-- The Section 9.2 frozen-pattern output with all three declared inputs retained. -/
def frozen_coefficient_pattern
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  prefix_layer_context C nSeq dSeq opening ∧
    RankTrichotomy.S_rank C nSeq dSeq opening ∧
    Section6.Legacy.legacy_S_0
      C nSeq dSeq
      (openingTSeq opening)
      (openingBSeq opening)
      (openingZSeq opening) ∧
    ∃ b : RankTrichotomy.FrozenEndpointCoefficientPattern,
      frozen_coefficient_source_coherence
          C nSeq dSeq opening b ∧
        frozen_coefficient_pattern_at opening b

