    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ} :
    five_near_root_divisor_witness C n d ↔
      StrictMono d ∧
        ∀ i : Fin 5, d i ∣ n ∧ inRootBand C n (d i) := by
  rfl

