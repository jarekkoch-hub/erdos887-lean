def finite_prefix_conflict_family_at
    {D : Type}
    (opening : CanonicalIntervalOverloadOpeningData)
    (data : RegularColoringProblemData)
    (certificateData : FinitePrefixCertificateSourceData D)
    (intervalData : PrefixIntervalSectorData)
    (lowRankData : RankTrichotomy.LowRankSourceData) : Prop :=
  regular_coloring_problem_at data ∧
    degree_two_branch_family_at data ∧
      finite_prefix_certificate_at
          (regularColoringChi data) certificateData ∧
        projective_cone_model_at
          (projectiveConeModelFromCertificate certificateData) ∧
          prefix_interval_sector_data_at opening intervalData ∧
            RankTrichotomy.lowRankNoLowerEscapeFlag
                lowRankData = true ∧
              ∀ C : PrefixCycleAddress,
                compatible_degree_two_branch
                    (regularColoringChi data) C →
                  prefix_cone_conflict_datum_at
                    opening
                    (projectiveConeModelFromCertificate certificateData)
                    intervalData
                    lowRankData
                    (prefixCertificateX certificateData C)
                    (prefixCertificateY certificateData C)
                    (prefixCertificateZ certificateData C)
                    (prefixCertificateConflictEdge certificateData C)
                    (prefixCertificateLeftGap certificateData C)
                    (prefixCertificateRightGap certificateData C)

/--
Open every compatible certificate row and type it as one exact prefix-cone
conflict datum.
-/
theorem build_finite_prefix_conflict_family_at
    {D : Type}
    {opening : CanonicalIntervalOverloadOpeningData}
    {data : RegularColoringProblemData}
    {certificateData : FinitePrefixCertificateSourceData D}
    {intervalData : PrefixIntervalSectorData}
    {lowRankData : RankTrichotomy.LowRankSourceData}
    (hRegular : regular_coloring_problem_at data)
    (hBranchFamily : degree_two_branch_family_at data)
    (hCertificate :
      finite_prefix_certificate_at
        (regularColoringChi data) certificateData)
    (hModel :
      projective_cone_model_at
        (projectiveConeModelFromCertificate certificateData))
    (hInterval :
      prefix_interval_sector_data_at opening intervalData)
    (hLowerClosed :
      RankTrichotomy.lowRankNoLowerEscapeFlag lowRankData = true) :
    finite_prefix_conflict_family_at
      opening data certificateData intervalData lowRankData := by
  refine
    ⟨hRegular, hBranchFamily, hCertificate, hModel,
      hInterval, hLowerClosed, ?_⟩
  intro C hBranch

  have hCompatible :
      prefixCycleCompatible (regularColoringChi data) C :=
    hBranch.1

  rcases hCertificate.2 C hCompatible with
    ⟨hNonparallel, hCone, hEndpoint,
      hGapDistinct, hLeftGap, hRightGap⟩

  have hNonparallelModel :
      ¬ projectiveConeSameLine
          (projectiveConeModelFromCertificate certificateData)
          (prefixCertificateX certificateData C)
          (prefixCertificateY certificateData C) := by
    simpa
      [projectiveConeSameLine,
        projectiveConeModelFromCertificate] using hNonparallel

  have hConeModel :
      projectiveConePositiveCone
          (projectiveConeModelFromCertificate certificateData)
          (prefixCertificateX certificateData C)
          (prefixCertificateY certificateData C)
          (prefixCertificateZ certificateData C) := by
    simpa
      [projectiveConePositiveCone,
        projectiveConeModelFromCertificate] using hCone

  have hEndpointModel :
      projectiveConeSameLine
          (projectiveConeModelFromCertificate certificateData)
          (prefixCertificateZ certificateData C)
          (prefixCertificateX certificateData C) ∨
        projectiveConeSameLine
          (projectiveConeModelFromCertificate certificateData)
          (prefixCertificateZ certificateData C)
          (prefixCertificateY certificateData C) := by
    simpa
      [projectiveConeSameLine,
        projectiveConeModelFromCertificate] using hEndpoint

  have hIntervalSource :
      prefix_conflict_interval_sum_source
        intervalData
        (prefixCertificateConflictEdge certificateData C) := by
    intro m
    exact
      hInterval.2.2.2.1 m
        (prefixCertificateConflictEdge certificateData C)

  exact
    build_prefix_cone_conflict_datum_at
      (opening := opening)
      (model := projectiveConeModelFromCertificate certificateData)
      (intervalData := intervalData)
      (lowRankData := lowRankData)
      (X := prefixCertificateX certificateData C)
      (Y := prefixCertificateY certificateData C)
      (Z := prefixCertificateZ certificateData C)
      (conflictEdge := prefixCertificateConflictEdge certificateData C)
      (leftGap := prefixCertificateLeftGap certificateData C)
      (rightGap := prefixCertificateRightGap certificateData C)
      hModel hInterval hNonparallelModel hConeModel hEndpointModel
      hGapDistinct hLeftGap hRightGap hIntervalSource hLowerClosed

/--
The Section 9.4 finite-family output.

The three declared input states remain visible.  The existential payload is one
exact family opened from their direct handoff: the regular datum and low-rank
packet share the same Section 8 source witnesses, the certificate is attached
to that coloring, and the interval packet is the exact packet retained by the
row-type batch.
-/
def finite_prefix_conflict_family
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  degree_two_branch_family C nSeq dSeq opening ∧
    finite_prefix_certificate C nSeq dSeq opening ∧
      prefix_cone_conflict_datum_type C nSeq dSeq opening ∧
        ∃ data : RegularColoringProblemData,
          regular_coloring_source_coherence
              C nSeq dSeq opening data ∧
            ∃ D : Type,
              ∃ certificateData : FinitePrefixCertificateSourceData D,
                ∃ intervalData : PrefixIntervalSectorData,
                  ∃ lowRankData : RankTrichotomy.LowRankSourceData,
                    prefix_interval_sector_source_coherence
                        C nSeq dSeq opening intervalData ∧
                      finite_prefix_conflict_low_rank_coherence
                          C nSeq dSeq opening data lowRankData ∧
                        finite_prefix_conflict_family_at
                          opening data certificateData intervalData lowRankData

/-
================================================================================
STATE-SHAPE BATCH
Section 9.4, Sub-layer 01, Sub-box 01

Incoming state shape:
  degree_two_branch_family C nSeq dSeq opening
  finite_prefix_certificate C nSeq dSeq opening
  prefix_cone_conflict_datum_type C nSeq dSeq opening

Outgoing state shape:
  finite_prefix_conflict_family C nSeq dSeq opening

Effect:
  Opens the exact regular-coloring witness and its exact Section 8 source
  selection, applies the direct finite certificate source to that same selected
  coloring, reads the exact interval packet and projective model already born
  in Section 9.3, and assigns one fully typed conflict row to every compatible
  cycle address.  No branch is selected or eliminated.

Public theorem:
  build_finite_prefix_conflict_family
================================================================================
-/

theorem build_finite_prefix_conflict_family
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hBranchFamily :
      degree_two_branch_family C nSeq dSeq opening)
    (hCertificate :
      finite_prefix_certificate C nSeq dSeq opening)
    (hConflictType :
      prefix_cone_conflict_datum_type C nSeq dSeq opening) :
    finite_prefix_conflict_family C nSeq dSeq opening := by
  have hBranchFamilyState :
      degree_two_branch_family C nSeq dSeq opening :=
    hBranchFamily
  have hConflictTypeState :
      prefix_cone_conflict_datum_type C nSeq dSeq opening :=
    hConflictType

  rcases hBranchFamily with
    ⟨hRegularState, hBranchFamilyUniversal⟩
  rcases hRegularState with
    ⟨_hRankFromRegular, data, hDataSource, hRegularAt⟩
  have hDataSourceState :
      regular_coloring_source_coherence
        C nSeq dSeq opening data :=
    hDataSource
  rcases hDataSource with
    ⟨leadingData, regimeData,
      hRankSource, hComponents, hLowPacket,
      hChiRead, _hDegreeRead, hSourceS0⟩

  have hBranchFamilyAt :
      degree_two_branch_family_at data :=
    hBranchFamilyUniversal data
      hDataSourceState hRegularAt

  rcases
      hCertificate leadingData regimeData
        hRankSource hLowPacket with
    ⟨D, certificateData, hCertificateSelected⟩

  have hCertificateAt :
      finite_prefix_certificate_at
        (regularColoringChi data) certificateData := by
    simpa [hChiRead] using hCertificateSelected

  rcases hConflictType with
    ⟨hModelState, hIntervalState, _hRankFromType⟩
  rcases hIntervalState with
    ⟨_hPatternState, _hIntervalS0,
      intervalData, hIntervalSource, hIntervalAt⟩

  have hModelAt :
      projective_cone_model_at
        (projectiveConeModelFromCertificate certificateData) :=
    hModelState.2
      leadingData regimeData D certificateData
      hRankSource hComponents hLowPacket hSourceS0
      hCertificateSelected

  have hLowerClosed :
      RankTrichotomy.lowRankNoLowerEscapeFlag
          (RankTrichotomy.lowRankSourceData regimeData) = true :=
    hLowPacket.2.2.2.2.2.2.1

  have hLowCoherence :
      finite_prefix_conflict_low_rank_coherence
        C nSeq dSeq opening data
        (RankTrichotomy.lowRankSourceData regimeData) := by
    exact
      ⟨leadingData, regimeData,
        hRankSource, hComponents, hLowPacket,
        hChiRead, rfl⟩

  have hFamilyAt :
      finite_prefix_conflict_family_at
        opening data certificateData intervalData
        (RankTrichotomy.lowRankSourceData regimeData) :=
    build_finite_prefix_conflict_family_at
      hRegularAt hBranchFamilyAt hCertificateAt
      hModelAt hIntervalAt hLowerClosed

  refine
    ⟨hBranchFamilyState, hCertificate, hConflictTypeState,
      data, hDataSourceState, ?_⟩
  refine
    ⟨D, certificateData, intervalData,
      RankTrichotomy.lowRankSourceData regimeData, ?_⟩
  exact ⟨hIntervalSource, hLowCoherence, hFamilyAt⟩


