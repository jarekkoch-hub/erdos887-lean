          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 7) +
          booleanIndicatorValue (chi 9)
    exact
      nat_fourth_le_sum_four
        _ _ _ _

/-
If every vertex degree is zero, every fixed edge indicator is false.
-/
theorem boolean_zero_degree_extremal
    (chi : BooleanEdgeIndicator)
    (hDegree :
      ∀ v : EndpointAddress,
        booleanVertexDegree chi v = 0) :
    ∀ e : K5EdgeAddress, chi e = false := by
  intro e

  have hContribution :
      booleanIndicatorValue (chi e) ≤
        booleanVertexDegree chi
          (k5EdgeBoundary e).1 :=
    boolean_edge_value_le_first_endpoint_degree
      chi e

  have hEndpointDegree :
      booleanVertexDegree chi
        (k5EdgeBoundary e).1 = 0 :=
    hDegree (k5EdgeBoundary e).1

  have hValueZero :
      booleanIndicatorValue (chi e) = 0 := by
    nlinarith

  exact
    (booleanIndicatorValue_eq_zero_iff
      (chi e)).1 hValueZero

/-- Boolean complement on the same fixed ten-edge address set. -/
def booleanIndicatorComplement
    (chi : BooleanEdgeIndicator) :
    BooleanEdgeIndicator :=
  fun e => !(chi e)

/-- A Boolean value and its complement contribute exactly one. -/
theorem booleanIndicatorValue_add_complement
    (b : Bool) :
    booleanIndicatorValue b +
      booleanIndicatorValue (!b) = 1 := by
  cases b <;> rfl

/-
At every vertex, the degree of an indicator plus the degree of its complement
is four.
-/
theorem boolean_four_values_add_complements
    (a b c d : Bool) :
    (booleanIndicatorValue a +
        booleanIndicatorValue b +
        booleanIndicatorValue c +
        booleanIndicatorValue d) +
      (booleanIndicatorValue (!a) +
        booleanIndicatorValue (!b) +
        booleanIndicatorValue (!c) +
        booleanIndicatorValue (!d)) = 4 := by
  cases a <;> cases b <;> cases c <;> cases d <;> rfl

theorem boolean_degree_add_complement
    (chi : BooleanEdgeIndicator)
    (v : EndpointAddress) :
    booleanVertexDegree chi v +
      booleanVertexDegree
        (booleanIndicatorComplement chi) v = 4 := by
  fin_cases v
  · change
      (booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 3)) +
        (booleanIndicatorValue (!(chi 0)) +
          booleanIndicatorValue (!(chi 1)) +
          booleanIndicatorValue (!(chi 2)) +
          booleanIndicatorValue (!(chi 3))) = 4
    exact
      boolean_four_values_add_complements
        (chi 0) (chi 1) (chi 2) (chi 3)
  · change
      (booleanIndicatorValue (chi 0) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 6)) +
        (booleanIndicatorValue (!(chi 0)) +
          booleanIndicatorValue (!(chi 4)) +
          booleanIndicatorValue (!(chi 5)) +
          booleanIndicatorValue (!(chi 6))) = 4
    exact
      boolean_four_values_add_complements
        (chi 0) (chi 4) (chi 5) (chi 6)
  · change
      (booleanIndicatorValue (chi 1) +
          booleanIndicatorValue (chi 4) +
          booleanIndicatorValue (chi 7) +
          booleanIndicatorValue (chi 8)) +
        (booleanIndicatorValue (!(chi 1)) +
          booleanIndicatorValue (!(chi 4)) +
          booleanIndicatorValue (!(chi 7)) +
          booleanIndicatorValue (!(chi 8))) = 4
    exact
      boolean_four_values_add_complements
        (chi 1) (chi 4) (chi 7) (chi 8)
  · change
      (booleanIndicatorValue (chi 2) +
          booleanIndicatorValue (chi 5) +
          booleanIndicatorValue (chi 7) +
          booleanIndicatorValue (chi 9)) +
        (booleanIndicatorValue (!(chi 2)) +
          booleanIndicatorValue (!(chi 5)) +
          booleanIndicatorValue (!(chi 7)) +
          booleanIndicatorValue (!(chi 9))) = 4
    exact
      boolean_four_values_add_complements
        (chi 2) (chi 5) (chi 7) (chi 9)
  · change
      (booleanIndicatorValue (chi 3) +
          booleanIndicatorValue (chi 6) +
          booleanIndicatorValue (chi 8) +
          booleanIndicatorValue (chi 9)) +
        (booleanIndicatorValue (!(chi 3)) +
          booleanIndicatorValue (!(chi 6)) +
          booleanIndicatorValue (!(chi 8)) +
          booleanIndicatorValue (!(chi 9))) = 4
    exact
      boolean_four_values_add_complements
        (chi 3) (chi 6) (chi 8) (chi 9)

/-
If every vertex degree is four, every fixed edge indicator is true.
-/
theorem boolean_full_degree_extremal
    (chi : BooleanEdgeIndicator)
    (hDegree :
      ∀ v : EndpointAddress,
        booleanVertexDegree chi v = 4) :
    ∀ e : K5EdgeAddress, chi e = true := by
  have hComplementDegree :
      ∀ v : EndpointAddress,
        booleanVertexDegree
          (booleanIndicatorComplement chi) v = 0 := by
    intro v

    have hDegreeSum :
        booleanVertexDegree chi v +
          booleanVertexDegree
            (booleanIndicatorComplement chi) v = 4 :=
      boolean_degree_add_complement chi v

    rw [hDegree v] at hDegreeSum

    have hCancelable :
        4 +
            booleanVertexDegree
              (booleanIndicatorComplement chi) v =
          4 + 0 := by
      simpa using hDegreeSum

    exact Nat.add_left_cancel hCancelable

  have hComplementFalse :
      ∀ e : K5EdgeAddress,
        booleanIndicatorComplement chi e = false :=
    boolean_zero_degree_extremal
      (booleanIndicatorComplement chi)
      hComplementDegree

  intro e
  have hFalse := hComplementFalse e
  cases hChi : chi e <;>
    simp [booleanIndicatorComplement, hChi] at hFalse ⊢

/-- The natural sum of three Boolean values. -/
def booleanThreeTermSum
    (a b c : Bool) : ℕ :=
  booleanIndicatorValue a +
    booleanIndicatorValue b +
    booleanIndicatorValue c

/-- The six possible permutations of one Boolean triple. -/
def booleanTriplePermutation
    (a b c a' b' c' : Bool) : Prop :=
  (a' = a ∧ b' = b ∧ c' = c) ∨
    (a' = a ∧ b' = c ∧ c' = b) ∨
    (a' = b ∧ b' = a ∧ c' = c) ∨
    (a' = b ∧ b' = c ∧ c' = a) ∨
    (a' = c ∧ b' = a ∧ c' = b) ∨
    (a' = c ∧ b' = b ∧ c' = a)

theorem boolean_three_term_sum_permutation
    {a b c a' b' c' : Bool}
    (hPermutation :
      booleanTriplePermutation
        a b c a' b' c') :
    booleanThreeTermSum a b c =
      booleanThreeTermSum a' b' c' := by
  rcases hPermutation with
    h | h | h | h | h | h <;>
    rcases h with ⟨rfl, rfl, rfl⟩ <;>
    simp
      [booleanThreeTermSum,
        Nat.add_comm,
        Nat.add_left_comm,
        Nat.add_assoc]

/-- The complete generic Boolean lemma packet retained in the address state. -/
def boolean_bookkeeping_lemmas : Prop :=
  (∀ chi : BooleanEdgeIndicator,
    ∀ v : EndpointAddress,
      booleanVertexDegree chi v ≤ 4) ∧
    (∀ chi : BooleanEdgeIndicator,
      booleanTotalVertexDegree chi =
        2 * booleanSelectedEdgeCount chi) ∧
    (∀ chi : BooleanEdgeIndicator,
      (∀ v : EndpointAddress,
        booleanVertexDegree chi v = 0) →
      ∀ e : K5EdgeAddress, chi e = false) ∧
    (∀ chi : BooleanEdgeIndicator,
      (∀ v : EndpointAddress,
        booleanVertexDegree chi v = 4) →
      ∀ e : K5EdgeAddress, chi e = true) ∧
    ∀ a b c a' b' c' : Bool,
      booleanTriplePermutation
        a b c a' b' c' →
      booleanThreeTermSum a b c =
        booleanThreeTermSum a' b' c'

