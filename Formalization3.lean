/- # Sub-sub-container 3.4.1: Paired square-root splits and prime-height projection. -/

/- Sub-sub-layer 01 -/
/-
Paper ref: 3.4.1
Sub-sub-box Label: `Paired square-root split: R=sqrt n, D_i=R+h_i, check D_i=n/D_i`
Sub-sub-inputs: `ordered_endpoint_addresses`, `section_3_4_construction_path`
Sub-sub-outputs: `paired_root_split`
Note: `section_3_4_construction_path` is a route marker from the 3.4 opening box, not new arithmetic data. It is read here so the marker does not dangle.
-/
def section_3_4_1_sub_sub_layer_01_sub_sub_box_01_label : String := "Paired square-root split: R=sqrt n, D_i=R+h_i, check D_i=n/D_i"
def section_3_4_1_sub_sub_layer_01_sub_sub_box_01_inputs : List String := ["ordered_endpoint_addresses [construction]", "section_3_4_construction_path [read]"]
def section_3_4_1_sub_sub_layer_01_sub_sub_box_01_outputs : List String := ["paired_root_split [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.1, Sub-sub-layer 01, Sub-sub-box 01
Birth token: paired_root_split

This box owns the exact real root-boundary read of the already ordered natural
witness.  For each selected divisor D it defines

  h = D - sqrt n,
  checkD = n / D,
  curvature = h^2 / D.

The natural product D*checkD=n remains exact.  The real identity

  checkD = sqrt n - h + h^2/D

is derived from D*checkD=n, (sqrt n)^2=n, and D=sqrt n+h.  The curvature
bound is proved explicitly from the root-band inequalities.  No asymptotic
sequence, atom bucket, or support address is introduced in this box.
================================================================================
-/

/-- The real displacement of a selected upper divisor from the root scale. -/
noncomputable def rootDeviation (n D : ℕ) : ℝ :=
  (D : ℝ) - Real.sqrt (n : ℝ)

/-- The exact natural lower partner forced by the same integer `n`. -/
def lowerPartnerNat (n D : ℕ) : ℕ :=
  n / D

/-- The curvature correction `h^2 / D`, where `D = sqrt n + h`. -/
noncomputable def curvatureTerm (n D : ℕ) : ℝ :=
  rootDeviation n D ^ 2 / (D : ℝ)

/--
The exact paired root-boundary data carried by every endpoint of one ordered
five-divisor witness.
-/
def paired_root_split
    (C : ℝ) (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  five_near_root_divisor_witness C n d ∧
    ∀ i : Fin 5,
      (d i : ℝ) =
          Real.sqrt (n : ℝ) + rootDeviation n (d i) ∧
      0 < rootDeviation n (d i) ∧
      rootDeviation n (d i) < C * fourthRootNat n ∧
      d i * lowerPartnerNat n (d i) = n ∧
      (lowerPartnerNat n (d i) : ℝ) =
          Real.sqrt (n : ℝ) - rootDeviation n (d i) +
            curvatureTerm n (d i) ∧
      0 < curvatureTerm n (d i) ∧
      curvatureTerm n (d i) ≤ C ^ 2

/--
Every ordered five-divisor witness has the exact paired square-root split and
the finite curvature bound stated in Section 3.4.1.
-/
theorem derive_paired_root_split
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hW : five_near_root_divisor_witness C n d) :
    paired_root_split C n d := by
  refine ⟨hW, ?_⟩
  intro i

  have hdata := hW.2 i
  have hdvd : d i ∣ n := hdata.1
  have hband : inRootBand C n (d i) := hdata.2

  have hsqrt_nonneg : 0 ≤ Real.sqrt (n : ℝ) :=
    Real.sqrt_nonneg (n : ℝ)

  have hD_pos : 0 < (d i : ℝ) :=
    lt_of_le_of_lt hsqrt_nonneg hband.1

  have hsplit :
      (d i : ℝ) =
        Real.sqrt (n : ℝ) + rootDeviation n (d i) := by
    unfold rootDeviation
    ring

  have hdev_pos : 0 < rootDeviation n (d i) := by
    unfold rootDeviation
    exact sub_pos.mpr hband.1

  have hdev_lt :
      rootDeviation n (d i) < C * fourthRootNat n := by
    unfold rootDeviation
    linarith [hband.2]

  have hprod_nat : d i * lowerPartnerNat n (d i) = n := by
    unfold lowerPartnerNat
    simpa [Nat.mul_comm] using Nat.div_mul_cancel hdvd

  have hprod_real :
      (d i : ℝ) * (lowerPartnerNat n (d i) : ℝ) = (n : ℝ) := by
    have hcast := congrArg (fun x : ℕ => (x : ℝ)) hprod_nat
    simpa only [Nat.cast_mul] using hcast

  have hsqrt_sq : (Real.sqrt (n : ℝ)) ^ 2 = (n : ℝ) :=
    Real.sq_sqrt (Nat.cast_nonneg n)

  have hfourth_nonneg : 0 ≤ fourthRootNat n := by
    unfold fourthRootNat
    exact Real.sqrt_nonneg (Real.sqrt (n : ℝ))

  have hfourth_sq :
      fourthRootNat n ^ 2 = Real.sqrt (n : ℝ) := by
    unfold fourthRootNat
    exact Real.sq_sqrt (Real.sqrt_nonneg (n : ℝ))

  have hpartner_div :
      (lowerPartnerNat n (d i) : ℝ) =
        (n : ℝ) / (d i : ℝ) := by
    apply (eq_div_iff (ne_of_gt hD_pos)).2
    calc
      (lowerPartnerNat n (d i) : ℝ) * (d i : ℝ)
          = (d i : ℝ) * (lowerPartnerNat n (d i) : ℝ) := by
              ring
      _ = (n : ℝ) := hprod_real

  have hpartner_formula :
      (lowerPartnerNat n (d i) : ℝ) =
        Real.sqrt (n : ℝ) - rootDeviation n (d i) +
          curvatureTerm n (d i) := by
    rw [hpartner_div]
    unfold curvatureTerm
    apply (div_eq_iff (ne_of_gt hD_pos)).2
    calc
      (n : ℝ) = (Real.sqrt (n : ℝ)) ^ 2 := hsqrt_sq.symm
      _ =
          (Real.sqrt (n : ℝ) - rootDeviation n (d i)) *
              (d i : ℝ) +
            rootDeviation n (d i) ^ 2 := by
        rw [hsplit]
        ring
      _ =
          (Real.sqrt (n : ℝ) - rootDeviation n (d i) +
              rootDeviation n (d i) ^ 2 / (d i : ℝ)) *
            (d i : ℝ) := by
        field_simp [ne_of_gt hD_pos]

  have hcurvature_pos : 0 < curvatureTerm n (d i) := by
    unfold curvatureTerm
    exact div_pos (pow_pos hdev_pos 2) hD_pos

  have hwindow_pos : 0 < C * fourthRootNat n :=
    lt_trans hdev_pos hdev_lt

  have hC_pos : 0 < C := by
    rcases (mul_pos_iff.mp hwindow_pos) with hpos | hneg
    · exact hpos.1
    · exfalso
      exact (not_lt_of_ge hfourth_nonneg) hneg.2

  have hC_sq_pos : 0 < C ^ 2 :=
    pow_pos hC_pos 2

  have hdev_sq_lt :
      rootDeviation n (d i) ^ 2 <
        (C * fourthRootNat n) ^ 2 := by
    nlinarith [hdev_pos, hdev_lt, hwindow_pos]

  have hnumerator_lt :
      rootDeviation n (d i) ^ 2 < C ^ 2 * (d i : ℝ) := by
    calc
      rootDeviation n (d i) ^ 2
          < (C * fourthRootNat n) ^ 2 := hdev_sq_lt
      _ = C ^ 2 * fourthRootNat n ^ 2 := by
            ring
      _ = C ^ 2 * Real.sqrt (n : ℝ) := by
            rw [hfourth_sq]
      _ < C ^ 2 * (d i : ℝ) :=
            mul_lt_mul_of_pos_left hband.1 hC_sq_pos

  have hcurvature_lt : curvatureTerm n (d i) < C ^ 2 := by
    unfold curvatureTerm
    exact (div_lt_iff₀ hD_pos).2 hnumerator_lt

  exact
    ⟨hsplit,
     hdev_pos,
     hdev_lt,
     hprod_nat,
     hpartner_formula,
     hcurvature_pos,
     le_of_lt hcurvature_lt⟩

/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.1, Sub-sub-layer 01, Sub-sub-box 01

Incoming state shape:
  section_3_4_opening_state C n d

Outgoing state shape:
  paired_root_split C n d

Effect:
  Reconstructs the exact five-divisor witness from the two opening views and
  applies the paired square-root split mathematics to every endpoint.

Public theorem:
  close_paired_root_split

================================================================================
-/

theorem close_paired_root_split
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hopen : section_3_4_opening_state C n d) :
    paired_root_split C n d := by
  have hW : five_near_root_divisor_witness C n d :=
    hopen.1.1
  exact derive_paired_root_split hW


/- Sub-sub-layer 02 -/
/-
Paper ref: 3.4.1
Sub-sub-box Label: `Prime-height projection: alpha_{p,i}=v_p(D_i), support slices S_{p,l}`
Sub-sub-inputs: `paired_root_split`
Sub-sub-outputs: `prime_height_projection`
Note: support addresses are projections of prime-height layers, not free variables.
-/
def section_3_4_1_sub_sub_layer_02_sub_sub_box_02_label : String := "Prime-height projection: alpha_{p,i}=v_p(D_i), support slices S_{p,l}"
def section_3_4_1_sub_sub_layer_02_sub_sub_box_02_inputs : List String := ["paired_root_split [construction]"]
def section_3_4_1_sub_sub_layer_02_sub_sub_box_02_outputs : List String := ["prime_height_projection [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.1, Sub-sub-layer 02, Sub-sub-box 02
Birth token: prime_height_projection

This box introduces the exact prime-height row

  alpha_{p,i} = factorization(D_i)(p)

and its horizontal support slice

  S_{p,ell} = { i | ell <= alpha_{p,i} }.

The nested-chain law is proved directly:

  ell_1 <= ell_2  =>  S_{p,ell_2} subset S_{p,ell_1}.

The result is stated for every natural base `p`, which is stronger than the
prime-base use in the paper.  No atom products are formed here.  In particular,
the thirty-two subset addresses are not treated as free integer variables.
================================================================================
-/

/-- The exponent of the base `p` in the selected endpoint `d i`. -/
noncomputable def primeHeight
    (d : Fin 5 → ℕ) (p : ℕ) (i : Fin 5) : ℕ :=
  (d i).factorization p

/-- The horizontal support slice at one prime-height level. -/
noncomputable def supportSlice
    (d : Fin 5 → ℕ) (p ell : ℕ) : Finset (Fin 5) := by
  classical
  exact Finset.univ.filter fun i => ell ≤ primeHeight d p i

@[simp]
theorem mem_supportSlice
    {d : Fin 5 → ℕ} {p ell : ℕ} {i : Fin 5} :
    i ∈ supportSlice d p ell ↔ ell ≤ primeHeight d p i := by
  classical
  simp [supportSlice]

/--
The exact prime-height projection retained at the end of Section 3.4.1.
Positivity records that the rows are being read from the selected nonzero
upper divisors; the second conjunct is prime-chain legality.
-/
def prime_height_projection (d : Fin 5 → ℕ) : Prop :=
  (∀ i : Fin 5, 0 < d i) ∧
    ∀ p ell₁ ell₂ : ℕ, ell₁ ≤ ell₂ →
      supportSlice d p ell₂ ⊆ supportSlice d p ell₁

/--
The paired root split supplies positive endpoints, and the support slices of
each factorization row are nested by their height threshold.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.1, Sub-sub-layer 02, Sub-sub-box 02

Incoming state shape:
  paired_root_split C n d

Outgoing state shape:
  prime_height_projection d

Effect:
  Projects each selected endpoint into its exact prime-height support slices.

Public theorem:
  derive_prime_height_projection

================================================================================
-/

theorem derive_prime_height_projection
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hsplit : paired_root_split C n d) :
    prime_height_projection d := by
  classical
  refine ⟨?_, ?_⟩
  · intro i
    have hdata := hsplit.1.2 i
    have hband : inRootBand C n (d i) := hdata.2
    apply Nat.pos_of_ne_zero
    intro hzero
    have hneg : Real.sqrt (n : ℝ) < 0 := by
      simpa [hzero] using hband.1
    exact (not_lt_of_ge (Real.sqrt_nonneg (n : ℝ))) hneg
  · intro p ell₁ ell₂ hell i hi
    have hi_height : ell₂ ≤ primeHeight d p i := by
      simpa [supportSlice] using hi
    have hlow_height : ell₁ ≤ primeHeight d p i :=
      le_trans hell hi_height
    simpa [supportSlice] using hlow_height

/- # Sub-sub-container 3.4.2: Full atom model. -/

/- Sub-sub-layer 01 -/
/-
Paper ref: 3.4.2
Sub-sub-box Label: `Full atom model: X_S(W), upper reads, lower partner reads, global product, and mandatory empty atom`
Sub-sub-inputs: `paired_root_split`, `prime_height_projection`
Sub-sub-outputs: `full_atom_model`
-/
def section_3_4_2_sub_sub_layer_01_sub_sub_box_01_label : String := "Full atom model: X_S(W), upper reads, lower partner reads, global product, and mandatory empty atom"
def section_3_4_2_sub_sub_layer_01_sub_sub_box_01_inputs : List String := ["paired_root_split [read]", "prime_height_projection [construction]"]
def section_3_4_2_sub_sub_layer_01_sub_sub_box_01_outputs : List String := ["full_atom_model [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 3.4.2, Sub-sub-layer 01, Sub-sub-box 01
Birth token: full_atom_model

This box constructs the exact finite atom family from prime-height tokens.
It does not introduce normalized masses, asymptotic sequences, clipped faces,
or any later routing object.

The mathematical dependency is slightly wider than the original metadata row:
  * `paired_root_split` supplies the same witness, divisibility, and n != 0;
  * `prime_height_projection` supplies positive endpoints and nested support
    slices.

The canonical atom at a support address S is built from all prime-height tokens
(p, ell) with 1 <= ell <= v_p(n) whose support slice equals S.  Thus the empty
address is part of the same family, rather than a separately selected factor.
================================================================================
-/

/-- The endpoint set V={0,1,2,3,4}. -/
def endpointUniverse : Finset (Fin 5) :=
  Finset.univ

/-- A visible support address is one of the thirty-two subsets of V. -/
abbrev SupportAddress := Finset (Fin 5)

/-- The finite alphabet of all support addresses. -/
def supportAddresses : Finset SupportAddress :=
  endpointUniverse.powerset

@[simp]
theorem mem_supportAddresses (S : SupportAddress) :
    S ∈ supportAddresses := by
  simp [supportAddresses, endpointUniverse]

/-- The levels 1,...,v_p(n) of one prime-height row. -/
noncomputable def primeTokenLevels (n p : ℕ) : Finset ℕ :=
  Finset.Icc 1 (n.factorization p)

@[simp]
theorem mem_primeTokenLevels
    {n p ell : ℕ} :
    ell ∈ primeTokenLevels n p ↔
      1 ≤ ell ∧ ell ≤ n.factorization p := by
  simp [primeTokenLevels]

/-- The support address carried by the prime token (p,ell). -/
noncomputable def primeTokenAddress
    (d : Fin 5 → ℕ) (p ell : ℕ) : SupportAddress :=
  supportSlice d p ell

@[simp]
theorem mem_primeTokenAddress
    {d : Fin 5 → ℕ} {p ell : ℕ} {i : Fin 5} :
    i ∈ primeTokenAddress d p ell ↔ ell ≤ primeHeight d p i := by
  simp [primeTokenAddress]

/-- Number of levels in L carrying the visible address S. -/
noncomputable def addressFiberCount
    (L : Finset ℕ)
    (addr : ℕ → SupportAddress)
    (S : SupportAddress) : ℕ :=
  (L.filter fun ell => addr ell = S).card

/--
Finite fiber-count identity. Every level has exactly one support address, so
summing the fiber sizes over addresses satisfying `Q` counts exactly the levels
whose address satisfies `Q`.
-/
theorem sum_addressFiberCount_filter
    (L : Finset ℕ)
    (addr : ℕ → SupportAddress)
    (Q : SupportAddress → Prop)
    [DecidablePred Q] :
    (∑ S ∈ supportAddresses.filter Q,
        addressFiberCount L addr S) =
      (L.filter fun ell => Q (addr ell)).card := by
  classical
  induction L using Finset.induction_on with
  | empty =>
      simp [addressFiberCount]

  | @insert ell L hell ih =>
      have hfiber (S : SupportAddress) :
          addressFiberCount (insert ell L) addr S =
            (if addr ell = S then 1 else 0) +
              addressFiberCount L addr S := by
        unfold addressFiberCount
        by_cases haddr : addr ell = S
        · have hell_fiber :
              ell ∉ L.filter (fun x => addr x = S) := by
            intro hmem
            exact hell (Finset.mem_filter.mp hmem).1

          rw [Finset.filter_insert]
          simp only [if_pos haddr]
          rw [Finset.card_insert_of_notMem hell_fiber]
          exact Nat.add_comm _ _

        · rw [Finset.filter_insert]
          simp only [if_neg haddr, zero_add]

      by_cases hQ : Q (addr ell)

      · have haddr_mem :
            addr ell ∈ supportAddresses.filter Q := by
          simp [hQ]

        have hindicator :
            (∑ S ∈ supportAddresses.filter Q,
                if addr ell = S then 1 else 0) = 1 := by
          rw [Finset.sum_eq_single (addr ell)]
          · simp
          · intro S _hS hne
            simp [Ne.symm hne]
          · intro hnot
            exact (hnot haddr_mem).elim

        have hell_Q :
            ell ∉ L.filter (fun x => Q (addr x)) := by
          intro hmem
          exact hell (Finset.mem_filter.mp hmem).1

        calc
          (∑ S ∈ supportAddresses.filter Q,
              addressFiberCount (insert ell L) addr S)
              =
              (∑ S ∈ supportAddresses.filter Q,
                  ((if addr ell = S then 1 else 0) +
                    addressFiberCount L addr S)) := by
                apply Finset.sum_congr rfl
                intro S _hS
                exact hfiber S

          _ =
              (∑ S ∈ supportAddresses.filter Q,
                  if addr ell = S then 1 else 0) +
                (∑ S ∈ supportAddresses.filter Q,
                  addressFiberCount L addr S) := by
                rw [Finset.sum_add_distrib]

          _ = 1 + (L.filter fun x => Q (addr x)).card := by
                rw [hindicator, ih]

          _ = ((insert ell L).filter fun x => Q (addr x)).card := by
                rw [Finset.filter_insert]
                simp only [if_pos hQ]
                rw [Finset.card_insert_of_notMem hell_Q]
                exact Nat.add_comm _ _
      · have haddr_not_mem :
            addr ell ∉ supportAddresses.filter Q := by
          simp [hQ]

        have hindicator :
            (∑ S ∈ supportAddresses.filter Q,
                if addr ell = S then 1 else 0) = 0 := by
          apply Finset.sum_eq_zero
          intro S hS
          have hne : addr ell ≠ S := by
            intro heq
            subst S
            exact haddr_not_mem hS
          simp [hne]

        calc
          (∑ S ∈ supportAddresses.filter Q,
              addressFiberCount (insert ell L) addr S)
              =
              (∑ S ∈ supportAddresses.filter Q,
                  ((if addr ell = S then 1 else 0) +
                    addressFiberCount L addr S)) := by
                apply Finset.sum_congr rfl
                intro S _hS
                exact hfiber S

          _ =
              (∑ S ∈ supportAddresses.filter Q,
                  if addr ell = S then 1 else 0) +
                (∑ S ∈ supportAddresses.filter Q,
                  addressFiberCount L addr S) := by
                rw [Finset.sum_add_distrib]

          _ = (L.filter fun x => Q (addr x)).card := by
                rw [hindicator, zero_add, ih]

          _ = ((insert ell L).filter fun x => Q (addr x)).card := by
                rw [Finset.filter_insert]
                simp only [if_neg hQ]

/-- Multiplicity of p in the atom bucket with visible address S. -/
noncomputable def atomMultiplicity
    (n : ℕ) (d : Fin 5 → ℕ) (S : SupportAddress) (p : ℕ) : ℕ :=
  addressFiberCount
    (primeTokenLevels n p)
    (primeTokenAddress d p)
    S

/-- A nonzero atom multiplicity can occur only at a prime divisor of n. -/
theorem atomMultiplicity_support
    (n : ℕ) (d : Fin 5 → ℕ) (S : SupportAddress) {p : ℕ}
    (hp : atomMultiplicity n d S p ≠ 0) :
    p ∈ n.primeFactors := by
  have hfactor : n.factorization p ≠ 0 := by
    intro hzero
    apply hp
    simp [atomMultiplicity, addressFiberCount, primeTokenLevels, hzero]
  have hp_support : p ∈ n.factorization.support :=
    Finsupp.mem_support_iff.mpr hfactor
  simpa using hp_support

/-- The factorization row of one canonical atom bucket. -/
noncomputable def atomFactorization
    (n : ℕ) (d : Fin 5 → ℕ) (S : SupportAddress) : ℕ →₀ ℕ :=
  Finsupp.onFinset
    n.primeFactors
    (atomMultiplicity n d S)
    (by
      intro p hp
      exact atomMultiplicity_support n d S hp)

@[simp]
theorem atomFactorization_apply
    (n : ℕ) (d : Fin 5 → ℕ) (S : SupportAddress) (p : ℕ) :
    atomFactorization n d S p = atomMultiplicity n d S p := by
  simp [atomFactorization]

/-- Every base in the support of an atom factorization is prime. -/
theorem atomFactorization_support_prime
    (n : ℕ) (d : Fin 5 → ℕ) (S : SupportAddress)
    (p : ℕ)
    (hp : p ∈ (atomFactorization n d S).support) :
    Nat.Prime p := by
  have hne : atomFactorization n d S p ≠ 0 :=
    Finsupp.mem_support_iff.mp hp
  have hmul : atomMultiplicity n d S p ≠ 0 := by
    simpa using hne
  exact Nat.prime_of_mem_primeFactors
    (atomMultiplicity_support n d S hmul)

/--
The canonical atom bucket X_S.  It is the product of p^m over the prime bases,
where m counts the height levels of p whose support address is S.
-/
noncomputable def atomBucket
    (n : ℕ) (d : Fin 5 → ℕ) (S : SupportAddress) : ℕ :=
  (atomFactorization n d S).prod fun p e => p ^ e

/-- The factorization of X_S is exactly its prime-token multiplicity row. -/
theorem atomBucket_factorization
    (n : ℕ) (d : Fin 5 → ℕ) (S : SupportAddress) :
    (atomBucket n d S).factorization = atomFactorization n d S := by
  unfold atomBucket
  exact Nat.prod_pow_factorization_eq_self
    (atomFactorization_support_prime n d S)

@[simp]
theorem atomBucket_factorization_apply
    (n : ℕ) (d : Fin 5 → ℕ) (S : SupportAddress) (p : ℕ) :
    (atomBucket n d S).factorization p = atomMultiplicity n d S p := by
  have h := congrArg (fun f : ℕ →₀ ℕ => f p)
    (atomBucket_factorization n d S)
  simpa using h

/-- Every canonical atom bucket is a positive natural number. -/
theorem atomBucket_pos
    (n : ℕ) (d : Fin 5 → ℕ) (S : SupportAddress) :
    0 < atomBucket n d S := by
  unfold atomBucket
  exact Nat.prod_pow_pos_of_zero_notMem_support
    (fun hzero =>
      Nat.not_prime_zero
        (atomFactorization_support_prime n d S 0 hzero))

/-- Product of atom buckets whose addresses contain endpoint i. -/
noncomputable def upperAtomRead
    (n : ℕ) (d : Fin 5 → ℕ) (i : Fin 5) : ℕ :=
  ∏ S ∈ supportAddresses.filter (fun S => i ∈ S), atomBucket n d S

/-- Product of atom buckets whose addresses omit endpoint i. -/
noncomputable def lowerAtomRead
    (n : ℕ) (d : Fin 5 → ℕ) (i : Fin 5) : ℕ :=
  ∏ S ∈ supportAddresses.filter (fun S => i ∉ S), atomBucket n d S

/-- Product of all thirty-two atom buckets, including the empty bucket. -/
noncomputable def globalAtomRead
    (n : ℕ) (d : Fin 5 → ℕ) : ℕ :=
  ∏ S ∈ supportAddresses, atomBucket n d S

/-- The total multiplicity of p across all support-address buckets is v_p(n). -/
theorem sum_atomMultiplicity_all
    (n : ℕ) (d : Fin 5 → ℕ) (p : ℕ) :
    (∑ S ∈ supportAddresses, atomMultiplicity n d S p) =
      n.factorization p := by
  have h := sum_addressFiberCount_filter
    (primeTokenLevels n p)
    (primeTokenAddress d p)
    (fun _ => True)
  simpa [atomMultiplicity, primeTokenLevels] using h

/--
For one endpoint i, the total p-multiplicity of addresses containing i is
v_p(d_i).
-/
theorem sum_atomMultiplicity_upper
    {n : ℕ} {d : Fin 5 → ℕ} {i : Fin 5} {p : ℕ}
    (hn : n ≠ 0)
    (hdi_pos : 0 < d i)
    (hdi_dvd : d i ∣ n) :
    (∑ S ∈ supportAddresses.filter (fun S => i ∈ S),
        atomMultiplicity n d S p) =
      primeHeight d p i := by
  have hfac_le : (d i).factorization ≤ n.factorization :=
    (Nat.factorization_le_iff_dvd hdi_pos.ne' hn).2 hdi_dvd
  have hheight_le : primeHeight d p i ≤ n.factorization p := by
    exact hfac_le p
  have hlevels :
      (primeTokenLevels n p).filter
          (fun ell => i ∈ primeTokenAddress d p ell) =
        Finset.Icc 1 (primeHeight d p i) := by
    ext ell
    simp only [Finset.mem_filter, mem_primeTokenLevels,
      mem_primeTokenAddress, Finset.mem_Icc]
    constructor
    · rintro ⟨⟨hell_one, _hell_n⟩, hell_height⟩
      exact ⟨hell_one, hell_height⟩
    · rintro ⟨hell_one, hell_height⟩
      exact ⟨⟨hell_one, le_trans hell_height hheight_le⟩, hell_height⟩
  unfold atomMultiplicity
  rw [sum_addressFiberCount_filter]
  rw [hlevels]
  simp

/--
For one endpoint i, the total p-multiplicity of addresses omitting i is the
factorization exponent of the lower partner n/d_i.
-/
theorem sum_atomMultiplicity_lower
    {n : ℕ} {d : Fin 5 → ℕ} {i : Fin 5} {p : ℕ}
    (hn : n ≠ 0)
    (hdi_pos : 0 < d i)
    (hdi_dvd : d i ∣ n) :
    (∑ S ∈ supportAddresses.filter (fun S => i ∉ S),
        atomMultiplicity n d S p) =
      (n / d i).factorization p := by
  have hfac_le : (d i).factorization ≤ n.factorization :=
    (Nat.factorization_le_iff_dvd hdi_pos.ne' hn).2 hdi_dvd
  have hheight_le : primeHeight d p i ≤ n.factorization p := by
    exact hfac_le p
  have hlevels :
      (primeTokenLevels n p).filter
          (fun ell => i ∉ primeTokenAddress d p ell) =
        Finset.Ioc (primeHeight d p i) (n.factorization p) := by
    ext ell
    simp only [Finset.mem_filter, mem_primeTokenLevels,
      mem_primeTokenAddress, Finset.mem_Ioc, not_le]
    constructor
    · rintro ⟨⟨_hell_one, hell_n⟩, hheight_lt⟩
      exact ⟨hheight_lt, hell_n⟩
    · rintro ⟨hheight_lt, hell_n⟩
      have hell_pos : 0 < ell :=
        lt_of_le_of_lt (Nat.zero_le (primeHeight d p i)) hheight_lt
      have hell_one : 1 ≤ ell := hell_pos
      exact ⟨⟨hell_one, hell_n⟩, hheight_lt⟩
  unfold atomMultiplicity
  rw [sum_addressFiberCount_filter]
  rw [hlevels]
  have hdiv := congrArg (fun f : ℕ →₀ ℕ => f p)
    (Nat.factorization_div hdi_dvd)
  simpa [primeHeight] using hdiv.symm

/-- Positivity of the upper atom read. -/
theorem upperAtomRead_pos
    (n : ℕ) (d : Fin 5 → ℕ) (i : Fin 5) :
    0 < upperAtomRead n d i := by
  unfold upperAtomRead
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro S _hS
    exact atomBucket_pos n d S)

/-- Positivity of the lower atom read. -/
theorem lowerAtomRead_pos
    (n : ℕ) (d : Fin 5 → ℕ) (i : Fin 5) :
    0 < lowerAtomRead n d i := by
  unfold lowerAtomRead
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro S _hS
    exact atomBucket_pos n d S)

/-- Positivity of the global atom read. -/
theorem globalAtomRead_pos
    (n : ℕ) (d : Fin 5 → ℕ) :
    0 < globalAtomRead n d := by
  unfold globalAtomRead
  exact (CanonicallyOrderedAdd.prod_pos).2 (by
    intro S _hS
    exact atomBucket_pos n d S)

/-- A paired root split cannot occur at n=0. -/
theorem paired_root_split_n_ne_zero
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hsplit : paired_root_split C n d) :
    n ≠ 0 := by
  intro hn
  have hupper := (hsplit.1.2 (0 : Fin 5)).2.2
  have hneg : (d 0 : ℝ) < 0 := by
    simpa [hn, fourthRootNat] using hupper
  exact (not_lt_of_ge (Nat.cast_nonneg (d 0))) hneg

/-- Factorization read of the upper atom product at endpoint i. -/
theorem upperAtomRead_factorization
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hsplit : paired_root_split C n d)
    (hproj : prime_height_projection d)
    (i : Fin 5) (p : ℕ) :
    (upperAtomRead n d i).factorization p = primeHeight d p i := by
  unfold upperAtomRead
  rw [Nat.factorization_prod_apply]
  · simp_rw [atomBucket_factorization_apply]
    exact sum_atomMultiplicity_upper
      (paired_root_split_n_ne_zero hsplit)
      (hproj.1 i)
      ((hsplit.1.2 i).1)
  · intro S _hS
    exact (atomBucket_pos n d S).ne'

/-- Factorization read of the lower atom product at endpoint i. -/
theorem lowerAtomRead_factorization
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hsplit : paired_root_split C n d)
    (hproj : prime_height_projection d)
    (i : Fin 5) (p : ℕ) :
    (lowerAtomRead n d i).factorization p =
      (n / d i).factorization p := by
  unfold lowerAtomRead
  rw [Nat.factorization_prod_apply]
  · simp_rw [atomBucket_factorization_apply]
    exact sum_atomMultiplicity_lower
      (paired_root_split_n_ne_zero hsplit)
      (hproj.1 i)
      ((hsplit.1.2 i).1)
  · intro S _hS
    exact (atomBucket_pos n d S).ne'

/-- Factorization read of the product of all atom buckets. -/
theorem globalAtomRead_factorization
    {n : ℕ} {d : Fin 5 → ℕ} (p : ℕ) :
    (globalAtomRead n d).factorization p = n.factorization p := by
  unfold globalAtomRead
  rw [Nat.factorization_prod_apply]
  · simp_rw [atomBucket_factorization_apply]
    exact sum_atomMultiplicity_all n d p
  · intro S _hS
    exact (atomBucket_pos n d S).ne'

/-- Exact upper-divisor reconstruction from the canonical atom buckets. -/
theorem upperAtomRead_eq_endpoint
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hsplit : paired_root_split C n d)
    (hproj : prime_height_projection d)
    (i : Fin 5) :
    upperAtomRead n d i = d i := by
  apply Nat.eq_of_factorization_eq
    (upperAtomRead_pos n d i).ne'
    (hproj.1 i).ne'
  intro p
  rw [upperAtomRead_factorization hsplit hproj i p]
  rfl

/-- Exact lower-partner reconstruction from the complementary atom buckets. -/
theorem lowerAtomRead_eq_partner
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hsplit : paired_root_split C n d)
    (hproj : prime_height_projection d)
    (i : Fin 5) :
    lowerAtomRead n d i = n / d i := by
  have hlower_pos : 0 < n / d i := by
    have hprod : d i * (n / d i) = n := by
      simpa [lowerPartnerNat] using (hsplit.2 i).2.2.2.1
    by_contra hnot
    have hzero : n / d i = 0 := Nat.eq_zero_of_not_pos hnot
    have hn_zero : n = 0 := by
      rw [← hprod, hzero, Nat.mul_zero]
    exact paired_root_split_n_ne_zero hsplit hn_zero
  apply Nat.eq_of_factorization_eq
    (lowerAtomRead_pos n d i).ne'
    hlower_pos.ne'
  intro p
  exact lowerAtomRead_factorization hsplit hproj i p

/-- Exact reconstruction of n from the product of all atom buckets. -/
theorem globalAtomRead_eq_n
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hsplit : paired_root_split C n d) :
    globalAtomRead n d = n := by
  have hn : n ≠ 0 := paired_root_split_n_ne_zero hsplit
  apply Nat.eq_of_factorization_eq
    (globalAtomRead_pos n d).ne'
    hn
  intro p
  exact globalAtomRead_factorization p

/--
The exact full atom model.  All components are canonical definitions from the
same witness.  In particular, X_empty is present and positive, and the support
slices for each prime base remain nested.
-/
def full_atom_model
    (n : ℕ) (d : Fin 5 → ℕ) : Prop :=
  (∀ S ∈ supportAddresses, 0 < atomBucket n d S) ∧
    0 < atomBucket n d ∅ ∧
    (∀ i : Fin 5, d i = upperAtomRead n d i) ∧
    (∀ i : Fin 5, n / d i = lowerAtomRead n d i) ∧
    n = globalAtomRead n d ∧
    (∀ p ell₁ ell₂ : ℕ, ell₁ ≤ ell₂ →
      supportSlice d p ell₂ ⊆ supportSlice d p ell₁)

/--
The paired root split and prime-height projection produce the canonical full
atom model with exact upper, lower, and global product reads.
-/
/-
================================================================================
STATE-SHAPE BATCH
Section 3.4.2, Sub-sub-layer 01, Sub-sub-box 01

Incoming state shape:
  paired_root_split C n d
  prime_height_projection d

Outgoing state shape:
  full_atom_model n d

Effect:
  Materializes the complete support-address atom model and all upper, lower,
  global, positivity, and chain reads over the same witness.

Public theorem:
  derive_full_atom_model

================================================================================
-/

theorem derive_full_atom_model
    {C : ℝ} {n : ℕ} {d : Fin 5 → ℕ}
    (hsplit : paired_root_split C n d)
    (hproj : prime_height_projection d) :
    full_atom_model n d := by
  refine ⟨?_, atomBucket_pos n d ∅, ?_, ?_, ?_, hproj.2⟩
  · intro S _hS
    exact atomBucket_pos n d S
  · intro i
    exact (upperAtomRead_eq_endpoint hsplit hproj i).symm
  · intro i
    exact (lowerAtomRead_eq_partner hsplit hproj i).symm
  · exact (globalAtomRead_eq_n hsplit).symm

