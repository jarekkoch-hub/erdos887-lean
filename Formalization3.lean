theorem open_adjacent_affine_ratios
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hContext : ratio_collapse_context C nSeq dSeq opening)
    (hAffine :
      SameKEndpointPolynomial.A_e_affine_pencil C nSeq dSeq opening)
    (hSource :
      same_K_prefix_average_formula_source C nSeq dSeq opening) :
    adjacent_affine_ratios C nSeq dSeq opening := by
  have hContextState : ratio_collapse_context C nSeq dSeq opening :=
    hContext
  have hAffineState :
      SameKEndpointPolynomial.A_e_affine_pencil C nSeq dSeq opening :=
    hAffine
  have hSourceState :
      same_K_prefix_average_formula_source C nSeq dSeq opening :=
    hSource
  rcases hContext.2.2.2 with
    ⟨D, survivorData, affineData, polynomialData, productRowData, hContextAt⟩
  have hContextAtState :
      ratio_collapse_context_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hContextAt
  rcases hContextAt with ⟨_hVertRouteAt, hAffineAt, hVertAt⟩
  rcases
      hSource survivorData affineData polynomialData productRowData
        hAffineAt hVertAt with
    ⟨sourceData, hSourceAt⟩
  have hSourceAtState :
      same_K_prefix_average_formula_source_at
        survivorData affineData polynomialData productRowData sourceData :=
    hSourceAt
  rcases hSourceAt with
    ⟨_hSurvivorIndex, _hAffineIndex, _hPolynomialIndex, _hProductRowIndex,
      hPositive, hRatio, _hVertexFacts, _hPrefixFacts, _hConversionRules⟩
  have hQuotient :
      ∀ k : Section6.AdjacentGapAddress,
        adjacentAffineRatio sourceData k =
          SameKEndpointPolynomial.sameKAffineOffset affineData k /
            SameKEndpointPolynomial.sameKAffineKappa affineData k := by
    intro k
    have hKappaNonzero :
        SameKEndpointPolynomial.sameKAffineKappa affineData k ≠ 0 :=
      ne_of_gt (hPositive k)
    exact (eq_div_iff hKappaNonzero).2 (hRatio k).symm
  have hRatiosAt :
      adjacent_affine_ratios_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData sourceData :=
    ⟨hContextAtState, hSourceAtState, hQuotient⟩
