Effect:
  Calls every public Section 9 construction batch in paper order.  It opens the
  exact low-rank coloring route, constructs the finite branch family, closes
  the projective prefix conflicts, fixes one survivor `K`, assembles `FG_mono`
  over that same `K`, and installs the same-`K` synchronization capability.
  No affine source, endpoint polynomial, product-row packet, shared state, or
  terminal theorem is opened.

Public theorem:
  close_prefix_conflict_section_9
================================================================================
-/

theorem close_prefix_conflict_section_9
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hLowRoute :
      RankTrichotomy.low_rank_route C nSeq dSeq opening)
    (hS0 :
      Section6.Legacy.legacy_S_0
        C nSeq dSeq
        (openingTSeq opening)
        (openingBSeq opening)
        (openingZSeq opening))
    (hCertificate :
      finite_prefix_certificate C nSeq dSeq opening) :
    prefix_conflict_outputs C nSeq dSeq opening := by
  have hRank :
      RankTrichotomy.S_rank C nSeq dSeq opening :=
    RankTrichotomy.low_rank_route_to_S_rank hLowRoute
  have hContext :
      prefix_layer_context C nSeq dSeq opening :=
    build_prefix_layer_context hLowRoute hS0 hCertificate
  have hRegular :
      regular_coloring_problem C nSeq dSeq opening :=
    build_regular_coloring_problem hContext hRank hS0
  have hBranchFamily :
      degree_two_branch_family C nSeq dSeq opening :=
    build_degree_two_branch_family hRegular
  have hAlternatives :
      regular_coloring_alternatives C nSeq dSeq opening :=
    build_regular_coloring_alternatives hRegular hBranchFamily
  have hPattern :
      frozen_coefficient_pattern C nSeq dSeq opening :=
    build_frozen_coefficient_pattern hContext hRank hS0
  have hInterval :
      prefix_interval_sector_data C nSeq dSeq opening :=
    build_prefix_interval_sector_data hPattern hS0
  have hModel :
      projective_cone_model C nSeq dSeq opening :=
    build_projective_cone_model hContext
  have hConflictType :
      prefix_cone_conflict_datum_type C nSeq dSeq opening :=
    build_prefix_cone_conflict_datum_type hModel hInterval hRank
  have hConflictImpossible :
      prefix_cone_conflict_impossible C nSeq dSeq opening :=
    build_prefix_cone_conflict_impossible hConflictType hModel
  have hFamily :
      finite_prefix_conflict_family C nSeq dSeq opening :=
    build_finite_prefix_conflict_family
      hBranchFamily hCertificate hConflictType
  have hEliminated :
      degree_two_branches_eliminated C nSeq dSeq opening :=
    build_degree_two_branches_eliminated hFamily hConflictImpossible
  have hComponents :
      K_components C nSeq dSeq opening :=
    build_K_components
      hRegular hAlternatives hInterval hPattern
      hRank hFamily hEliminated
  have hK :
      K C nSeq dSeq opening :=
    build_K hRank hFamily hComponents
  have hMono :
      FG_mono C nSeq dSeq opening :=
    build_FG_mono hRank hRegular hAlternatives hK
  have hSameK :
      same_k_synchronization C nSeq dSeq opening :=
    build_same_k_synchronization hK
  exact ⟨hK, hMono, hSameK⟩


