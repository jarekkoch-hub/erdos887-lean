theorem build_product_row_coefficient_data
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    (hP :
      SameKEndpointPolynomial.endpoint_polynomial_P_e
        C nSeq dSeq opening)
    (hRows : product_difference_row_source C nSeq dSeq opening)
    (hTable : endpoint_coefficient_table C nSeq dSeq opening)
    (hVanish : coefficient_vanishings C nSeq dSeq opening)
    (hLead : L_lead C nSeq dSeq opening)
    (hVert : V_vert C nSeq dSeq opening)
    (hCub : C_cub C nSeq dSeq opening) :
    product_row_coefficient_data C nSeq dSeq opening := by
  rcases hP.2 with
    ⟨D, survivorData, affineData, polynomialData,
      hAffineAt, hPolynomialAt, hIdentityAt⟩
  have hIdentityPacketAt :
      SameKEndpointPolynomial.same_K_endpoint_polynomial_identity_data_at
        C nSeq dSeq opening
        survivorData affineData polynomialData :=
    ⟨hAffineAt, hPolynomialAt, hIdentityAt⟩
  rcases
      hRows.2 survivorData affineData polynomialData hIdentityPacketAt with
    ⟨productRowData, hRowsAt⟩
  have hTableAt :
      endpoint_coefficient_table_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hTable.2.2
      survivorData affineData polynomialData productRowData hRowsAt
  have hVanishAt :
      coefficient_vanishings_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hVanish.2.2
      survivorData affineData polynomialData productRowData hTableAt
  have hSemanticsState :
      row_conversion_semantics C nSeq dSeq opening :=
    hLead.2.1
  have hSemanticsAt :
      row_conversion_semantics_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hSemanticsState.2.2
      survivorData affineData polynomialData productRowData hVanishAt
  have hLeadAt :
      L_lead_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hLead.2.2
      survivorData affineData polynomialData productRowData hSemanticsAt
  have hVertAt :
      V_vert_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hVert.2.2.2
      survivorData affineData polynomialData productRowData hSemanticsAt
  have hConstantState :
      endpoint_constant_identity C nSeq dSeq opening :=
    hCub.1
  have hConstantAt :
      endpoint_constant_identity_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hConstantState.2.2
      survivorData affineData polynomialData productRowData hVanishAt
  have hCubAt :
      C_cub_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    hCub.2.2
      survivorData affineData polynomialData productRowData
      hConstantAt hSemanticsAt
  have hPacketAt :
      product_row_coefficient_data_at
        C nSeq dSeq opening
        survivorData affineData polynomialData productRowData :=
    ⟨hIdentityPacketAt, hRowsAt, hTableAt,
      hVanishAt, hLeadAt, hVertAt, hCubAt⟩
  exact
    ⟨D, survivorData, affineData, polynomialData, productRowData, hPacketAt⟩


