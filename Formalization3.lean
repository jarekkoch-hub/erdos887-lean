    neighbor_ratio_equalities C nSeq dSeq opening := by
  have hBalancesState : weighted_balances C nSeq dSeq opening :=
    hBalances
  have hRatiosState : adjacent_affine_ratios C nSeq dSeq opening :=
    hRatios
