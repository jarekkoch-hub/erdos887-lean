/-- The same-line and positive-cone relations of one abstract projective model. -/
abbrev ProjectiveConeModelData (D : Type) :=
  PrefixSameLineRelation D × PrefixPositiveConeRelation D

/-- The same-line relation of the retained projective model. -/
def projectiveConeSameLine
    {D : Type}
    (model : ProjectiveConeModelData D) :
    PrefixSameLineRelation D :=
  model.1

/-- The positive-cone relation of the retained projective model. -/
def projectiveConePositiveCone
    {D : Type}
    (model : ProjectiveConeModelData D) :
    PrefixPositiveConeRelation D :=
  model.2

/-- The exact projective model read from one finite certificate payload. -/
def projectiveConeModelFromCertificate
    {D : Type}
    (certificateData : FinitePrefixCertificateSourceData D) :
    ProjectiveConeModelData D :=
  ⟨prefixCertificateSameLine certificateData,
    prefixCertificatePositiveCone certificateData⟩

/-- The endpoint-exclusion law retained by one abstract projective model. -/
def projective_cone_model_at
    {D : Type}
    (model : ProjectiveConeModelData D) : Prop :=
  ∀ X Y Z : D,
    ¬ projectiveConeSameLine model X Y →
      projectiveConePositiveCone model X Y Z →
        ¬ projectiveConeSameLine model Z X ∧
          ¬ projectiveConeSameLine model Z Y

/--
The two cases of the branch-forced endpoint alternative are both excluded by
one retained projective model.
-/
theorem projective_cone_endpoint_exclusion
    {D : Type}
    {model : ProjectiveConeModelData D}
    {X Y Z : D}
    (hModel : projective_cone_model_at model)
    (hNonparallel : ¬ projectiveConeSameLine model X Y)
    (hCone : projectiveConePositiveCone model X Y Z)
    (hEndpoint :
      projectiveConeSameLine model Z X ∨
        projectiveConeSameLine model Z Y) :
    False := by
  rcases hModel X Y Z hNonparallel hCone with
    ⟨hNotLeft, hNotRight⟩
  rcases hEndpoint with hLeft | hRight
  · exact hNotLeft hLeft
  · exact hNotRight hRight

/--
The Section 9.3 projective-model output.

The universal field is intentional.  It says that every exact certificate
payload admitted by the already-fixed prefix-layer batch exposes its own model
with the endpoint-exclusion law.  The box does not existentially select a
second direction type or a second certificate payload.
-/
def projective_cone_model
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  prefix_layer_context C nSeq dSeq opening ∧
    ∀ leadingData : RankTrichotomy.LeadingDescendantExtractionData,
      ∀ regimeData : RankTrichotomy.RankRegimeSourceData,
        ∀ D : Type,
          ∀ certificateData : FinitePrefixCertificateSourceData D,
            RankTrichotomy.rank_source
                opening leadingData regimeData →
              RankTrichotomy.S_rank_components
                  C nSeq dSeq opening leadingData regimeData →
                RankTrichotomy.low_rank_coloring_packet
                    C nSeq dSeq opening leadingData regimeData →
                  Section6.Legacy.legacy_S_0
                      C nSeq dSeq
                      (openingTSeq opening)
                      (openingBSeq opening)
                      (openingZSeq opening) →
                    finite_prefix_certificate_at
                        (RankTrichotomy.lowRankSelectedColoring
                          (RankTrichotomy.lowRankSourceData regimeData))
                        certificateData →
                      projective_cone_model_at
                        (projectiveConeModelFromCertificate certificateData)

