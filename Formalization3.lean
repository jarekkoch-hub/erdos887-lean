/- Sub-layer 02 -/
/-
Paper ref: 8.1
Sub-box Label: `Quadratic descent table Q_desc: finite descendant identities from algebraic comparison of compatible reduced cubic rows, each with fixed three-edge active support after common sector factors are matched and cancelled`
Sub-inputs: `R_cub`
Sub-outputs: `Q_desc`
Note: Finite algebraic source component; no limiting argument and no hidden terminal endpoint argument. (E_can, L_sector) => R_cub => Q_desc.
-/
def rank_trichotomy_section_8_1_sub_layer_02_sub_box_02_label : String := "Quadratic descent table Q_desc: finite descendant identities from algebraic comparison of compatible reduced cubic rows, each with fixed three-edge active support after common sector factors are matched and cancelled"
def rank_trichotomy_section_8_1_sub_layer_02_sub_box_02_inputs : List String := ["R_cub [construction]"]
def rank_trichotomy_section_8_1_sub_layer_02_sub_box_02_outputs : List String := ["Q_desc [birth]"]

/-
================================================================================
EXECUTABLE BOX
Section 8.1, Sub-layer 02, Sub-box 02

Birth token: Q_desc

For each ordered triangle `u < v < w`, the three reduced cubic rows on its
edges are aligned.  Their two outside sectors form the three quadratic
coefficients.  The resulting row has active support exactly on `uv`, `uw`, and
`vw`.
================================================================================
-/

/-- The product of the two sectors at `i` outside the three vertices `i,j,k`. -/
def quadraticOutsideProduct
    (Z : Section3.IntegerSectorFamily)
    (i j k : Fin 5) : ℤ :=
  ∏ r ∈ ((Finset.univ.erase i).erase j).erase k, Z i r

/-- Swapping the last two removed endpoints does not change the outside product. -/
theorem quadraticOutsideProduct_swap
    (Z : Section3.IntegerSectorFamily)
    (i j k : Fin 5) :
    quadraticOutsideProduct Z i j k =
      quadraticOutsideProduct Z i k j := by
  unfold quadraticOutsideProduct
  rw [Finset.erase_right_comm]

/-- Split a reduced-cubic complement product at a third distinct endpoint. -/
theorem reducedCubicComplementProduct_split
    (Z : Section3.IntegerSectorFamily)
    {i j k : Fin 5}
    (hik : i ≠ k)
    (hjk : j ≠ k) :
    reducedCubicComplementProduct Z i j =
      Z i k * quadraticOutsideProduct Z i j k := by
  have hkmem : k ∈ (Finset.univ.erase i).erase j := by
    apply Finset.mem_erase.mpr
    refine ⟨Ne.symm hjk, ?_⟩
    exact
      Finset.mem_erase.mpr
        ⟨Ne.symm hik, Finset.mem_univ k⟩
  simpa
      [reducedCubicComplementProduct,
        quadraticOutsideProduct] using
    (Finset.mul_prod_erase
      ((Finset.univ.erase i).erase j)
      (fun r : Fin 5 => Z i r)
      hkmem).symm

/--
The three-edge quadratic descendant identity attached to one ordered triangle.
The active coordinates are the endpoint edges `uv`, `uw`, and `vw`.
-/
def quadraticDescendantIdentityAt
    (b : Section3.EndpointCoefficientFamily)
    (Z : Section3.IntegerSectorFamily)
    (u v w : Fin 5) : Prop :=
  b u v * quadraticOutsideProduct Z w u v -
      b u w * quadraticOutsideProduct Z v u w +
      b v w * quadraticOutsideProduct Z u v w = 0

/-- The finite quadratic descent table at one sequence index. -/
def quadratic_descent_table_at
    (b : Section3.EndpointCoefficientFamily)
    (Z : Section3.IntegerSectorFamily) : Prop :=
  ∀ u v w : Fin 5, u < v → v < w →
    quadraticDescendantIdentityAt b Z u v w

/-- Three compatible reduced cubic rows give one quadratic descendant row. -/
theorem reduced_cubic_rows_give_quadratic_descendant
    {b : Section3.EndpointCoefficientFamily}
    {Z : Section3.IntegerSectorFamily}
    (hSym :
      ∀ i j : Fin 5, i ≠ j → Z i j = Z j i)
    (hRows : reduced_cubic_rows_at b Z)
    {u v w : Fin 5}
    (huv : u < v)
    (hvw : v < w) :
    quadraticDescendantIdentityAt b Z u v w := by
  have huw : u < w := lt_trans huv hvw
  have huvNe : u ≠ v := ne_of_lt huv
  have hvwNe : v ≠ w := ne_of_lt hvw
  have huwNe : u ≠ w := ne_of_lt huw

  have hUV := hRows u v huv
  have hUW := hRows u w huw
  have hVW := hRows v w hvw

  unfold reducedCubicRowValue at hUV hUW hVW

  rw [
    reducedCubicComplementProduct_split
      (Z := Z) (i := v) (j := u) (k := w)
      hvwNe huwNe,
    reducedCubicComplementProduct_split
      (Z := Z) (i := u) (j := v) (k := w)
      huwNe hvwNe
  ] at hUV

  rw [
    reducedCubicComplementProduct_split
      (Z := Z) (i := w) (j := u) (k := v)
      (Ne.symm hvwNe) huvNe,
    reducedCubicComplementProduct_split
      (Z := Z) (i := u) (j := w) (k := v)
      huvNe (Ne.symm hvwNe)
  ] at hUW

  rw [
    reducedCubicComplementProduct_split
      (Z := Z) (i := w) (j := v) (k := u)
      (Ne.symm huwNe) (Ne.symm huvNe),
    reducedCubicComplementProduct_split
      (Z := Z) (i := v) (j := w) (k := u)
      (Ne.symm huvNe) (Ne.symm huwNe)
  ] at hVW

  have hSymUV : Z u v = Z v u :=
    hSym u v huvNe
  have hSymUW : Z u w = Z w u :=
    hSym u w huwNe
  have hSymVW : Z v w = Z w v :=
    hSym v w hvwNe

  rw [
    ← hSymVW,
    quadraticOutsideProduct_swap Z u w v
  ] at hUW

  rw [
    ← hSymUW,
    ← hSymUV,
    quadraticOutsideProduct_swap Z w v u,
    quadraticOutsideProduct_swap Z v w u
  ] at hVW

  unfold quadraticDescendantIdentityAt
  rw [hUV, hUW, hVW]
  ring

/-- The sequence-level quadratic descent table over the same canonical opening. -/
def Q_desc
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  ∀ m : ℕ,
    quadratic_descent_table_at
      (openingBSeq opening m)
      (openingZSeq opening m)

/-
================================================================================
STATE-SHAPE BATCH
Section 8.1, Sub-layer 02, Sub-box 02

Incoming state shape:
  R_cub opening

Outgoing state shape:
  Q_desc opening

Effect:
  For every ordered endpoint triangle, aligns the three compatible reduced
  cubic rows, rewrites their directed sector entries through the retained
  unordered sector laws, and cancels the common cubic terms by exact ring
  algebra.  The output is the finite table of ten quadratic rows, each with
  active support on exactly three endpoint edges.  No limiting, rank, coloring,
  prefix, affine, or terminal input is used.

Public theorem:
  build_Q_desc
================================================================================
-/

theorem build_Q_desc
    {opening : CanonicalIntervalOverloadOpeningData}
    (hRows : R_cub opening) :
    Q_desc opening := by
  intro m u v w huv hvw
  exact
    reduced_cubic_rows_give_quadratic_descendant
      (hRows.1 m).1
      (hRows.2 m)
      huv hvw


/-
