def uniform_max_linear_profile
    (G : MaxLinearProfile) : Prop :=
  G 0 = G 1 ∧
    G 1 = G 2 ∧
    G 2 = G 3

/-- The refined left-low branch shape for one rational max-linear profile. -/
def refined_left_low_profile
    (G : MaxLinearProfile) : Prop :=
  leftLowProductionBranchShape G

/-- The refined right-low branch shape for one rational max-linear profile. -/
def refined_right_low_profile
    (G : MaxLinearProfile) : Prop :=
  rightLowProductionBranchShape G

/--
The exact branch-alternative interface attached to one retained max-linear
profile sequence.

The first conjunct retains the exact max-linear realization over the same
`GammaSeq` and stored `sigmaSeq`.  The second conjunct records, pointwise, the
three paper branch shapes and nothing stronger.  In particular, this state does
not assert their disjunction and does not classify the profile.
-/
def refined_branch_alternatives
    (GammaSeq : Gamma_W_adjacent_growth_profile)
    (sigmaSeq : ProfileReadSequence)
    (GSeq : MaxLinearProfileSequence) : Prop :=
  max_linear_profile GammaSeq sigmaSeq GSeq ∧
    ∀ m : ℕ,
      (uniform_max_linear_profile (GSeq m) ↔
        (GSeq m 0 = GSeq m 1 ∧
          GSeq m 1 = GSeq m 2 ∧
          GSeq m 2 = GSeq m 3)) ∧
      (refined_left_low_profile (GSeq m) ↔
        (GSeq m 0 < GSeq m 2 ∧
          GSeq m 2 < GSeq m 1 ∧
          GSeq m 2 = GSeq m 3 ∧
          GSeq m 0 + GSeq m 1 =
            2 * GSeq m 2)) ∧
      (refined_right_low_profile (GSeq m) ↔
        (GSeq m 3 < GSeq m 1 ∧
          GSeq m 1 < GSeq m 2 ∧
          GSeq m 0 = GSeq m 1 ∧
          GSeq m 3 + GSeq m 2 =
            2 * GSeq m 1))

