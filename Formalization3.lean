Outgoing state shape:
  endpoint_address_context

Effect:
  Closes the five-vertex, four-gap, and ten-edge finite ledger.

Internal theorem:
  build_endpoint_address_context
================================================================================
-/

theorem build_endpoint_address_context :
    endpoint_address_context := by
  exact
    ⟨endpointVertexAddresses_card,
      adjacentGapAddresses_card,
      k5EdgeAddresses_card,
      k5EdgeBoundary_ordered⟩

/--
The Section 6 endpoint-address state required by Section 6.1.

The ordering belongs to the supplied pointwise endpoint family itself.  This
definition does not identify that family with `T`, an earlier divisor witness,
or any canonical-opening projection.
-/
def endpoint_address_state
    (v : Section3.EndpointValueFamily) : Prop :=
  StrictMono v ∧
    endpoint_address_context

