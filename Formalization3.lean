-/

/-- The complete retained Section 9 output packet. -/
def prefix_conflict_outputs
    (C : ℝ)
    (nSeq : ℕ → ℕ)
    (dSeq : ℕ → Fin 5 → ℕ)
    (opening : CanonicalIntervalOverloadOpeningData) : Prop :=
  K C nSeq dSeq opening ∧
    FG_mono C nSeq dSeq opening ∧
