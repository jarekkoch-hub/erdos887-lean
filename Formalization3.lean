def incident_growth_section_7_6_sub_layer_03_sub_box_03_label : String := "Right-low monotone-cubic certificate production and nonexistence by endpoint reversal"
def incident_growth_section_7_6_sub_layer_03_sub_box_03_inputs : List String := ["monotone_cubic_certificate_interfaces [construction]", "left_low_ruled_out [construction]"]
