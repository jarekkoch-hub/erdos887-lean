/-
================================================================================
THEOREM-SOURCE PAYLOAD COMPARTMENT
Section 8.3 rank-layer extraction source

The paper assigns two source components to this layer.

  1. The leading-layer extraction source freezes the endpoint coefficient
     pattern, supplies the top homogeneous row, the linear shadow `L_b`, and
     the right-hand side `eta`, and identifies their decomposition with the
     same quadratic descendant rows.

  2. The fork source attaches the rank-four, rank-three, and rank-at-most-two
     branch packets to that same matrix.  These packets are conditional on the
     corresponding rank regime and are not reconstructed from the integer rank.

These are permanent paper-source boundaries, not temporary placeholders.  The
public box theorems below consume the exact source proofs and derive the
advertised matrix and rank-source states.
================================================================================
-/

/-- One frozen rational coefficient on each fixed endpoint-edge address. -/
abbrev FrozenEndpointCoefficientPattern :=
  Section6.K5EdgeAddress → ℚ

/-- The top homogeneous row coefficient for every descendant row. -/
abbrev LeadingDescendantTopLayer :=
  QuadraticDescendantRowAddress → ℚ

/-- The ten-by-four leading descendant matrix. -/
abbrev LeadingDescendantMatrix :=
  Matrix QuadraticDescendantRowAddress Section6.AdjacentGapAddress ℚ

/-- The sequence-indexed right-hand side produced by the same extraction. -/
abbrev LeadingDescendantRHS :=
  ℕ → QuadraticDescendantRowAddress → ℚ

/--
The four pieces selected together by the leading-layer extraction source.
No custom structure or record is introduced.
-/
abbrev LeadingDescendantExtractionData :=
  FrozenEndpointCoefficientPattern ×
    (LeadingDescendantTopLayer ×
      (LeadingDescendantMatrix × LeadingDescendantRHS))

/-- The frozen coefficient projection. -/
def leadingFrozenCoefficientPattern
    (data : LeadingDescendantExtractionData) :
    FrozenEndpointCoefficientPattern :=
  data.1

/-- The top homogeneous layer projection. -/
def leadingTopHomogeneousLayer
    (data : LeadingDescendantExtractionData) :
    LeadingDescendantTopLayer :=
  data.2.1

/-- The matrix projection `L_b`. -/
def leadingMatrix
    (data : LeadingDescendantExtractionData) :
    LeadingDescendantMatrix :=
  data.2.2.1

/-- The right-hand side projection `eta`. -/
def leadingRHS
    (data : LeadingDescendantExtractionData) :
    LeadingDescendantRHS :=
  data.2.2.2

/-- The rational adjacent-gap vector at one retained sequence index. -/
def leadingAdjacentGapVector
    (opening : CanonicalIntervalOverloadOpeningData)
    (m : ℕ) :
    Section6.AdjacentGapAddress → ℚ :=
  fun k =>
    (Section6.adjacentEndpointGap
      (openingTSeq opening m) k : ℚ)

/-- The rational endpoint coefficient read at one fixed edge address. -/
def rationalEndpointCoefficientAtEdge
    (opening : CanonicalIntervalOverloadOpeningData)
    (m : ℕ)
    (e : Section6.K5EdgeAddress) : ℚ :=
  (openingBSeq opening m
    (Section6.k5EdgeBoundary e).1
    (Section6.k5EdgeBoundary e).2 : ℚ)

/--
The frozen pattern is the coefficient pattern of the same canonical opening at
all retained sequence indices.
-/
def frozen_endpoint_coefficient_pattern
    (opening : CanonicalIntervalOverloadOpeningData)
    (frozenB : FrozenEndpointCoefficientPattern) : Prop :=
  ∀ m : ℕ, ∀ e : Section6.K5EdgeAddress,
    frozenB e = rationalEndpointCoefficientAtEdge opening m e

/-- The descendant active part after replacing the endpoint coefficients by the frozen pattern. -/
def frozenQuadraticDescendantActivePart
    (frozenB : FrozenEndpointCoefficientPattern)
    (Z : Section3.IntegerSectorFamily)
    (t : QuadraticDescendantRowAddress) : ℚ :=
  frozenB (quadraticDescendantEdgeVW t) *
      quadraticDescendantXvw Z t -
    frozenB (quadraticDescendantEdgeUW t) *
      quadraticDescendantXuw Z t +
    frozenB (quadraticDescendantEdgeUV t) *
      quadraticDescendantXuv Z t

/-- The matrix-vector read of the adjacent-gap vector. -/
def leadingMatrixGapRead
    (opening : CanonicalIntervalOverloadOpeningData)
    (data : LeadingDescendantExtractionData)
    (m : ℕ)
    (t : QuadraticDescendantRowAddress) : ℚ :=
  (leadingMatrix data).mulVec
    (leadingAdjacentGapVector opening m) t

/--
The exact leading-layer extraction source.

The final equation is the source decomposition of the frozen quadratic row
into its top homogeneous contribution and its first surviving linear residual.
The top layer, matrix, and right-hand side are therefore one synchronized
selection over the same row family.
-/
def leading_descendant_extraction_source
    (opening : CanonicalIntervalOverloadOpeningData)
    (data : LeadingDescendantExtractionData) : Prop :=
  frozen_endpoint_coefficient_pattern
      opening (leadingFrozenCoefficientPattern data) ∧
    (∀ t : QuadraticDescendantRowAddress,
      leadingTopHomogeneousLayer data t = 0) ∧
    ∀ m : ℕ, ∀ t : QuadraticDescendantRowAddress,
      frozenQuadraticDescendantActivePart
          (leadingFrozenCoefficientPattern data)
          (openingZSeq opening m) t =
        leadingTopHomogeneousLayer data t +
          (leadingMatrixGapRead opening data m t -
            leadingRHS data m t)

/-- The row identity is unchanged when the exact coefficient family is read through its frozen edge pattern. -/
theorem quadraticDescendantActivePart_eq_frozen
    {opening : CanonicalIntervalOverloadOpeningData}
    {data : LeadingDescendantExtractionData}
    (hFrozen :
      frozen_endpoint_coefficient_pattern
        opening (leadingFrozenCoefficientPattern data))
    (m : ℕ)
    (t : QuadraticDescendantRowAddress) :
    quadraticDescendantActivePart
        (openingBSeq opening m)
        (openingZSeq opening m) t =
      frozenQuadraticDescendantActivePart
        (leadingFrozenCoefficientPattern data)
        (openingZSeq opening m) t := by
  rcases quadraticDescendantActiveEdgePacket_holds t with
    ⟨hVW, hUW, hUV, _, _, _⟩
  unfold frozenQuadraticDescendantActivePart
  unfold quadraticDescendantActivePart
  unfold quadraticDescendantLambdaVW
  unfold quadraticDescendantLambdaUW
  unfold quadraticDescendantLambdaUV
  rw [
    hFrozen m (quadraticDescendantEdgeVW t),
    hFrozen m (quadraticDescendantEdgeUW t),
    hFrozen m (quadraticDescendantEdgeUV t)
  ]
  unfold rationalEndpointCoefficientAtEdge
  rw [hVW, hUW, hUV]
  ring

/-- The exact linear system `L_b g = eta` over the retained sequence. -/
def leading_descendant_linear_system
    (opening : CanonicalIntervalOverloadOpeningData)
    (data : LeadingDescendantExtractionData) : Prop :=
  ∀ m : ℕ, ∀ t : QuadraticDescendantRowAddress,
    leadingMatrixGapRead opening data m t =
      leadingRHS data m t

/--
The leading descendant matrix state.

The quadratic rows and interval substitutions are retained as the source and
address components of the extraction.  The source proof records the frozen
pattern and top-layer provenance.  The final conjunct is the derived linear
system.
-/
def leading_descendant_matrix
    (opening : CanonicalIntervalOverloadOpeningData)
    (data : LeadingDescendantExtractionData) : Prop :=
  quadratic_descendant_rows opening ∧
    Section6.endpoint_intervals (openingTSeq opening) ∧
    leading_descendant_extraction_source opening data ∧
    leading_descendant_linear_system opening data

/-
================================================================================
EXECUTABLE BOX
Section 8.3, Sub-layer 01, Sub-box 01
Birth token: Leading descendant matrix

This box combines the exact materialized quadratic rows, the endpoint interval
packet from the same `S_0`, and one synchronized leading-layer extraction
source.  The displayed system is proved from those inputs.  It is not inserted
as a separate source field.
================================================================================
-/

/-
================================================================================
STATE-SHAPE BATCH
Section 8.3, Sub-layer 01, Sub-box 01

Incoming state shape:
  quadratic_descendant_rows opening
  Section6.Legacy.legacy_S_0 C nSeq dSeq
    (openingTSeq opening)
    (openingBSeq opening)
    (openingZSeq opening)
  leading_descendant_extraction_source opening data

Outgoing state shape:
  leading_descendant_matrix opening data

Effect:
  Reads the fixed endpoint interval substitutions from the exact `S_0`, freezes
  the endpoint coefficient pattern through the extraction source, identifies
  the source decomposition with the same quadratic rows, eliminates the
  vanishing top homogeneous layer, and derives the pointwise system
  `L_b g = eta`.  The matrix and right-hand side are not independently chosen.

Public theorem:
  build_leading_descendant_matrix
================================================================================
-/

theorem build_leading_descendant_matrix
    {C : ℝ}
    {nSeq : ℕ → ℕ}
    {dSeq : ℕ → Fin 5 → ℕ}
    {opening : CanonicalIntervalOverloadOpeningData}
    {data : LeadingDescendantExtractionData}
    (hRows : quadratic_descendant_rows opening)
    (hS0 :
      Section6.Legacy.legacy_S_0
        C nSeq dSeq
        (openingTSeq opening)
        (openingBSeq opening)
        (openingZSeq opening))
    (hSource :
      leading_descendant_extraction_source opening data) :
    leading_descendant_matrix opening data := by
  refine ⟨hRows, hS0.2.2.1, hSource, ?_⟩
  intro m t
  have hRowZero :
      quadraticDescendantActivePart
          (openingBSeq opening m)
          (openingZSeq opening m) t = 0 :=
    (hRows m t).2.2.2
  have hFrozenEq :
      quadraticDescendantActivePart
          (openingBSeq opening m)
          (openingZSeq opening m) t =
        frozenQuadraticDescendantActivePart
          (leadingFrozenCoefficientPattern data)
          (openingZSeq opening m) t :=
    quadraticDescendantActivePart_eq_frozen
      hSource.1 m t
  have hFrozenZero :
      frozenQuadraticDescendantActivePart
          (leadingFrozenCoefficientPattern data)
          (openingZSeq opening m) t = 0 := by
    rw [← hFrozenEq]
    exact hRowZero
  have hTopZero :
      leadingTopHomogeneousLayer data t = 0 :=
    hSource.2.1 t
  have hDecomposition := hSource.2.2 m t
  linarith

/-- The retained rank of the exact leading matrix. -/
noncomputable def leadingDescendantRank
    (data : LeadingDescendantExtractionData) : ℕ :=
  Matrix.rank (leadingMatrix data)

/-- Four selected descendant rows used by a rank-four source packet. -/
abbrev RankFourRowSelection :=
  Fin 4 → QuadraticDescendantRowAddress

/-- The rank-four source data: selected rows and three quantitative bounds. -/
abbrev RankFourSourceData :=
  RankFourRowSelection × (ℚ × (ℚ × ℚ))

/-- Selected rows in the rank-four source data. -/
def rankFourSelectedRows
    (data : RankFourSourceData) : RankFourRowSelection :=
  data.1

/-- A uniform coefficient bound for the selected minor. -/
def rankFourCoefficientBound
    (data : RankFourSourceData) : ℚ :=
  data.2.1

/-- A uniform right-hand-side bound. -/
def rankFourRHSBound
    (data : RankFourSourceData) : ℚ :=
  data.2.2.1

/-- A positive lower bound for the selected determinant. -/
def rankFourDeterminantLowerBound
    (data : RankFourSourceData) : ℚ :=
  data.2.2.2

/-- The selected four-by-four minor of the leading matrix. -/
def rankFourMinor
    (leadingData : LeadingDescendantExtractionData)
    (rankFourData : RankFourSourceData) :
    Matrix (Fin 4) (Fin 4) ℚ :=
  (leadingMatrix leadingData).submatrix
    (rankFourSelectedRows rankFourData) id

/--
The rank-four certificate source attached to the rank-four branch.
The boundedness contradiction itself remains owned by Section 8.4.
-/
def rank_four_boundedness_source
    (opening : CanonicalIntervalOverloadOpeningData)
    (leadingData : LeadingDescendantExtractionData)
    (rankFourData : RankFourSourceData) : Prop :=
  leadingDescendantRank leadingData = 4 →
    (rankFourMinor leadingData rankFourData).det ≠ 0 ∧
      0 ≤ rankFourCoefficientBound rankFourData ∧
      0 ≤ rankFourRHSBound rankFourData ∧
      0 < rankFourDeterminantLowerBound rankFourData ∧
      (∀ i k : Fin 4,
        |rankFourMinor leadingData rankFourData i k| ≤
          rankFourCoefficientBound rankFourData) ∧
      (∀ m : ℕ, ∀ i : Fin 4,
        |leadingRHS leadingData m
            (rankFourSelectedRows rankFourData i)| ≤
          rankFourRHSBound rankFourData) ∧
      rankFourDeterminantLowerBound rankFourData ≤
        |(rankFourMinor leadingData rankFourData).det| ∧
      ∀ B : ℚ, ∃ m : ℕ, ∃ k : Section6.AdjacentGapAddress,
        B < |leadingAdjacentGapVector opening m k|

/-- Rank-three source data: absorption flag, slope vector, and offset vector. -/
abbrev RankThreeSourceData :=
  Bool ×
    ((Section6.AdjacentGapAddress → ℚ) ×
      (Section6.AdjacentGapAddress → ℚ))

/-- Whether the rank-three branch is already absorbed. -/
def rankThreeAbsorbed
    (data : RankThreeSourceData) : Bool :=
  data.1

/-- The affine slope vector `kappa`. -/
def rankThreeKappa
    (data : RankThreeSourceData) :
    Section6.AdjacentGapAddress → ℚ :=
  data.2.1

/-- The affine offset vector `s`. -/
def rankThreeOffset
    (data : RankThreeSourceData) :
    Section6.AdjacentGapAddress → ℚ :=
  data.2.2

/-- The affine adjacent-gap read carried by the rank-three source. -/
def rankThreeAffineGap
    (data : RankThreeSourceData)
    (T : ℚ)
    (k : Section6.AdjacentGapAddress) : ℚ :=
  rankThreeKappa data k * T + rankThreeOffset data k

/--
The rank-three source either records absorption or places every retained gap
vector on one affine line with the selected slopes and offsets.
-/
def rank_three_affine_line_source
    (opening : CanonicalIntervalOverloadOpeningData)
    (leadingData : LeadingDescendantExtractionData)
    (rankThreeData : RankThreeSourceData) : Prop :=
  leadingDescendantRank leadingData = 3 →
    (rankThreeAbsorbed rankThreeData = true ∧
      ¬ (∀ m : ℕ, ∃ T : ℚ,
        ∀ k : Section6.AdjacentGapAddress,
          leadingAdjacentGapVector opening m k =
            rankThreeAffineGap rankThreeData T k)) ∨
    (rankThreeAbsorbed rankThreeData = false ∧
      ∀ m : ℕ, ∃ T : ℚ,
        ∀ k : Section6.AdjacentGapAddress,
          leadingAdjacentGapVector opening m k =
            rankThreeAffineGap rankThreeData T k)

/-- The selected two-class active leading direction on each row slot. -/
abbrev LowRankActiveDirectionFamily :=
  QuadraticDescendantRowAddress → Fin 3 → Bool

/-- A rational value attached to every ordered five-endpoint frame label. -/
abbrev TopProductFrameValueFamily :=
  Section6.EndpointAddress →
    Section6.EndpointAddress →
      Section6.EndpointAddress →
        Section6.EndpointAddress →
          Section6.EndpointAddress → ℚ

/-- The two sides of the retained top-product frame identity. -/
abbrev TopProductFrameSourceData :=
  TopProductFrameValueFamily × TopProductFrameValueFamily

/--
The selected low-rank source data.

The active direction family is row-indexed and slot-indexed.  Its codomain is
`Bool`, so after coherence with the selected edge direction function is proved,
every active comparison lies in exactly the two retained projective classes.
The final pair stores the lower-layer and row-applicability flags together with
the frame identity family used by the prefix route.
-/
abbrev LowRankSourceData :=
  (Section6.K5EdgeAddress → Bool) ×
    (Section6.BooleanEdgeIndicator ×
      (LowRankActiveDirectionFamily ×
        (Bool × (Bool × TopProductFrameSourceData))))

/-- The selected leading-direction function. -/
def lowRankLeadingDirection
    (data : LowRankSourceData) :
    Section6.K5EdgeAddress → Bool :=
  data.1

/-- The selected leading-direction coloring. -/
def lowRankSelectedColoring
    (data : LowRankSourceData) :
    Section6.BooleanEdgeIndicator :=
  data.2.1

/-- The active leading direction read on each descendant-row slot. -/
def lowRankActiveDirection
    (data : LowRankSourceData) :
    LowRankActiveDirectionFamily :=
  data.2.2.1

/-- The retained no-lower-layer-escape flag. -/
def lowRankNoLowerEscapeFlag
    (data : LowRankSourceData) : Bool :=
  data.2.2.2.1

/-- The retained active-row applicability flag. -/
def lowRankRowApplicabilityFlag
    (data : LowRankSourceData) : Bool :=
  data.2.2.2.2.1

/-- The retained top-product frame source data. -/
def lowRankTopProductFrameSourceData
    (data : LowRankSourceData) : TopProductFrameSourceData :=
  data.2.2.2.2.2

/-- The left side of the retained top-product frame identity. -/
def lowRankTopProductLeft
    (data : LowRankSourceData) : TopProductFrameValueFamily :=
  (lowRankTopProductFrameSourceData data).1

/-- The right side of the retained top-product frame identity. -/
def lowRankTopProductRight
    (data : LowRankSourceData) : TopProductFrameValueFamily :=
  (lowRankTopProductFrameSourceData data).2

/-- The active edge occupying one of the three row slots. -/
def lowRankActiveEdge
    (t : QuadraticDescendantRowAddress)
    (q : Fin 3) : Section6.K5EdgeAddress :=
  ![quadraticDescendantEdgeVW t,
    quadraticDescendantEdgeUW t,
    quadraticDescendantEdgeUV t] q

/--
Every active row direction agrees with the selected two-class edge direction.
This is the exact no-third-direction condition used by the low-rank route.
-/
def low_rank_no_third_direction
    (data : LowRankSourceData) : Prop :=
  ∀ t : QuadraticDescendantRowAddress, ∀ q : Fin 3,
    lowRankActiveDirection data t q =
      lowRankLeadingDirection data (lowRankActiveEdge t q)

/-- Incident multiset balance for the selected coloring. -/
def lowRankIncidentMultisetBalance
    (chi : Section6.BooleanEdgeIndicator) : Prop :=
  ∀ i j r s t : Section6.EndpointAddress,
    List.Nodup [i, j, r, s, t] →
      Section6.booleanTriplePermutation
        (chi (Section6.endpointEdgeReference i r))
        (chi (Section6.endpointEdgeReference i s))
        (chi (Section6.endpointEdgeReference i t))
        (chi (Section6.endpointEdgeReference j r))
        (chi (Section6.endpointEdgeReference j s))
        (chi (Section6.endpointEdgeReference j t))

/-- Endpoint inventory balance is the same incident multiset balance read endpointwise. -/
def lowRankEndpointInventoryBalance
    (chi : Section6.BooleanEdgeIndicator) : Prop :=
  lowRankIncidentMultisetBalance chi

/-- The retained leading-layer product identity on every legal pair-product frame. -/
def low_rank_top_product_frame_source
    (data : LowRankSourceData) : Prop :=
  ∀ i j k a b : Section6.EndpointAddress,
    Section6.pair_product_frame i j k a b →
      lowRankTopProductLeft data i j k a b =
        lowRankTopProductRight data i j k a b

/-- The selected two-class coloring source on the rank-at-most-two branch. -/
def low_rank_leading_direction_source
    (leadingData : LeadingDescendantExtractionData)
    (lowRankData : LowRankSourceData) : Prop :=
  leadingDescendantRank leadingData ≤ 2 →
    (∀ e : Section6.K5EdgeAddress,
      lowRankSelectedColoring lowRankData e = true ↔
        lowRankLeadingDirection lowRankData e = true) ∧
      lowRankIncidentMultisetBalance
        (lowRankSelectedColoring lowRankData) ∧
      low_rank_no_third_direction lowRankData ∧
      lowRankNoLowerEscapeFlag lowRankData = true ∧
      lowRankRowApplicabilityFlag lowRankData = true ∧
      low_rank_top_product_frame_source lowRankData


/-- The three branch packets selected together by the rank source. -/
abbrev RankRegimeSourceData :=
  RankFourSourceData × (RankThreeSourceData × LowRankSourceData)

/-- Rank-four data projection. -/
def rankFourSourceData
    (data : RankRegimeSourceData) : RankFourSourceData :=
  data.1

/-- Rank-three data projection. -/
def rankThreeSourceData
    (data : RankRegimeSourceData) : RankThreeSourceData :=
  data.2.1

/-- Low-rank data projection. -/
def lowRankSourceData
    (data : RankRegimeSourceData) : LowRankSourceData :=
  data.2.2

/--
The fork source attached to one exact leading matrix.  Each branch packet is
conditional on its own rank regime.  None is inferred from `rho` alone.
-/
def rank_regime_source
    (opening : CanonicalIntervalOverloadOpeningData)
    (leadingData : LeadingDescendantExtractionData)
    (regimeData : RankRegimeSourceData) : Prop :=
  rank_four_boundedness_source
      opening leadingData (rankFourSourceData regimeData) ∧
    rank_three_affine_line_source
      opening leadingData (rankThreeSourceData regimeData) ∧
    low_rank_leading_direction_source
      leadingData (lowRankSourceData regimeData)

/-- The complete permanent source boundary consumed by Section 8.3. -/
def rank_layer_source
    (opening : CanonicalIntervalOverloadOpeningData)
    (leadingData : LeadingDescendantExtractionData)
    (regimeData : RankRegimeSourceData) : Prop :=
  leading_descendant_extraction_source opening leadingData ∧
    rank_regime_source opening leadingData regimeData

/--
The rank source stores the exact leading matrix state, the definitional rank,
the four-column rank bound, and the three retained conditional branch packets.
-/
def rank_source
    (opening : CanonicalIntervalOverloadOpeningData)
    (leadingData : LeadingDescendantExtractionData)
    (regimeData : RankRegimeSourceData) : Prop :=
  leading_descendant_matrix opening leadingData ∧
    leadingDescendantRank leadingData =
      Matrix.rank (leadingMatrix leadingData) ∧
    leadingDescendantRank leadingData ≤ 4 ∧
    rank_regime_source opening leadingData regimeData

/-
================================================================================
